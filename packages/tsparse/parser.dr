from scanner import Scanner, token_name
from scanner import TK_UNKNOWN, TK_EOF, TK_NUMERIC_LITERAL, TK_BIGINT_LITERAL, TK_STRING_LITERAL, TK_REGEX_LITERAL, TK_NO_SUB_TEMPLATE, TK_TEMPLATE_HEAD, TK_TEMPLATE_MIDDLE, TK_TEMPLATE_TAIL
from scanner import TK_OPEN_BRACE, TK_CLOSE_BRACE, TK_OPEN_PAREN, TK_CLOSE_PAREN, TK_OPEN_BRACKET, TK_CLOSE_BRACKET, TK_DOT, TK_DOT_DOT_DOT, TK_SEMICOLON, TK_COMMA, TK_QUESTION_DOT
from scanner import TK_LT, TK_GT, TK_LT_EQ, TK_GT_EQ, TK_EQ_EQ, TK_EXCL_EQ, TK_EQ_EQ_EQ, TK_EXCL_EQ_EQ, TK_ARROW, TK_PLUS, TK_MINUS, TK_ASTERISK, TK_ASTERISK_ASTERISK, TK_SLASH, TK_PERCENT
from scanner import TK_PLUS_PLUS, TK_MINUS_MINUS, TK_LT_LT, TK_GT_GT, TK_GT_GT_GT, TK_AMP, TK_BAR, TK_CARET, TK_EXCL, TK_TILDE, TK_AMP_AMP, TK_BAR_BAR, TK_QUESTION, TK_COLON, TK_AT
from scanner import TK_QUESTION_QUESTION, TK_BACKTICK, TK_HASH, TK_EQ, TK_PLUS_EQ, TK_MINUS_EQ, TK_ASTERISK_EQ, TK_ASTERISK_ASTERISK_EQ, TK_SLASH_EQ, TK_PERCENT_EQ, TK_LT_LT_EQ
from scanner import TK_GT_GT_EQ, TK_GT_GT_GT_EQ, TK_AMP_EQ, TK_BAR_EQ, TK_BAR_BAR_EQ, TK_AMP_AMP_EQ, TK_QUESTION_QUESTION_EQ, TK_CARET_EQ, TK_IDENTIFIER, TK_PRIVATE_IDENTIFIER
from scanner import TK_KW_FIRST, TK_KW_LAST, TK_ABSTRACT, TK_ACCESSOR, TK_ANY, TK_AS, TK_ASSERTS, TK_ASSERT, TK_ASYNC, TK_AWAIT, TK_BIGINT, TK_BOOLEAN, TK_BREAK, TK_CASE, TK_CATCH
from scanner import TK_CLASS, TK_CONST, TK_CONSTRUCTOR, TK_CONTINUE, TK_DEBUGGER, TK_DECLARE, TK_DEFAULT, TK_DELETE, TK_DO, TK_ELSE, TK_ENUM, TK_EXPORT, TK_EXTENDS, TK_FALSE
from scanner import TK_FINALLY, TK_FOR, TK_FROM, TK_FUNCTION, TK_GET, TK_GLOBAL, TK_IF, TK_IMPLEMENTS, TK_IMPORT, TK_IN, TK_INFER, TK_INSTANCEOF, TK_INTERFACE, TK_INTRINSIC
from scanner import TK_IS, TK_KEYOF, TK_LET, TK_MODULE, TK_NAMESPACE, TK_NEVER, TK_NEW, TK_NULL, TK_NUMBER, TK_OBJECT, TK_OF, TK_OUT, TK_OVERRIDE, TK_PACKAGE, TK_PRIVATE
from scanner import TK_PROTECTED, TK_PUBLIC, TK_READONLY, TK_REQUIRE, TK_RETURN, TK_SATISFIES, TK_SET, TK_STATIC, TK_STRING, TK_SUPER, TK_SWITCH, TK_SYMBOL, TK_THIS, TK_THROW
from scanner import TK_TRUE, TK_TRY, TK_TYPE, TK_TYPEOF, TK_UNDEFINED, TK_UNIQUE, TK_UNKNOWN_KW, TK_USING, TK_VAR, TK_VOID, TK_WHILE, TK_WITH, TK_YIELD, TK_DEFER


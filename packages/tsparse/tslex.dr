from io import open, Reader
from sys import argv
from time import perf_counter
from scanner import Scanner, token_name, TK_EOF

def read_file(path: str) -> bytes {
    const rd: Reader = open(path)
    return rd.bytes()
}

def lex_dump(path: str) -> None {
    const buf: bytes = read_file(path)
    sc: Scanner = Scanner(buf)
    lines: list[str] = []
    while true {
        const k: int = sc.scan()
        lines.append(f"{token_name(k)} {sc.tok_start} {sc.pos}")
        if k == TK_EOF {
            break
        }
    }
    print("\n".join(lines))
}

def lex_bench(path: str, iters: int) -> None {
    const buf: bytes = read_file(path)
    best: float = 1.0e9
    total: float = 0.0
    tokens: int = 0
    i: int = 0
    while i < iters {
        const t0: float = perf_counter()
        sc: Scanner = Scanner(buf)
        count: int = 0
        while true {
            const k: int = sc.scan()
            count = count + 1
            if k == TK_EOF {
                break
            }
        }
        const dt: float = perf_counter() - t0
        if dt < best {
            best = dt
        }
        total = total + dt
        tokens = count
        i = i + 1
    }
    const mb: float = len(buf) / 1048576.0
    print(f"file: {path}")
    print(f"tokens: {tokens}")
    print(f"best: {best * 1000.0} ms  avg: {total / iters * 1000.0} ms")
    print(f"throughput: {mb / best} MB/s")
}

const args: list[str] = argv()
if len(args) < 3 {
    print("usage: tslex <dump|bench> <file> [iters]")
} else {
    const mode: str = args[1]
    if mode == "dump" {
        lex_dump(args[2])
    } else {
        iters: int = 20
        if len(args) >= 4 {
            iters = int(args[3])
        }
        lex_bench(args[2], iters)
    }
}

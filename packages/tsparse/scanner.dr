const TK_CLOSE_BRACE: int = 11
const TK_OPEN_PAREN: int = 12
const TK_CLOSE_PAREN: int = 13
const TK_OPEN_BRACKET: int = 14
const TK_CLOSE_BRACKET: int = 15

const TK_DOT_DOT_DOT: int = 17
const TK_SEMICOLON: int = 18
const TK_COMMA: int = 19
const TK_QUESTION_DOT: int = 20
const TK_LT: int = 21
const TK_LT_SLASH: int = 22
const TK_GT: int = 23
const TK_LT_EQ: int = 24

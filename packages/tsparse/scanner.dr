const TK_UNKNOWN: int = 0
const TK_EOF: int = 1
const TK_NUMERIC_LITERAL: int = 2
const TK_BIGINT_LITERAL: int = 3
const TK_STRING_LITERAL: int = 4
const TK_REGEX_LITERAL: int = 5
const TK_NO_SUB_TEMPLATE: int = 6
const TK_TEMPLATE_HEAD: int = 7
const TK_TEMPLATE_MIDDLE: int = 8
const TK_TEMPLATE_TAIL: int = 9

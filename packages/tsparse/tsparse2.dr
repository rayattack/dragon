from io import open, Reader
from sys import argv
from time import perf_counter
from parser2 import Parser2, count_output2

def read_file(path: str) -> bytes {
    const rd: Reader = open(path)
    return rd.bytes()
}

def run_count(path: str) -> None {
    const buf: bytes = read_file(path)
    p: Parser2 = Parser2(buf)
    const root: int = p.parse_source_file()
    print(count_output2(p, root))
}

def run_bench(path: str, iters: int) -> None {
    const buf: bytes = read_file(path)
    best: float = 1.0e9
    total: float = 0.0
    nodes: int = 0
    i: int = 0
    while i < iters {
        const t0: float = perf_counter()
        p: Parser2 = Parser2(buf)
        const root: int = p.parse_source_file()
        const dt: float = perf_counter() - t0
        if dt < best {
            best = dt
        }
        total = total + dt
        nodes = p.nn
        i = i + 1
    }
    const mb: float = len(buf) / 1048576.0
    print(f"file: {path}")
    print(f"nodes: {nodes}")
    print(f"best: {best * 1000.0} ms  avg: {total / iters * 1000.0} ms")
    print(f"throughput: {mb / best} MB/s")
}

const args: list[str] = argv()
if len(args) < 3 {
    print("usage: tsparse2 <count|bench> <file> [iters]")
} else {
    const mode: str = args[1]
    if mode == "count" {
        run_count(args[2])
    } else {
        iters: int = 20
        if len(args) >= 4 {
            iters = int(args[3])
        }
        run_bench(args[2], iters)
    }
}

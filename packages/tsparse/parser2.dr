from scanner import token_name
from scanner import TK_UNKNOWN, TK_EOF, TK_NUMERIC_LITERAL, TK_BIGINT_LITERAL, TK_STRING_LITERAL, TK_REGEX_LITERAL, TK_NO_SUB_TEMPLATE, TK_TEMPLATE_HEAD, TK_TEMPLATE_MIDDLE, TK_TEMPLATE_TAIL
from scanner import TK_OPEN_BRACE, TK_CLOSE_BRACE, TK_OPEN_PAREN, TK_CLOSE_PAREN, TK_OPEN_BRACKET, TK_CLOSE_BRACKET, TK_DOT, TK_DOT_DOT_DOT, TK_SEMICOLON, TK_COMMA, TK_QUESTION_DOT
from scanner import TK_LT, TK_GT, TK_LT_EQ, TK_GT_EQ, TK_EQ_EQ, TK_EXCL_EQ, TK_EQ_EQ_EQ, TK_EXCL_EQ_EQ, TK_ARROW, TK_PLUS, TK_MINUS, TK_ASTERISK, TK_ASTERISK_ASTERISK, TK_SLASH, TK_PERCENT
from scanner import TK_PLUS_PLUS, TK_MINUS_MINUS, TK_LT_LT, TK_GT_GT, TK_GT_GT_GT, TK_AMP, TK_BAR, TK_CARET, TK_EXCL, TK_TILDE, TK_AMP_AMP, TK_BAR_BAR, TK_QUESTION, TK_COLON, TK_AT
from scanner import TK_QUESTION_QUESTION, TK_HASH, TK_EQ, TK_PLUS_EQ, TK_MINUS_EQ, TK_ASTERISK_EQ, TK_ASTERISK_ASTERISK_EQ, TK_SLASH_EQ, TK_PERCENT_EQ, TK_LT_LT_EQ
from scanner import TK_GT_GT_EQ, TK_GT_GT_GT_EQ, TK_AMP_EQ, TK_BAR_EQ, TK_BAR_BAR_EQ, TK_AMP_AMP_EQ, TK_QUESTION_QUESTION_EQ, TK_CARET_EQ, TK_IDENTIFIER, TK_PRIVATE_IDENTIFIER
from scanner import TK_KW_FIRST, TK_KW_LAST, TK_ABSTRACT, TK_ACCESSOR, TK_ANY, TK_AS, TK_ASSERTS, TK_ASSERT, TK_ASYNC, TK_AWAIT, TK_BIGINT, TK_BOOLEAN, TK_BREAK, TK_CASE, TK_CATCH
from scanner import TK_CLASS, TK_CONST, TK_CONSTRUCTOR, TK_CONTINUE, TK_DEBUGGER, TK_DECLARE, TK_DEFAULT, TK_DELETE, TK_DO, TK_ELSE, TK_ENUM, TK_EXPORT, TK_EXTENDS, TK_FALSE
from scanner import TK_FINALLY, TK_FOR, TK_FROM, TK_FUNCTION, TK_GET, TK_GLOBAL, TK_IF, TK_IMPLEMENTS, TK_IMPORT, TK_IN, TK_INFER, TK_INSTANCEOF, TK_INTERFACE, TK_INTRINSIC
from scanner import TK_IS, TK_KEYOF, TK_LET, TK_MODULE, TK_NAMESPACE, TK_NEVER, TK_NEW, TK_NULL, TK_NUMBER, TK_OBJECT, TK_OF, TK_OUT, TK_OVERRIDE, TK_PACKAGE, TK_PRIVATE
from scanner import TK_PROTECTED, TK_PUBLIC, TK_READONLY, TK_REQUIRE, TK_RETURN, TK_SATISFIES, TK_SET, TK_STATIC, TK_STRING, TK_SUPER, TK_SWITCH, TK_SYMBOL, TK_THIS, TK_THROW
from scanner import TK_TRUE, TK_TRY, TK_TYPE, TK_TYPEOF, TK_UNDEFINED, TK_UNIQUE, TK_UNKNOWN_KW, TK_USING, TK_VAR, TK_VOID, TK_WHILE, TK_WITH, TK_YIELD, TK_DEFER
from scanner2 import Scanner2
from parser import KW_IDENT_OK, COUNT_KINDS, COUNT_NAMES
from parser import NK_SOURCE_FILE, NK_QUALIFIED_NAME, NK_COMPUTED_PROPERTY_NAME, NK_TYPE_PARAMETER, NK_PARAMETER, NK_DECORATOR, NK_PROPERTY_SIGNATURE, NK_PROPERTY_DECLARATION
from parser import NK_METHOD_SIGNATURE, NK_METHOD_DECLARATION, NK_CLASS_STATIC_BLOCK, NK_CONSTRUCTOR, NK_GET_ACCESSOR, NK_SET_ACCESSOR, NK_CALL_SIGNATURE, NK_CONSTRUCT_SIGNATURE
from parser import NK_INDEX_SIGNATURE, NK_TYPE_PREDICATE, NK_TYPE_REFERENCE, NK_FUNCTION_TYPE, NK_CONSTRUCTOR_TYPE, NK_TYPE_QUERY, NK_TYPE_LITERAL, NK_ARRAY_TYPE, NK_TUPLE_TYPE
from parser import NK_OPTIONAL_TYPE, NK_REST_TYPE, NK_UNION_TYPE, NK_INTERSECTION_TYPE, NK_CONDITIONAL_TYPE, NK_INFER_TYPE, NK_PARENTHESIZED_TYPE, NK_THIS_TYPE, NK_TYPE_OPERATOR
from parser import NK_INDEXED_ACCESS_TYPE, NK_MAPPED_TYPE, NK_LITERAL_TYPE, NK_NAMED_TUPLE_MEMBER, NK_TEMPLATE_LITERAL_TYPE, NK_TEMPLATE_LITERAL_TYPE_SPAN, NK_IMPORT_TYPE
from parser import NK_OBJECT_BINDING_PATTERN, NK_ARRAY_BINDING_PATTERN, NK_BINDING_ELEMENT, NK_ARRAY_LITERAL, NK_OBJECT_LITERAL, NK_PROPERTY_ACCESS, NK_ELEMENT_ACCESS, NK_CALL
from parser import NK_NEW, NK_TAGGED_TEMPLATE, NK_TYPE_ASSERTION, NK_PAREN_EXPR, NK_FUNCTION_EXPR, NK_ARROW_FUNCTION, NK_DELETE_EXPR, NK_TYPEOF_EXPR, NK_VOID_EXPR, NK_AWAIT_EXPR
from parser import NK_PREFIX_UNARY, NK_POSTFIX_UNARY, NK_BINARY, NK_CONDITIONAL_EXPR, NK_TEMPLATE_EXPR, NK_YIELD_EXPR, NK_SPREAD, NK_CLASS_EXPR, NK_OMITTED, NK_EXPR_WITH_TYPE_ARGS
from parser import NK_AS_EXPR, NK_NON_NULL, NK_META_PROPERTY, NK_SATISFIES_EXPR, NK_TEMPLATE_SPAN, NK_BLOCK, NK_EMPTY_STATEMENT, NK_VARIABLE_STATEMENT, NK_EXPRESSION_STATEMENT
from parser import NK_IF_STATEMENT, NK_DO_STATEMENT, NK_WHILE_STATEMENT, NK_FOR_STATEMENT, NK_FOR_IN_STATEMENT, NK_FOR_OF_STATEMENT, NK_CONTINUE_STATEMENT, NK_BREAK_STATEMENT
from parser import NK_RETURN_STATEMENT, NK_WITH_STATEMENT, NK_SWITCH_STATEMENT, NK_LABELED_STATEMENT, NK_THROW_STATEMENT, NK_TRY_STATEMENT, NK_DEBUGGER_STATEMENT
from parser import NK_VARIABLE_DECLARATION, NK_VARIABLE_DECLARATION_LIST, NK_FUNCTION_DECLARATION, NK_CLASS_DECLARATION, NK_INTERFACE_DECLARATION, NK_TYPE_ALIAS_DECLARATION
from parser import NK_ENUM_DECLARATION, NK_MODULE_DECLARATION, NK_MODULE_BLOCK, NK_CASE_BLOCK, NK_CASE_CLAUSE, NK_DEFAULT_CLAUSE, NK_HERITAGE_CLAUSE, NK_CATCH_CLAUSE
from parser import NK_PROPERTY_ASSIGNMENT, NK_SHORTHAND_PROPERTY, NK_SPREAD_ASSIGNMENT, NK_ENUM_MEMBER, NK_IMPORT_DECLARATION, NK_IMPORT_CLAUSE, NK_NAMESPACE_IMPORT
from parser import NK_NAMED_IMPORTS, NK_IMPORT_SPECIFIER, NK_EXPORT_ASSIGNMENT, NK_EXPORT_DECLARATION, NK_NAMED_EXPORTS, NK_EXPORT_SPECIFIER, NK_NAMESPACE_EXPORT
from parser import NK_EXTERNAL_MODULE_REF, NK_IMPORT_EQUALS, NK_IMPORT_ATTRIBUTES, NK_IMPORT_ATTRIBUTE, NK_NAMESPACE_EXPORT_DECL, NK_SEMICOLON_CLASS_ELEMENT
from parser import MOD_EXPORT, MOD_DECLARE, MOD_ABSTRACT, MOD_ASYNC, MOD_STATIC, MOD_PUBLIC, MOD_PRIVATE, MOD_PROTECTED, MOD_READONLY, MOD_OVERRIDE, MOD_ACCESSOR, MOD_DEFAULT, MOD_CONST_KW, MOD_IN, MOD_OUT

const F_KIND: int = 0
const F_POS: int = 1
const F_END: int = 2
const F_OP: int = 3
const F_FLAGS: int = 4
const F_A: int = 5
const F_B: int = 6
const F_C: int = 7
const F_D: int = 8
const F_KS: int = 9
const F_KN: int = 10
const STRIDE: int = 11

class Parser2 {
    sc: Scanner2
    tok: int = 0
    prev_end: int = 0
    no_in: bool = false
    no_cond_type: bool = false

    ast: list[int]
    cap: int = 0
    nn: int = 0
    edges: list[int]
    ecap: int = 0
    ep: int = 0
    stk: list[int]
    sp: int = 0
    sv: list[int]
    sd: int = 0

    def(src: bytes) {
        self.sc = Scanner2(src)
        cap: int = len(src) // 11 + 128
        self.cap = cap
        self.ast = [0] * (cap * STRIDE)
        self.ecap = cap
        self.edges = [0] * cap
        self.stk = [0] * 1024
        self.sp = 0
        self.sv = [0] * 640
        self.sd = 0
        self.tok = self.sc.scan()
    }

    def new_node(kind: int, pos: int) -> int {
        const i: int = self.nn
        self.nn = i + 1
        const base: int = i * STRIDE
        if i >= self.cap {
            self.ast.append(kind)
            self.ast.append(pos)
            self.ast.append(0)
            self.ast.append(0)
            self.ast.append(0)
            self.ast.append(0 - 1)
            self.ast.append(0 - 1)
            self.ast.append(0 - 1)
            self.ast.append(0 - 1)
            self.ast.append(0)
            self.ast.append(0)
            self.cap = self.cap + 1
            return i
        }
        self.ast[base + F_KIND] = kind
        self.ast[base + F_POS] = pos
        self.ast[base + F_END] = 0
        self.ast[base + F_OP] = 0
        self.ast[base + F_FLAGS] = 0
        self.ast[base + F_A] = 0 - 1
        self.ast[base + F_B] = 0 - 1
        self.ast[base + F_C] = 0 - 1
        self.ast[base + F_D] = 0 - 1
        self.ast[base + F_KS] = 0
        self.ast[base + F_KN] = 0
        return i
    }

    def mk(kind: int) -> int {
        return self.new_node(kind, self.sc.tok_start)
    }

    def fin(i: int) -> int {
        self.ast[i * STRIDE + F_END] = self.prev_end
        return i
    }

    def seta(i: int, v: int) -> None {
        self.ast[i * STRIDE + F_A] = v
    }

    def setb(i: int, v: int) -> None {
        self.ast[i * STRIDE + F_B] = v
    }

    def setc(i: int, v: int) -> None {
        self.ast[i * STRIDE + F_C] = v
    }

    def setd(i: int, v: int) -> None {
        self.ast[i * STRIDE + F_D] = v
    }

    def setop(i: int, v: int) -> None {
        self.ast[i * STRIDE + F_OP] = v
    }

    def setflags(i: int, v: int) -> None {
        self.ast[i * STRIDE + F_FLAGS] = v
    }

    def getflags(i: int) -> int {
        return self.ast[i * STRIDE + F_FLAGS]
    }

    def push(v: int) -> None {
        if self.sp >= len(self.stk) {
            self.stk.append(v)
        } else {
            self.stk[self.sp] = v
        }
        self.sp = self.sp + 1
    }

    def close_kids(i: int, base: int) -> None {
        const count: int = self.sp - base
        const start: int = self.ep
        j: int = 0
        while j < count {
            const v: int = self.stk[base + j]
            if self.ep >= self.ecap {
                self.edges.append(v)
                self.ecap = self.ecap + 1
            } else {
                self.edges[self.ep] = v
            }
            self.ep = self.ep + 1
            j = j + 1
        }
        self.ast[i * STRIDE + F_KS] = start
        self.ast[i * STRIDE + F_KN] = count
        self.sp = base
    }

    def bump() -> None {
        self.prev_end = self.sc.pos
        self.tok = self.sc.scan()
    }

    def at(k: int) -> bool {
        return self.tok == k
    }

    def eat(k: int) -> bool {
        if self.tok == k {
            self.bump()
            return true
        }
        return false
    }

    def expect(k: int) -> None {
        if self.tok != k {
            self.fail(f"expected {token_name(k)}, found {token_name(self.tok)}")
        }
        self.bump()
    }

    def fail(msg: str) -> None {
        raise ValueError(f"parse error at byte {self.sc.tok_start}: {msg}")
    }

    def pos_of() -> int {
        return self.sc.tok_start
    }

    def mark() -> int {
        const d: int = self.sd
        const base: int = d * 5
        while len(self.sv) < base + 5 {
            self.sv.append(0)
        }
        self.sv[base] = self.sc.pos
        self.sv[base + 1] = self.sc.token
        self.sv[base + 2] = self.sc.tok_start
        self.sv[base + 3] = 1 if self.sc.line_break_before else 0
        self.sv[base + 4] = self.prev_end
        self.sd = d + 1
        return d
    }

    def restore(d: int) -> None {
        const base: int = d * 5
        self.sc.pos = self.sv[base]
        self.sc.token = self.sv[base + 1]
        self.sc.tok_start = self.sv[base + 2]
        self.sc.line_break_before = self.sv[base + 3] == 1
        self.prev_end = self.sv[base + 4]
        self.tok = self.sv[base + 1]
        self.sd = d
    }

    def drop(d: int) -> None {
        self.sd = d
    }

    def is_ident_like(t: int) -> bool {
        if t == TK_IDENTIFIER {
            return true
        }
        if t >= TK_KW_FIRST and t <= TK_KW_LAST {
            return KW_IDENT_OK[t] == 1
        }
        return false
    }

    def is_ident_name_tok(t: int) -> bool {
        return t == TK_IDENTIFIER or (t >= TK_KW_FIRST and t <= TK_KW_LAST)
    }

    def can_semi() -> bool {
        if self.tok == TK_SEMICOLON or self.tok == TK_CLOSE_BRACE or self.tok == TK_EOF {
            return true
        }
        return self.sc.line_break_before
    }

    def semi() -> None {
        if self.eat(TK_SEMICOLON) {
            return
        }
        if self.tok == TK_CLOSE_BRACE or self.tok == TK_EOF or self.sc.line_break_before {
            return
        }
        self.fail(f"expected semicolon, found {token_name(self.tok)}")
    }

    def peek() -> int {
        const d: int = self.mark()
        self.bump()
        const t: int = self.tok
        self.restore(d)
        return t
    }

    def peek_no_lb() -> int {
        const d: int = self.mark()
        self.bump()
        t: int = self.tok
        if self.sc.line_break_before {
            t = 0 - 1
        }
        self.restore(d)
        return t
    }

    def parse_ident() -> int {
        if not self.is_ident_like(self.tok) {
            self.fail(f"expected identifier, found {token_name(self.tok)}")
        }
        const n: int = self.mk(TK_IDENTIFIER)
        self.bump()
        return self.fin(n)
    }

    def parse_ident_name() -> int {
        if not self.is_ident_name_tok(self.tok) {
            self.fail(f"expected name, found {token_name(self.tok)}")
        }
        const n: int = self.mk(TK_IDENTIFIER)
        self.bump()
        return self.fin(n)
    }

    def parse_entity_name() -> int {
        left: int = self.parse_ident()
        while self.at(TK_DOT) {
            self.bump()
            const q: int = self.new_node(NK_QUALIFIED_NAME, self.ast[left * STRIDE + F_POS])
            self.seta(q, left)
            self.setb(q, self.parse_ident_name())
            left = self.fin(q)
        }
        return left
    }

    def parse_property_name() -> int {
        const t: int = self.tok
        if t == TK_STRING_LITERAL or t == TK_NO_SUB_TEMPLATE {
            const s: int = self.mk(TK_STRING_LITERAL)
            self.bump()
            return self.fin(s)
        }
        if t == TK_NUMERIC_LITERAL or t == TK_BIGINT_LITERAL {
            const m: int = self.mk(t)
            self.bump()
            return self.fin(m)
        }
        if t == TK_OPEN_BRACKET {
            const c: int = self.mk(NK_COMPUTED_PROPERTY_NAME)
            self.bump()
            self.seta(c, self.parse_assign())
            self.expect(TK_CLOSE_BRACKET)
            return self.fin(c)
        }
        if t == TK_PRIVATE_IDENTIFIER {
            const p: int = self.mk(TK_PRIVATE_IDENTIFIER)
            self.bump()
            return self.fin(p)
        }
        return self.parse_ident_name()
    }

    def parse_binding_name() -> int {
        if self.at(TK_OPEN_BRACE) {
            return self.parse_object_binding()
        }
        if self.at(TK_OPEN_BRACKET) {
            return self.parse_array_binding()
        }
        return self.parse_ident()
    }

    def parse_object_binding() -> int {
        const n: int = self.mk(NK_OBJECT_BINDING_PATTERN)
        self.expect(TK_OPEN_BRACE)
        const base: int = self.sp
        while not self.at(TK_CLOSE_BRACE) {
            const e: int = self.mk(NK_BINDING_ELEMENT)
            if self.eat(TK_DOT_DOT_DOT) {
                self.setop(e, 1)
            }
            const name: int = self.parse_property_name()
            if self.eat(TK_COLON) {
                self.seta(e, name)
                self.setb(e, self.parse_binding_name())
            } else {
                self.setb(e, name)
            }
            if self.eat(TK_EQ) {
                self.setc(e, self.parse_assign())
            }
            self.push(self.fin(e))
            if not self.eat(TK_COMMA) {
                break
            }
        }
        self.expect(TK_CLOSE_BRACE)
        self.close_kids(n, base)
        return self.fin(n)
    }

    def parse_array_binding() -> int {
        const n: int = self.mk(NK_ARRAY_BINDING_PATTERN)
        self.expect(TK_OPEN_BRACKET)
        const base: int = self.sp
        while not self.at(TK_CLOSE_BRACKET) {
            if self.at(TK_COMMA) {
                const o: int = self.mk(NK_OMITTED)
                self.push(self.fin(o))
                self.bump()
                continue
            }
            const e: int = self.mk(NK_BINDING_ELEMENT)
            if self.eat(TK_DOT_DOT_DOT) {
                self.setop(e, 1)
            }
            self.setb(e, self.parse_binding_name())
            if self.eat(TK_EQ) {
                self.setc(e, self.parse_assign())
            }
            self.push(self.fin(e))
            if not self.eat(TK_COMMA) {
                break
            }
        }
        self.expect(TK_CLOSE_BRACKET)
        self.close_kids(n, base)
        return self.fin(n)
    }

    def parse_type() -> int {
        if self.is_fn_type_start() {
            return self.parse_fn_or_ctor_type()
        }
        const t: int = self.parse_union_type()
        if self.at(TK_EXTENDS) and not self.no_cond_type {
            const n: int = self.new_node(NK_CONDITIONAL_TYPE, self.ast[t * STRIDE + F_POS])
            self.seta(n, t)
            self.bump()
            const saved: bool = self.no_cond_type
            self.no_cond_type = true
            self.setb(n, self.parse_type())
            self.no_cond_type = saved
            self.expect(TK_QUESTION)
            const saved2: bool = self.no_cond_type
            self.no_cond_type = false
            self.setc(n, self.parse_type())
            self.expect(TK_COLON)
            self.setd(n, self.parse_type())
            self.no_cond_type = saved2
            return self.fin(n)
        }
        return t
    }

    def is_fn_type_start() -> bool {
        const t: int = self.tok
        if t == TK_LT {
            return true
        }
        if t == TK_NEW {
            return true
        }
        if t == TK_ABSTRACT and self.peek() == TK_NEW {
            return true
        }
        if t != TK_OPEN_PAREN {
            return false
        }
        const d: int = self.mark()
        self.bump()
        result: bool = false
        if self.at(TK_CLOSE_PAREN) {
            self.bump()
            result = self.at(TK_ARROW)
        } elif self.at(TK_DOT_DOT_DOT) {
            result = true
        } elif self.is_ident_like(self.tok) or self.at(TK_THIS) or self.at(TK_OPEN_BRACE) or self.at(TK_OPEN_BRACKET) {
            self.bump()
            const t2: int = self.tok
            if t2 == TK_COLON or t2 == TK_COMMA or t2 == TK_QUESTION or t2 == TK_EQ {
                result = true
            } elif t2 == TK_CLOSE_PAREN {
                self.bump()
                result = self.at(TK_ARROW)
            }
        }
        self.restore(d)
        return result
    }

    def parse_fn_or_ctor_type() -> int {
        const pos: int = self.pos_of()
        is_ctor: bool = false
        is_abstract: bool = false
        if self.at(TK_ABSTRACT) {
            is_abstract = true
            self.bump()
        }
        if self.eat(TK_NEW) {
            is_ctor = true
        }
        kind: int = NK_FUNCTION_TYPE
        if is_ctor {
            kind = NK_CONSTRUCTOR_TYPE
        }
        const n: int = self.new_node(kind, pos)
        if is_abstract {
            self.setflags(n, MOD_ABSTRACT)
        }
        if self.at(TK_LT) {
            self.seta(n, self.parse_type_params())
        }
        self.parse_params_into(n)
        self.expect(TK_ARROW)
        self.setb(n, self.parse_type_or_predicate())
        return self.fin(n)
    }

    def parse_union_type() -> int {
        const pos: int = self.pos_of()
        self.eat(TK_BAR)
        const first: int = self.parse_intersection_type()
        if not self.at(TK_BAR) {
            return first
        }
        const n: int = self.new_node(NK_UNION_TYPE, pos)
        const base: int = self.sp
        self.push(first)
        while self.eat(TK_BAR) {
            self.push(self.parse_intersection_type())
        }
        self.close_kids(n, base)
        return self.fin(n)
    }

    def parse_intersection_type() -> int {
        const pos: int = self.pos_of()
        self.eat(TK_AMP)
        const first: int = self.parse_type_operator()
        if not self.at(TK_AMP) {
            return first
        }
        const n: int = self.new_node(NK_INTERSECTION_TYPE, pos)
        const base: int = self.sp
        self.push(first)
        while self.eat(TK_AMP) {
            self.push(self.parse_type_operator())
        }
        self.close_kids(n, base)
        return self.fin(n)
    }

    def parse_type_operator() -> int {
        const t: int = self.tok
        if t == TK_KEYOF or t == TK_UNIQUE or t == TK_READONLY {
            const n: int = self.mk(NK_TYPE_OPERATOR)
            self.setop(n, t)
            self.bump()
            self.seta(n, self.parse_type_operator())
            return self.fin(n)
        }
        if t == TK_INFER {
            const inf: int = self.mk(NK_INFER_TYPE)
            self.bump()
            const tp: int = self.mk(NK_TYPE_PARAMETER)
            self.seta(tp, self.parse_ident())
            if self.at(TK_EXTENDS) and not self.no_cond_type {
                const d: int = self.mark()
                self.bump()
                const saved: bool = self.no_cond_type
                self.no_cond_type = true
                worked: bool = true
                try {
                    self.setb(tp, self.parse_type())
                } except ValueError {
                    worked = false
                }
                self.no_cond_type = saved
                if not worked or self.at(TK_QUESTION) {
                    self.setb(tp, 0 - 1)
                    self.restore(d)
                } else {
                    self.drop(d)
                }
            } elif self.at(TK_EXTENDS) and self.no_cond_type {
                self.bump()
                const saved3: bool = self.no_cond_type
                self.no_cond_type = true
                self.setb(tp, self.parse_type())
                self.no_cond_type = saved3
            }
            self.seta(inf, self.fin(tp))
            return self.fin(inf)
        }
        return self.parse_postfix_type()
    }

    def parse_postfix_type() -> int {
        n: int = self.parse_primary_type()
        while self.at(TK_OPEN_BRACKET) and not self.sc.line_break_before {
            self.bump()
            if self.eat(TK_CLOSE_BRACKET) {
                const arr: int = self.new_node(NK_ARRAY_TYPE, self.ast[n * STRIDE + F_POS])
                self.seta(arr, n)
                n = self.fin(arr)
            } else {
                const idx: int = self.new_node(NK_INDEXED_ACCESS_TYPE, self.ast[n * STRIDE + F_POS])
                self.seta(idx, n)
                self.setb(idx, self.parse_type())
                self.expect(TK_CLOSE_BRACKET)
                n = self.fin(idx)
            }
        }
        return n
    }

    def parse_primary_type() -> int {
        const t: int = self.tok
        if t == TK_ANY or t == TK_UNKNOWN_KW or t == TK_STRING or t == TK_NUMBER or t == TK_BOOLEAN or t == TK_OBJECT or t == TK_SYMBOL or t == TK_BIGINT or t == TK_VOID or t == TK_UNDEFINED or t == TK_NEVER or t == TK_INTRINSIC {
            const k: int = self.mk(t)
            self.bump()
            return self.fin(k)
        }
        if t == TK_CONST {
            const n: int = self.mk(NK_TYPE_REFERENCE)
            const id: int = self.mk(TK_IDENTIFIER)
            self.bump()
            self.seta(n, self.fin(id))
            return self.fin(n)
        }
        if t == TK_THIS {
            const th: int = self.mk(NK_THIS_TYPE)
            self.bump()
            return self.fin(th)
        }
        if t == TK_TYPEOF {
            const q: int = self.mk(NK_TYPE_QUERY)
            self.bump()
            if self.at(TK_IMPORT) {
                self.seta(q, self.parse_import_type())
            } else {
                self.seta(q, self.parse_entity_name())
                if self.at(TK_LT) {
                    self.setb(q, self.parse_type_args())
                }
            }
            return self.fin(q)
        }
        if t == TK_OPEN_BRACE {
            if self.is_mapped_type_start() {
                return self.parse_mapped_type()
            }
            return self.parse_type_literal()
        }
        if t == TK_OPEN_BRACKET {
            return self.parse_tuple_type()
        }
        if t == TK_OPEN_PAREN {
            const p: int = self.mk(NK_PARENTHESIZED_TYPE)
            self.bump()
            self.seta(p, self.parse_type())
            self.expect(TK_CLOSE_PAREN)
            return self.fin(p)
        }
        if t == TK_STRING_LITERAL or t == TK_NO_SUB_TEMPLATE or t == TK_NUMERIC_LITERAL or t == TK_BIGINT_LITERAL {
            const lt: int = self.mk(NK_LITERAL_TYPE)
            const lit: int = self.mk(t)
            self.bump()
            self.seta(lt, self.fin(lit))
            return self.fin(lt)
        }
        if t == TK_MINUS {
            const neg: int = self.mk(NK_LITERAL_TYPE)
            const pre: int = self.mk(NK_PREFIX_UNARY)
            self.setop(pre, TK_MINUS)
            self.bump()
            const num: int = self.mk(self.tok)
            if not (self.at(TK_NUMERIC_LITERAL) or self.at(TK_BIGINT_LITERAL)) {
                self.fail("expected numeric literal after - in type")
            }
            self.bump()
            self.seta(pre, self.fin(num))
            self.seta(neg, self.fin(pre))
            return self.fin(neg)
        }
        if t == TK_TRUE or t == TK_FALSE or t == TK_NULL {
            const bl: int = self.mk(NK_LITERAL_TYPE)
            const kw: int = self.mk(t)
            self.bump()
            self.seta(bl, self.fin(kw))
            return self.fin(bl)
        }
        if t == TK_TEMPLATE_HEAD {
            return self.parse_template_type()
        }
        if t == TK_IMPORT {
            return self.parse_import_type()
        }
        if t == TK_ASSERTS {
            return self.parse_type_predicate_asserts()
        }
        if self.is_ident_like(t) {
            const r: int = self.mk(NK_TYPE_REFERENCE)
            self.seta(r, self.parse_entity_name())
            if self.at(TK_LT) {
                self.setb(r, self.parse_type_args())
            }
            return self.fin(r)
        }
        self.fail(f"unexpected token in type: {token_name(t)}")
        return 0 - 1
    }

    def parse_template_type() -> int {
        const n: int = self.mk(NK_TEMPLATE_LITERAL_TYPE)
        const head: int = self.mk(TK_TEMPLATE_HEAD)
        self.bump()
        self.seta(n, self.fin(head))
        const base: int = self.sp
        while true {
            const span: int = self.mk(NK_TEMPLATE_LITERAL_TYPE_SPAN)
            self.seta(span, self.parse_type())
            if not self.at(TK_CLOSE_BRACE) {
                self.fail("unterminated template literal type span")
            }
            self.tok = self.sc.re_scan_template()
            const lit: int = self.mk(self.tok)
            const was_tail: bool = self.at(TK_TEMPLATE_TAIL)
            self.bump()
            self.setb(span, self.fin(lit))
            self.push(self.fin(span))
            if was_tail {
                break
            }
        }
        self.close_kids(n, base)
        return self.fin(n)
    }

    def parse_import_type() -> int {
        const n: int = self.mk(NK_IMPORT_TYPE)
        self.expect(TK_IMPORT)
        self.expect(TK_OPEN_PAREN)
        const arg: int = self.mk(NK_LITERAL_TYPE)
        const s: int = self.mk(TK_STRING_LITERAL)
        self.expect(TK_STRING_LITERAL)
        self.seta(arg, self.fin(s))
        self.seta(n, self.fin(arg))
        if self.eat(TK_COMMA) {
            self.setc(n, self.parse_object_literal())
        }
        self.expect(TK_CLOSE_PAREN)
        if self.eat(TK_DOT) {
            self.setb(n, self.parse_entity_name())
        }
        if self.at(TK_LT) {
            self.setd(n, self.parse_type_args())
        }
        return self.fin(n)
    }

    def is_mapped_type_start() -> bool {
        const d: int = self.mark()
        self.bump()
        if self.at(TK_PLUS) or self.at(TK_MINUS) {
            self.restore(d)
            return true
        }
        if self.at(TK_READONLY) {
            self.bump()
        }
        result: bool = false
        if self.at(TK_OPEN_BRACKET) {
            self.bump()
            if self.is_ident_like(self.tok) {
                self.bump()
                result = self.at(TK_IN)
            }
        }
        self.restore(d)
        return result
    }

    def parse_mapped_type() -> int {
        const n: int = self.mk(NK_MAPPED_TYPE)
        self.expect(TK_OPEN_BRACE)
        if self.at(TK_PLUS) or self.at(TK_MINUS) {
            self.setop(n, self.tok)
            self.bump()
            self.expect(TK_READONLY)
            self.setflags(n, self.getflags(n) + MOD_READONLY)
        } elif self.eat(TK_READONLY) {
            self.setflags(n, self.getflags(n) + MOD_READONLY)
        }
        self.expect(TK_OPEN_BRACKET)
        const tp: int = self.mk(NK_TYPE_PARAMETER)
        self.seta(tp, self.parse_ident())
        self.expect(TK_IN)
        self.setb(tp, self.parse_type())
        self.seta(n, self.fin(tp))
        if self.eat(TK_AS) {
            self.setb(n, self.parse_type())
        }
        self.expect(TK_CLOSE_BRACKET)
        if self.at(TK_PLUS) or self.at(TK_MINUS) {
            self.bump()
            self.expect(TK_QUESTION)
        } else {
            self.eat(TK_QUESTION)
        }
        if self.eat(TK_COLON) {
            self.setc(n, self.parse_type())
        }
        self.eat(TK_SEMICOLON)
        self.expect(TK_CLOSE_BRACE)
        return self.fin(n)
    }

    def parse_tuple_type() -> int {
        const n: int = self.mk(NK_TUPLE_TYPE)
        self.expect(TK_OPEN_BRACKET)
        const base: int = self.sp
        while not self.at(TK_CLOSE_BRACKET) {
            self.push(self.parse_tuple_member())
            if not self.eat(TK_COMMA) {
                break
            }
        }
        self.expect(TK_CLOSE_BRACKET)
        self.close_kids(n, base)
        return self.fin(n)
    }

    def parse_tuple_member() -> int {
        const pos: int = self.pos_of()
        has_dots: bool = false
        if self.eat(TK_DOT_DOT_DOT) {
            has_dots = true
        }
        if self.is_ident_like(self.tok) {
            const nt: int = self.peek()
            if nt == TK_COLON or nt == TK_QUESTION {
                named: bool = nt == TK_COLON
                if nt == TK_QUESTION {
                    const d: int = self.mark()
                    self.bump()
                    self.bump()
                    named = self.at(TK_COLON)
                    self.restore(d)
                }
                if named {
                    const m: int = self.new_node(NK_NAMED_TUPLE_MEMBER, pos)
                    if has_dots {
                        self.setop(m, 1)
                    }
                    self.seta(m, self.parse_ident())
                    if self.eat(TK_QUESTION) {
                        self.setflags(m, 1)
                    }
                    self.expect(TK_COLON)
                    self.setb(m, self.parse_type())
                    return self.fin(m)
                }
            }
        }
        if has_dots {
            const r: int = self.new_node(NK_REST_TYPE, pos)
            self.seta(r, self.parse_type())
            return self.fin(r)
        }
        const t: int = self.parse_type()
        if self.at(TK_QUESTION) {
            self.bump()
            const o: int = self.new_node(NK_OPTIONAL_TYPE, pos)
            self.seta(o, t)
            return self.fin(o)
        }
        return t
    }

    def parse_type_literal() -> int {
        const n: int = self.mk(NK_TYPE_LITERAL)
        self.expect(TK_OPEN_BRACE)
        self.parse_type_members_into(n)
        self.expect(TK_CLOSE_BRACE)
        return self.fin(n)
    }

    def parse_type_members_into(n: int) -> None {
        const base: int = self.sp
        while not (self.at(TK_CLOSE_BRACE) or self.at(TK_EOF)) {
            self.push(self.parse_type_member())
            if self.eat(TK_SEMICOLON) {
                continue
            }
            if self.eat(TK_COMMA) {
                continue
            }
            if self.at(TK_CLOSE_BRACE) {
                break
            }
            if not self.sc.line_break_before {
                self.fail(f"expected type-member separator, found {token_name(self.tok)}")
            }
        }
        self.close_kids(n, base)
    }

    def parse_type_member() -> int {
        if self.at(TK_OPEN_PAREN) or self.at(TK_LT) {
            const cs: int = self.mk(NK_CALL_SIGNATURE)
            self.parse_sig_tail(cs)
            return self.fin(cs)
        }
        if self.at(TK_NEW) {
            const nt: int = self.peek()
            if nt == TK_OPEN_PAREN or nt == TK_LT {
                const ns: int = self.mk(NK_CONSTRUCT_SIGNATURE)
                self.bump()
                self.parse_sig_tail(ns)
                return self.fin(ns)
            }
        }
        pos: int = self.pos_of()
        flags: int = 0
        if self.at(TK_READONLY) {
            const nt2: int = self.peek()
            if self.is_ident_name_tok(nt2) or nt2 == TK_OPEN_BRACKET or nt2 == TK_STRING_LITERAL or nt2 == TK_NUMERIC_LITERAL {
                self.bump()
                flags = flags + MOD_READONLY
            }
        }
        if self.at(TK_OPEN_BRACKET) and self.is_index_sig_start() {
            const ix: int = self.new_node(NK_INDEX_SIGNATURE, pos)
            self.setflags(ix, flags)
            self.bump()
            const prm: int = self.mk(NK_PARAMETER)
            self.seta(prm, self.parse_ident())
            self.expect(TK_COLON)
            self.setb(prm, self.parse_type())
            self.seta(ix, self.fin(prm))
            self.expect(TK_CLOSE_BRACKET)
            if self.eat(TK_COLON) {
                self.setb(ix, self.parse_type())
            }
            return self.fin(ix)
        }
        const name: int = self.parse_property_name()
        opt: bool = self.eat(TK_QUESTION)
        if self.at(TK_OPEN_PAREN) or self.at(TK_LT) {
            const ms: int = self.new_node(NK_METHOD_SIGNATURE, pos)
            self.setflags(ms, flags)
            self.seta(ms, name)
            if opt {
                self.setop(ms, 1)
            }
            self.parse_sig_tail(ms)
            return self.fin(ms)
        }
        const ps: int = self.new_node(NK_PROPERTY_SIGNATURE, pos)
        self.setflags(ps, flags)
        self.seta(ps, name)
        if opt {
            self.setop(ps, 1)
        }
        if self.eat(TK_COLON) {
            self.setb(ps, self.parse_type_or_predicate())
        }
        return self.fin(ps)
    }

    def parse_sig_tail(n: int) -> None {
        if self.at(TK_LT) {
            self.setc(n, self.parse_type_params())
        }
        self.parse_params_into(n)
        if self.eat(TK_COLON) {
            self.setb(n, self.parse_type_or_predicate())
        }
    }

    def is_index_sig_start() -> bool {
        const d: int = self.mark()
        self.bump()
        result: bool = false
        if self.is_ident_like(self.tok) {
            self.bump()
            result = self.at(TK_COLON)
        }
        self.restore(d)
        return result
    }

    def parse_type_predicate_asserts() -> int {
        const n: int = self.mk(NK_TYPE_PREDICATE)
        self.setop(n, 1)
        self.expect(TK_ASSERTS)
        if self.at(TK_THIS) {
            const th: int = self.mk(NK_THIS_TYPE)
            self.bump()
            self.seta(n, self.fin(th))
        } else {
            self.seta(n, self.parse_ident())
        }
        if self.eat(TK_IS) {
            self.setb(n, self.parse_type())
        }
        return self.fin(n)
    }

    def parse_type_or_predicate() -> int {
        if self.at(TK_ASSERTS) {
            const nt: int = self.peek_no_lb()
            if nt == TK_THIS or (nt > 0 and self.is_ident_like(nt)) {
                return self.parse_type_predicate_asserts()
            }
        }
        if self.at(TK_THIS) and self.peek() == TK_IS {
            const n: int = self.mk(NK_TYPE_PREDICATE)
            const th: int = self.mk(NK_THIS_TYPE)
            self.bump()
            self.seta(n, self.fin(th))
            self.expect(TK_IS)
            self.setb(n, self.parse_type())
            return self.fin(n)
        }
        if self.is_ident_like(self.tok) and self.peek() == TK_IS {
            const p: int = self.mk(NK_TYPE_PREDICATE)
            self.seta(p, self.parse_ident())
            self.expect(TK_IS)
            self.setb(p, self.parse_type())
            return self.fin(p)
        }
        return self.parse_type()
    }

    def parse_type_args() -> int {
        const n: int = self.mk(0)
        self.expect(TK_LT)
        const base: int = self.sp
        while true {
            self.push(self.parse_type())
            if not self.eat(TK_COMMA) {
                break
            }
        }
        self.expect(TK_GT)
        self.close_kids(n, base)
        return n
    }

    def parse_type_params() -> int {
        const n: int = self.mk(0)
        self.expect(TK_LT)
        const base: int = self.sp
        while true {
            const tp: int = self.mk(NK_TYPE_PARAMETER)
            while self.at(TK_CONST) or self.at(TK_IN) or self.at(TK_OUT) {
                if self.at(TK_CONST) {
                    self.setflags(tp, self.getflags(tp) + MOD_CONST_KW)
                } elif self.at(TK_IN) {
                    self.setflags(tp, self.getflags(tp) + MOD_IN)
                } else {
                    self.setflags(tp, self.getflags(tp) + MOD_OUT)
                }
                self.bump()
            }
            self.seta(tp, self.parse_ident())
            if self.eat(TK_EXTENDS) {
                self.setb(tp, self.parse_type())
            }
            if self.eat(TK_EQ) {
                self.setc(tp, self.parse_type())
            }
            self.push(self.fin(tp))
            if not self.eat(TK_COMMA) {
                break
            }
        }
        self.expect(TK_GT)
        self.close_kids(n, base)
        return n
    }

    def parse_params_into(n: int) -> None {
        self.expect(TK_OPEN_PAREN)
        const base: int = self.sp
        while not self.at(TK_CLOSE_PAREN) {
            self.push(self.parse_param())
            if not self.eat(TK_COMMA) {
                break
            }
        }
        self.expect(TK_CLOSE_PAREN)
        self.close_kids(n, base)
    }

    def parse_param() -> int {
        const n: int = self.mk(NK_PARAMETER)
        while self.at(TK_PUBLIC) or self.at(TK_PRIVATE) or self.at(TK_PROTECTED) or self.at(TK_READONLY) or self.at(TK_OVERRIDE) {
            const t: int = self.tok
            const nt: int = self.peek()
            if not (self.is_ident_like(nt) or nt == TK_THIS or nt == TK_OPEN_BRACE or nt == TK_OPEN_BRACKET or nt == TK_DOT_DOT_DOT or nt == TK_READONLY or nt == TK_PUBLIC or nt == TK_PRIVATE or nt == TK_PROTECTED or nt == TK_OVERRIDE) {
                break
            }
            f: int = MOD_OVERRIDE
            if t == TK_PUBLIC {
                f = MOD_PUBLIC
            } elif t == TK_PRIVATE {
                f = MOD_PRIVATE
            } elif t == TK_PROTECTED {
                f = MOD_PROTECTED
            } elif t == TK_READONLY {
                f = MOD_READONLY
            }
            self.setflags(n, self.getflags(n) + f)
            self.bump()
        }
        if self.eat(TK_DOT_DOT_DOT) {
            self.setop(n, 1)
        }
        if self.at(TK_THIS) {
            const th: int = self.mk(TK_IDENTIFIER)
            self.bump()
            self.seta(n, self.fin(th))
        } else {
            self.seta(n, self.parse_binding_name())
        }
        if self.eat(TK_QUESTION) {
            self.setflags(n, self.getflags(n) + MOD_DEFAULT)
        }
        if self.eat(TK_COLON) {
            self.setb(n, self.parse_type())
        }
        if self.eat(TK_EQ) {
            self.setc(n, self.parse_assign())
        }
        return self.fin(n)
    }

    def parse_expression() -> int {
        left: int = self.parse_assign()
        while self.at(TK_COMMA) {
            const n: int = self.new_node(NK_BINARY, self.ast[left * STRIDE + F_POS])
            self.setop(n, TK_COMMA)
            self.seta(n, left)
            self.bump()
            self.setb(n, self.parse_assign())
            left = self.fin(n)
        }
        return left
    }

    def parse_assign() -> int {
        if self.at(TK_YIELD) {
            const nt: int = self.peek_no_lb()
            if nt == TK_ASTERISK or (nt > 0 and self.is_start_of_expr(nt)) {
                return self.parse_yield()
            }
            if nt < 0 {
                return self.parse_yield()
            }
        }
        if self.at(TK_LT) {
            const ga: int = self.try_parse_typed_arrow()
            if ga >= 0 {
                return ga
            }
        }
        if self.at(TK_OPEN_PAREN) {
            const st: int = self.paren_arrow_state()
            if st == 1 {
                return self.parse_arrow_tail(0, 0 - 1)
            }
            if st == 2 {
                const tryres: int = self.try_parse_paren_arrow(0)
                if tryres >= 0 {
                    return tryres
                }
            }
        } elif self.at(TK_ASYNC) {
            const an: int = self.try_parse_async_arrow()
            if an >= 0 {
                return an
            }
        } elif self.is_ident_like(self.tok) {
            if self.peek_no_lb() == TK_ARROW {
                return self.parse_simple_arrow(0)
            }
        }

        left: int = self.parse_binary(1)

        if self.at(TK_QUESTION) {
            const cond: int = self.new_node(NK_CONDITIONAL_EXPR, self.ast[left * STRIDE + F_POS])
            self.seta(cond, left)
            self.bump()
            const saved: bool = self.no_in
            self.no_in = false
            self.setb(cond, self.parse_assign())
            self.no_in = saved
            self.expect(TK_COLON)
            self.setc(cond, self.parse_assign())
            return self.fin(cond)
        }
        if self.tok >= TK_EQ and self.tok <= TK_CARET_EQ {
            const asg: int = self.new_node(NK_BINARY, self.ast[left * STRIDE + F_POS])
            self.setop(asg, self.tok)
            self.seta(asg, left)
            self.bump()
            self.setb(asg, self.parse_assign())
            return self.fin(asg)
        }
        return left
    }

    def parse_yield() -> int {
        const n: int = self.mk(NK_YIELD_EXPR)
        self.expect(TK_YIELD)
        if not self.sc.line_break_before {
            if self.eat(TK_ASTERISK) {
                self.setop(n, 1)
                self.seta(n, self.parse_assign())
            } elif self.is_start_of_expr(self.tok) {
                self.seta(n, self.parse_assign())
            }
        }
        return self.fin(n)
    }

    def op_prec(t: int) -> int {
        if t == TK_QUESTION_QUESTION {
            return 4
        }
        if t == TK_BAR_BAR {
            return 5
        }
        if t == TK_AMP_AMP {
            return 6
        }
        if t == TK_BAR {
            return 7
        }
        if t == TK_CARET {
            return 8
        }
        if t == TK_AMP {
            return 9
        }
        if t == TK_EQ_EQ or t == TK_EXCL_EQ or t == TK_EQ_EQ_EQ or t == TK_EXCL_EQ_EQ {
            return 10
        }
        if t == TK_LT or t == TK_GT or t == TK_LT_EQ or t == TK_GT_EQ or t == TK_INSTANCEOF or t == TK_IN {
            return 11
        }
        if t == TK_LT_LT or t == TK_GT_GT or t == TK_GT_GT_GT {
            return 12
        }
        if t == TK_PLUS or t == TK_MINUS {
            return 13
        }
        if t == TK_ASTERISK or t == TK_SLASH or t == TK_PERCENT {
            return 14
        }
        if t == TK_ASTERISK_ASTERISK {
            return 15
        }
        return 0
    }

    def parse_binary(min_prec: int) -> int {
        const left: int = self.parse_unary()
        return self.parse_binary_rest(left, min_prec)
    }

    def parse_binary_rest(start_left: int, min_prec: int) -> int {
        left: int = start_left
        while true {
            if self.at(TK_GT) {
                self.tok = self.sc.re_scan_greater()
            }
            const t: int = self.tok
            if (t == TK_AS or t == TK_SATISFIES) and min_prec <= 11 {
                if self.sc.line_break_before {
                    break
                }
                kind: int = NK_AS_EXPR
                if t == TK_SATISFIES {
                    kind = NK_SATISFIES_EXPR
                }
                const ae: int = self.new_node(kind, self.ast[left * STRIDE + F_POS])
                self.seta(ae, left)
                self.bump()
                self.setb(ae, self.parse_type())
                left = self.fin(ae)
                continue
            }
            const prec: int = self.op_prec(t)
            if prec == 0 or prec < min_prec {
                break
            }
            if t == TK_IN and self.no_in {
                break
            }
            const n: int = self.new_node(NK_BINARY, self.ast[left * STRIDE + F_POS])
            self.setop(n, t)
            self.seta(n, left)
            self.bump()
            if t == TK_ASTERISK_ASTERISK {
                self.setb(n, self.parse_binary(prec))
            } else {
                self.setb(n, self.parse_binary(prec + 1))
            }
            left = self.fin(n)
        }
        return left
    }

    def parse_unary() -> int {
        const t: int = self.tok
        if t == TK_PLUS or t == TK_MINUS or t == TK_TILDE or t == TK_EXCL or t == TK_PLUS_PLUS or t == TK_MINUS_MINUS {
            const n: int = self.mk(NK_PREFIX_UNARY)
            self.setop(n, t)
            self.bump()
            self.seta(n, self.parse_unary())
            return self.fin(n)
        }
        if t == TK_DELETE or t == TK_TYPEOF or t == TK_VOID {
            kind: int = NK_DELETE_EXPR
            if t == TK_TYPEOF {
                kind = NK_TYPEOF_EXPR
            } elif t == TK_VOID {
                kind = NK_VOID_EXPR
            }
            const u: int = self.mk(kind)
            self.bump()
            self.seta(u, self.parse_unary())
            return self.fin(u)
        }
        if t == TK_AWAIT {
            const nt: int = self.peek_no_lb()
            if nt > 0 and self.is_start_of_expr(nt) {
                const aw: int = self.mk(NK_AWAIT_EXPR)
                self.bump()
                self.seta(aw, self.parse_unary())
                return self.fin(aw)
            }
        }
        if t == TK_LT {
            const ta: int = self.mk(NK_TYPE_ASSERTION)
            self.bump()
            self.seta(ta, self.parse_type())
            self.expect(TK_GT)
            self.setb(ta, self.parse_unary())
            return self.fin(ta)
        }
        return self.parse_postfix()
    }

    def parse_postfix() -> int {
        const n: int = self.parse_lhs()
        if (self.at(TK_PLUS_PLUS) or self.at(TK_MINUS_MINUS)) and not self.sc.line_break_before {
            const p: int = self.new_node(NK_POSTFIX_UNARY, self.ast[n * STRIDE + F_POS])
            self.setop(p, self.tok)
            self.seta(p, n)
            self.bump()
            return self.fin(p)
        }
        return n
    }

    def parse_lhs() -> int {
        base: int = 0 - 1
        if self.at(TK_NEW) {
            base = self.parse_new()
        } elif self.at(TK_SLASH) or self.at(TK_SLASH_EQ) {
            self.tok = self.sc.re_scan_slash()
            const re: int = self.mk(TK_REGEX_LITERAL)
            self.bump()
            base = self.fin(re)
        } else {
            base = self.parse_primary()
        }
        return self.parse_member_rest(base, true)
    }

    def parse_new() -> int {
        const pos: int = self.pos_of()
        self.expect(TK_NEW)
        if self.at(TK_DOT) {
            const mp: int = self.new_node(NK_META_PROPERTY, pos)
            self.bump()
            self.seta(mp, self.parse_ident_name())
            return self.fin(mp)
        }
        const n: int = self.new_node(NK_NEW, pos)
        prim: int = 0 - 1
        if self.at(TK_NEW) {
            prim = self.parse_new()
        } else {
            prim = self.parse_primary()
        }
        self.seta(n, self.parse_member_rest(prim, false))
        if self.at(TK_LT) {
            const ta: int = self.try_parse_type_args_in_expr()
            if ta >= 0 {
                self.setc(n, ta)
            }
        }
        if self.at(TK_OPEN_PAREN) {
            self.parse_args_into(n)
        }
        return self.fin(n)
    }

    def parse_args_into(n: int) -> None {
        self.expect(TK_OPEN_PAREN)
        const base: int = self.sp
        while not self.at(TK_CLOSE_PAREN) {
            if self.at(TK_DOT_DOT_DOT) {
                const sp_n: int = self.mk(NK_SPREAD)
                self.bump()
                self.seta(sp_n, self.parse_assign())
                self.push(self.fin(sp_n))
            } else {
                self.push(self.parse_assign())
            }
            if not self.eat(TK_COMMA) {
                break
            }
        }
        self.expect(TK_CLOSE_PAREN)
        self.close_kids(n, base)
    }

    def parse_member_rest(start_base: int, allow_call: bool) -> int {
        base: int = start_base
        while true {
            const t: int = self.tok
            if t == TK_DOT {
                self.bump()
                const pa: int = self.new_node(NK_PROPERTY_ACCESS, self.ast[base * STRIDE + F_POS])
                self.seta(pa, base)
                if self.at(TK_PRIVATE_IDENTIFIER) {
                    const pv: int = self.mk(TK_PRIVATE_IDENTIFIER)
                    self.bump()
                    self.setb(pa, self.fin(pv))
                } else {
                    self.setb(pa, self.parse_ident_name())
                }
                base = self.fin(pa)
                continue
            }
            if t == TK_QUESTION_DOT {
                self.bump()
                if self.at(TK_OPEN_PAREN) and allow_call {
                    const oc: int = self.new_node(NK_CALL, self.ast[base * STRIDE + F_POS])
                    self.seta(oc, base)
                    self.setop(oc, 1)
                    self.parse_args_into(oc)
                    base = self.fin(oc)
                    continue
                }
                if self.at(TK_OPEN_BRACKET) {
                    self.bump()
                    const oe: int = self.new_node(NK_ELEMENT_ACCESS, self.ast[base * STRIDE + F_POS])
                    self.seta(oe, base)
                    self.setop(oe, 1)
                    self.setb(oe, self.parse_expression())
                    self.expect(TK_CLOSE_BRACKET)
                    base = self.fin(oe)
                    continue
                }
                const opa: int = self.new_node(NK_PROPERTY_ACCESS, self.ast[base * STRIDE + F_POS])
                self.seta(opa, base)
                self.setop(opa, 1)
                if self.at(TK_PRIVATE_IDENTIFIER) {
                    const pv2: int = self.mk(TK_PRIVATE_IDENTIFIER)
                    self.bump()
                    self.setb(opa, self.fin(pv2))
                } else {
                    self.setb(opa, self.parse_ident_name())
                }
                base = self.fin(opa)
                continue
            }
            if t == TK_OPEN_BRACKET {
                self.bump()
                const ea: int = self.new_node(NK_ELEMENT_ACCESS, self.ast[base * STRIDE + F_POS])
                self.seta(ea, base)
                self.setb(ea, self.parse_expression())
                self.expect(TK_CLOSE_BRACKET)
                base = self.fin(ea)
                continue
            }
            if t == TK_OPEN_PAREN and allow_call {
                const call: int = self.new_node(NK_CALL, self.ast[base * STRIDE + F_POS])
                self.seta(call, base)
                self.parse_args_into(call)
                base = self.fin(call)
                continue
            }
            if t == TK_EXCL and not self.sc.line_break_before {
                const nn2: int = self.new_node(NK_NON_NULL, self.ast[base * STRIDE + F_POS])
                self.seta(nn2, base)
                self.bump()
                base = self.fin(nn2)
                continue
            }
            if t == TK_LT and allow_call {
                const ta: int = self.try_parse_type_args_in_expr()
                if ta >= 0 {
                    if self.at(TK_OPEN_PAREN) {
                        const gcall: int = self.new_node(NK_CALL, self.ast[base * STRIDE + F_POS])
                        self.seta(gcall, base)
                        self.setc(gcall, ta)
                        self.parse_args_into(gcall)
                        base = self.fin(gcall)
                        continue
                    }
                    if self.at(TK_NO_SUB_TEMPLATE) or self.at(TK_TEMPLATE_HEAD) {
                        const gt: int = self.new_node(NK_TAGGED_TEMPLATE, self.ast[base * STRIDE + F_POS])
                        self.seta(gt, base)
                        self.setc(gt, ta)
                        self.setb(gt, self.parse_template_literal())
                        base = self.fin(gt)
                        continue
                    }
                    const ewta: int = self.new_node(NK_EXPR_WITH_TYPE_ARGS, self.ast[base * STRIDE + F_POS])
                    self.seta(ewta, base)
                    self.setc(ewta, ta)
                    base = self.fin(ewta)
                    continue
                }
                break
            }
            if t == TK_NO_SUB_TEMPLATE or t == TK_TEMPLATE_HEAD {
                const tt: int = self.new_node(NK_TAGGED_TEMPLATE, self.ast[base * STRIDE + F_POS])
                self.seta(tt, base)
                self.setb(tt, self.parse_template_literal())
                base = self.fin(tt)
                continue
            }
            break
        }
        return base
    }

    def parse_template_literal() -> int {
        if self.at(TK_NO_SUB_TEMPLATE) {
            const lit: int = self.mk(TK_NO_SUB_TEMPLATE)
            self.bump()
            return self.fin(lit)
        }
        const n: int = self.mk(NK_TEMPLATE_EXPR)
        const head: int = self.mk(TK_TEMPLATE_HEAD)
        self.expect(TK_TEMPLATE_HEAD)
        self.seta(n, self.fin(head))
        const base: int = self.sp
        while true {
            const span: int = self.mk(NK_TEMPLATE_SPAN)
            self.seta(span, self.parse_expression())
            if not self.at(TK_CLOSE_BRACE) {
                self.fail("unterminated template span")
            }
            self.tok = self.sc.re_scan_template()
            const lit2: int = self.mk(self.tok)
            const was_tail: bool = self.at(TK_TEMPLATE_TAIL)
            self.bump()
            self.setb(span, self.fin(lit2))
            self.push(self.fin(span))
            if was_tail {
                break
            }
        }
        self.close_kids(n, base)
        return self.fin(n)
    }

    def is_start_of_expr(t: int) -> bool {
        if self.is_ident_like(t) {
            return true
        }
        if t == TK_NUMERIC_LITERAL or t == TK_BIGINT_LITERAL or t == TK_STRING_LITERAL or t == TK_NO_SUB_TEMPLATE or t == TK_TEMPLATE_HEAD {
            return true
        }
        if t == TK_OPEN_PAREN or t == TK_OPEN_BRACKET or t == TK_OPEN_BRACE {
            return true
        }
        if t == TK_PLUS or t == TK_MINUS or t == TK_TILDE or t == TK_EXCL or t == TK_PLUS_PLUS or t == TK_MINUS_MINUS {
            return true
        }
        if t == TK_SLASH or t == TK_SLASH_EQ or t == TK_LT {
            return true
        }
        if t == TK_THIS or t == TK_SUPER or t == TK_NEW or t == TK_DELETE or t == TK_TYPEOF or t == TK_VOID or t == TK_AWAIT or t == TK_YIELD {
            return true
        }
        if t == TK_TRUE or t == TK_FALSE or t == TK_NULL or t == TK_FUNCTION or t == TK_CLASS or t == TK_IMPORT {
            return true
        }
        return false
    }

    def paren_arrow_state() -> int {
        const d: int = self.mark()
        self.bump()
        result: int = 0
        if self.at(TK_CLOSE_PAREN) {
            self.bump()
            if self.at(TK_ARROW) or self.at(TK_COLON) {
                result = 1
            }
        } elif self.at(TK_DOT_DOT_DOT) {
            result = 1
        } elif self.at(TK_OPEN_BRACE) or self.at(TK_OPEN_BRACKET) {
            result = 2
        } elif self.is_ident_like(self.tok) or self.at(TK_THIS) {
            self.bump()
            const t2: int = self.tok
            if t2 == TK_COLON {
                result = 1
            } elif t2 == TK_COMMA or t2 == TK_EQ {
                result = 2
            } elif t2 == TK_QUESTION {
                self.bump()
                const t3: int = self.tok
                if t3 == TK_COMMA or t3 == TK_CLOSE_PAREN or t3 == TK_COLON or t3 == TK_EQ {
                    result = 1
                }
            } elif t2 == TK_CLOSE_PAREN {
                self.bump()
                if self.at(TK_ARROW) or self.at(TK_COLON) {
                    result = 1
                }
            }
        }
        self.restore(d)
        return result
    }

    def parse_arrow_tail(mods: int, typarams: int) -> int {
        const n: int = self.mk(NK_ARROW_FUNCTION)
        self.setflags(n, mods)
        if typarams >= 0 {
            self.setd(n, typarams)
        }
        self.parse_params_into(n)
        if self.eat(TK_COLON) {
            self.setb(n, self.parse_type_or_predicate())
        }
        self.expect(TK_ARROW)
        if self.at(TK_OPEN_BRACE) {
            self.seta(n, self.parse_block())
        } else {
            const saved: bool = self.no_in
            self.no_in = false
            self.seta(n, self.parse_assign())
            self.no_in = saved
        }
        return self.fin(n)
    }

    def try_parse_paren_arrow(mods: int) -> int {
        const d: int = self.mark()
        const sp0: int = self.sp
        try {
            const r: int = self.parse_arrow_tail(mods, 0 - 1)
            self.drop(d)
            return r
        } except ValueError {
            self.restore(d)
            self.sp = sp0
            return 0 - 1
        }
    }

    def try_parse_typed_arrow() -> int {
        const d: int = self.mark()
        const sp0: int = self.sp
        try {
            const tps: int = self.parse_type_params()
            if not self.at(TK_OPEN_PAREN) {
                self.fail("not an arrow")
            }
            const r: int = self.parse_arrow_tail(0, tps)
            self.drop(d)
            return r
        } except ValueError {
            self.restore(d)
            self.sp = sp0
            return 0 - 1
        }
    }

    def parse_simple_arrow(mods: int) -> int {
        const n: int = self.mk(NK_ARROW_FUNCTION)
        self.setflags(n, mods)
        const base: int = self.sp
        const prm: int = self.mk(NK_PARAMETER)
        self.seta(prm, self.parse_ident())
        self.push(self.fin(prm))
        self.close_kids(n, base)
        self.expect(TK_ARROW)
        if self.at(TK_OPEN_BRACE) {
            self.seta(n, self.parse_block())
        } else {
            self.seta(n, self.parse_assign())
        }
        return self.fin(n)
    }

    def try_parse_async_arrow() -> int {
        const nt: int = self.peek_no_lb()
        if nt < 0 {
            return 0 - 1
        }
        if self.is_ident_like(nt) and nt != TK_ASYNC {
            const d: int = self.mark()
            self.bump()
            ok: bool = false
            if self.is_ident_like(self.tok) {
                if self.peek_no_lb() == TK_ARROW {
                    ok = true
                }
            }
            if ok {
                const r: int = self.parse_simple_arrow(MOD_ASYNC)
                self.drop(d)
                return r
            }
            self.restore(d)
            return 0 - 1
        }
        if nt == TK_OPEN_PAREN {
            const d2: int = self.mark()
            const sp0: int = self.sp
            self.bump()
            const st: int = self.paren_arrow_state()
            if st == 1 {
                const r: int = self.parse_arrow_tail(MOD_ASYNC, 0 - 1)
                self.drop(d2)
                return r
            }
            if st == 2 {
                try {
                    const r2: int = self.parse_arrow_tail(MOD_ASYNC, 0 - 1)
                    self.drop(d2)
                    return r2
                } except ValueError {
                    self.restore(d2)
                    self.sp = sp0
                    return 0 - 1
                }
            }
            self.restore(d2)
            return 0 - 1
        }
        if nt == TK_LT {
            const d3: int = self.mark()
            const sp1: int = self.sp
            self.bump()
            try {
                const tps: int = self.parse_type_params()
                if not self.at(TK_OPEN_PAREN) {
                    self.fail("not an arrow")
                }
                const r3: int = self.parse_arrow_tail(MOD_ASYNC, tps)
                self.drop(d3)
                return r3
            } except ValueError {
                self.restore(d3)
                self.sp = sp1
                return 0 - 1
            }
        }
        return 0 - 1
    }

    def try_parse_type_args_in_expr() -> int {
        const d: int = self.mark()
        const sp0: int = self.sp
        try {
            const ta: int = self.parse_type_args()
            const t: int = self.tok
            if t == TK_OPEN_PAREN or t == TK_NO_SUB_TEMPLATE or t == TK_TEMPLATE_HEAD {
                self.drop(d)
                return ta
            }
            if not self.is_start_of_expr(t) {
                self.drop(d)
                return ta
            }
            self.restore(d)
            self.sp = sp0
            return 0 - 1
        } except ValueError {
            self.restore(d)
            self.sp = sp0
            return 0 - 1
        }
    }

    def parse_primary() -> int {
        const t: int = self.tok
        if t == TK_NUMERIC_LITERAL or t == TK_BIGINT_LITERAL or t == TK_STRING_LITERAL or t == TK_NO_SUB_TEMPLATE or t == TK_REGEX_LITERAL {
            const lit: int = self.mk(t)
            self.bump()
            return self.fin(lit)
        }
        if t == TK_TEMPLATE_HEAD {
            return self.parse_template_literal()
        }
        if t == TK_OPEN_PAREN {
            const p: int = self.mk(NK_PAREN_EXPR)
            self.bump()
            const saved: bool = self.no_in
            self.no_in = false
            self.seta(p, self.parse_expression())
            self.no_in = saved
            self.expect(TK_CLOSE_PAREN)
            return self.fin(p)
        }
        if t == TK_OPEN_BRACKET {
            return self.parse_array_literal()
        }
        if t == TK_OPEN_BRACE {
            return self.parse_object_literal()
        }
        if t == TK_FUNCTION {
            return self.parse_function_expr_flags(0)
        }
        if t == TK_CLASS {
            return self.parse_class_like(NK_CLASS_EXPR, 0)
        }
        if t == TK_THIS or t == TK_SUPER or t == TK_TRUE or t == TK_FALSE or t == TK_NULL {
            const kw: int = self.mk(t)
            self.bump()
            return self.fin(kw)
        }
        if t == TK_IMPORT {
            const pos: int = self.pos_of()
            self.bump()
            if self.at(TK_DOT) {
                self.bump()
                const mp: int = self.new_node(NK_META_PROPERTY, pos)
                self.seta(mp, self.parse_ident_name())
                return self.fin(mp)
            }
            const imp: int = self.new_node(TK_IMPORT, pos)
            self.ast[imp * STRIDE + F_END] = pos + 6
            return imp
        }
        if t == TK_ASYNC {
            if self.peek_no_lb() == TK_FUNCTION {
                self.bump()
                return self.parse_function_expr_flags(MOD_ASYNC)
            }
        }
        if self.is_ident_like(t) {
            const id: int = self.mk(TK_IDENTIFIER)
            self.bump()
            return self.fin(id)
        }
        self.fail(f"unexpected token in expression: {token_name(t)}")
        return 0 - 1
    }

    def parse_array_literal() -> int {
        const n: int = self.mk(NK_ARRAY_LITERAL)
        self.expect(TK_OPEN_BRACKET)
        const base: int = self.sp
        while not self.at(TK_CLOSE_BRACKET) {
            if self.at(TK_COMMA) {
                const o: int = self.mk(NK_OMITTED)
                self.push(self.fin(o))
                self.bump()
                continue
            }
            if self.at(TK_DOT_DOT_DOT) {
                const sp_n: int = self.mk(NK_SPREAD)
                self.bump()
                self.seta(sp_n, self.parse_assign())
                self.push(self.fin(sp_n))
            } else {
                self.push(self.parse_assign())
            }
            if not self.eat(TK_COMMA) {
                break
            }
        }
        self.expect(TK_CLOSE_BRACKET)
        self.close_kids(n, base)
        return self.fin(n)
    }

    def parse_object_literal() -> int {
        const n: int = self.mk(NK_OBJECT_LITERAL)
        self.expect(TK_OPEN_BRACE)
        const base: int = self.sp
        while not self.at(TK_CLOSE_BRACE) {
            self.push(self.parse_object_member())
            if not self.eat(TK_COMMA) {
                break
            }
        }
        self.expect(TK_CLOSE_BRACE)
        self.close_kids(n, base)
        return self.fin(n)
    }

    def parse_object_member() -> int {
        const pos: int = self.pos_of()
        if self.at(TK_DOT_DOT_DOT) {
            const sp_n: int = self.mk(NK_SPREAD_ASSIGNMENT)
            self.bump()
            self.seta(sp_n, self.parse_assign())
            return self.fin(sp_n)
        }
        mods: int = 0
        if self.at(TK_ASYNC) {
            const nt: int = self.peek_no_lb()
            if nt > 0 and (self.is_ident_name_tok(nt) or nt == TK_OPEN_BRACKET or nt == TK_STRING_LITERAL or nt == TK_NUMERIC_LITERAL or nt == TK_ASTERISK) {
                mods = mods + MOD_ASYNC
                self.bump()
            }
        }
        is_gen: bool = false
        if self.at(TK_ASTERISK) {
            is_gen = true
            self.bump()
        }
        if (self.at(TK_GET) or self.at(TK_SET)) and mods == 0 and not is_gen {
            const which: int = self.tok
            const nt2: int = self.peek()
            if self.is_ident_name_tok(nt2) or nt2 == TK_OPEN_BRACKET or nt2 == TK_STRING_LITERAL or nt2 == TK_NUMERIC_LITERAL {
                kind: int = NK_GET_ACCESSOR
                if which == TK_SET {
                    kind = NK_SET_ACCESSOR
                }
                const acc: int = self.new_node(kind, pos)
                self.bump()
                self.seta(acc, self.parse_property_name())
                self.parse_params_into(acc)
                if self.eat(TK_COLON) {
                    self.setb(acc, self.parse_type_or_predicate())
                }
                self.setc(acc, self.parse_block())
                return self.fin(acc)
            }
        }
        const name: int = self.parse_property_name()
        if self.at(TK_OPEN_PAREN) or self.at(TK_LT) {
            const m: int = self.new_node(NK_METHOD_DECLARATION, pos)
            self.setflags(m, mods)
            if is_gen {
                self.setop(m, 2)
            }
            self.seta(m, name)
            self.parse_sig_tail(m)
            self.setd(m, self.parse_block())
            return self.fin(m)
        }
        if self.eat(TK_COLON) {
            const pa: int = self.new_node(NK_PROPERTY_ASSIGNMENT, pos)
            self.seta(pa, name)
            self.setb(pa, self.parse_assign())
            return self.fin(pa)
        }
        const sh: int = self.new_node(NK_SHORTHAND_PROPERTY, pos)
        self.seta(sh, name)
        if self.eat(TK_EQ) {
            self.setb(sh, self.parse_assign())
        }
        return self.fin(sh)
    }

    def parse_function_expr_flags(mods: int) -> int {
        const n: int = self.mk(NK_FUNCTION_EXPR)
        self.setflags(n, mods)
        self.expect(TK_FUNCTION)
        if self.eat(TK_ASTERISK) {
            self.setop(n, 2)
        }
        if self.is_ident_like(self.tok) {
            self.seta(n, self.parse_ident())
        }
        self.parse_sig_tail(n)
        self.setd(n, self.parse_block())
        return self.fin(n)
    }

    def parse_source_file() -> int {
        const n: int = self.mk(NK_SOURCE_FILE)
        const base: int = self.sp
        while not self.at(TK_EOF) {
            self.push(self.parse_statement())
        }
        self.close_kids(n, base)
        return self.fin(n)
    }

    def parse_block() -> int {
        const n: int = self.mk(NK_BLOCK)
        self.expect(TK_OPEN_BRACE)
        const base: int = self.sp
        while not (self.at(TK_CLOSE_BRACE) or self.at(TK_EOF)) {
            self.push(self.parse_statement())
        }
        self.expect(TK_CLOSE_BRACE)
        self.close_kids(n, base)
        return self.fin(n)
    }

    def parse_statement() -> int {
        const t: int = self.tok
        if t == TK_OPEN_BRACE {
            return self.parse_block()
        }
        if t == TK_SEMICOLON {
            const e: int = self.mk(NK_EMPTY_STATEMENT)
            self.bump()
            return self.fin(e)
        }
        if t == TK_VAR {
            return self.parse_var_stmt(0)
        }
        if t == TK_CONST {
            if self.peek() == TK_ENUM {
                return self.parse_enum(0)
            }
            return self.parse_var_stmt(0)
        }
        if t == TK_LET {
            const nt: int = self.peek()
            if self.is_ident_like(nt) or nt == TK_OPEN_BRACE or nt == TK_OPEN_BRACKET {
                return self.parse_var_stmt(0)
            }
        }
        if t == TK_USING {
            const nt2: int = self.peek_no_lb()
            if nt2 > 0 and self.is_ident_like(nt2) {
                return self.parse_var_stmt(0)
            }
        }
        if t == TK_AWAIT {
            const d: int = self.mark()
            self.bump()
            if self.at(TK_USING) and not self.sc.line_break_before {
                const nt3: int = self.peek_no_lb()
                if nt3 > 0 and self.is_ident_like(nt3) {
                    self.restore(d)
                    self.bump()
                    return self.parse_var_stmt(0)
                }
            }
            self.restore(d)
        }
        if t == TK_FUNCTION {
            return self.parse_function_decl(0)
        }
        if t == TK_CLASS {
            return self.parse_class_like(NK_CLASS_DECLARATION, 0)
        }
        if t == TK_IF {
            return self.parse_if()
        }
        if t == TK_DO {
            return self.parse_do()
        }
        if t == TK_WHILE {
            return self.parse_while()
        }
        if t == TK_FOR {
            return self.parse_for()
        }
        if t == TK_CONTINUE {
            return self.parse_jump(NK_CONTINUE_STATEMENT)
        }
        if t == TK_BREAK {
            return self.parse_jump(NK_BREAK_STATEMENT)
        }
        if t == TK_RETURN {
            return self.parse_return()
        }
        if t == TK_WITH {
            return self.parse_with()
        }
        if t == TK_SWITCH {
            return self.parse_switch()
        }
        if t == TK_THROW {
            return self.parse_throw()
        }
        if t == TK_TRY {
            return self.parse_try()
        }
        if t == TK_DEBUGGER {
            const dbg: int = self.mk(NK_DEBUGGER_STATEMENT)
            self.bump()
            self.semi()
            return self.fin(dbg)
        }
        if t == TK_AT {
            return self.parse_decorated_declaration()
        }
        if t == TK_IMPORT {
            const nt4: int = self.peek()
            if nt4 != TK_OPEN_PAREN and nt4 != TK_DOT {
                return self.parse_import()
            }
        }
        if t == TK_EXPORT {
            return self.parse_export()
        }
        if t == TK_INTERFACE {
            return self.parse_interface(0)
        }
        if t == TK_ENUM {
            return self.parse_enum(0)
        }
        if t == TK_TYPE {
            if self.is_type_alias_start() {
                return self.parse_type_alias(0)
            }
        }
        if t == TK_NAMESPACE or t == TK_MODULE {
            const nt5: int = self.peek_no_lb()
            if nt5 > 0 and (self.is_ident_like(nt5) or nt5 == TK_STRING_LITERAL) {
                return self.parse_module(0)
            }
        }
        if t == TK_GLOBAL and self.peek() == TK_OPEN_BRACE {
            return self.parse_module(0)
        }
        if t == TK_DECLARE or t == TK_ABSTRACT or t == TK_ASYNC {
            const found: int = self.find_decl_after_mods()
            if found != 0 {
                return self.parse_decl_with_mods(0)
            }
        }
        if self.is_ident_like(t) and self.peek() == TK_COLON {
            const lbl: int = self.mk(NK_LABELED_STATEMENT)
            self.seta(lbl, self.parse_ident())
            self.expect(TK_COLON)
            self.setb(lbl, self.parse_statement())
            return self.fin(lbl)
        }
        const es: int = self.mk(NK_EXPRESSION_STATEMENT)
        self.seta(es, self.parse_expression())
        self.semi()
        return self.fin(es)
    }

    def is_type_alias_start() -> bool {
        const d: int = self.mark()
        self.bump()
        result: bool = false
        if self.is_ident_like(self.tok) and not self.sc.line_break_before {
            self.bump()
            result = self.at(TK_LT) or self.at(TK_EQ)
        }
        self.restore(d)
        return result
    }

    def find_decl_after_mods() -> int {
        const d: int = self.mark()
        found: int = 0
        steps: int = 0
        while steps < 8 {
            const t: int = self.tok
            if t == TK_DECLARE or t == TK_ABSTRACT or t == TK_ASYNC or t == TK_EXPORT or t == TK_DEFAULT {
                self.bump()
                steps = steps + 1
                continue
            }
            if t == TK_CLASS or t == TK_FUNCTION or t == TK_INTERFACE or t == TK_ENUM or t == TK_VAR or t == TK_LET or t == TK_CONST or t == TK_TYPE or t == TK_NAMESPACE or t == TK_MODULE or t == TK_GLOBAL or t == TK_IMPORT {
                found = t
            }
            break
        }
        self.restore(d)
        return found
    }

    def parse_decl_with_mods(start_mods: int) -> int {
        mods: int = start_mods
        while true {
            const t: int = self.tok
            if t == TK_DECLARE {
                mods = mods + MOD_DECLARE
                self.bump()
                continue
            }
            if t == TK_ABSTRACT {
                mods = mods + MOD_ABSTRACT
                self.bump()
                continue
            }
            if t == TK_ASYNC {
                mods = mods + MOD_ASYNC
                self.bump()
                continue
            }
            break
        }
        const t2: int = self.tok
        if t2 == TK_CLASS {
            return self.parse_class_like(NK_CLASS_DECLARATION, mods)
        }
        if t2 == TK_FUNCTION {
            return self.parse_function_decl(mods)
        }
        if t2 == TK_INTERFACE {
            return self.parse_interface(mods)
        }
        if t2 == TK_ENUM or (t2 == TK_CONST and self.peek() == TK_ENUM) {
            return self.parse_enum(mods)
        }
        if t2 == TK_TYPE {
            return self.parse_type_alias(mods)
        }
        if t2 == TK_NAMESPACE or t2 == TK_MODULE or t2 == TK_GLOBAL {
            return self.parse_module(mods)
        }
        if t2 == TK_VAR or t2 == TK_LET or t2 == TK_CONST or t2 == TK_USING {
            return self.parse_var_stmt(mods)
        }
        if t2 == TK_IMPORT {
            return self.parse_import()
        }
        self.fail(f"expected declaration after modifiers, found {token_name(t2)}")
        return 0 - 1
    }

    def parse_decorated_declaration() -> int {
        const wrap: int = self.new_node(0, self.pos_of())
        const base: int = self.sp
        while self.at(TK_AT) {
            const dec: int = self.mk(NK_DECORATOR)
            self.bump()
            self.seta(dec, self.parse_lhs())
            self.push(self.fin(dec))
        }
        self.close_kids(wrap, base)
        mods: int = 0
        while self.at(TK_EXPORT) or self.at(TK_DECLARE) or self.at(TK_ABSTRACT) or self.at(TK_DEFAULT) {
            if self.at(TK_EXPORT) {
                mods = mods + MOD_EXPORT
            } elif self.at(TK_DECLARE) {
                mods = mods + MOD_DECLARE
            } elif self.at(TK_DEFAULT) {
                mods = mods + MOD_DEFAULT
            } else {
                mods = mods + MOD_ABSTRACT
            }
            self.bump()
        }
        const cls: int = self.parse_class_like(NK_CLASS_DECLARATION, mods)
        self.setd(cls, wrap)
        return cls
    }

    def parse_var_stmt(mods: int) -> int {
        const n: int = self.mk(NK_VARIABLE_STATEMENT)
        self.setflags(n, mods)
        self.seta(n, self.parse_var_decl_list())
        self.semi()
        return self.fin(n)
    }

    def parse_var_decl_list() -> int {
        const lst: int = self.mk(NK_VARIABLE_DECLARATION_LIST)
        const t: int = self.tok
        if t == TK_VAR or t == TK_LET or t == TK_CONST or t == TK_USING {
            self.setop(lst, t)
            self.bump()
        } else {
            self.fail(f"expected var/let/const/using, found {token_name(t)}")
        }
        const base: int = self.sp
        while true {
            const dcl: int = self.mk(NK_VARIABLE_DECLARATION)
            self.seta(dcl, self.parse_binding_name())
            if self.eat(TK_EXCL) {
                self.setop(dcl, 1)
            }
            if self.eat(TK_COLON) {
                self.setb(dcl, self.parse_type())
            }
            if self.eat(TK_EQ) {
                self.setc(dcl, self.parse_assign())
            }
            self.push(self.fin(dcl))
            if not self.eat(TK_COMMA) {
                break
            }
        }
        self.close_kids(lst, base)
        return self.fin(lst)
    }

    def parse_if() -> int {
        const n: int = self.mk(NK_IF_STATEMENT)
        self.expect(TK_IF)
        self.expect(TK_OPEN_PAREN)
        self.seta(n, self.parse_expression())
        self.expect(TK_CLOSE_PAREN)
        self.setb(n, self.parse_statement())
        if self.eat(TK_ELSE) {
            self.setc(n, self.parse_statement())
        }
        return self.fin(n)
    }

    def parse_do() -> int {
        const n: int = self.mk(NK_DO_STATEMENT)
        self.expect(TK_DO)
        self.seta(n, self.parse_statement())
        self.expect(TK_WHILE)
        self.expect(TK_OPEN_PAREN)
        self.setb(n, self.parse_expression())
        self.expect(TK_CLOSE_PAREN)
        self.eat(TK_SEMICOLON)
        return self.fin(n)
    }

    def parse_while() -> int {
        const n: int = self.mk(NK_WHILE_STATEMENT)
        self.expect(TK_WHILE)
        self.expect(TK_OPEN_PAREN)
        self.seta(n, self.parse_expression())
        self.expect(TK_CLOSE_PAREN)
        self.setb(n, self.parse_statement())
        return self.fin(n)
    }

    def parse_for() -> int {
        const pos: int = self.pos_of()
        self.expect(TK_FOR)
        is_await: bool = false
        if self.eat(TK_AWAIT) {
            is_await = true
        }
        self.expect(TK_OPEN_PAREN)
        init: int = 0 - 1
        const t: int = self.tok
        if t == TK_SEMICOLON {
            init = 0 - 1
        } elif t == TK_VAR or t == TK_LET or t == TK_CONST or (t == TK_USING and self.is_ident_like(self.peek())) {
            const saved: bool = self.no_in
            self.no_in = true
            init = self.parse_var_decl_list()
            self.no_in = saved
        } else {
            const saved2: bool = self.no_in
            self.no_in = true
            init = self.parse_expression()
            self.no_in = saved2
        }
        if self.at(TK_OF) {
            const fo: int = self.new_node(NK_FOR_OF_STATEMENT, pos)
            if is_await {
                self.setflags(fo, 1)
            }
            self.seta(fo, init)
            self.bump()
            self.setb(fo, self.parse_assign())
            self.expect(TK_CLOSE_PAREN)
            self.setc(fo, self.parse_statement())
            return self.fin(fo)
        }
        if self.at(TK_IN) {
            const fi: int = self.new_node(NK_FOR_IN_STATEMENT, pos)
            self.seta(fi, init)
            self.bump()
            self.setb(fi, self.parse_expression())
            self.expect(TK_CLOSE_PAREN)
            self.setc(fi, self.parse_statement())
            return self.fin(fi)
        }
        const n: int = self.new_node(NK_FOR_STATEMENT, pos)
        self.seta(n, init)
        self.expect(TK_SEMICOLON)
        if not self.at(TK_SEMICOLON) {
            self.setb(n, self.parse_expression())
        }
        self.expect(TK_SEMICOLON)
        if not self.at(TK_CLOSE_PAREN) {
            self.setc(n, self.parse_expression())
        }
        self.expect(TK_CLOSE_PAREN)
        self.setd(n, self.parse_statement())
        return self.fin(n)
    }

    def parse_jump(kind: int) -> int {
        const n: int = self.mk(kind)
        self.bump()
        if not self.can_semi() and self.is_ident_like(self.tok) {
            self.seta(n, self.parse_ident())
        }
        self.semi()
        return self.fin(n)
    }

    def parse_return() -> int {
        const n: int = self.mk(NK_RETURN_STATEMENT)
        self.expect(TK_RETURN)
        if not self.can_semi() {
            self.seta(n, self.parse_expression())
        }
        self.semi()
        return self.fin(n)
    }

    def parse_with() -> int {
        const n: int = self.mk(NK_WITH_STATEMENT)
        self.expect(TK_WITH)
        self.expect(TK_OPEN_PAREN)
        self.seta(n, self.parse_expression())
        self.expect(TK_CLOSE_PAREN)
        self.setb(n, self.parse_statement())
        return self.fin(n)
    }

    def parse_switch() -> int {
        const n: int = self.mk(NK_SWITCH_STATEMENT)
        self.expect(TK_SWITCH)
        self.expect(TK_OPEN_PAREN)
        self.seta(n, self.parse_expression())
        self.expect(TK_CLOSE_PAREN)
        const cb: int = self.mk(NK_CASE_BLOCK)
        self.expect(TK_OPEN_BRACE)
        const base: int = self.sp
        while not (self.at(TK_CLOSE_BRACE) or self.at(TK_EOF)) {
            if self.at(TK_CASE) {
                const cc: int = self.mk(NK_CASE_CLAUSE)
                self.bump()
                self.seta(cc, self.parse_expression())
                self.expect(TK_COLON)
                const base2: int = self.sp
                while not (self.at(TK_CASE) or self.at(TK_DEFAULT) or self.at(TK_CLOSE_BRACE) or self.at(TK_EOF)) {
                    self.push(self.parse_statement())
                }
                self.close_kids(cc, base2)
                self.push(self.fin(cc))
            } elif self.at(TK_DEFAULT) {
                const dc: int = self.mk(NK_DEFAULT_CLAUSE)
                self.bump()
                self.expect(TK_COLON)
                const base3: int = self.sp
                while not (self.at(TK_CASE) or self.at(TK_DEFAULT) or self.at(TK_CLOSE_BRACE) or self.at(TK_EOF)) {
                    self.push(self.parse_statement())
                }
                self.close_kids(dc, base3)
                self.push(self.fin(dc))
            } else {
                self.fail(f"expected case or default, found {token_name(self.tok)}")
            }
        }
        self.expect(TK_CLOSE_BRACE)
        self.close_kids(cb, base)
        self.setb(n, self.fin(cb))
        return self.fin(n)
    }

    def parse_throw() -> int {
        const n: int = self.mk(NK_THROW_STATEMENT)
        self.expect(TK_THROW)
        self.seta(n, self.parse_expression())
        self.semi()
        return self.fin(n)
    }

    def parse_try() -> int {
        const n: int = self.mk(NK_TRY_STATEMENT)
        self.expect(TK_TRY)
        self.seta(n, self.parse_block())
        if self.at(TK_CATCH) {
            const cc: int = self.mk(NK_CATCH_CLAUSE)
            self.bump()
            if self.eat(TK_OPEN_PAREN) {
                const vd: int = self.mk(NK_VARIABLE_DECLARATION)
                self.seta(vd, self.parse_binding_name())
                if self.eat(TK_COLON) {
                    self.setb(vd, self.parse_type())
                }
                self.seta(cc, self.fin(vd))
                self.expect(TK_CLOSE_PAREN)
            }
            self.setb(cc, self.parse_block())
            self.setb(n, self.fin(cc))
        }
        if self.eat(TK_FINALLY) {
            self.setc(n, self.parse_block())
        }
        return self.fin(n)
    }

    def parse_function_decl(mods: int) -> int {
        const n: int = self.mk(NK_FUNCTION_DECLARATION)
        self.setflags(n, mods)
        self.expect(TK_FUNCTION)
        if self.eat(TK_ASTERISK) {
            self.setop(n, 2)
        }
        if self.is_ident_like(self.tok) {
            self.seta(n, self.parse_ident())
        }
        self.parse_sig_tail(n)
        if self.at(TK_OPEN_BRACE) {
            self.setd(n, self.parse_block())
        } else {
            self.semi()
        }
        return self.fin(n)
    }

    def parse_class_like(kind: int, mods: int) -> int {
        const n: int = self.mk(kind)
        self.setflags(n, mods)
        self.expect(TK_CLASS)
        if self.is_ident_like(self.tok) and not self.at(TK_EXTENDS) {
            self.seta(n, self.parse_ident())
        }
        if self.at(TK_LT) {
            self.setb(n, self.parse_type_params())
        }
        const hwrap: int = self.new_node(0, self.pos_of())
        const hbase: int = self.sp
        heritage_count: int = 0
        while self.at(TK_EXTENDS) or self.at(TK_IMPLEMENTS) {
            const hc: int = self.mk(NK_HERITAGE_CLAUSE)
            self.setop(hc, self.tok)
            self.bump()
            const base2: int = self.sp
            while true {
                const ew: int = self.mk(NK_EXPR_WITH_TYPE_ARGS)
                self.seta(ew, self.parse_member_rest(self.parse_primary(), false))
                if self.at(TK_LT) {
                    self.setc(ew, self.parse_type_args())
                }
                self.push(self.fin(ew))
                if not self.eat(TK_COMMA) {
                    break
                }
            }
            self.close_kids(hc, base2)
            self.push(self.fin(hc))
            heritage_count = heritage_count + 1
        }
        self.close_kids(hwrap, hbase)
        const members: int = self.new_node(0, self.pos_of())
        self.expect(TK_OPEN_BRACE)
        const mbase: int = self.sp
        while not (self.at(TK_CLOSE_BRACE) or self.at(TK_EOF)) {
            self.push(self.parse_class_member())
        }
        self.expect(TK_CLOSE_BRACE)
        self.close_kids(members, mbase)
        self.setc(n, members)
        if heritage_count > 0 {
            self.setd(n, hwrap)
        }
        return self.fin(n)
    }

    def parse_class_member() -> int {
        const pos: int = self.pos_of()
        if self.at(TK_SEMICOLON) {
            const sc_el: int = self.mk(NK_SEMICOLON_CLASS_ELEMENT)
            self.bump()
            return self.fin(sc_el)
        }
        dwrap: int = 0 - 1
        if self.at(TK_AT) {
            dwrap = self.new_node(0, pos)
            const dbase: int = self.sp
            while self.at(TK_AT) {
                const dec: int = self.mk(NK_DECORATOR)
                self.bump()
                self.seta(dec, self.parse_lhs())
                self.push(self.fin(dec))
            }
            self.close_kids(dwrap, dbase)
        }
        if self.at(TK_STATIC) and self.peek() == TK_OPEN_BRACE {
            const sb: int = self.new_node(NK_CLASS_STATIC_BLOCK, pos)
            self.bump()
            self.seta(sb, self.parse_block())
            return self.fin(sb)
        }
        mods: int = 0
        while true {
            const t: int = self.tok
            is_mod: bool = false
            bit: int = 0
            if t == TK_PUBLIC {
                bit = MOD_PUBLIC
            } elif t == TK_PRIVATE {
                bit = MOD_PRIVATE
            } elif t == TK_PROTECTED {
                bit = MOD_PROTECTED
            } elif t == TK_STATIC {
                bit = MOD_STATIC
            } elif t == TK_READONLY {
                bit = MOD_READONLY
            } elif t == TK_ABSTRACT {
                bit = MOD_ABSTRACT
            } elif t == TK_OVERRIDE {
                bit = MOD_OVERRIDE
            } elif t == TK_DECLARE {
                bit = MOD_DECLARE
            } elif t == TK_ACCESSOR {
                bit = MOD_ACCESSOR
            } elif t == TK_ASYNC {
                bit = MOD_ASYNC
            }
            if bit != 0 {
                const nt: int = self.peek()
                if self.is_ident_name_tok(nt) or nt == TK_OPEN_BRACKET or nt == TK_STRING_LITERAL or nt == TK_NUMERIC_LITERAL or nt == TK_ASTERISK or nt == TK_PRIVATE_IDENTIFIER or (t == TK_STATIC and nt == TK_OPEN_BRACE) {
                    if t == TK_STATIC and nt == TK_OPEN_BRACE {
                        is_mod = false
                    } else {
                        mods = mods + bit
                        self.bump()
                        is_mod = true
                    }
                }
            }
            if not is_mod {
                break
            }
        }
        is_gen: bool = false
        if self.at(TK_ASTERISK) {
            is_gen = true
            self.bump()
        }
        if self.at(TK_OPEN_BRACKET) and self.is_index_sig_start() {
            const ix: int = self.new_node(NK_INDEX_SIGNATURE, pos)
            self.setflags(ix, mods)
            self.bump()
            const prm: int = self.mk(NK_PARAMETER)
            self.seta(prm, self.parse_ident())
            self.expect(TK_COLON)
            self.setb(prm, self.parse_type())
            self.seta(ix, self.fin(prm))
            self.expect(TK_CLOSE_BRACKET)
            if self.eat(TK_COLON) {
                self.setb(ix, self.parse_type())
            }
            self.eat(TK_SEMICOLON)
            return self.fin(ix)
        }
        if (self.at(TK_GET) or self.at(TK_SET)) and not is_gen {
            const which: int = self.tok
            const nt2: int = self.peek()
            if self.is_ident_name_tok(nt2) or nt2 == TK_OPEN_BRACKET or nt2 == TK_STRING_LITERAL or nt2 == TK_NUMERIC_LITERAL or nt2 == TK_PRIVATE_IDENTIFIER {
                kind: int = NK_GET_ACCESSOR
                if which == TK_SET {
                    kind = NK_SET_ACCESSOR
                }
                const acc: int = self.new_node(kind, pos)
                self.setflags(acc, mods)
                self.bump()
                self.seta(acc, self.parse_property_name())
                self.parse_params_into(acc)
                if self.eat(TK_COLON) {
                    self.setb(acc, self.parse_type_or_predicate())
                }
                if self.at(TK_OPEN_BRACE) {
                    self.setc(acc, self.parse_block())
                } else {
                    self.semi()
                }
                return self.fin(acc)
            }
        }
        if self.at(TK_CONSTRUCTOR) and (self.peek() == TK_OPEN_PAREN or self.peek() == TK_LT) {
            const ctor: int = self.new_node(NK_CONSTRUCTOR, pos)
            self.setflags(ctor, mods)
            self.bump()
            self.parse_sig_tail(ctor)
            if self.at(TK_OPEN_BRACE) {
                self.setd(ctor, self.parse_block())
            } else {
                self.semi()
            }
            return self.fin(ctor)
        }
        const name: int = self.parse_property_name()
        opt: bool = self.eat(TK_QUESTION)
        excl: bool = false
        if not opt {
            excl = self.eat(TK_EXCL)
        }
        if self.at(TK_OPEN_PAREN) or self.at(TK_LT) {
            const m: int = self.new_node(NK_METHOD_DECLARATION, pos)
            self.setflags(m, mods)
            if is_gen {
                self.setop(m, 2)
            }
            self.seta(m, name)
            self.parse_sig_tail(m)
            if self.at(TK_OPEN_BRACE) {
                self.setd(m, self.parse_block())
            } else {
                self.semi()
            }
            return self.fin(m)
        }
        const p: int = self.new_node(NK_PROPERTY_DECLARATION, pos)
        self.setflags(p, mods)
        self.seta(p, name)
        if opt {
            self.setop(p, 1)
        }
        if excl {
            self.setop(p, 3)
        }
        if self.eat(TK_COLON) {
            self.setb(p, self.parse_type())
        }
        if self.eat(TK_EQ) {
            self.setc(p, self.parse_assign())
        }
        self.semi()
        return self.fin(p)
    }

    def parse_interface(mods: int) -> int {
        const n: int = self.mk(NK_INTERFACE_DECLARATION)
        self.setflags(n, mods)
        self.expect(TK_INTERFACE)
        self.seta(n, self.parse_ident())
        if self.at(TK_LT) {
            self.setb(n, self.parse_type_params())
        }
        const hwrap: int = self.new_node(0, self.pos_of())
        const hbase: int = self.sp
        heritage_count: int = 0
        while self.at(TK_EXTENDS) {
            const hc: int = self.mk(NK_HERITAGE_CLAUSE)
            self.setop(hc, TK_EXTENDS)
            self.bump()
            const base2: int = self.sp
            while true {
                const ew: int = self.mk(NK_EXPR_WITH_TYPE_ARGS)
                self.seta(ew, self.parse_member_rest(self.parse_primary(), false))
                if self.at(TK_LT) {
                    self.setc(ew, self.parse_type_args())
                }
                self.push(self.fin(ew))
                if not self.eat(TK_COMMA) {
                    break
                }
            }
            self.close_kids(hc, base2)
            self.push(self.fin(hc))
            heritage_count = heritage_count + 1
        }
        self.close_kids(hwrap, hbase)
        self.expect(TK_OPEN_BRACE)
        const body: int = self.new_node(0, self.pos_of())
        self.parse_type_members_into(body)
        self.expect(TK_CLOSE_BRACE)
        self.setc(n, body)
        if heritage_count > 0 {
            self.setd(n, hwrap)
        }
        return self.fin(n)
    }

    def parse_type_alias(mods: int) -> int {
        const n: int = self.mk(NK_TYPE_ALIAS_DECLARATION)
        self.setflags(n, mods)
        self.expect(TK_TYPE)
        self.seta(n, self.parse_ident())
        if self.at(TK_LT) {
            self.setb(n, self.parse_type_params())
        }
        self.expect(TK_EQ)
        self.setc(n, self.parse_type())
        self.semi()
        return self.fin(n)
    }

    def parse_enum(mods: int) -> int {
        const n: int = self.mk(NK_ENUM_DECLARATION)
        self.setflags(n, mods)
        if self.eat(TK_CONST) {
            self.setop(n, 1)
        }
        self.expect(TK_ENUM)
        self.seta(n, self.parse_ident())
        self.expect(TK_OPEN_BRACE)
        const base: int = self.sp
        while not self.at(TK_CLOSE_BRACE) {
            const m: int = self.mk(NK_ENUM_MEMBER)
            self.seta(m, self.parse_property_name())
            if self.eat(TK_EQ) {
                self.setb(m, self.parse_assign())
            }
            self.push(self.fin(m))
            if not self.eat(TK_COMMA) {
                break
            }
        }
        self.expect(TK_CLOSE_BRACE)
        self.close_kids(n, base)
        return self.fin(n)
    }

    def parse_module(mods: int) -> int {
        const n: int = self.mk(NK_MODULE_DECLARATION)
        self.setflags(n, mods)
        if self.at(TK_GLOBAL) {
            self.seta(n, self.parse_ident())
        } else {
            if self.at(TK_NAMESPACE) {
                self.setop(n, 1)
            }
            self.bump()
            if self.at(TK_STRING_LITERAL) {
                const s: int = self.mk(TK_STRING_LITERAL)
                self.bump()
                self.seta(n, self.fin(s))
            } else {
                self.seta(n, self.parse_entity_name())
            }
        }
        if self.at(TK_OPEN_BRACE) {
            const mb: int = self.mk(NK_MODULE_BLOCK)
            self.bump()
            const base: int = self.sp
            while not (self.at(TK_CLOSE_BRACE) or self.at(TK_EOF)) {
                self.push(self.parse_statement())
            }
            self.expect(TK_CLOSE_BRACE)
            self.close_kids(mb, base)
            self.setb(n, self.fin(mb))
        } else {
            self.semi()
        }
        return self.fin(n)
    }

    def parse_import() -> int {
        const pos: int = self.pos_of()
        self.expect(TK_IMPORT)
        if self.at(TK_STRING_LITERAL) {
            const n: int = self.new_node(NK_IMPORT_DECLARATION, pos)
            const s: int = self.mk(TK_STRING_LITERAL)
            self.bump()
            self.setb(n, self.fin(s))
            self.setc(n, self.parse_import_attributes_opt())
            self.semi()
            return self.fin(n)
        }
        const clause: int = self.new_node(NK_IMPORT_CLAUSE, pos)
        is_type_only: bool = false
        phase: int = 0
        if self.at(TK_TYPE) {
            const nt: int = self.peek()
            if nt == TK_ASTERISK or nt == TK_OPEN_BRACE or (self.is_ident_like(nt) and nt != TK_FROM) {
                is_type_only = true
                self.bump()
            }
        } elif self.at(TK_DEFER) {
            if self.peek() == TK_ASTERISK {
                phase = 1
                self.bump()
            }
        }
        if is_type_only {
            self.setop(clause, 1)
        }
        if phase == 1 {
            self.setflags(clause, 1)
        }
        if self.is_ident_like(self.tok) {
            self.seta(clause, self.parse_ident())
            if self.eat(TK_EQ) {
                const ie: int = self.new_node(NK_IMPORT_EQUALS, pos)
                self.seta(ie, self.ast[clause * STRIDE + F_A])
                if self.at(TK_REQUIRE) and self.peek() == TK_OPEN_PAREN {
                    const ext: int = self.mk(NK_EXTERNAL_MODULE_REF)
                    self.bump()
                    self.expect(TK_OPEN_PAREN)
                    const ms: int = self.mk(TK_STRING_LITERAL)
                    self.expect(TK_STRING_LITERAL)
                    self.seta(ext, self.fin(ms))
                    self.expect(TK_CLOSE_PAREN)
                    self.setb(ie, self.fin(ext))
                } else {
                    self.setb(ie, self.parse_entity_name())
                }
                self.semi()
                return self.fin(ie)
            }
            if self.eat(TK_COMMA) {
                if self.at(TK_ASTERISK) {
                    self.setb(clause, self.parse_namespace_import())
                } else {
                    self.setb(clause, self.parse_named_imports())
                }
            }
        } elif self.at(TK_ASTERISK) {
            self.setb(clause, self.parse_namespace_import())
        } elif self.at(TK_OPEN_BRACE) {
            self.setb(clause, self.parse_named_imports())
        }
        const n2: int = self.new_node(NK_IMPORT_DECLARATION, pos)
        self.seta(n2, self.fin(clause))
        self.expect(TK_FROM)
        const spec: int = self.mk(TK_STRING_LITERAL)
        self.expect(TK_STRING_LITERAL)
        self.setb(n2, self.fin(spec))
        self.setc(n2, self.parse_import_attributes_opt())
        self.semi()
        return self.fin(n2)
    }

    def parse_namespace_import() -> int {
        const n: int = self.mk(NK_NAMESPACE_IMPORT)
        self.expect(TK_ASTERISK)
        self.expect(TK_AS)
        self.seta(n, self.parse_ident())
        return self.fin(n)
    }

    def parse_named_imports() -> int {
        const n: int = self.mk(NK_NAMED_IMPORTS)
        self.expect(TK_OPEN_BRACE)
        const base: int = self.sp
        while not self.at(TK_CLOSE_BRACE) {
            const sp_n: int = self.mk(NK_IMPORT_SPECIFIER)
            if self.at(TK_TYPE) {
                const nt: int = self.peek()
                if self.is_ident_name_tok(nt) and nt != TK_AS {
                    self.setop(sp_n, 1)
                    self.bump()
                }
            }
            const nm: int = self.parse_ident_name()
            if self.eat(TK_AS) {
                self.seta(sp_n, nm)
                self.setb(sp_n, self.parse_ident())
            } else {
                self.setb(sp_n, nm)
            }
            self.push(self.fin(sp_n))
            if not self.eat(TK_COMMA) {
                break
            }
        }
        self.expect(TK_CLOSE_BRACE)
        self.close_kids(n, base)
        return self.fin(n)
    }

    def parse_import_attributes_opt() -> int {
        if (self.at(TK_WITH) or self.at(TK_ASSERT)) and not self.sc.line_break_before {
            const n: int = self.mk(NK_IMPORT_ATTRIBUTES)
            self.bump()
            self.expect(TK_OPEN_BRACE)
            const base: int = self.sp
            while not self.at(TK_CLOSE_BRACE) {
                const at_n: int = self.mk(NK_IMPORT_ATTRIBUTE)
                self.seta(at_n, self.parse_property_name())
                self.expect(TK_COLON)
                self.setb(at_n, self.parse_assign())
                self.push(self.fin(at_n))
                if not self.eat(TK_COMMA) {
                    break
                }
            }
            self.expect(TK_CLOSE_BRACE)
            self.close_kids(n, base)
            return self.fin(n)
        }
        return 0 - 1
    }

    def parse_export() -> int {
        const pos: int = self.pos_of()
        self.expect(TK_EXPORT)
        if self.at(TK_EQ) {
            const ea: int = self.new_node(NK_EXPORT_ASSIGNMENT, pos)
            self.setop(ea, 1)
            self.bump()
            self.seta(ea, self.parse_assign())
            self.semi()
            return self.fin(ea)
        }
        if self.at(TK_DEFAULT) {
            self.bump()
            const t: int = self.tok
            if t == TK_FUNCTION or (t == TK_ASYNC and self.peek_no_lb() == TK_FUNCTION) {
                mods: int = MOD_EXPORT + MOD_DEFAULT
                if t == TK_ASYNC {
                    mods = mods + MOD_ASYNC
                    self.bump()
                }
                return self.parse_function_decl(mods)
            }
            if t == TK_CLASS {
                return self.parse_class_like(NK_CLASS_DECLARATION, MOD_EXPORT + MOD_DEFAULT)
            }
            if t == TK_ABSTRACT and self.peek() == TK_CLASS {
                self.bump()
                return self.parse_class_like(NK_CLASS_DECLARATION, MOD_EXPORT + MOD_DEFAULT + MOD_ABSTRACT)
            }
            if t == TK_INTERFACE {
                return self.parse_interface(MOD_EXPORT + MOD_DEFAULT)
            }
            const ea2: int = self.new_node(NK_EXPORT_ASSIGNMENT, pos)
            self.seta(ea2, self.parse_assign())
            self.semi()
            return self.fin(ea2)
        }
        if self.at(TK_ASTERISK) {
            const ed: int = self.new_node(NK_EXPORT_DECLARATION, pos)
            self.bump()
            if self.eat(TK_AS) {
                const ne: int = self.mk(NK_NAMESPACE_EXPORT)
                self.seta(ne, self.parse_ident_name())
                self.seta(ed, self.fin(ne))
            }
            self.expect(TK_FROM)
            const spec: int = self.mk(TK_STRING_LITERAL)
            self.expect(TK_STRING_LITERAL)
            self.setb(ed, self.fin(spec))
            self.setc(ed, self.parse_import_attributes_opt())
            self.semi()
            return self.fin(ed)
        }
        if self.at(TK_OPEN_BRACE) or (self.at(TK_TYPE) and self.peek() == TK_OPEN_BRACE) {
            const ed2: int = self.new_node(NK_EXPORT_DECLARATION, pos)
            if self.at(TK_TYPE) {
                self.setop(ed2, 1)
                self.bump()
            }
            const ne2: int = self.mk(NK_NAMED_EXPORTS)
            self.expect(TK_OPEN_BRACE)
            const base: int = self.sp
            while not self.at(TK_CLOSE_BRACE) {
                const sp_n: int = self.mk(NK_EXPORT_SPECIFIER)
                if self.at(TK_TYPE) {
                    const nt: int = self.peek()
                    if self.is_ident_name_tok(nt) and nt != TK_AS {
                        self.setop(sp_n, 1)
                        self.bump()
                    }
                }
                const nm: int = self.parse_ident_name()
                if self.eat(TK_AS) {
                    self.seta(sp_n, nm)
                    self.setb(sp_n, self.parse_ident_name())
                } else {
                    self.setb(sp_n, nm)
                }
                self.push(self.fin(sp_n))
                if not self.eat(TK_COMMA) {
                    break
                }
            }
            self.expect(TK_CLOSE_BRACE)
            self.close_kids(ne2, base)
            self.seta(ed2, self.fin(ne2))
            if self.eat(TK_FROM) {
                const spec2: int = self.mk(TK_STRING_LITERAL)
                self.expect(TK_STRING_LITERAL)
                self.setb(ed2, self.fin(spec2))
                self.setc(ed2, self.parse_import_attributes_opt())
            }
            self.semi()
            return self.fin(ed2)
        }
        if self.at(TK_AS) {
            const nsd: int = self.new_node(NK_NAMESPACE_EXPORT_DECL, pos)
            self.bump()
            self.expect(TK_NAMESPACE)
            self.seta(nsd, self.parse_ident())
            self.semi()
            return self.fin(nsd)
        }
        if self.at(TK_IMPORT) {
            return self.parse_import()
        }
        return self.parse_exported_decl()
    }

    def parse_exported_decl() -> int {
        const t: int = self.tok
        if t == TK_VAR or t == TK_LET or (t == TK_CONST and self.peek() != TK_ENUM) or t == TK_USING {
            return self.parse_var_stmt(MOD_EXPORT)
        }
        if t == TK_FUNCTION {
            return self.parse_function_decl(MOD_EXPORT)
        }
        if t == TK_CLASS {
            return self.parse_class_like(NK_CLASS_DECLARATION, MOD_EXPORT)
        }
        if t == TK_INTERFACE {
            return self.parse_interface(MOD_EXPORT)
        }
        if t == TK_TYPE {
            return self.parse_type_alias(MOD_EXPORT)
        }
        if t == TK_ENUM or (t == TK_CONST and self.peek() == TK_ENUM) {
            return self.parse_enum(MOD_EXPORT)
        }
        if t == TK_NAMESPACE or t == TK_MODULE or t == TK_GLOBAL {
            return self.parse_module(MOD_EXPORT)
        }
        if t == TK_AT {
            return self.parse_decorated_declaration()
        }
        if t == TK_DECLARE or t == TK_ABSTRACT or t == TK_ASYNC {
            return self.parse_decl_with_mods(MOD_EXPORT)
        }
        self.fail(f"expected declaration after export, found {token_name(t)}")
        return 0 - 1
    }
}

def count_walk2(ast: list[int], edges: list[int], i: int, acc: dict[int, int]) -> None {
    const base: int = i * STRIDE
    const kind: int = ast[base + F_KIND]
    acc[kind] = acc.get(kind, 0) + 1
    const a: int = ast[base + F_A]
    if a >= 0 {
        count_walk2(ast, edges, a, acc)
    }
    const b: int = ast[base + F_B]
    if b >= 0 {
        count_walk2(ast, edges, b, acc)
    }
    const c: int = ast[base + F_C]
    if c >= 0 {
        count_walk2(ast, edges, c, acc)
    }
    const d: int = ast[base + F_D]
    if d >= 0 {
        count_walk2(ast, edges, d, acc)
    }
    const ks: int = ast[base + F_KS]
    const kn: int = ast[base + F_KN]
    j: int = 0
    while j < kn {
        count_walk2(ast, edges, edges[ks + j], acc)
        j = j + 1
    }
}

def count_output2(p: Parser2, root: int) -> str {
    acc: dict[int, int] = {}
    count_walk2(p.ast, p.edges, root, acc)
    lines: list[str] = []
    lines.append(f"statements {p.ast[root * STRIDE + F_KN]}")
    i: int = 0
    while i < len(COUNT_KINDS) {
        const k: int = COUNT_KINDS[i]
        lines.append(f"{COUNT_NAMES[i]} {acc.get(k, 0)}")
        i = i + 1
    }
    return "\n".join(lines)
}

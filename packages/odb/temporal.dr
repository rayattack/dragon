from odb.errors import SchemaError

const MICROS_PER_SEC: int = 1000000
const SECS_PER_DAY: int = 86400
const MICROS_PER_DAY: int = 86400000000
const MIN_YEAR: int = 1
const MAX_YEAR: int = 9999


def days_from_civil(y: int, m: int, d: int) -> int {
    yy: int = y
    if m <= 2 {
        yy = y - 1
    }
    const era: int = yy // 400
    const yoe: int = yy - era * 400
    mp: int = m + 9
    if m > 2 {
        mp = m - 3
    }
    const doy: int = (153 * mp + 2) // 5 + d - 1
    const doe: int = yoe * 365 + yoe // 4 - yoe // 100 + doy
    return era * 146097 + doe - 719468
}


def civil_from_days(z0: int) -> tuple[int, int, int] {
    const z: int = z0 + 719468
    const era: int = z // 146097
    const doe: int = z - era * 146097
    const yoe: int = (doe - doe // 1460 + doe // 36524 - doe // 146096) // 365
    const y0: int = yoe + era * 400
    const doy: int = doe - (365 * yoe + yoe // 4 - yoe // 100)
    const mp: int = (5 * doy + 2) // 153
    const d: int = doy - (153 * mp + 2) // 5 + 1
    m: int = mp - 9
    if mp < 10 {
        m = mp + 3
    }
    y: int = y0
    if m <= 2 {
        y = y0 + 1
    }
    return (y, m, d)
}


def is_leap_year(y: int) -> bool {
    if y % 4 != 0 {
        return False
    }
    if y % 100 != 0 {
        return True
    }
    return y % 400 == 0
}


def days_in_month(y: int, m: int) -> int {
    if m == 2 {
        if is_leap_year(y) {
            return 29
        }
        return 28
    }
    if m == 4 or m == 6 or m == 9 or m == 11 {
        return 30
    }
    return 31
}


def _pad(n: int, width: int) -> str {
    s: str = str(n)
    while len(s) < width {
        s = "0" + s
    }
    return s
}


def _ascii(s: str, what: str) -> bytes {
    const b: bytes = s.encode()
    if len(b) != len(s) {
        raise SchemaError(what + " '" + s + "' contains non-ASCII characters")
    }
    return b
}


def _digits(b: bytes, off: int, n: int, s: str, what: str) -> int {
    if off + n > len(b) {
        raise SchemaError(what + " '" + s + "' is truncated")
    }
    v: int = 0
    i: int = 0
    while i < n {
        const c: int = b[off + i]
        if c < 48 or c > 57 {
            raise SchemaError(what + " '" + s + "' expects a digit at position " + str(off + i))
        }
        v = v * 10 + (c - 48)
        i = i + 1
    }
    return v
}


def _lit(b: bytes, off: int, ch: int, s: str, what: str) -> None {
    if off >= len(b) {
        raise SchemaError(what + " '" + s + "' is truncated")
    }
    if b[off] != ch {
        raise SchemaError(what + " '" + s + "' expects '" + chr(ch) + "' at position " + str(off))
    }
}


def _check_ymd(y: int, m: int, d: int, s: str, what: str) -> None {
    if y < MIN_YEAR or y > MAX_YEAR {
        raise SchemaError(what + " '" + s + "' has a year outside " + str(MIN_YEAR) + "-" + str(MAX_YEAR))
    }
    if m < 1 or m > 12 {
        raise SchemaError(what + " '" + s + "' has month " + str(m) + " outside 1-12")
    }
    if d < 1 or d > days_in_month(y, m) {
        raise SchemaError(what + " '" + s + "' has day " + str(d) + " outside 1-" + str(days_in_month(y, m)) + " for month " + str(m))
    }
}


def parse_date(s: str) -> int {
    const b: bytes = _ascii(s, "date")
    if len(b) != 10 {
        raise SchemaError("date '" + s + "' must be exactly YYYY-MM-DD")
    }
    const y: int = _digits(b, 0, 4, s, "date")
    _lit(b, 4, 45, s, "date")
    const m: int = _digits(b, 5, 2, s, "date")
    _lit(b, 7, 45, s, "date")
    const d: int = _digits(b, 8, 2, s, "date")
    _check_ymd(y, m, d, s, "date")
    return days_from_civil(y, m, d)
}


def format_date(days: int) -> str {
    const ymd: tuple[int, int, int] = civil_from_days(days)
    return _pad(ymd[0], 4) + "-" + _pad(ymd[1], 2) + "-" + _pad(ymd[2], 2)
}


def parse_datetime(s: str) -> int {
    const b: bytes = _ascii(s, "date-time")
    if len(b) < 20 {
        raise SchemaError("date-time '" + s + "' is shorter than the RFC 3339 minimum YYYY-MM-DDTHH:MM:SSZ")
    }
    const y: int = _digits(b, 0, 4, s, "date-time")
    _lit(b, 4, 45, s, "date-time")
    const mo: int = _digits(b, 5, 2, s, "date-time")
    _lit(b, 7, 45, s, "date-time")
    const d: int = _digits(b, 8, 2, s, "date-time")
    const sep: int = b[10]
    if sep != 84 and sep != 116 and sep != 32 {
        raise SchemaError("date-time '" + s + "' expects 'T' between the date and the time")
    }
    const hh: int = _digits(b, 11, 2, s, "date-time")
    _lit(b, 13, 58, s, "date-time")
    const mi: int = _digits(b, 14, 2, s, "date-time")
    _lit(b, 16, 58, s, "date-time")
    const ss: int = _digits(b, 17, 2, s, "date-time")
    _check_ymd(y, mo, d, s, "date-time")
    if hh > 23 {
        raise SchemaError("date-time '" + s + "' has hour " + str(hh) + " outside 0-23")
    }
    if mi > 59 {
        raise SchemaError("date-time '" + s + "' has minute " + str(mi) + " outside 0-59")
    }
    if ss == 60 {
        raise SchemaError("date-time '" + s + "' is a leap second; odb stores microseconds since the epoch, which cannot represent one")
    }
    if ss > 59 {
        raise SchemaError("date-time '" + s + "' has second " + str(ss) + " outside 0-59")
    }

    off: int = 19
    micros: int = 0
    if off < len(b) and b[off] == 46 {
        off = off + 1
        start: int = off
        while off < len(b) and b[off] >= 48 and b[off] <= 57 {
            off = off + 1
        }
        const ndig: int = off - start
        if ndig == 0 {
            raise SchemaError("date-time '" + s + "' has a '.' with no fractional digits")
        }
        if ndig > 9 {
            raise SchemaError("date-time '" + s + "' has more than 9 fractional digits")
        }
        scaled: int = 0
        i: int = 0
        while i < 6 {
            digit: int = 0
            if i < ndig {
                digit = b[start + i] - 48
            }
            scaled = scaled * 10 + digit
            i = i + 1
        }
        micros = scaled
    }

    if off >= len(b) {
        raise SchemaError("date-time '" + s + "' has no UTC offset; RFC 3339 requires 'Z' or +HH:MM")
    }
    const zc: int = b[off]
    offset_secs: int = 0
    if zc == 90 or zc == 122 {
        if off + 1 != len(b) {
            raise SchemaError("date-time '" + s + "' has trailing characters after 'Z'")
        }
    } else {
        if zc != 43 and zc != 45 {
            raise SchemaError("date-time '" + s + "' expects 'Z' or a +HH:MM offset at position " + str(off))
        }
        if off + 6 != len(b) {
            raise SchemaError("date-time '" + s + "' has a malformed offset; RFC 3339 requires +HH:MM")
        }
        const oh: int = _digits(b, off + 1, 2, s, "date-time")
        _lit(b, off + 3, 58, s, "date-time")
        const om: int = _digits(b, off + 4, 2, s, "date-time")
        if oh > 23 or om > 59 {
            raise SchemaError("date-time '" + s + "' has an offset outside +/-23:59")
        }
        offset_secs = oh * 3600 + om * 60
        if zc == 45 {
            offset_secs = -offset_secs
        }
    }

    const days: int = days_from_civil(y, mo, d)
    const secs: int = days * SECS_PER_DAY + hh * 3600 + mi * 60 + ss - offset_secs
    return secs * MICROS_PER_SEC + micros
}


def format_datetime(micros: int) -> str {
    days: int = micros // MICROS_PER_DAY
    rem: int = micros - days * MICROS_PER_DAY
    const ymd: tuple[int, int, int] = civil_from_days(days)
    const frac: int = rem % MICROS_PER_SEC
    const tod: int = rem // MICROS_PER_SEC
    const out: str = _pad(ymd[0], 4) + "-" + _pad(ymd[1], 2) + "-" + _pad(ymd[2], 2) + "T" + _pad(tod // 3600, 2) + ":" + _pad((tod // 60) % 60, 2) + ":" + _pad(tod % 60, 2)
    if frac == 0 {
        return out + "Z"
    }
    return out + "." + _pad(frac, 6) + "Z"
}

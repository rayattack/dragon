const _MASK32: int = 0xFFFFFFFF

class Rng {
    state: int

    def(seed: int) {
        s: int = seed & _MASK32
        if s == 0 {
            s = 0x9E3779B9
        }
        self.state = s
    }

    def next_u32() -> int {
        x: int = self.state
        x = (x ^ (x << 13)) & _MASK32
        x = (x ^ (x >> 17)) & _MASK32
        x = (x ^ (x << 5)) & _MASK32
        self.state = x
        return x
    }

    def below(n: int) -> int {
        if n <= 0 {
            return 0
        }
        return self.next_u32() % n
    }

    def chance(num: int, den: int) -> bool {
        if den <= 0 {
            return False
        }
        return self.below(den) < num
    }

    def flip() -> bool {
        return (self.next_u32() & 1) == 1
    }
}

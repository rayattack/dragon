from odb.errors import SchemaError
from odb.schema import CompiledSchema, FieldSpec, T_BOOL, T_INT, T_NUM, T_STR, T_ARRAY, T_OBJECT, T_NULL, type_name
from odb.schema import T_BYTES, T_DATETIME, T_DATE, T_DECIMAL, decode_b64, order_key
from odb.keyenc import enc_bool, enc_int, enc_float, enc_str, enc_composite, enc_null
from odb.keyenc import enc_bytes, enc_date, enc_datetime, enc_decimal
from odb.temporal import parse_date, parse_datetime

const IK_PK: int = 0
const IK_UNIQUE: int = 1
const IK_INDEX: int = 2
const IK_REVERSE: int = 3

class PathSpec {
    text: str
    segments: list[str]
    array_at: int
    tag: int

    def(text: str) {
        self.text = text
        self.segments = []
        self.array_at = -1
        self.tag = T_NULL
    }
}

class IndexDecl {
    name: str
    kind: int
    fields: list[str]
    tags: list[int]
    paths: list[PathSpec]
    unique: bool
    sparse: bool
    multikey: bool

    def(name: str, kind: int, fields: list[str], tags: list[int], unique: bool, sparse: bool) {
        self.name = name
        self.kind = kind
        self.fields = fields
        self.tags = tags
        self.paths = []
        self.unique = unique
        self.sparse = sparse
        self.multikey = False
        for t in tags {
            if t == T_ARRAY {
                self.multikey = True
            }
        }
    }

    def with_paths(paths: list[PathSpec]) -> IndexDecl {
        self.paths = paths
        self.multikey = False
        for p in paths {
            if p.array_at >= 0 {
                self.multikey = True
            }
        }
        return self
    }
}

class RefDecl {
    source_path: str
    source_tag: int
    target_schema: str
    target_field: str
    on_delete: str
    rev_name: str
    is_array: bool
    elem_tag: int

    def(source_path: str, source_tag: int, target_schema: str, target_field: str, on_delete: str, rev_name: str) {
        self.source_path = source_path
        self.source_tag = source_tag
        self.target_schema = target_schema
        self.target_field = target_field
        self.on_delete = on_delete
        self.rev_name = rev_name
        self.is_array = source_tag == T_ARRAY
        self.elem_tag = source_tag
    }
}

class CompiledMeta {
    primary: list[str]
    indexes: list[IndexDecl]
    refs: list[RefDecl]

    def(primary: list[str]) {
        self.primary = primary
        self.indexes = []
        self.refs = []
    }

    def has(n: str) -> bool {
        for d in self.indexes {
            if d.name == n {
                return True
            }
        }
        return False
    }

    def by_name(n: str) -> IndexDecl {
        for d in self.indexes {
            if d.name == n {
                return d
            }
        }
        raise SchemaError("no index named '" + n + "'")
    }
}

def _req_field(cs: CompiledSchema, name: str) -> FieldSpec {
    if name not in cs.by_name {
        raise SchemaError("metadata path '" + name + "' is not a field of schema '" + cs.name + "'")
    }
    f: FieldSpec = cs.by_name[name]
    if not f.required {
        raise SchemaError("metadata path '" + name + "' must be a required field (spec section 7)")
    }
    return f
}

def _parse_path(text: str) -> PathSpec {
    ps: PathSpec = PathSpec(text)
    if len(text) == 0 {
        raise SchemaError("metadata path is empty")
    }
    for raw in text.split(".") {
        seg: str = raw
        is_array: bool = False
        if seg.endswith("[]") {
            is_array = True
            seg = seg[0:len(seg) - 2]
        }
        if len(seg) == 0 {
            raise SchemaError("metadata path '" + text + "' has an empty segment; the grammar is ident(.ident)* with [] after an array segment (spec section 7)")
        }
        if seg.find("[") >= 0 or seg.find("]") >= 0 {
            raise SchemaError("metadata path '" + text + "' may only use [] at the end of a segment")
        }
        if is_array {
            if ps.array_at >= 0 {
                raise SchemaError("metadata path '" + text + "' has more than one []; odb indexes one array level per path")
            }
            ps.array_at = len(ps.segments)
        }
        ps.segments.append(seg)
    }
    return ps
}

def _resolve_path(cs: CompiledSchema, ps: PathSpec, sparse: bool) -> None {
    scope: CompiledSchema = cs
    i: int = 0
    while i < len(ps.segments) {
        const seg: str = ps.segments[i]
        if seg not in scope.by_name {
            raise SchemaError("metadata path '" + ps.text + "' names '" + seg + "', which is not a field of '" + scope.name + "'")
        }
        const f: FieldSpec = scope.by_name[seg]
        if not f.required and not sparse {
            raise SchemaError("metadata path '" + ps.text + "' passes through optional field '" + seg + "'; every segment must be required unless the entry is sparse (spec section 7)")
        }
        const last: bool = i == len(ps.segments) - 1
        if i == ps.array_at {
            if f.tag != T_ARRAY {
                raise SchemaError("metadata path '" + ps.text + "' puts [] after '" + seg + "', which is " + type_name(f.tag) + ", not an array")
            }
            if not f.has_item_tag {
                raise SchemaError("metadata path '" + ps.text + "' indexes '" + seg + "', which declares no items type; an indexed array needs a declared items type so its element keys are ordered consistently")
            }
            if last {
                if f.item_tag == T_OBJECT or f.item_tag == T_ARRAY {
                    raise SchemaError("metadata path '" + ps.text + "' indexes an array of " + type_name(f.item_tag) + "; name a scalar inside the element, as 'items[].sku'")
                }
                ps.tag = f.item_tag
                return
            }
            if f.item_tag != T_OBJECT or len(f.item_nested) != 1 {
                raise SchemaError("metadata path '" + ps.text + "' reaches into elements of '" + seg + "', which are " + type_name(f.item_tag) + ", not objects with properties")
            }
            scope = f.item_nested[0]
            i = i + 1
            continue
        }
        if f.tag == T_ARRAY {
            if not last {
                raise SchemaError("metadata path '" + ps.text + "' walks through array field '" + seg + "' without []; an implicit multikey path is rejected, write '" + seg + "[]' (spec section 7)")
            }
            if not f.has_item_tag {
                raise SchemaError("metadata path '" + ps.text + "' indexes '" + seg + "', which declares no items type; an indexed array needs a declared items type so its element keys are ordered consistently")
            }
            if f.item_tag == T_OBJECT or f.item_tag == T_ARRAY {
                raise SchemaError("metadata path '" + ps.text + "' indexes an array of " + type_name(f.item_tag) + "; name a scalar inside the element, as '" + seg + "[].<field>'")
            }
            ps.array_at = i
            ps.tag = f.item_tag
            return
        }
        if last {
            if f.tag == T_OBJECT {
                raise SchemaError("metadata path '" + ps.text + "' ends on an object; name a scalar inside it, as '" + ps.text + ".<field>'")
            }
            ps.tag = f.tag
            return
        }
        if f.tag != T_OBJECT or len(f.nested) != 1 {
            raise SchemaError("metadata path '" + ps.text + "' walks into '" + seg + "', which is " + type_name(f.tag) + ", not an object with properties")
        }
        scope = f.nested[0]
        i = i + 1
    }
}

def _decl_name(prefix: str, fields: list[str]) -> str {
    s: str = prefix
    i: int = 0
    while i < len(fields) {
        if i > 0 {
            s = s + "+"
        }
        s = s + fields[i]
        i = i + 1
    }
    return s
}

class EntryFields {
    fields: list[str]
    tags: list[int]
    paths: list[PathSpec]
    sparse: bool

    def(fields: list[str], tags: list[int], paths: list[PathSpec], sparse: bool) {
        self.fields = fields
        self.tags = tags
        self.paths = paths
        self.sparse = sparse
    }
}

def _entry_sparse(entry: dict[str, Any]) -> bool {
    if "sparse" not in entry {
        return False
    }
    const sp: Any = entry["sparse"]
    if not isinstance(sp, bool) {
        raise SchemaError("metadata entry `sparse` must be true or false")
    }
    const spb: bool = sp
    return spb
}

def _entry_paths(cs: CompiledSchema, raw: Any, sparse: bool) -> EntryFields {
    fields: list[str] = []
    tags: list[int] = []
    paths: list[PathSpec] = []
    texts: list[str] = []
    if isinstance(raw, str) {
        const nm: str = raw
        texts.append(nm)
    } else {
        if not isinstance(raw, list) {
            raise SchemaError("metadata entry must be a path, a list of paths, or an object with `path`")
        }
        const el: list[Any] = raw
        for item in el {
            if not isinstance(item, str) {
                raise SchemaError("a composite metadata entry must list paths as strings")
            }
            const nm2: str = item
            texts.append(nm2)
        }
    }
    arrays: int = 0
    for t in texts {
        ps: PathSpec = _parse_path(t)
        _resolve_path(cs, ps, sparse)
        if ps.array_at >= 0 {
            arrays = arrays + 1
        }
        fields.append(t)
        tags.append(ps.tag)
        paths.append(ps)
    }
    if arrays > 1 {
        raise SchemaError("metadata entry combines more than one array path; the key count would be the product of both element counts")
    }
    return EntryFields(fields, tags, paths, sparse)
}

def _entry_fields(cs: CompiledSchema, entry: Any) -> EntryFields {
    if isinstance(entry, dict) {
        const spec: dict[str, Any] = entry
        if "path" not in spec {
            raise SchemaError("an object metadata entry needs a `path` (spec section 7)")
        }
        return _entry_paths(cs, spec["path"], _entry_sparse(spec))
    }
    return _entry_paths(cs, entry, False)
}

def _add_entries(cs: CompiledSchema, cm: CompiledMeta, raw: Any, kind: int, unique: bool, prefix: str) -> None {
    if not isinstance(raw, list) {
        raise SchemaError("metadata `unique`/`index` must be a list")
    }
    entries: list[Any] = raw
    for entry in entries {
        ef: EntryFields = _entry_fields(cs, entry)
        name: str = _decl_name(prefix, ef.fields)
        if not cm.has(name) {
            cm.indexes.append(IndexDecl(name, kind, ef.fields, ef.tags, unique, ef.sparse).with_paths(ef.paths))
        }
    }
}

def compile_meta(cs: CompiledSchema, meta: dict[str, Any]) -> CompiledMeta {
    primary: list[str] = []
    if "primary" in meta {
        pv: Any = meta["primary"]
        if isinstance(pv, list) {
            pl: list[Any] = pv
            for item in pl {
                if not isinstance(item, str) {
                    raise SchemaError("`primary` field names must be strings")
                }
                const pn: str = item
                _req_field(cs, pn)
                primary.append(pn)
            }
        } else {
            if not isinstance(pv, str) {
                raise SchemaError("`primary` must be a field name or a list of names")
            }
            const pn2: str = pv
            _req_field(cs, pn2)
            primary.append(pn2)
        }
    }

    cm: CompiledMeta = CompiledMeta(primary)
    if len(primary) > 0 {
        ptags: list[int] = []
        for pf in primary {
            ptags.append(cs.by_name[pf].tag)
        }
        cm.indexes.append(IndexDecl("pk", IK_PK, primary, ptags, True, False))
    }
    if "unique" in meta {
        _add_entries(cs, cm, meta["unique"], IK_UNIQUE, True, "u:")
    }
    if "index" in meta {
        _add_entries(cs, cm, meta["index"], IK_INDEX, False, "i:")
    }
    if "refs" in meta {
        _add_refs(cs, cm, meta["refs"])
    }
    return cm
}

def _add_refs(cs: CompiledSchema, cm: CompiledMeta, raw: Any) -> None {
    if not isinstance(raw, dict) {
        raise SchemaError("metadata `refs` must be an object keyed by source field")
    }
    refs: dict[str, Any] = raw
    for src in refs {
        if src.find(".") >= 0 or src.find("[") >= 0 {
            raise SchemaError("ref '" + src + "' uses a nested or array path; odb indexes those paths but does not yet source a ref from one, because on_delete cascade/detach cannot rewrite a value inside an array (spec section 7). Use a top-level field.")
        }
        f: FieldSpec = _req_field(cs, src)
        spec_any: Any = refs[src]
        if not isinstance(spec_any, dict) {
            raise SchemaError("ref '" + src + "' must be an object with `to` and optional `on_delete`")
        }
        spec: dict[str, Any] = spec_any
        if "to" not in spec {
            raise SchemaError("ref '" + src + "' needs a `to` target")
        }
        to_any: Any = spec["to"]
        if not isinstance(to_any, str) {
            raise SchemaError("ref '" + src + "' `to` must be a \"schema.field\" string")
        }
        const to: str = to_any
        dot: int = to.find(".")
        if dot <= 0 or dot >= len(to) - 1 {
            raise SchemaError("ref '" + src + "' `to` must be \"schema.field\", got '" + to + "'")
        }
        tschema: str = to[0:dot]
        tfield: str = to[dot + 1:]

        od: str = "restrict"
        if "on_delete" in spec {
            od_any: Any = spec["on_delete"]
            if not isinstance(od_any, str) {
                raise SchemaError("ref '" + src + "' `on_delete` must be a string")
            }
            const ods: str = od_any
            od = ods
        }
        if od == "set_null" and not f.nullable {
            raise SchemaError("ref '" + src + "' on_delete=set_null needs a nullable field; declare it as \"type\": [\"" + type_name(f.tag) + "\", \"null\"]")
        }
        if od == "detach" and f.tag != T_ARRAY {
            raise SchemaError("ref '" + src + "' on_delete=detach applies to an array field; declare it as \"type\": \"array\"")
        }
        if od != "restrict" and od != "cascade" and od != "set_null" and od != "detach" {
            raise SchemaError("ref '" + src + "' has unknown on_delete '" + od + "'")
        }

        rev_name: str = "rev:" + src
        cm.refs.append(RefDecl(src, f.tag, tschema, tfield, od, rev_name))
        cm.indexes.append(IndexDecl(rev_name, IK_REVERSE, [src], [f.tag], False, False))
    }
}

def enc_field_value(tag: int, v: Any) -> bytes {
    return order_key(tag, v)
}


def _walk(doc: dict[str, Any], segments: list[str], start: int, stop: int) -> list[Any] {
    absent: list[Any] = []
    cur: Any = doc
    i: int = start
    while i < stop {
        if not isinstance(cur, dict) {
            return absent
        }
        const m: dict[str, Any] = cur
        if segments[i] not in m {
            return absent
        }
        cur = m[segments[i]]
        i = i + 1
    }
    found: list[Any] = [cur]
    return found
}

def path_values(ps: PathSpec, doc: dict[str, Any]) -> list[Any] {
    if ps.array_at < 0 {
        return _walk(doc, ps.segments, 0, len(ps.segments))
    }
    const arr_at: list[Any] = _walk(doc, ps.segments, 0, ps.array_at + 1)
    out: list[Any] = []
    if len(arr_at) == 0 or arr_at[0] is None {
        return out
    }
    const items: list[Any] = arr_at[0]
    for e in items {
        if ps.array_at + 1 == len(ps.segments) {
            out.append(e)
            continue
        }
        if not isinstance(e, dict) {
            continue
        }
        const em: dict[str, Any] = e
        const sub: list[Any] = _walk(em, ps.segments, ps.array_at + 1, len(ps.segments))
        if len(sub) == 1 {
            out.append(sub[0])
        }
    }
    return out
}

def enc_decl_key(decl: IndexDecl, doc: dict[str, Any]) -> bytes {
    parts: list[bytes] = []
    i: int = 0
    while i < len(decl.fields) {
        if i < len(decl.paths) {
            const vals: list[Any] = path_values(decl.paths[i], doc)
            if len(vals) == 0 {
                raise SchemaError("index '" + decl.name + "' needs path '" + decl.paths[i].text + "', which this document does not have")
            }
            parts.append(enc_field_value(decl.tags[i], vals[0]))
        } else {
            parts.append(enc_field_value(decl.tags[i], doc[decl.fields[i]]))
        }
        i = i + 1
    }
    return enc_composite(parts)
}

def elem_values(v: Any) -> list[Any] {
    if v is None {
        out0: list[Any] = []
        return out0
    }
    const items: list[Any] = v
    seen: list[bytes] = []
    out: list[Any] = []
    for e in items {
        const mark: bytes = enc_field_value(elem_tag_of(e), e)
        dup: bool = False
        for prev in seen {
            if prev == mark {
                dup = True
            }
        }
        if not dup {
            seen.append(mark)
            out.append(e)
        }
    }
    return out
}

def elem_tag_of(e: Any) -> int {
    if e is None {
        return T_NULL
    }
    if isinstance(e, bool) {
        return T_BOOL
    }
    if isinstance(e, int) {
        return T_INT
    }
    if isinstance(e, float) {
        return T_NUM
    }
    if isinstance(e, str) {
        return T_STR
    }
    raise SchemaError("only scalar array elements can be indexed")
}

def _dedupe(vals: list[Any], tag: int) -> list[Any] {
    seen: list[bytes] = []
    out: list[Any] = []
    for e in vals {
        const mark: bytes = enc_field_value(tag, e)
        dup: bool = False
        for prev in seen {
            if prev == mark {
                dup = True
            }
        }
        if not dup {
            seen.append(mark)
            out.append(e)
        }
    }
    return out
}

def enc_decl_keys(decl: IndexDecl, doc: dict[str, Any]) -> list[bytes] {
    keys: list[bytes] = []
    if len(decl.paths) != len(decl.fields) {
        keys.append(enc_decl_key(decl, doc))
        return keys
    }
    seed: list[bytes] = []
    prefixes: list[list[bytes]] = [seed]
    i: int = 0
    while i < len(decl.paths) {
        const ps: PathSpec = decl.paths[i]
        const tag: int = decl.tags[i]
        vals: list[Any] = path_values(ps, doc)
        if ps.array_at >= 0 {
            vals = _dedupe(vals, tag)
        } else if len(vals) == 0 {
            if not decl.sparse {
                raise SchemaError("index '" + decl.name + "' needs path '" + ps.text + "', which this document does not have")
            }
            const skipped: list[bytes] = []
            return skipped
        }
        grown: list[list[bytes]] = []
        for pre in prefixes {
            for e in vals {
                nxt: list[bytes] = []
                for b in pre {
                    nxt.append(b)
                }
                nxt.append(enc_field_value(tag, e))
                grown.append(nxt)
            }
        }
        prefixes = grown
        i = i + 1
    }
    for pre in prefixes {
        keys.append(enc_composite(pre))
    }
    return keys
}

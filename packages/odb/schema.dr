from odb.errors import SchemaError
from odb.temporal import parse_date, format_date, parse_datetime, format_datetime
from odb.decimal import check_decimal
from odb.keyenc import enc_bool, enc_int, enc_float, enc_str, enc_null
from odb.keyenc import enc_bytes, enc_date, enc_datetime, enc_decimal
from base64 import b64decode, b64encode
import re

const T_BOOL: int = 1
const T_INT: int = 2
const T_NUM: int = 3
const T_STR: int = 4
const T_BYTES: int = 5
const T_NULL: int = 6
const T_ARRAY: int = 7
const T_OBJECT: int = 8
const T_DATETIME: int = 9
const T_DATE: int = 10
const T_DECIMAL: int = 11

const MAX_DEPTH: int = 64
const EXTRAS_ID: int = 0xFFFF

_pattern_cache: dict[str, re.Pattern] = {}


def cached_pattern(src: str) -> re.Pattern {
    if src in _pattern_cache {
        return _pattern_cache[src]
    }
    p: re.Pattern = re.compile(src)
    _pattern_cache[src] = p
    return p
}


def slot_size(tag: int) -> int {
    if tag == T_BOOL {
        return 1
    }
    if tag == T_DATE {
        return 4
    }
    return 8
}


def is_composite(tag: int) -> bool {
    return tag == T_ARRAY or tag == T_OBJECT
}


def is_varlen(tag: int) -> bool {
    return tag == T_STR or tag == T_BYTES or tag == T_DECIMAL
}


def type_name(tag: int) -> str {
    if tag == T_BOOL {
        return "boolean"
    }
    if tag == T_INT {
        return "integer"
    }
    if tag == T_NUM {
        return "number"
    }
    if tag == T_STR {
        return "string"
    }
    if tag == T_NULL {
        return "null"
    }
    if tag == T_ARRAY {
        return "array"
    }
    if tag == T_OBJECT {
        return "object"
    }
    if tag == T_DATETIME {
        return "string with format date-time"
    }
    if tag == T_DATE {
        return "string with format date"
    }
    if tag == T_DECIMAL {
        return "string with format decimal"
    }
    return "string with format bytes"
}


def format_name(tag: int) -> str {
    if tag == T_BYTES {
        return "bytes"
    }
    if tag == T_DATETIME {
        return "date-time"
    }
    if tag == T_DATE {
        return "date"
    }
    if tag == T_DECIMAL {
        return "decimal"
    }
    return ""
}


def _num(v: Any) -> float {
    if isinstance(v, int) {
        const i: int = v
        return float(i)
    }
    const f: float = v
    return f
}


def _value_tag(v: Any) -> int {
    if v is None {
        return T_NULL
    }
    if isinstance(v, bool) {
        return T_BOOL
    }
    if isinstance(v, int) {
        return T_INT
    }
    if isinstance(v, float) {
        return T_NUM
    }
    if isinstance(v, str) {
        return T_STR
    }
    if isinstance(v, list) {
        return T_ARRAY
    }
    if isinstance(v, dict) {
        return T_OBJECT
    }
    return -1
}


def json_eq(a: Any, b: Any) -> bool {
    const ta: int = _value_tag(a)
    const tb: int = _value_tag(b)
    if ta == T_NULL or tb == T_NULL {
        return ta == tb
    }
    if ta == T_BOOL or tb == T_BOOL {
        if ta != tb {
            return False
        }
        const ba: bool = a
        const bb: bool = b
        return ba == bb
    }
    if (ta == T_INT or ta == T_NUM) and (tb == T_INT or tb == T_NUM) {
        return _num(a) == _num(b)
    }
    if ta != tb {
        return False
    }
    if ta == T_STR {
        const sa: str = a
        const sb: str = b
        return sa == sb
    }
    if ta == T_ARRAY {
        const la: list[Any] = a
        const lb: list[Any] = b
        if len(la) != len(lb) {
            return False
        }
        i: int = 0
        while i < len(la) {
            if not json_eq(la[i], lb[i]) {
                return False
            }
            i = i + 1
        }
        return True
    }
    const ma: dict[str, Any] = a
    const mb: dict[str, Any] = b
    for k in ma {
        if k not in mb {
            return False
        }
        if not json_eq(ma[k], mb[k]) {
            return False
        }
    }
    for k2 in mb {
        if k2 not in ma {
            return False
        }
    }
    return True
}


def show_value(v: Any) -> str {
    const t: int = _value_tag(v)
    if t == T_NULL {
        return "null"
    }
    if t == T_BOOL {
        const b: bool = v
        return "true" if b else "false"
    }
    if t == T_STR {
        const s: str = v
        return "'" + s + "'"
    }
    if t == T_INT {
        const i: int = v
        return str(i)
    }
    if t == T_NUM {
        const f: float = v
        return str(f)
    }
    if t == T_ARRAY {
        return "an array"
    }
    return "an object"
}


class FieldSpec {
    name: str
    field_id: int
    tag: int
    required: bool
    slot_off: int
    has_min: bool
    min_v: float
    has_max: bool
    max_v: float
    has_minlen: bool
    minlen: int
    has_maxlen: bool
    maxlen: int
    nullable: bool
    has_item_tag: bool
    item_tag: int
    null_index: int
    has_exmin: bool
    exmin_v: float
    has_exmax: bool
    exmax_v: float
    has_pattern: bool
    pattern_src: str
    has_enum: bool
    enum_vals: list[Any]
    has_const: bool
    const_val: list[Any]
    has_minitems: bool
    minitems: int
    has_maxitems: bool
    maxitems: int
    has_default: bool
    default_val: list[Any]
    nested: list[CompiledSchema]
    item_nested: list[CompiledSchema]
    has_union: bool
    union_key: str
    branches: list[CompiledSchema]
    branch_values: list[Any]

    def(name: str, field_id: int, tag: int, required: bool, slot_off: int) {
        self.name = name
        self.field_id = field_id
        self.tag = tag
        self.required = required
        self.slot_off = slot_off
        self.has_min = False
        self.min_v = 0.0
        self.has_max = False
        self.max_v = 0.0
        self.has_minlen = False
        self.minlen = 0
        self.has_maxlen = False
        self.maxlen = 0
        self.nullable = False
        self.has_item_tag = False
        self.item_tag = 0
        self.null_index = -1
        self.has_exmin = False
        self.exmin_v = 0.0
        self.has_exmax = False
        self.exmax_v = 0.0
        self.has_pattern = False
        self.pattern_src = ""
        self.has_enum = False
        self.enum_vals = []
        self.has_const = False
        self.const_val = []
        self.has_minitems = False
        self.minitems = 0
        self.has_maxitems = False
        self.maxitems = 0
        self.has_default = False
        self.default_val = []
        self.nested = []
        self.item_nested = []
        self.has_union = False
        self.union_key = ""
        self.branches = []
        self.branch_values = []
    }
}


class CompiledSchema {
    name: str
    schema_id: int
    version: int
    required: list[FieldSpec]
    optional: list[FieldSpec]
    by_name: dict[str, FieldSpec]
    by_id: dict[int, FieldSpec]
    req_region_size: int
    schema_json: str
    additional: bool
    null_bitmap_size: int
    has_defaults: bool
    symbols: dict[str, int]
    prior: dict[int, CompiledSchema]

    def(name: str, schema_id: int, version: int) {
        self.name = name
        self.schema_id = schema_id
        self.version = version
        self.required = []
        self.optional = []
        self.by_name = {}
        self.by_id = {}
        self.req_region_size = 0
        self.schema_json = ""
        self.additional = True
        self.null_bitmap_size = 0
        self.has_defaults = False
        self.symbols = {}
        self.prior = {}
    }

    def field(fname: str) -> FieldSpec {
        if fname in self.by_name {
            return self.by_name[fname]
        }
        raise SchemaError("no such field: " + fname)
    }
}


def _tag_for_type(ty: str) -> int {
    if ty == "boolean" {
        return T_BOOL
    }
    if ty == "integer" {
        return T_INT
    }
    if ty == "number" {
        return T_NUM
    }
    if ty == "string" {
        return T_STR
    }
    if ty == "null" {
        return T_NULL
    }
    if ty == "array" {
        return T_ARRAY
    }
    if ty == "object" {
        return T_OBJECT
    }
    raise SchemaError("unsupported type '" + ty + "'")
}


def _tag_for_format(where: str, fmt: str) -> int {
    if fmt == "bytes" {
        return T_BYTES
    }
    if fmt == "date-time" {
        return T_DATETIME
    }
    if fmt == "date" {
        return T_DATE
    }
    if fmt == "decimal" {
        return T_DECIMAL
    }
    raise SchemaError(where + ": format '" + fmt + "' is not supported; odb implements bytes, date-time, date and decimal (spec section 4)")
}


def _resolve_type(where: str, ty_any: Any) -> tuple[int, bool] {
    if isinstance(ty_any, str) {
        const single: str = ty_any
        const tag: int = _tag_for_type(single)
        return (tag, tag == T_NULL)
    }
    if not isinstance(ty_any, list) {
        raise SchemaError(where + ": type must be a string or a list of strings")
    }
    const parts: list[Any] = ty_any
    nullable: bool = False
    chosen: int = -1
    for p in parts {
        if not isinstance(p, str) {
            raise SchemaError(where + ": every entry in a type list must be a string")
        }
        const ps: str = p
        const t: int = _tag_for_type(ps)
        if t == T_NULL {
            nullable = True
        } else if chosen >= 0 {
            raise SchemaError(where + ": a type list may pair exactly one type with \"null\"")
        } else {
            chosen = t
        }
    }
    if chosen < 0 {
        return (T_NULL, True)
    }
    return (chosen, nullable)
}


def _resolve_field_type(where: str, sub: dict[str, Any]) -> tuple[int, bool] {
    const base: tuple[int, bool] = _resolve_type(where, sub["type"])
    tag: int = base[0]
    if "format" not in sub {
        return (tag, base[1])
    }
    f_any: Any = sub["format"]
    if not isinstance(f_any, str) {
        raise SchemaError(where + ": format must be a string")
    }
    const fmt: str = f_any
    if tag != T_STR {
        raise SchemaError(where + ": format '" + fmt + "' applies to \"type\": \"string\", not " + type_name(tag))
    }
    return (_tag_for_format(where, fmt), base[1])
}


def _annotation(k: str) -> bool {
    return k == "title" or k == "description" or k == "$comment" or k == "examples" or k == "deprecated" or k == "readOnly" or k == "writeOnly" or k == "$schema" or k == "$id"
}


def _rejected_reason(k: str) -> str {
    if k == "patternProperties" {
        return "a physical layout cannot be derived from a key pattern"
    }
    if k == "if" or k == "then" or k == "else" or k == "dependentSchemas" {
        return "a conditional schema leaves the physical shape ambiguous"
    }
    if k == "not" {
        return "a negated schema has no layout"
    }
    if k == "unevaluatedProperties" {
        return "it depends on annotations collected across sibling subschemas, which a compiled layout does not carry"
    }
    if k == "anyOf" or k == "allOf" {
        return "an undiscriminated union has no single physical shape; use oneOf with a discriminator"
    }
    if k == "prefixItems" {
        return "tuple arrays are deferred (spec section 4)"
    }
    return ""
}


def _prop_keyword_ok(k: str) -> bool {
    if k == "type" or k == "format" or k == "items" or k == "enum" or k == "const" or k == "default" {
        return True
    }
    if k == "minimum" or k == "maximum" or k == "exclusiveMinimum" or k == "exclusiveMaximum" {
        return True
    }
    if k == "minLength" or k == "maxLength" or k == "pattern" {
        return True
    }
    if k == "minItems" or k == "maxItems" {
        return True
    }
    return k == "properties" or k == "required" or k == "additionalProperties" or k == "oneOf"
}


def _root_keyword_ok(k: str) -> bool {
    return k == "type" or k == "properties" or k == "required" or k == "additionalProperties" or k == "$defs"
}


def _check_keywords(where: str, sub: dict[str, Any], root: bool) -> None {
    for k in sub {
        if _annotation(k) {
            continue
        }
        ok: bool = _prop_keyword_ok(k)
        if root {
            ok = _root_keyword_ok(k)
        }
        if ok {
            continue
        }
        const why: str = _rejected_reason(k)
        if len(why) > 0 {
            raise SchemaError(where + ": keyword '" + k + "' is rejected because " + why + " (spec section 4)")
        }
        raise SchemaError(where + ": keyword '" + k + "' is not implemented by odb; spec section 4 lists the supported subset, and accepting it silently would mean the constraint is never enforced")
    }
}


def _defs_of(schema: dict[str, Any]) -> dict[str, Any] {
    empty: dict[str, Any] = {}
    if "$defs" not in schema {
        return empty
    }
    d_any: Any = schema["$defs"]
    if not isinstance(d_any, dict) {
        raise SchemaError("$defs must be an object mapping names to schemas")
    }
    const d: dict[str, Any] = d_any
    return d
}


def _ref_target(where: str, r_any: Any) -> str {
    if not isinstance(r_any, str) {
        raise SchemaError(where + ": $ref must be a string")
    }
    const target: str = r_any
    if not target.startswith("#/$defs/") {
        raise SchemaError(where + ": $ref '" + target + "' must be an intra-file reference of the form '#/$defs/<name>'; cross-file references are rejected because a relationship belongs in metadata, not in a shape (spec section 4)")
    }
    const nm: str = target[8:]
    if len(nm) == 0 {
        raise SchemaError(where + ": $ref '" + target + "' names no entry in $defs")
    }
    return nm
}


def _expand(where: str, sub: dict[str, Any], defs: dict[str, Any], chain: list[str]) -> dict[str, Any] {
    out: dict[str, Any] = {}
    if "$ref" in sub {
        const nm: str = _ref_target(where, sub["$ref"])
        for seen in chain {
            if seen == nm {
                raise SchemaError(where + ": $ref cycle through '#/$defs/" + nm + "'; $defs is shape reuse by embedding, so it cannot be recursive")
            }
        }
        if nm not in defs {
            raise SchemaError(where + ": $ref '#/$defs/" + nm + "' names no entry in $defs")
        }
        base_any: Any = defs[nm]
        if not isinstance(base_any, dict) {
            raise SchemaError("$defs entry '" + nm + "' must be a schema object")
        }
        const base: dict[str, Any] = base_any
        nchain: list[str] = []
        for c in chain {
            nchain.append(c)
        }
        nchain.append(nm)
        const expanded: dict[str, Any] = _expand(where, base, defs, nchain)
        for ek in expanded {
            out[ek] = expanded[ek]
        }
    }
    for k in sub {
        if k == "$ref" {
            continue
        }
        out[k] = sub[k]
    }

    if "properties" in out {
        p_any: Any = out["properties"]
        if isinstance(p_any, dict) {
            const p: dict[str, Any] = p_any
            np: dict[str, Any] = {}
            for pk in p {
                ps_any: Any = p[pk]
                if isinstance(ps_any, dict) {
                    const ps: dict[str, Any] = ps_any
                    const sub_out: dict[str, Any] = _expand(where + "." + pk, ps, defs, chain)
                    const sub_any2: Any = sub_out
                    np[pk] = sub_any2
                } else {
                    np[pk] = p[pk]
                }
            }
            const np_any: Any = np
            out["properties"] = np_any
        }
    }
    if "items" in out {
        i_any: Any = out["items"]
        if isinstance(i_any, dict) {
            const isub: dict[str, Any] = i_any
            const iout: dict[str, Any] = _expand(where + "[]", isub, defs, chain)
            const iout_any: Any = iout
            out["items"] = iout_any
        }
    }
    return out
}


def _int_keyword(where: str, sub: dict[str, Any], key: str) -> int {
    v: Any = sub[key]
    if isinstance(v, bool) or not isinstance(v, int) {
        raise SchemaError(where + ": " + key + " must be an integer")
    }
    const i: int = v
    if i < 0 {
        raise SchemaError(where + ": " + key + " must not be negative")
    }
    return i
}


def _num_keyword(where: str, sub: dict[str, Any], key: str) -> float {
    v: Any = sub[key]
    if isinstance(v, bool) {
        raise SchemaError(where + ": " + key + " must be a number; the boolean form of " + key + " is JSON Schema draft 4 and is not supported")
    }
    if not isinstance(v, int) and not isinstance(v, float) {
        raise SchemaError(where + ": " + key + " must be a number")
    }
    return _num(v)
}


def _branch_const(where: str, branch: dict[str, Any], key: str) -> list[Any] {
    absent: list[Any] = []
    if "properties" not in branch {
        return absent
    }
    const props_any: Any = branch["properties"]
    if not isinstance(props_any, dict) {
        return absent
    }
    const props: dict[str, Any] = props_any
    if key not in props {
        return absent
    }
    const spec_any: Any = props[key]
    if not isinstance(spec_any, dict) {
        return absent
    }
    const spec: dict[str, Any] = spec_any
    if "const" not in spec {
        return absent
    }
    found: list[Any] = [spec["const"]]
    return found
}


def _discriminator(where: str, branches: list[dict[str, Any]]) -> str {
    const first: dict[str, Any] = branches[0]
    if "properties" not in first {
        raise SchemaError(where + ": every oneOf branch must be an object schema with properties (spec section 4)")
    }
    const p_any: Any = first["properties"]
    if not isinstance(p_any, dict) {
        raise SchemaError(where + ": every oneOf branch must be an object schema with properties (spec section 4)")
    }
    const props: dict[str, Any] = p_any

    candidates: list[str] = []
    for key in props {
        pinned: bool = True
        seen: list[Any] = []
        for b in branches {
            const c: list[Any] = _branch_const(where, b, key)
            if len(c) == 0 {
                pinned = False
            } else {
                for prev in seen {
                    if json_eq(prev, c[0]) {
                        pinned = False
                    }
                }
                seen.append(c[0])
            }
        }
        if pinned {
            candidates.append(key)
        }
    }

    if len(candidates) == 0 {
        raise SchemaError(where + ": oneOf is undiscriminated; every branch must pin one shared field to a distinct const, so a document's shape can be read off that tag (spec section 4)")
    }
    if len(candidates) > 1 {
        raise SchemaError(where + ": oneOf has more than one field that could be the discriminator (" + ", ".join(candidates) + "); pin exactly one so the branch is unambiguous")
    }
    return candidates[0]
}


def _compile_union(where: str, sub: dict[str, Any], fs: FieldSpec) -> None {
    const raw: Any = sub["oneOf"]
    if not isinstance(raw, list) {
        raise SchemaError(where + ": oneOf must be an array of branch schemas")
    }
    const entries: list[Any] = raw
    if len(entries) < 2 {
        raise SchemaError(where + ": oneOf needs at least two branches")
    }
    branches: list[dict[str, Any]] = []
    for e in entries {
        if not isinstance(e, dict) {
            raise SchemaError(where + ": every oneOf branch must be a schema object")
        }
        const b: dict[str, Any] = e
        branches.append(b)
    }

    fs.union_key = _discriminator(where, branches)
    fs.has_union = True
    i: int = 0
    while i < len(branches) {
        const label: str = where + " oneOf branch " + str(i)
        const compiled: CompiledSchema = _compile_object(label, branches[i])
        if fs.union_key not in compiled.by_name {
            raise SchemaError(label + " does not declare the discriminator '" + fs.union_key + "'")
        }
        const tagspec: FieldSpec = compiled.by_name[fs.union_key]
        if not tagspec.required {
            raise SchemaError(label + " must mark the discriminator '" + fs.union_key + "' required, or a document could arrive with no branch tag")
        }
        fs.branches.append(compiled)
        fs.branch_values.append(tagspec.const_val[0])
        i = i + 1
    }
}


def _compile_field(where: str, nm: str, sub: dict[str, Any], fid: int, is_req: bool, slot: int) -> FieldSpec {
    _check_keywords(where, sub, False)
    if "oneOf" in sub {
        if "type" in sub {
            const declared: tuple[int, bool] = _resolve_field_type(where, sub)
            if declared[0] != T_OBJECT {
                raise SchemaError(where + ": a oneOf field is an object union; \"type\" may only be \"object\" here, not " + type_name(declared[0]))
            }
        }
        if "properties" in sub {
            raise SchemaError(where + ": a oneOf field takes its shape from its branches, so it cannot also declare properties")
        }
        u: FieldSpec = FieldSpec(nm, fid, T_OBJECT, is_req, slot)
        _compile_union(where, sub, u)
        return u
    }
    if "type" not in sub {
        raise SchemaError(where + " has no type")
    }
    const resolved: tuple[int, bool] = _resolve_field_type(where, sub)
    const tag: int = resolved[0]
    fs: FieldSpec = FieldSpec(nm, fid, tag, is_req, slot)
    fs.nullable = resolved[1]

    if tag == T_ARRAY and "items" in sub {
        items_any: Any = sub["items"]
        if not isinstance(items_any, dict) {
            raise SchemaError(where + ": items must be a schema object")
        }
        const items: dict[str, Any] = items_any
        _check_keywords(where + "[]", items, False)
        if "type" in items {
            const it: tuple[int, bool] = _resolve_field_type(where + "[]", items)
            fs.has_item_tag = True
            fs.item_tag = it[0]
            if it[0] == T_OBJECT and "properties" in items {
                fs.item_nested.append(_compile_object(where + "[]", items))
            }
        }
    }
    if tag != T_ARRAY and "items" in sub {
        raise SchemaError(where + ": items applies to \"type\": \"array\", not " + type_name(tag))
    }
    if tag == T_OBJECT and "properties" in sub {
        fs.nested.append(_compile_object(where, sub))
    }
    if tag != T_OBJECT and "properties" in sub {
        raise SchemaError(where + ": properties applies to \"type\": \"object\", not " + type_name(tag))
    }

    if "minimum" in sub {
        fs.has_min = True
        fs.min_v = _num_keyword(where, sub, "minimum")
    }
    if "maximum" in sub {
        fs.has_max = True
        fs.max_v = _num_keyword(where, sub, "maximum")
    }
    if "exclusiveMinimum" in sub {
        fs.has_exmin = True
        fs.exmin_v = _num_keyword(where, sub, "exclusiveMinimum")
    }
    if "exclusiveMaximum" in sub {
        fs.has_exmax = True
        fs.exmax_v = _num_keyword(where, sub, "exclusiveMaximum")
    }
    if fs.has_min or fs.has_max or fs.has_exmin or fs.has_exmax {
        if tag != T_INT and tag != T_NUM {
            raise SchemaError(where + ": numeric bounds apply to \"integer\" or \"number\", not " + type_name(tag))
        }
    }
    if "minLength" in sub {
        fs.has_minlen = True
        fs.minlen = _int_keyword(where, sub, "minLength")
    }
    if "maxLength" in sub {
        fs.has_maxlen = True
        fs.maxlen = _int_keyword(where, sub, "maxLength")
    }
    if fs.has_minlen or fs.has_maxlen {
        if tag != T_STR {
            raise SchemaError(where + ": minLength and maxLength apply to \"string\", not " + type_name(tag))
        }
    }
    if "pattern" in sub {
        if tag != T_STR {
            raise SchemaError(where + ": pattern applies to \"string\", not " + type_name(tag))
        }
        p_any: Any = sub["pattern"]
        if not isinstance(p_any, str) {
            raise SchemaError(where + ": pattern must be a string")
        }
        const psrc: str = p_any
        try {
            cached_pattern(psrc)
        } except Exception as e {
            raise SchemaError(where + ": pattern '" + psrc + "' is not a valid regular expression: " + str(e))
        }
        fs.has_pattern = True
        fs.pattern_src = psrc
    }
    if "minItems" in sub {
        fs.has_minitems = True
        fs.minitems = _int_keyword(where, sub, "minItems")
    }
    if "maxItems" in sub {
        fs.has_maxitems = True
        fs.maxitems = _int_keyword(where, sub, "maxItems")
    }
    if fs.has_minitems or fs.has_maxitems {
        if tag != T_ARRAY {
            raise SchemaError(where + ": minItems and maxItems apply to \"array\", not " + type_name(tag))
        }
    }
    if fs.has_minlen and fs.has_maxlen and fs.minlen > fs.maxlen {
        raise SchemaError(where + ": minLength " + str(fs.minlen) + " exceeds maxLength " + str(fs.maxlen))
    }
    if fs.has_minitems and fs.has_maxitems and fs.minitems > fs.maxitems {
        raise SchemaError(where + ": minItems " + str(fs.minitems) + " exceeds maxItems " + str(fs.maxitems))
    }

    if "enum" in sub {
        e_any: Any = sub["enum"]
        if not isinstance(e_any, list) {
            raise SchemaError(where + ": enum must be an array")
        }
        const el: list[Any] = e_any
        if len(el) == 0 {
            raise SchemaError(where + ": enum must list at least one value")
        }
        for ev in el {
            fs.enum_vals.append(ev)
        }
        fs.has_enum = True
    }
    if "const" in sub {
        fs.has_const = True
        fs.const_val.append(sub["const"])
    }
    if "default" in sub {
        fs.has_default = True
        fs.default_val.append(sub["default"])
    }

    if fs.has_enum {
        i: int = 0
        while i < len(fs.enum_vals) {
            _check_value(fs, fs.enum_vals[i], where + ": enum entry " + str(i), False)
            i = i + 1
        }
    }
    if fs.has_const {
        _check_value(fs, fs.const_val[0], where + ": const", False)
    }
    if fs.has_default {
        _check_value(fs, fs.default_val[0], where + ": default", False)
    }
    return fs
}


def _compile_object(where: str, schema: dict[str, Any]) -> CompiledSchema {
    fresh: dict[str, int] = {}
    return _compile_layout(where, where, schema, 0, 0, fresh)
}


def _next_symbol(symbols: dict[str, int]) -> int {
    top: int = -1
    for k in symbols {
        if symbols[k] > top {
            top = symbols[k]
        }
    }
    return top + 1
}


def _compile_layout(where: str, name: str, schema: dict[str, Any], schema_id: int, version: int, symbols: dict[str, int]) -> CompiledSchema {
    cs: CompiledSchema = CompiledSchema(name, schema_id, version)
    for sk in symbols {
        cs.symbols[sk] = symbols[sk]
    }

    if "properties" not in schema {
        raise SchemaError("schema '" + name + "' has no properties")
    }
    props_any: Any = schema["properties"]
    if not isinstance(props_any, dict) {
        raise SchemaError(where + ": properties must be an object")
    }
    const props: dict[str, Any] = props_any

    req_set: dict[str, bool] = {}
    if "required" in schema {
        ra: Any = schema["required"]
        if not isinstance(ra, list) {
            raise SchemaError(where + ": required must be an array of field names")
        }
        const rl: list[Any] = ra
        for item in rl {
            if not isinstance(item, str) {
                raise SchemaError(where + ": required must list field names as strings")
            }
            const rn: str = item
            if rn not in props {
                raise SchemaError(where + ": required names '" + rn + "', which is not in properties")
            }
            req_set[rn] = True
        }
    }

    names: list[str] = []
    for k in props {
        names.append(k)
    }
    names.sort()

    off: int = 0
    for nm in names {
        sub_any: Any = props[nm]
        if not isinstance(sub_any, dict) {
            raise SchemaError(where + "." + nm + " must be a schema object")
        }
        const sub: dict[str, Any] = sub_any
        const is_req: bool = nm in req_set

        probe: tuple[int, bool] = _resolve_field_type(where + "." + nm, sub) if "type" in sub else (T_NULL, True)
        slot: int = -1
        if is_req {
            slot = off
            off = off + slot_size(probe[0])
        }
        fid: int = 0
        if nm in cs.symbols {
            fid = cs.symbols[nm]
        } else {
            fid = _next_symbol(cs.symbols)
            cs.symbols[nm] = fid
        }
        if fid >= EXTRAS_ID {
            raise SchemaError(where + ": schema '" + name + "' has run out of field ids; " + str(EXTRAS_ID) + " is reserved for the extras entry")
        }
        fs: FieldSpec = _compile_field(where + "." + nm, nm, sub, fid, is_req, slot)
        if fs.has_default {
            cs.has_defaults = True
        }

        cs.by_name[nm] = fs
        cs.by_id[fid] = fs
        if is_req {
            cs.required.append(fs)
        } else {
            cs.optional.append(fs)
        }
    }
    cs.req_region_size = off

    if "additionalProperties" in schema {
        ap: Any = schema["additionalProperties"]
        if not isinstance(ap, bool) {
            raise SchemaError(where + ": additionalProperties must be true or false")
        }
        const apb: bool = ap
        cs.additional = apb
    }

    nulls: int = 0
    for f in cs.required {
        if f.nullable or f.tag == T_NULL {
            f.null_index = nulls
            nulls = nulls + 1
        }
    }
    cs.null_bitmap_size = (nulls + 7) // 8
    return cs
}


def compile_schema_with_symbols(name: str, schema: dict[str, Any], schema_id: int, version: int, schema_json: str, symbols: dict[str, int]) -> CompiledSchema {
    _check_keywords("schema '" + name + "'", schema, True)
    const defs: dict[str, Any] = _defs_of(schema)
    seed: list[str] = []
    const expanded: dict[str, Any] = _expand("schema '" + name + "'", schema, defs, seed)
    cs: CompiledSchema = _compile_layout("schema '" + name + "'", name, expanded, schema_id, version, symbols)
    cs.schema_json = schema_json
    return cs
}


def compile_schema(name: str, schema: dict[str, Any], schema_id: int, version: int, schema_json: str) -> CompiledSchema {
    fresh: dict[str, int] = {}
    return compile_schema_with_symbols(name, schema, schema_id, version, schema_json, fresh)
}


def _tag_accepts(field_tag: int, vt: int) -> bool {
    if field_tag == T_NUM {
        return vt == T_NUM or vt == T_INT
    }
    if field_tag == T_BYTES or field_tag == T_DATETIME or field_tag == T_DATE or field_tag == T_DECIMAL {
        return vt == T_STR
    }
    return field_tag == vt
}


def _type_ok(field_tag: int, v: Any) -> bool {
    return _tag_accepts(field_tag, _value_tag(v))
}


def decode_b64(where: str, s: str) -> bytes {
    try {
        return b64decode(s.encode())
    } except Exception {
        raise SchemaError(where + " is declared format bytes, so it must hold base64 text; '" + s + "' is not valid base64")
    }
}


def encode_b64(raw: bytes) -> str {
    return b64encode(raw).decode()
}


def order_key(tag: int, v: Any) -> bytes {
    if v is None {
        return enc_null()
    }
    if tag == T_BOOL {
        const b: bool = v
        return enc_bool(b)
    }
    if tag == T_INT {
        const i: int = v
        return enc_int(i)
    }
    if tag == T_NUM {
        if isinstance(v, int) {
            const iv: int = v
            return enc_float(float(iv))
        }
        const f: float = v
        return enc_float(f)
    }
    if tag == T_STR {
        const s: str = v
        return enc_str(s)
    }
    if tag == T_DATE {
        const ds: str = v
        return enc_date(parse_date(ds))
    }
    if tag == T_DATETIME {
        const ts: str = v
        return enc_datetime(parse_datetime(ts))
    }
    if tag == T_DECIMAL {
        if isinstance(v, bool) {
            raise SchemaError("a boolean cannot be compared against a decimal field")
        }
        if isinstance(v, int) {
            const di: int = v
            return enc_decimal(str(di))
        }
        if isinstance(v, float) {
            const df: float = v
            return enc_decimal(str(df))
        }
        const ms: str = v
        return enc_decimal(ms)
    }
    if tag == T_BYTES {
        const bs: str = v
        return enc_bytes(decode_b64("a format bytes value", bs))
    }
    raise SchemaError("a field of type " + type_name(tag) + " is not ordered on its own; use a scalar path instead")
}


def is_formatted(tag: int) -> bool {
    return tag == T_DATE or tag == T_DATETIME or tag == T_DECIMAL or tag == T_BYTES
}


def cmp_keys(a: bytes, op: str, b: bytes) -> bool {
    i: int = 0
    c: int = 0
    while i < len(a) and i < len(b) {
        if a[i] != b[i] {
            c = -1 if a[i] < b[i] else 1
            i = len(a) + len(b)
        } else {
            i = i + 1
        }
    }
    if c == 0 {
        if len(a) < len(b) {
            c = -1
        } else if len(a) > len(b) {
            c = 1
        }
    }
    if op == "==" {
        return c == 0
    }
    if op == "!=" {
        return c != 0
    }
    if op == "<" {
        return c < 0
    }
    if op == "<=" {
        return c <= 0
    }
    if op == ">" {
        return c > 0
    }
    return c >= 0
}


def check_depth(v: Any, depth: int) -> None {
    if depth > MAX_DEPTH {
        raise SchemaError("document nests deeper than the " + str(MAX_DEPTH) + " level limit")
    }
    if isinstance(v, list) {
        const items: list[Any] = v
        for e in items {
            check_depth(e, depth + 1)
        }
        return
    }
    if isinstance(v, dict) {
        const m: dict[str, Any] = v
        for k in m {
            check_depth(m[k], depth + 1)
        }
    }
}


def _check_format(where: str, tag: int, s: str) -> None {
    if tag == T_DATETIME {
        parse_datetime(s)
        return
    }
    if tag == T_DATE {
        parse_date(s)
        return
    }
    if tag == T_DECIMAL {
        check_decimal(s)
        return
    }
    if tag == T_BYTES {
        decode_b64(where, s)
    }
}


def _check_value(f: FieldSpec, v: Any, where: str, deep: bool) -> None {
    const vt: int = _value_tag(v)
    if vt == T_NULL {
        if f.tag == T_NULL {
            return
        }
        if not f.nullable {
            raise SchemaError(where + " is not nullable; declare it as \"type\": [\"" + type_name(f.tag) + "\", \"null\"] to store null")
        }
        return
    }
    if not _tag_accepts(f.tag, vt) {
        raise SchemaError(where + " expects " + type_name(f.tag) + ", got " + type_name(vt))
    }
    check_depth(v, 1)

    if f.has_const and not json_eq(v, f.const_val[0]) {
        raise SchemaError(where + " is const " + show_value(f.const_val[0]) + ", got " + show_value(v))
    }
    if f.has_enum {
        hit: bool = False
        for ev in f.enum_vals {
            if json_eq(v, ev) {
                hit = True
            }
        }
        if not hit {
            allowed: list[str] = []
            for ev2 in f.enum_vals {
                allowed.append(show_value(ev2))
            }
            raise SchemaError(where + " must be one of " + ", ".join(allowed) + "; got " + show_value(v))
        }
    }

    if f.tag == T_NUM or f.tag == T_INT {
        const x: float = _num(v)
        if f.has_min and x < f.min_v {
            raise SchemaError(where + " is below the minimum of " + str(f.min_v))
        }
        if f.has_max and x > f.max_v {
            raise SchemaError(where + " is above the maximum of " + str(f.max_v))
        }
        if f.has_exmin and x <= f.exmin_v {
            raise SchemaError(where + " must be greater than " + str(f.exmin_v))
        }
        if f.has_exmax and x >= f.exmax_v {
            raise SchemaError(where + " must be less than " + str(f.exmax_v))
        }
    }

    if f.tag == T_STR {
        const s: str = v
        const L: int = len(s)
        if f.has_minlen and L < f.minlen {
            raise SchemaError(where + " is shorter than the minLength of " + str(f.minlen))
        }
        if f.has_maxlen and L > f.maxlen {
            raise SchemaError(where + " is longer than the maxLength of " + str(f.maxlen))
        }
        if f.has_pattern and not cached_pattern(f.pattern_src).match(s) {
            raise SchemaError(where + " does not match the pattern '" + f.pattern_src + "'")
        }
    }

    if f.tag == T_BYTES or f.tag == T_DATETIME or f.tag == T_DATE or f.tag == T_DECIMAL {
        const fs2: str = v
        _check_format(where, f.tag, fs2)
    }

    if f.tag == T_ARRAY {
        const arr: list[Any] = v
        if f.has_minitems and len(arr) < f.minitems {
            raise SchemaError(where + " has " + str(len(arr)) + " items, fewer than the minItems of " + str(f.minitems))
        }
        if f.has_maxitems and len(arr) > f.maxitems {
            raise SchemaError(where + " has " + str(len(arr)) + " items, more than the maxItems of " + str(f.maxitems))
        }
        if f.has_item_tag {
            j: int = 0
            while j < len(arr) {
                const evt: int = _value_tag(arr[j])
                if evt == T_NULL {
                    raise SchemaError(where + " element " + str(j) + " is null; declare the element type as a list with \"null\" to allow it")
                }
                if not _tag_accepts(f.item_tag, evt) {
                    raise SchemaError(where + " element " + str(j) + " expects " + type_name(f.item_tag) + ", got " + type_name(evt))
                }
                if f.item_tag == T_BYTES or f.item_tag == T_DATETIME or f.item_tag == T_DATE or f.item_tag == T_DECIMAL {
                    const es: str = arr[j]
                    _check_format(where + " element " + str(j), f.item_tag, es)
                }
                if len(f.item_nested) == 1 {
                    const eobj: dict[str, Any] = arr[j]
                    validate_doc_at(f.item_nested[0], eobj, where + " element " + str(j))
                }
                j = j + 1
            }
        }
    }

    if f.has_union and deep {
        const um: dict[str, Any] = v
        if f.union_key not in um {
            raise SchemaError(where + " is a union tagged by '" + f.union_key + "', which this value does not have")
        }
        picked: int = -1
        i: int = 0
        while i < len(f.branch_values) {
            if json_eq(um[f.union_key], f.branch_values[i]) {
                picked = i
            }
            i = i + 1
        }
        if picked < 0 {
            allowed: list[str] = []
            for bv in f.branch_values {
                allowed.append(show_value(bv))
            }
            raise SchemaError(where + " has '" + f.union_key + "' = " + show_value(um[f.union_key]) + ", which matches no branch; expected one of " + ", ".join(allowed))
        }
        validate_doc_at(f.branches[picked], um, where)
    }

    if f.tag == T_OBJECT and len(f.nested) == 1 and deep {
        const m: dict[str, Any] = v
        validate_doc_at(f.nested[0], m, where)
    }
}


def validate_doc_at(schema: CompiledSchema, doc: dict[str, Any], prefix: str) -> None {
    for f in schema.required {
        if f.name not in doc and not f.has_default {
            raise SchemaError("missing required field '" + prefix + "." + f.name + "'")
        }
    }
    for k in doc {
        if k == "_id" {
            continue
        }
        if k not in schema.by_name {
            if not schema.additional {
                raise SchemaError("unknown field '" + prefix + "." + k + "'; this schema sets additionalProperties to false")
            }
            check_depth(doc[k], 1)
            continue
        }
        _check_value(schema.by_name[k], doc[k], "field '" + prefix + "." + k + "'", True)
    }
}


def validate_doc(schema: CompiledSchema, doc: dict[str, Any]) -> None {
    for f in schema.required {
        if f.name not in doc and not f.has_default {
            raise SchemaError("missing required field '" + f.name + "'")
        }
    }
    for k in doc {
        if k == "_id" {
            continue
        }
        if k not in schema.by_name {
            if not schema.additional {
                raise SchemaError("unknown field '" + k + "'; this schema sets additionalProperties to false")
            }
            check_depth(doc[k], 1)
            continue
        }
        _check_value(schema.by_name[k], doc[k], "field '" + k + "'", True)
    }
}


def apply_write_defaults(schema: CompiledSchema, doc: dict[str, Any]) -> dict[str, Any] {
    if not schema.has_defaults {
        return doc
    }
    missing: bool = False
    for f in schema.required {
        if f.has_default and f.name not in doc {
            missing = True
        }
    }
    if not missing {
        return doc
    }
    out: dict[str, Any] = {}
    for k in doc {
        out[k] = doc[k]
    }
    for f2 in schema.required {
        if f2.has_default and f2.name not in out {
            out[f2.name] = f2.default_val[0]
        }
    }
    return out
}


def apply_read_defaults(schema: CompiledSchema, doc: dict[str, Any]) -> None {
    if not schema.has_defaults {
        return
    }
    for f in schema.optional {
        if f.has_default and f.name not in doc {
            doc[f.name] = f.default_val[0]
        }
    }
}

"""tomllib.dr - read-only TOML parser matching Python 3.11+ tomllib.
No arrays-of-tables, inline tables, multi-line strings, or datetimes.
"""

extern "C" def dragon_str_to_int(s: str) -> int
extern "C" def dragon_str_to_float(s: str) -> float


def _strip(s: str) -> str {
    return s.strip(" \t\r")
}

def _strip_comment(line: str) -> str {
    # Removes a trailing comment; a # outside a quoted string starts it.
    in_string: bool = false
    i: int = 0
    while i < len(line) {
        const ch: str = line[i:i + 1]
        if ch == "\"" {
            in_string = not in_string
        } else {
            if ch == "#" {
                if not in_string {
                    return _strip(line[:i])
                }
            }
        }
        i = i + 1
    }
    return line
}

def _unquote(s: str) -> str {
    # Removes surrounding double quotes if present; also unescapes basic sequences.
    if len(s) < 2 { return s }
    if s[0:1] == "\"" {
        if s[len(s) - 1:len(s)] == "\"" {
            const inner: str = s[1:len(s) - 1]
            # Copies verbatim spans between backslashes; unknown escapes keep the backslash.
            parts: list[str] = []
            i: int = 0
            run: int = 0
            const n: int = len(inner)
            while i < n {
                if inner[i:i + 1] != "\\" or i + 1 >= n {
                    i = i + 1
                    continue
                }
                if i > run { parts.append(inner[run:i]) }
                const next: str = inner[i + 1:i + 2]
                if next == "n" { parts.append("\n"); i = i + 2 }
                elif next == "t" { parts.append("\t"); i = i + 2 }
                elif next == "\\" { parts.append("\\"); i = i + 2 }
                elif next == "\"" { parts.append("\""); i = i + 2 }
                else {
                    parts.append("\\")
                    i = i + 1
                }
                run = i
            }
            if n > run { parts.append(inner[run:n]) }
            return "".join(parts)
        }
    }
    # Also handle single-quoted (literal) strings
    if s[0:1] == "'" {
        if s[len(s) - 1:len(s)] == "'" {
            return s[1:len(s) - 1]
        }
    }
    return s
}

def _parse_value(raw: str) -> str {
    # Parses a TOML scalar; strings are unquoted, booleans/numbers returned as-is.
    const val: str = _strip(raw)
    if len(val) == 0 { return "" }

    const first: str = val[0:1]
    if first == "\"" { return _unquote(val) }
    if first == "'" { return _unquote(val) }

    if val == "true" { return "true" }
    if val == "false" { return "false" }

    # Number (int or float): returned as-is for typed getters.
    return val
}


class TomlDoc {
    def() {
        self._data: dict[str, str] = {}
    }

    def _set(key: str, value: str) {
        self._data[key] = value
    }

    def get(key: str) -> str {
        if key not in self._data {
            raise ValueError(f"TOML key not found: {key}")
        }
        return self._data[key]
    }

    def get_int(key: str) -> int {
        # TOML allows underscores in integers (e.g. 1_000) - strip them.
        return dragon_str_to_int(self.get(key).replace("_", ""))
    }

    def get_float(key: str) -> float {
        # TOML allows underscores in floats - strip them.
        return dragon_str_to_float(self.get(key).replace("_", ""))
    }

    def get_bool(key: str) -> bool {
        const val: str = self.get(key)
        if val == "true" { return true }
        return false
    }

    def has(key: str) -> bool {
        return key in self._data
    }

    def all_keys() -> list[str] {
        return self._data.keys()
    }
}


def loads(text: str) -> TomlDoc {
    # Parses TOML text (sections, dotted keys, scalars, comments) into a TomlDoc.
    doc: TomlDoc = TomlDoc()
    const lines: list[str] = text.split("\n")
    current_prefix: str = ""

    i: int = 0
    while i < len(lines) {
        raw: str = _strip(lines[i])

        # Skip empty lines and full-line comments
        if len(raw) == 0 {
            i = i + 1
        } else {
            if raw[0:1] == "#" {
                i = i + 1
            } else {
                # Section header: [name] or [a.b.c]
                if raw[0:1] == "[" {
                    # Ensure it's not an array of tables [[...]]
                    if len(raw) > 1 {
                        if raw[1:2] == "[" {
                            # Array of tables - skip (unsupported)
                            i = i + 1
                        } else {
                            const close: int = raw.find("]")
                            if close > 0 {
                                current_prefix = _strip(raw[1:close])
                            }
                            i = i + 1
                        }
                    } else {
                        i = i + 1
                    }
                } else {
                    const cleaned: str = _strip_comment(raw)
                    const eq_pos: int = cleaned.find("=")
                    if eq_pos > 0 {
                        const raw_key: str = _strip(cleaned[:eq_pos])
                        const raw_val: str = _strip(cleaned[eq_pos + 1:])
                        const value: str = _parse_value(raw_val)

                        full_key: str = raw_key
                        if len(current_prefix) > 0 {
                            full_key = current_prefix + "." + raw_key
                        }
                        doc._set(full_key, value)
                    }
                    i = i + 1
                }
            }
        }
    }

    return doc
}


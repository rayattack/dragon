"""binascii.dr - hexlify/unhexlify (b2a_hex/a2b_hex), CRC32 and CRC-32C, matching
Python's binascii where the name exists there. Hex helpers back SHA-256 fingerprints
in the registry (D022); CRC32 backs gzip/tar and CRC-32C backs odb's page checksums.
Both checksums run in the runtime: CRC32 over zlib, CRC-32C over the SSE4.2 / ARMv8
crc32 instruction with a table loop where the instruction is missing."""


extern "C" def dragon_crc32_range(data: bytes, start: int, length: int, value: int) -> int
extern "C" def dragon_crc32c_range(data: bytes, start: int, length: int, value: int) -> int


const _HEX_LOWER: str = "0123456789abcdef"
const _HEX_LOWER_B: bytes = b"0123456789abcdef"


def hexlify(data: bytes) -> bytes {
    n: int = len(data)
    out: list[int] = [0] * (n * 2)
    i: int = 0
    o: int = 0
    while i < n {
        v: int = data[i]
        out[o] = _HEX_LOWER_B[(v >> 4) & 0x0F]
        out[o + 1] = _HEX_LOWER_B[v & 0x0F]
        i = i + 1
        o = o + 2
    }
    return bytes(out)
}


def b2a_hex(data: bytes) -> bytes {
    return hexlify(data)
}


def _hex_value(ch: int) -> int {
    if ch >= 0x30 and ch <= 0x39 { return ch - 0x30 }
    if ch >= 0x61 and ch <= 0x66 { return ch - 0x61 + 10 }
    if ch >= 0x41 and ch <= 0x46 { return ch - 0x41 + 10 }
    return -1
}


def unhexlify(data: bytes | str) -> bytes {
    if isinstance(data, str) {
        return _unhexlify_impl(data.encode("ascii"))
    } else {
        return _unhexlify_impl(data)
    }
}


def _unhexlify_impl(buf: bytes) -> bytes {
    n: int = len(buf)
    if n % 2 != 0 {
        raise ValueError("odd-length hex string")
    }
    out: list[int] = [0] * (n // 2)
    i: int = 0
    o: int = 0
    while i < n {
        hi: int = _hex_value(buf[i])
        lo: int = _hex_value(buf[i + 1])
        if hi < 0 or lo < 0 {
            raise ValueError("non-hexadecimal digit")
        }
        out[o] = (hi << 4) | lo
        i = i + 2
        o = o + 1
    }
    return bytes(out)
}


def a2b_hex(data: bytes | str) -> bytes {
    return unhexlify(data)
}


def crc32(data: bytes, value: int = 0) -> int {
    """IEEE 802.3 CRC32, the one gzip, PNG and zip headers carry."""
    return dragon_crc32_range(data, 0, len(data), value)
}


def crc32c(data: bytes, value: int = 0) -> int {
    """Castagnoli CRC-32C. `value` is the running checksum, so crc32c(tail, crc32c(head))
    equals crc32c(head + tail)."""
    return dragon_crc32c_range(data, 0, len(data), value)
}


def crc32c_range(data: bytes, start: int, length: int, value: int = 0) -> int {
    """CRC-32C over data[start:start + length], continuing from `value`. Chained ranges
    that cover the buffer end at the same checksum as crc32c over the whole of it.
    Raises IndexError when the range leaves the buffer."""
    return dragon_crc32c_range(data, start, length, value)
}

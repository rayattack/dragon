"""configparser.dr - INI parser: [section] headers, key=value / key:value pairs, #/; comments."""

def _strip(s: str) -> str {
    return s.strip(" \t\r")
}

def _find_separator(line: str) -> int {
    # Position of the first = or : separator, or -1 if none.
    i: int = 0
    while i < len(line) {
        const ch: str = line[i:i + 1]
        if ch == "=" {
            return i
        }
        if ch == ":" {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

def _is_comment(line: str) -> bool {
    # True if line starts with # or ;.
    if len(line) == 0 { return false }
    const ch: str = line[0:1]
    if ch == "#" { return true }
    if ch == ";" { return true }
    return false
}

def _is_section_header(line: str) -> bool {
    # True if line starts with [ and ends with ].
    if len(line) < 3 { return false }
    if line[0:1] == "[" {
        if line[len(line) - 1:len(line)] == "]" {
            return true
        }
    }
    return false
}

def _extract_section_name(line: str) -> str {
    return _strip(line[1:len(line) - 1])
}


class ConfigParser {
    def() {
        self._sections: dict[str, dict[str, str]] = {}
    }

    def read_string(text: str) {
        const lines: list[str] = text.split("\n")
        current_section: str = ""
        has_section: bool = false

        i: int = 0
        while i < len(lines) {
            const raw_line: str = _strip(lines[i])
            i = i + 1
            if len(raw_line) == 0 { continue }
            if _is_comment(raw_line) { continue }
            if _is_section_header(raw_line) {
                current_section = _extract_section_name(raw_line)
                has_section = true
                self.add_section(current_section)
                continue
            }
            if has_section {
                const sep: int = _find_separator(raw_line)
                if sep > 0 {
                    const key: str = _strip(raw_line[:sep])
                    const value: str = _strip(raw_line[sep + 1:])
                    self.set(current_section, key, value)
                }
            }
        }
    }

    def sections() -> list[str] {
        return self._sections.keys()
    }

    def has_section(name: str) -> bool {
        return name in self._sections
    }

    def has_option(section: str, key: str) -> bool {
        if section not in self._sections { return false }
        const sec: dict[str, str] = self._sections[section]
        return key in sec
    }

    def get(section: str, key: str) -> str {
        if section not in self._sections {
            raise ValueError(f"section not found: {section}")
        }
        const sec: dict[str, str] = self._sections[section]
        if key not in sec {
            raise ValueError(f"key not found: {key}")
        }
        return sec[key]
    }

    def get_int(section: str, key: str) -> int {
        const val: str = self.get(section, key)
        return int(val)
    }

    def get_float(section: str, key: str) -> float {
        const val: str = self.get(section, key)
        return float(val)
    }

    def get_bool(section: str, key: str) -> bool {
        # Recognizes true/yes/on/1 (case-sensitive) as true; everything else false.
        const val: str = self.get(section, key)
        if val == "true" { return true }
        if val == "yes" { return true }
        if val == "on" { return true }
        if val == "1" { return true }
        return false
    }

    def set(section: str, key: str, value: str) {
        empty: dict[str, str] = {}
        sec: dict[str, str] = self._sections.setdefault(section, empty)
        sec[key] = value
    }

    def add_section(name: str) {
        if name not in self._sections {
            empty: dict[str, str] = {}
            self._sections[name] = empty
        }
    }

    def items(section: str) -> list[list[str]] {
        if section not in self._sections {
            raise ValueError(f"section not found: {section}")
        }
        const sec: dict[str, str] = self._sections[section]
        result: list[list[str]] = []
        for k in sec {
            pair: list[str] = [k, sec[k]]
            result.append(pair)
        }
        return result
    }

    def to_string() -> str {
        parts: list[str] = []
        first: bool = true
        for name in self._sections {
            if not first {
                parts.append("\n")
            }
            first = false
            parts.append("[" + name + "]\n")
            const sec: dict[str, str] = self._sections[name]
            for k in sec {
                parts.append(k + " = " + sec[k] + "\n")
            }
        }
        return "".join(parts)
    }
}

"""fnmatch.dr - Unix shell glob matching: * ? [abc] [!abc]. Pure Dragon."""

const _RE_SPECIAL: str = "()[]{}?*+-|^$\\.&~# \t\n\r"

def _class_end(pattern: str, pi: int) -> int {
    const plen: int = len(pattern)
    j: int = pi + 1
    if j < plen and pattern[j] == "!" { j = j + 1 }
    if j < plen and pattern[j] == "]" { j = j + 1 }
    while j < plen and pattern[j] != "]" { j = j + 1 }
    if j >= plen { return -1 }
    return j
}

def _class_match(pattern: str, pi: int, end: int, ch: str) -> bool {
    j: int = pi + 1
    negate: bool = False
    if pattern[j] == "!" {
        negate = True
        j = j + 1
    }
    found: bool = False
    while j < end {
        if j + 2 < end and pattern[j + 1] == "-" {
            if ch >= pattern[j] and ch <= pattern[j + 2] { found = True }
            j = j + 3
        } else {
            if ch == pattern[j] { found = True }
            j = j + 1
        }
    }
    if negate { return not found }
    return found
}

def _match(name: str, ni: int, pattern: str, pi: int) -> bool {
    const nlen: int = len(name)
    const plen: int = len(pattern)
    star_pi: int = -1
    star_ni: int = 0

    while ni < nlen {
        advanced: bool = False
        if pi < plen {
            const pc: str = pattern[pi]
            if pc == "*" {
                star_pi = pi
                star_ni = ni
                pi = pi + 1
                advanced = True
            } elif pc == "?" {
                ni = ni + 1
                pi = pi + 1
                advanced = True
            } elif pc == "[" {
                const end: int = _class_end(pattern, pi)
                if end < 0 {
                    if name[ni] == "[" {
                        ni = ni + 1
                        pi = pi + 1
                        advanced = True
                    }
                } elif _class_match(pattern, pi, end, name[ni]) {
                    ni = ni + 1
                    pi = end + 1
                    advanced = True
                }
            } elif name[ni] == pc {
                ni = ni + 1
                pi = pi + 1
                advanced = True
            }
        }
        if not advanced {
            if star_pi < 0 { return False }
            pi = star_pi + 1
            star_ni = star_ni + 1
            ni = star_ni
        }
    }

    while pi < plen and pattern[pi] == "*" { pi = pi + 1 }
    return pi == plen
}

def fnmatch(name: str, pattern: str) -> bool {
    # Case-sensitive on Unix/POSIX, same as fnmatchcase.
    return _match(name, 0, pattern, 0)
}

def fnmatchcase(name: str, pattern: str) -> bool {
    # Identical to fnmatch on Unix.
    return _match(name, 0, pattern, 0)
}

def filter_names(names: list[str], pattern: str) -> list[str] {
    result: list[str] = []
    i: int = 0
    while i < len(names) {
        if _match(names[i], 0, pattern, 0) {
            result.append(names[i])
        }
        i = i + 1
    }
    return result
}

def _re_escape_char(c: str) -> str {
    if c in _RE_SPECIAL {
        return "\\" + c
    }
    return c
}

def translate(pattern: str) -> str {
    """Translate a glob pattern to a regex string, like Python's fnmatch.translate."""
    const plen: int = len(pattern)
    parts: list[str] = ["(?s:"]
    i: int = 0
    while i < plen {
        const c: str = pattern[i]
        if c == "*" {
            parts.append(".*")
            i = i + 1
            while i < plen and pattern[i] == "*" { i = i + 1 }
        } elif c == "?" {
            parts.append(".")
            i = i + 1
        } elif c == "[" {
            const end: int = _class_end(pattern, i)
            if end < 0 {
                parts.append("\\[")
                i = i + 1
            } else {
                stuff: str = pattern[i + 1:end]
                stuff = stuff.replace("\\", "\\\\")
                if len(stuff) > 0 {
                    if stuff[0] == "!" {
                        stuff = "^" + stuff[1:len(stuff)]
                    } elif stuff[0] == "^" or stuff[0] == "[" {
                        stuff = "\\" + stuff
                    }
                }
                parts.append("[" + stuff + "]")
                i = end + 1
            }
        } else {
            parts.append(_re_escape_char(c))
            i = i + 1
        }
    }
    parts.append(")\\Z")
    return "".join(parts)
}

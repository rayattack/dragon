"""statistics.dr - statistical functions (subset of Python's statistics module).

Pure Dragon; only extern dependency is sqrt from libm.
"""

extern "C" def sqrt(x: float) -> float

def mean(data: list[float]) -> float {
    if len(data) == 0 {
        raise ValueError("mean requires at least one data point")
    }
    total: float = 0.0
    i: int = 0
    while i < len(data) {
        total = total + data[i]
        i = i + 1
    }
    return total / float(len(data))
}

def fmean(data: list[float]) -> float {
    return mean(data)
}

def geometric_mean(data: list[float]) -> float {
    if len(data) == 0 {
        raise ValueError("geometric_mean requires at least one data point")
    }
    log_sum: float = 0.0
    i: int = 0
    while i < len(data) {
        if data[i] <= 0.0 {
            raise ValueError("geometric_mean requires all positive values")
        }
        log_sum = log_sum + _ln(data[i])
        i = i + 1
    }
    return _exp(log_sum / float(len(data)))
}

def harmonic_mean(data: list[float]) -> float {
    if len(data) == 0 {
        raise ValueError("harmonic_mean requires at least one data point")
    }
    reciprocal_sum: float = 0.0
    i: int = 0
    while i < len(data) {
        if data[i] <= 0.0 {
            raise ValueError("harmonic_mean requires all positive values")
        }
        reciprocal_sum = reciprocal_sum + (1.0 / data[i])
        i = i + 1
    }
    return float(len(data)) / reciprocal_sum
}

def median(data: list[float]) -> float {
    if len(data) == 0 {
        raise ValueError("median requires at least one data point")
    }
    const ordered: list[float] = sorted(data)
    const n: int = len(ordered)
    const mid: int = n // 2
    if n - (n // 2) * 2 == 1 {
        return ordered[mid]
    }
    return (ordered[mid - 1] + ordered[mid]) / 2.0
}

def median_low(data: list[float]) -> float {
    if len(data) == 0 {
        raise ValueError("median_low requires at least one data point")
    }
    const ordered: list[float] = sorted(data)
    const n: int = len(ordered)
    const mid: int = n // 2
    if n - (n // 2) * 2 == 1 {
        return ordered[mid]
    }
    return ordered[mid - 1]
}

def median_high(data: list[float]) -> float {
    if len(data) == 0 {
        raise ValueError("median_high requires at least one data point")
    }
    const ordered: list[float] = sorted(data)
    const n: int = len(ordered)
    const mid: int = n // 2
    return ordered[mid]
}

def mode_float(data: list[float]) -> float {
    """Most common value; on ties, the first seen in data order."""
    if len(data) == 0 {
        raise ValueError("mode_float requires at least one data point")
    }
    const ordered: list[float] = sorted(data)
    distinct: list[float] = []
    counts: list[int] = []
    i: int = 0
    while i < len(ordered) {
        const v: float = ordered[i]
        if len(distinct) > 0 and distinct[len(distinct) - 1] == v {
            counts[len(counts) - 1] = counts[len(counts) - 1] + 1
        } else {
            distinct.append(v)
            counts.append(1)
        }
        i = i + 1
    }
    best_count: int = 0
    i = 0
    while i < len(counts) {
        if counts[i] > best_count { best_count = counts[i] }
        i = i + 1
    }
    i = 0
    while i < len(data) {
        if counts[_distinct_index(distinct, data[i])] == best_count {
            return data[i]
        }
        i = i + 1
    }
    return data[0]
}

def _distinct_index(xs: list[float], v: float) -> int {
    lo: int = 0
    hi: int = len(xs) - 1
    while lo < hi {
        const mid: int = (lo + hi) // 2
        if xs[mid] < v { lo = mid + 1 } else { hi = mid }
    }
    return lo
}

def mode_int(data: list[int]) -> int {
    """Most common value; on ties, the first seen in data order."""
    if len(data) == 0 {
        raise ValueError("mode_int requires at least one data point")
    }
    counts: dict[int, int] = {}
    order: list[int] = []
    i: int = 0
    while i < len(data) {
        const v: int = data[i]
        if v in counts {
            counts[v] = counts[v] + 1
        } else {
            counts[v] = 1
            order.append(v)
        }
        i = i + 1
    }
    best: int = order[0]
    best_count: int = counts[best]
    i = 1
    while i < len(order) {
        if counts[order[i]] > best_count {
            best = order[i]
            best_count = counts[order[i]]
        }
        i = i + 1
    }
    return best
}

def variance(data: list[float]) -> float {
    if len(data) < 2 {
        raise ValueError("variance requires at least two data points")
    }
    const m: float = mean(data)
    sum_sq: float = 0.0
    i: int = 0
    while i < len(data) {
        const diff: float = data[i] - m
        sum_sq = sum_sq + diff * diff
        i = i + 1
    }
    return sum_sq / float(len(data) - 1)
}

def pvariance(data: list[float]) -> float {
    if len(data) < 1 {
        raise ValueError("pvariance requires at least one data point")
    }
    const m: float = mean(data)
    sum_sq: float = 0.0
    i: int = 0
    while i < len(data) {
        const diff: float = data[i] - m
        sum_sq = sum_sq + diff * diff
        i = i + 1
    }
    return sum_sq / float(len(data))
}

def stdev(data: list[float]) -> float {
    return sqrt(variance(data))
}

def pstdev(data: list[float]) -> float {
    return sqrt(pvariance(data))
}

def quantiles(data: list[float], n: int) -> list[float] {
    """n-1 cut points dividing data into n intervals (exclusive method)."""
    if len(data) < 2 {
        raise ValueError("quantiles requires at least two data points")
    }
    if n < 1 {
        raise ValueError("n must be at least 1")
    }
    const ordered: list[float] = sorted(data)
    const ld: int = len(ordered)
    const m: int = ld + 1

    result: list[float] = []
    i: int = 1
    while i < n {
        j: int = i * m // n
        if j < 1 { j = 1 }
        if j > ld - 1 { j = ld - 1 }
        const delta: int = i * m - j * n
        result.append((ordered[j - 1] * float(n - delta) + ordered[j] * float(delta)) / float(n))
        i = i + 1
    }
    return result
}

def _ln(x: float) -> float {
    const LN2: float = 0.6931471805599453

    k: int = 0
    m: float = x
    while m >= 2.0 {
        m = m / 2.0
        k = k + 1
    }
    while m < 0.5 {
        m = m * 2.0
        k = k - 1
    }

    const z: float = (m - 1.0) / (m + 1.0)
    const z2: float = z * z
    result: float = 0.0
    term: float = z
    i: int = 0
    while i < 30 {
        result = result + term / float(2 * i + 1)
        term = term * z2
        i = i + 1
    }
    return 2.0 * result + float(k) * LN2
}

def _exp(x: float) -> float {
    const LN2: float = 0.6931471805599453

    k: int = int(x / LN2)
    if x < 0.0 {
        k = k - 1
    }
    const r: float = x - float(k) * LN2

    result: float = 1.0
    term: float = 1.0
    i: int = 1
    while i <= 25 {
        term = term * r / float(i)
        result = result + term
        i = i + 1
    }

    pow2: float = 1.0
    if k >= 0 {
        j: int = 0
        while j < k {
            pow2 = pow2 * 2.0
            j = j + 1
        }
    } else {
        j: int = 0
        while j < 0 - k {
            pow2 = pow2 / 2.0
            j = j + 1
        }
    }
    return result * pow2
}

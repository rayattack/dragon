"""uuid.dr - UUID v4 generation + string utilities, via the OS CSPRNG
(dragon_urandom); rand() could make same-second processes collide.
"""

extern "C" def dragon_urandom(n: int) -> bytes

def _hex_char(v: int) -> str {
    return f"{v:x}"
}

def _hex_byte(v: int) -> str {
    return _hex_char((v >> 4) & 15) + _hex_char(v & 15)
}

def _hex_range(b: bytes, start: int, end: int) -> str {
    result: str = ""
    i: int = start
    while i < end {
        result = result + _hex_byte(b[i])
        i = i + 1
    }
    return result
}

def uuid4() -> str {
    const b: bytes = dragon_urandom(16)

    const b6: int = (b[6] & 15) | 64
    const b8: int = (b[8] & 63) | 128

    const p1: str = _hex_range(b, 0, 4)
    const p2: str = _hex_range(b, 4, 6)
    const p3: str = _hex_byte(b6) + _hex_byte(b[7])
    const p4: str = _hex_byte(b8) + _hex_byte(b[9])
    const p5: str = _hex_range(b, 10, 16)

    return f"{p1}-{p2}-{p3}-{p4}-{p5}"
}

def uuid_hex(uuid: str) -> str {
    result: str = ""
    i: int = 0
    while i < len(uuid) {
        const ch: str = uuid[i:i + 1]
        if ch != "-" {
            result = result + ch
        }
        i = i + 1
    }
    return result
}

def uuid_version(uuid: str) -> int {
    const ch: str = uuid[14:15]
    if ch == "0" { return 0 }
    if ch == "1" { return 1 }
    if ch == "2" { return 2 }
    if ch == "3" { return 3 }
    if ch == "4" { return 4 }
    if ch == "5" { return 5 }
    return -1
}

def _is_hex_char(ch: str) -> bool {
    if ch == "0" { return true }
    if ch == "1" { return true }
    if ch == "2" { return true }
    if ch == "3" { return true }
    if ch == "4" { return true }
    if ch == "5" { return true }
    if ch == "6" { return true }
    if ch == "7" { return true }
    if ch == "8" { return true }
    if ch == "9" { return true }
    if ch == "a" { return true }
    if ch == "b" { return true }
    if ch == "c" { return true }
    if ch == "d" { return true }
    if ch == "e" { return true }
    if ch == "f" { return true }
    if ch == "A" { return true }
    if ch == "B" { return true }
    if ch == "C" { return true }
    if ch == "D" { return true }
    if ch == "E" { return true }
    if ch == "F" { return true }
    return false
}

def uuid_is_valid(uuid: str) -> bool {
    if len(uuid) != 36 { return false }

    if uuid[8:9] != "-" { return false }
    if uuid[13:14] != "-" { return false }
    if uuid[18:19] != "-" { return false }
    if uuid[23:24] != "-" { return false }

    i: int = 0
    while i < 36 {
        if i != 8 {
            if i != 13 {
                if i != 18 {
                    if i != 23 {
                        if _is_hex_char(uuid[i:i + 1]) == false {
                            return false
                        }
                    }
                }
            }
        }
        i = i + 1
    }

    const ver: int = uuid_version(uuid)
    if ver < 1 { return false }
    if ver > 5 { return false }

    return true
}

def uuid_compare(a: str, b: str) -> int {
    const ha: str = uuid_hex(a)
    const hb: str = uuid_hex(b)
    if ha < hb { return -1 }
    if ha > hb { return 1 }
    return 0
}

# uuid.dr - Dragon standard library: UUID generation
#
# Provides UUID v4 (random) generation and UUID string utilities.
#
# Randomness comes from the OS CSPRNG (getrandom/getentropy) via
# `dragon_urandom`, not libc rand(). A time-seeded LCG made two processes that
# started in the same second emit identical UUIDs, which breaks the one
# property a UUID is supposed to have.

#===----------------------------------------------------------------------===#
# C extern declarations
#===----------------------------------------------------------------------===#

extern "C" def dragon_urandom(n: int) -> bytes

#===----------------------------------------------------------------------===#
# Hex helpers
#===----------------------------------------------------------------------===#

def _hex_char(v: int) -> str {
    # Map 0-15 to "0"-"f".
    return f"{v:x}"
}

def _hex_byte(v: int) -> str {
    # Map 0-255 to two hex characters, high nibble first.
    return _hex_char((v >> 4) & 15) + _hex_char(v & 15)
}

def _hex_range(b: bytes, start: int, end: int) -> str {
    result: str = ""
    i: int = start
    while i < end {
        result = result + _hex_byte(b[i])
        i = i + 1
    }
    return result
}

#===----------------------------------------------------------------------===#
# UUID v4 generation
#===----------------------------------------------------------------------===#

def uuid4() -> str {
    # Format: xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx
    #
    # RFC 4122 s4.4: take 16 random bytes, then overwrite the version nibble
    # (high nibble of byte 6) with 4 and the variant bits (top two bits of
    # byte 8) with 10. The other 122 bits stay random.
    const b: bytes = dragon_urandom(16)

    const b6: int = (b[6] & 15) | 64      # 0x4_ : version 4
    const b8: int = (b[8] & 63) | 128     # 10xx xxxx : RFC 4122 variant

    const p1: str = _hex_range(b, 0, 4)
    const p2: str = _hex_range(b, 4, 6)
    const p3: str = _hex_byte(b6) + _hex_byte(b[7])
    const p4: str = _hex_byte(b8) + _hex_byte(b[9])
    const p5: str = _hex_range(b, 10, 16)

    return f"{p1}-{p2}-{p3}-{p4}-{p5}"
}

#===----------------------------------------------------------------------===#
# UUID utilities
#===----------------------------------------------------------------------===#

def uuid_hex(uuid: str) -> str {
    result: str = ""
    i: int = 0
    while i < len(uuid) {
        const ch: str = uuid[i:i + 1]
        if ch != "-" {
            result = result + ch
        }
        i = i + 1
    }
    return result
}

def uuid_version(uuid: str) -> int {
    # The version char is at position 14 (the char after the second dash).
    const ch: str = uuid[14:15]
    if ch == "0" { return 0 }
    if ch == "1" { return 1 }
    if ch == "2" { return 2 }
    if ch == "3" { return 3 }
    if ch == "4" { return 4 }
    if ch == "5" { return 5 }
    return -1
}

def _is_hex_char(ch: str) -> bool {
    if ch == "0" { return true }
    if ch == "1" { return true }
    if ch == "2" { return true }
    if ch == "3" { return true }
    if ch == "4" { return true }
    if ch == "5" { return true }
    if ch == "6" { return true }
    if ch == "7" { return true }
    if ch == "8" { return true }
    if ch == "9" { return true }
    if ch == "a" { return true }
    if ch == "b" { return true }
    if ch == "c" { return true }
    if ch == "d" { return true }
    if ch == "e" { return true }
    if ch == "f" { return true }
    if ch == "A" { return true }
    if ch == "B" { return true }
    if ch == "C" { return true }
    if ch == "D" { return true }
    if ch == "E" { return true }
    if ch == "F" { return true }
    return false
}

def uuid_is_valid(uuid: str) -> bool {
    # Validate UUID format: 8-4-4-4-12, all hex digits, version 1-5.
    if len(uuid) != 36 { return false }

    if uuid[8:9] != "-" { return false }
    if uuid[13:14] != "-" { return false }
    if uuid[18:19] != "-" { return false }
    if uuid[23:24] != "-" { return false }

    # Check all non-dash characters are hex
    i: int = 0
    while i < 36 {
        if i != 8 {
            if i != 13 {
                if i != 18 {
                    if i != 23 {
                        if _is_hex_char(uuid[i:i + 1]) == false {
                            return false
                        }
                    }
                }
            }
        }
        i = i + 1
    }

    const ver: int = uuid_version(uuid)
    if ver < 1 { return false }
    if ver > 5 { return false }

    return true
}

def uuid_compare(a: str, b: str) -> int {
    # Lexicographic comparison of two UUID strings.
    # Returns -1 if a < b, 0 if a == b, 1 if a > b.
    # Compare on hex-only (stripped) form for canonical ordering.
    const ha: str = uuid_hex(a)
    const hb: str = uuid_hex(b)
    if ha < hb { return -1 }
    if ha > hb { return 1 }
    return 0
}

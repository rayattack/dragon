"""time.dr - POSIX time access/conversions via extern "C" (current time,
process clock, sleep, monotonic clock).
"""

extern "C" def time(tloc: ptr) -> int
extern "C" def clock() -> int
extern "C" def sleep(seconds: intc) -> intc
extern "C" def usleep(usec: intc) -> intc
extern "C" def nanosleep(req: ptr, rem: ptr) -> intc
extern "C" def clock_gettime(clockid: intc, tp: ptr) -> intc
extern "C" def difftime(time1: int, time0: int) -> float
extern "C" def malloc(size: int) -> ptr
extern "C" def free(p: ptr)
extern "C" def memset(s: ptr, c: intc, n: int) -> ptr

extern "C" def dragon_vthread_sleep(ms: int) -> None

extern "C" def dragon_timespec_new(sec: int, nsec: int) -> ptr
extern "C" def dragon_timespec_sec(ts: ptr) -> int
extern "C" def dragon_timespec_nsec(ts: ptr) -> int

extern "C" def dragon_clock_realtime_id() -> int
extern "C" def dragon_clock_monotonic_id() -> int
extern "C" def dragon_clock_process_id() -> int

CLOCK_REALTIME: int = dragon_clock_realtime_id()
CLOCK_MONOTONIC: int = dragon_clock_monotonic_id()
CLOCK_PROCESS: int = dragon_clock_process_id()

const CLOCKS_PER_SEC: int = 1000000
const MILLIS_PER_SEC: int = 1000

def now() -> int {
    return time(none)
}

def now_float() -> float {
    const ts: ptr = malloc(16)
    memset(ts, 0, 16)
    clock_gettime(CLOCK_REALTIME, ts)
    const sec: int = dragon_timespec_sec(ts)
    const nsec: int = dragon_timespec_nsec(ts)
    free(ts)
    return float(sec) + float(nsec) / 1000000000.0
}

def monotonic() -> float {
    const ts: ptr = malloc(16)
    memset(ts, 0, 16)
    clock_gettime(CLOCK_MONOTONIC, ts)
    const sec: int = dragon_timespec_sec(ts)
    const nsec: int = dragon_timespec_nsec(ts)
    free(ts)
    return float(sec) + float(nsec) / 1000000000.0
}

def process_time() -> float {
    return float(clock()) / float(CLOCKS_PER_SEC)
}

def _milliseconds_ceil(seconds: float) -> int {
    const exact: float = seconds * float(MILLIS_PER_SEC)
    const whole: int = int(exact)
    if float(whole) < exact {
        return whole + 1
    }
    return whole
}

def sleep_secs(seconds: int) -> int {
    dragon_vthread_sleep(seconds * MILLIS_PER_SEC)
    return 0
}

def sleep_ms(milliseconds: int) -> int {
    dragon_vthread_sleep(milliseconds)
    return 0
}

def sleep_float(seconds: float) -> int {
    dragon_vthread_sleep(_milliseconds_ceil(seconds))
    return 0
}

def perf_counter() -> float {
    return monotonic()
}

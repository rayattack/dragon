"""errno.dr - symbolic constants for POSIX error numbers, mirroring CPython's errno module.
Values are Linux/glibc canonicals (also used by Dragon's runtime libuv/libc); macOS/BSD divergences are noted."""

const EPERM: int = 1
const ENOENT: int = 2
const ESRCH: int = 3
const EINTR: int = 4
const EIO: int = 5
const ENXIO: int = 6
const E2BIG: int = 7
const ENOEXEC: int = 8
const EBADF: int = 9
const ECHILD: int = 10
const EAGAIN: int = 11
const EWOULDBLOCK: int = 11
const ENOMEM: int = 12
const EACCES: int = 13
const EFAULT: int = 14
const ENOTBLK: int = 15
const EBUSY: int = 16
const EEXIST: int = 17
const EXDEV: int = 18
const ENODEV: int = 19
const ENOTDIR: int = 20
const EISDIR: int = 21
const EINVAL: int = 22
const ENFILE: int = 23
const EMFILE: int = 24
const ENOTTY: int = 25
const ETXTBSY: int = 26
const EFBIG: int = 27
const ENOSPC: int = 28
const ESPIPE: int = 29
const EROFS: int = 30
const EMLINK: int = 31
const EPIPE: int = 32
const EDOM: int = 33
const ERANGE: int = 34

const EDEADLK: int = 35
const EDEADLOCK: int = 35
const ENAMETOOLONG: int = 36
const ENOLCK: int = 37
const ENOSYS: int = 38
const ENOTEMPTY: int = 39
const ELOOP: int = 40
const ENOMSG: int = 42
const EIDRM: int = 43

const ENOSTR: int = 60
const ENODATA: int = 61
const ETIME: int = 62
const ENOSR: int = 63
const EREMOTE: int = 66
const ENOLINK: int = 67
const EPROTO: int = 71
const EMULTIHOP: int = 72
const EBADMSG: int = 74
const EOVERFLOW: int = 75
const EILSEQ: int = 84

const EUSERS: int = 87
const ENOTSOCK: int = 88
const EDESTADDRREQ: int = 89
const EMSGSIZE: int = 90
const EPROTOTYPE: int = 91
const ENOPROTOOPT: int = 92
const EPROTONOSUPPORT: int = 93
const ESOCKTNOSUPPORT: int = 94
const EOPNOTSUPP: int = 95
const ENOTSUP: int = 95
const EPFNOSUPPORT: int = 96
const EAFNOSUPPORT: int = 97
const EADDRINUSE: int = 98
const EADDRNOTAVAIL: int = 99
const ENETDOWN: int = 100
const ENETUNREACH: int = 101
const ENETRESET: int = 102
const ECONNABORTED: int = 103
const ECONNRESET: int = 104
const ENOBUFS: int = 105
const EISCONN: int = 106
const ENOTCONN: int = 107
const ESHUTDOWN: int = 108
const ETOOMANYREFS: int = 109
const ETIMEDOUT: int = 110
const ECONNREFUSED: int = 111
const EHOSTDOWN: int = 112
const EHOSTUNREACH: int = 113
const EALREADY: int = 114
const EINPROGRESS: int = 115
const ESTALE: int = 116
const EDQUOT: int = 122

const ECANCELED: int = 125
const EOWNERDEAD: int = 130
const ENOTRECOVERABLE: int = 131

_errorcode_cache: dict[int, str] = {}

def _build_errorcode() -> dict[int, str] {
    d: dict[int, str] = {}
    d[1] = "EPERM"
    d[2] = "ENOENT"
    d[3] = "ESRCH"
    d[4] = "EINTR"
    d[5] = "EIO"
    d[6] = "ENXIO"
    d[7] = "E2BIG"
    d[8] = "ENOEXEC"
    d[9] = "EBADF"
    d[10] = "ECHILD"
    d[11] = "EAGAIN"
    d[12] = "ENOMEM"
    d[13] = "EACCES"
    d[14] = "EFAULT"
    d[15] = "ENOTBLK"
    d[16] = "EBUSY"
    d[17] = "EEXIST"
    d[18] = "EXDEV"
    d[19] = "ENODEV"
    d[20] = "ENOTDIR"
    d[21] = "EISDIR"
    d[22] = "EINVAL"
    d[23] = "ENFILE"
    d[24] = "EMFILE"
    d[25] = "ENOTTY"
    d[26] = "ETXTBSY"
    d[27] = "EFBIG"
    d[28] = "ENOSPC"
    d[29] = "ESPIPE"
    d[30] = "EROFS"
    d[31] = "EMLINK"
    d[32] = "EPIPE"
    d[33] = "EDOM"
    d[34] = "ERANGE"
    d[35] = "EDEADLK"
    d[36] = "ENAMETOOLONG"
    d[37] = "ENOLCK"
    d[38] = "ENOSYS"
    d[39] = "ENOTEMPTY"
    d[40] = "ELOOP"
    d[42] = "ENOMSG"
    d[43] = "EIDRM"
    d[60] = "ENOSTR"
    d[61] = "ENODATA"
    d[62] = "ETIME"
    d[63] = "ENOSR"
    d[66] = "EREMOTE"
    d[67] = "ENOLINK"
    d[71] = "EPROTO"
    d[72] = "EMULTIHOP"
    d[74] = "EBADMSG"
    d[75] = "EOVERFLOW"
    d[84] = "EILSEQ"
    d[87] = "EUSERS"
    d[88] = "ENOTSOCK"
    d[89] = "EDESTADDRREQ"
    d[90] = "EMSGSIZE"
    d[91] = "EPROTOTYPE"
    d[92] = "ENOPROTOOPT"
    d[93] = "EPROTONOSUPPORT"
    d[94] = "ESOCKTNOSUPPORT"
    d[95] = "EOPNOTSUPP"
    d[96] = "EPFNOSUPPORT"
    d[97] = "EAFNOSUPPORT"
    d[98] = "EADDRINUSE"
    d[99] = "EADDRNOTAVAIL"
    d[100] = "ENETDOWN"
    d[101] = "ENETUNREACH"
    d[102] = "ENETRESET"
    d[103] = "ECONNABORTED"
    d[104] = "ECONNRESET"
    d[105] = "ENOBUFS"
    d[106] = "EISCONN"
    d[107] = "ENOTCONN"
    d[108] = "ESHUTDOWN"
    d[109] = "ETOOMANYREFS"
    d[110] = "ETIMEDOUT"
    d[111] = "ECONNREFUSED"
    d[112] = "EHOSTDOWN"
    d[113] = "EHOSTUNREACH"
    d[114] = "EALREADY"
    d[115] = "EINPROGRESS"
    d[116] = "ESTALE"
    d[122] = "EDQUOT"
    d[125] = "ECANCELED"
    d[130] = "EOWNERDEAD"
    d[131] = "ENOTRECOVERABLE"
    return d
}

def errorcode(code: int) -> str {
    global _errorcode_cache
    if len(_errorcode_cache) == 0 {
        _errorcode_cache = _build_errorcode()
    }
    if code in _errorcode_cache {
        return _errorcode_cache[code]
    }
    return ""
}

def errorcode_dict() -> dict[int, str] {
    global _errorcode_cache
    if len(_errorcode_cache) == 0 {
        _errorcode_cache = _build_errorcode()
    }
    return _errorcode_cache
}

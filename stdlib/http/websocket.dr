import hashlib
import base64

extern "C" def dragon_nb_recv_bytes(fd: int, max_len: int) -> bytes
extern "C" def dragon_nb_send_bytes(fd: int, data: bytes) -> int
extern "C" def dragon_close_fd(fd: int)

const OPCODE_CONT: int = 0x0
const OPCODE_TEXT: int = 0x1
const OPCODE_BINARY: int = 0x2
const OPCODE_CLOSE: int = 0x8
const OPCODE_PING: int = 0x9
const OPCODE_PONG: int = 0xA

const _WS_GUID: str = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"

def compute_accept_key(key: str) -> str {
    combined: str = key + _WS_GUID
    digest: bytes = hashlib.sha1(combined.encode("utf-8")).digest()
    encoded: bytes = base64.b64encode(digest)
    return encoded.decode("utf-8")
}

def is_websocket_upgrade(headers: dict[str, str]) -> bool {
    if "upgrade" not in headers {
        return False
    }
    if "connection" not in headers {
        return False
    }
    if "sec-websocket-key" not in headers {
        return False
    }
    upgrade_val: str = headers["upgrade"].lower()
    if "websocket" not in upgrade_val {
        return False
    }
    connection_val: str = headers["connection"].lower()
    if "upgrade" not in connection_val {
        return False
    }
    return True
}

class Frame {
    fin: bool
    opcode: int
    payload: bytes

    def(fin: bool, opcode: int, payload: bytes) {
        self.fin = fin
        self.opcode = opcode
        self.payload = payload
    }

    def is_control() -> bool {
        return (self.opcode & 0x08) != 0
    }

    def is_text() -> bool {
        return self.opcode == OPCODE_TEXT
    }

    def is_binary() -> bool {
        return self.opcode == OPCODE_BINARY
    }
}

class IncompleteFrameError(Exception) {}

class ProtocolError(Exception) {}

def parse_frame(data: bytes) -> Frame {
    n: int = len(data)
    if n < 2 {
        raise IncompleteFrameError("need at least 2 bytes for a frame header")
    }

    b0: int = data[0]
    b1: int = data[1]

    fin: bool = (b0 & 0x80) != 0
    rsv: int = b0 & 0x70
    if rsv != 0 {
        raise ProtocolError("reserved RSV bits set with no extension negotiated")
    }
    opcode: int = b0 & 0x0F

    masked: bool = (b1 & 0x80) != 0
    length: int = b1 & 0x7F

    offset: int = 2

    if length == 126 {
        if n < offset + 2 {
            raise IncompleteFrameError("need 2 bytes for 16-bit extended length")
        }
        length = (data[offset] << 8) | data[offset + 1]
        offset = offset + 2
    } else if length == 127 {
        if n < offset + 8 {
            raise IncompleteFrameError("need 8 bytes for 64-bit extended length")
        }
        length = (data[offset] << 56) | (data[offset + 1] << 48) | (data[offset + 2] << 40) | (data[offset + 3] << 32) | (data[offset + 4] << 24) | (data[offset + 5] << 16) | (data[offset + 6] << 8) | data[offset + 7]
        offset = offset + 8
    }

    if (opcode & 0x08) != 0 {
        if length > 125 {
            raise ProtocolError("control frame payload exceeds 125 bytes")
        }
        if not fin {
            raise ProtocolError("control frame must not be fragmented")
        }
    }

    mask_key: list[int] = [0, 0, 0, 0]
    if masked {
        if n < offset + 4 {
            raise IncompleteFrameError("need 4 bytes for masking key")
        }
        mask_key[0] = data[offset]
        mask_key[1] = data[offset + 1]
        mask_key[2] = data[offset + 2]
        mask_key[3] = data[offset + 3]
        offset = offset + 4
    }

    if n < offset + length {
        raise IncompleteFrameError("payload not fully buffered")
    }

    payload_bytes: list[int] = [0] * length
    i: int = 0
    if masked {
        while i < length {
            payload_bytes[i] = data[offset + i] ^ mask_key[i & 3]
            i = i + 1
        }
    } else {
        while i < length {
            payload_bytes[i] = data[offset + i]
            i = i + 1
        }
    }

    return Frame(fin, opcode, bytes(payload_bytes))
}

def frame_length(data: bytes) -> int {
    n: int = len(data)
    if n < 2 {
        raise IncompleteFrameError("need at least 2 bytes for a frame header")
    }
    b1: int = data[1]
    masked: bool = (b1 & 0x80) != 0
    length: int = b1 & 0x7F
    offset: int = 2
    if length == 126 {
        if n < offset + 2 {
            raise IncompleteFrameError("need 2 bytes for 16-bit extended length")
        }
        length = (data[offset] << 8) | data[offset + 1]
        offset = offset + 2
    } else if length == 127 {
        if n < offset + 8 {
            raise IncompleteFrameError("need 8 bytes for 64-bit extended length")
        }
        length = (data[offset] << 56) | (data[offset + 1] << 48) | (data[offset + 2] << 40) | (data[offset + 3] << 32) | (data[offset + 4] << 24) | (data[offset + 5] << 16) | (data[offset + 6] << 8) | data[offset + 7]
        offset = offset + 8
    }
    if masked {
        offset = offset + 4
    }
    return offset + length
}

def build_frame(opcode: int, payload: bytes, fin: bool = True, mask: bool = False, mask_key: bytes = b"") -> bytes {
    out: list[int] = []

    b0: int = opcode & 0x0F
    if fin {
        b0 = b0 | 0x80
    }
    out.append(b0)

    length: int = len(payload)
    mask_bit: int = 0
    if mask {
        mask_bit = 0x80
    }

    if length < 126 {
        out.append(mask_bit | length)
    } else if length <= 0xFFFF {
        out.append(mask_bit | 126)
        out.append((length >> 8) & 0xFF)
        out.append(length & 0xFF)
    } else {
        out.append(mask_bit | 127)
        out.append((length >> 56) & 0xFF)
        out.append((length >> 48) & 0xFF)
        out.append((length >> 40) & 0xFF)
        out.append((length >> 32) & 0xFF)
        out.append((length >> 24) & 0xFF)
        out.append((length >> 16) & 0xFF)
        out.append((length >> 8) & 0xFF)
        out.append(length & 0xFF)
    }

    if mask {
        if len(mask_key) != 4 {
            raise ProtocolError("build_frame: mask=True requires a 4-byte mask_key")
        }
        out.append(mask_key[0])
        out.append(mask_key[1])
        out.append(mask_key[2])
        out.append(mask_key[3])
        i: int = 0
        while i < length {
            out.append(payload[i] ^ mask_key[i & 3])
            i = i + 1
        }
    } else {
        i: int = 0
        while i < length {
            out.append(payload[i])
            i = i + 1
        }
    }

    return bytes(out)
}

def build_text_frame(text: str, fin: bool = True) -> bytes {
    return build_frame(OPCODE_TEXT, text.encode("utf-8"), fin)
}

def build_binary_frame(payload: bytes, fin: bool = True) -> bytes {
    return build_frame(OPCODE_BINARY, payload, fin)
}

def build_close_frame(code: int = 1000, reason: str = "") -> bytes {
    if code == 0 {
        return build_frame(OPCODE_CLOSE, b"")
    }
    body: list[int] = [(code >> 8) & 0xFF, code & 0xFF]
    reason_bytes: bytes = reason.encode("utf-8")
    i: int = 0
    while i < len(reason_bytes) {
        body.append(reason_bytes[i])
        i = i + 1
    }
    return build_frame(OPCODE_CLOSE, bytes(body))
}

def build_ping_frame(payload: bytes = b"") -> bytes {
    return build_frame(OPCODE_PING, payload)
}

def build_pong_frame(payload: bytes = b"") -> bytes {
    return build_frame(OPCODE_PONG, payload)
}

class MessageReassembler {
    opcode: int
    _buffer: bytes
    _active: bool

    def() {
        self.opcode = 0
        self._buffer = b""
        self._active = False
    }

    def add(frame: Frame) -> bool {
        if frame.opcode == OPCODE_CONT {
            if not self._active {
                raise ProtocolError("CONT frame with no message in progress")
            }
            self._buffer = self._buffer + frame.payload
        } else {
            if self._active {
                raise ProtocolError("new data frame while a fragmented message is in progress")
            }
            self.opcode = frame.opcode
            self._buffer = frame.payload
            self._active = True
        }
        if frame.fin {
            self._active = False
            return True
        }
        return False
    }

    def message() -> bytes {
        return self._buffer
    }

    def reset() -> None {
        self.opcode = 0
        self._buffer = b""
        self._active = False
    }
}

class WebSocket {
    fd: int
    closed: bool
    _fd_closed: bool
    _inbuf: bytes

    def(fd: int) {
        self.fd = fd
        self.closed = False
        self._fd_closed = False
        self._inbuf = b""
    }

    def _fill() -> int {
        chunk: bytes = dragon_nb_recv_bytes(self.fd, 65536)
        got: int = len(chunk)
        if got > 0 {
            self._inbuf = self._inbuf + chunk
        }
        return got
    }

    def recv_frame() -> Frame {
        while True {
            if len(self._inbuf) >= 2 {
                try {
                    frame: Frame = parse_frame(self._inbuf)
                    consumed: int = frame_length(self._inbuf)
                    self._inbuf = self._inbuf[consumed:]
                    return frame
                } except IncompleteFrameError as e {
                }
            }
            got: int = self._fill()
            if got == 0 {
                raise IncompleteFrameError("connection closed before a full frame arrived")
            }
        }
        raise IncompleteFrameError("unreachable")
    }

    def recv() -> bytes {
        assembler: MessageReassembler = MessageReassembler()
        while True {
            frame: Frame = self.recv_frame()
            if frame.opcode == OPCODE_PING {
                self._send_raw(build_pong_frame(frame.payload))
                continue
            }
            if frame.opcode == OPCODE_PONG {
                continue
            }
            if frame.opcode == OPCODE_CLOSE {
                if not self.closed {
                    self.closed = True
                    self._send_raw(build_close_frame(1000, ""))
                }
                raise IncompleteFrameError("peer closed the connection")
            }
            done: bool = assembler.add(frame)
            if done {
                return assembler.message()
            }
        }
        raise IncompleteFrameError("unreachable")
    }

    def recv_text() -> str {
        return self.recv().decode("utf-8")
    }

    def _send_raw(frame_bytes: bytes) -> int {
        return dragon_nb_send_bytes(self.fd, frame_bytes)
    }

    def send(data: str) -> int {
        return self._send_raw(build_text_frame(data))
    }

    def send_bytes(data: bytes) -> int {
        return self._send_raw(build_binary_frame(data))
    }

    def ping(payload: bytes = b"") -> int {
        return self._send_raw(build_ping_frame(payload))
    }

    def _shutdown() -> None {
        if not self._fd_closed {
            self._fd_closed = True
            dragon_close_fd(self.fd)
        }
    }

    def close(code: int = 1000, reason: str = "") -> None {
        if not self.closed {
            self.closed = True
            self._send_raw(build_close_frame(code, reason))
        }
        self._shutdown()
    }
}

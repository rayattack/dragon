from socket import TcpStream, SocketHandle
from ssl import SSLContext, SSLSocket, create_default_context
from urllib.parse import urlsplit, SplitResult

extern "C" def dragon_int_to_str(n: int) -> str


def _reason_for(status: int) -> str {
    if status == 200 { return "OK" }
    if status == 201 { return "Created" }
    if status == 202 { return "Accepted" }
    if status == 204 { return "No Content" }
    if status == 301 { return "Moved Permanently" }
    if status == 302 { return "Found" }
    if status == 303 { return "See Other" }
    if status == 304 { return "Not Modified" }
    if status == 307 { return "Temporary Redirect" }
    if status == 308 { return "Permanent Redirect" }
    if status == 400 { return "Bad Request" }
    if status == 401 { return "Unauthorized" }
    if status == 403 { return "Forbidden" }
    if status == 404 { return "Not Found" }
    if status == 405 { return "Method Not Allowed" }
    if status == 409 { return "Conflict" }
    if status == 410 { return "Gone" }
    if status == 422 { return "Unprocessable Entity" }
    if status == 429 { return "Too Many Requests" }
    if status == 500 { return "Internal Server Error" }
    if status == 502 { return "Bad Gateway" }
    if status == 503 { return "Service Unavailable" }
    if status == 504 { return "Gateway Timeout" }
    return ""
}


def _parse_status_line(line: str) -> tuple[int, str] {
    sp1: int = line.find(" ")
    if sp1 < 0 {
        raise ValueError("invalid HTTP status line: '" + line + "'")
    }
    sp2: int = line.find(" ", sp1 + 1)
    code_str: str = ""
    reason: str = ""
    if sp2 < 0 {
        code_str = line[sp1 + 1:len(line)]
    } else {
        code_str = line[sp1 + 1:sp2]
        reason = line[sp2 + 1:len(line)]
    }
    status: int = int(code_str)
    if len(reason) == 0 {
        reason = _reason_for(status)
    }
    return (status, reason)
}


def _parse_header_line(line: str) -> tuple[str, str] {
    colon: int = line.find(":")
    if colon < 0 {
        return ("", "")
    }
    key: str = line[0:colon].strip()
    val: str = line[colon + 1:len(line)].strip()
    return (key, val)
}


class _ResponseHead {
    status: int
    reason: str
    headers: dict[str, str]

    def(status: int, reason: str, headers: dict[str, str]) {
        self.status = status
        self.reason = reason
        self.headers = headers
    }
}


def _parse_head(head: str) -> _ResponseHead {
    const lines: list[str] = head.split("\r\n")
    if len(lines) == 0 {
        raise ValueError("malformed HTTP response: empty head")
    }
    const status_pair: tuple[int, str] = _parse_status_line(lines[0])
    headers: dict[str, str] = {}
    i: int = 1
    while i < len(lines) {
        const line: str = lines[i]
        if len(line) > 0 {
            const kv: tuple[str, str] = _parse_header_line(line)
            if len(kv[0]) > 0 {
                headers[kv[0]] = kv[1]
            }
        }
        i = i + 1
    }
    return _ResponseHead(status_pair[0], status_pair[1], headers)
}


def _header_value(headers: dict[str, str], name: str) -> str {
    const target: str = name.lower()
    for k in headers {
        if k.lower() == target {
            return headers[k]
        }
    }
    return ""
}


def _chunk_size(line: str) -> int {
    s: str = line
    const semi: int = s.find(";")
    if semi >= 0 {
        s = s[0:semi]
    }
    s = s.strip()
    if len(s) == 0 {
        raise ValueError("malformed chunked body: empty chunk-size line")
    }
    size: int = 0
    i: int = 0
    while i < len(s) {
        const c: int = ord(s[i])
        d: int = -1
        if c >= 48 and c <= 57 { d = c - 48 }
        if c >= 97 and c <= 102 { d = c - 87 }
        if c >= 65 and c <= 70 { d = c - 55 }
        if d < 0 {
            raise ValueError("malformed chunked body: invalid chunk size '" + line + "'")
        }
        size = size * 16 + d
        i = i + 1
    }
    return size
}


def _dechunk(body: str) -> str {
    parts: list[str] = []
    pos: int = 0
    const n: int = len(body)
    done: bool = False
    while not done {
        const eol: int = body.find("\r\n", pos)
        if eol < 0 {
            raise ValueError("malformed chunked body: missing chunk-size terminator")
        }
        const size: int = _chunk_size(body[pos:eol])
        pos = eol + 2
        if size == 0 {
            done = True
        } else {
            if pos + size + 2 > n {
                raise ValueError("malformed chunked body: chunk data truncated")
            }
            parts.append(body[pos:pos + size])
            if body[pos + size:pos + size + 2] != "\r\n" {
                raise ValueError("malformed chunked body: missing chunk-data terminator")
            }
            pos = pos + size + 2
        }
    }
    return "".join(parts)
}


def _request_head(method: str, url: str, host: str, port: int,
                  content_len: int, headers: dict[str, str]) -> str {
    host_hdr: str = host
    if port != 80 and port != 443 {
        host_hdr = host + ":" + dragon_int_to_str(port)
    }
    parts: list[str] = [method + " " + url + " HTTP/1.1\r\n"]
    parts.append("Host: " + host_hdr + "\r\n")
    parts.append("Connection: close\r\n")
    if content_len >= 0 {
        parts.append("Content-Length: " + dragon_int_to_str(content_len) + "\r\n")
    }
    for k in headers {
        parts.append(k + ": " + headers[k] + "\r\n")
    }
    parts.append("\r\n")
    return "".join(parts)
}


class HTTPResponse {
    def(stream: TcpStream, status: int, reason: str, headers: dict[str, str], body: str) {
        self.stream = stream
        self.status = status
        self.reason = reason
        self.headers = headers
        self._body = body
        self._consumed = False
    }

    def read() -> str {
        if self._consumed {
            return ""
        }
        self._consumed = True
        return self._body
    }

    def getheader(name: str, default: str = "") -> str {
        target: str = name.lower()
        for k in self.headers {
            if k.lower() == target {
                return self.headers[k]
            }
        }
        return default
    }

    def getheaders() -> list[tuple[str, str]] {
        out: list[tuple[str, str]] = []
        for k in self.headers {
            out.append((k, self.headers[k]))
        }
        return out
    }

    def close() -> None {
        self.stream.close()
    }
}


class HTTPConnection {
    def(host: str, port: int) {
        self.host = host
        self.port = port
        self.stream = TcpStream(SocketHandle.adopt_raw(-1))
        self._connected = False
    }

    def connect() -> None {
        if self._connected {
            return
        }
        self.stream = TcpStream.open(self.host, self.port)
        self._connected = True
    }

    def request(method: str, url: str, body: str, headers: dict[str, str]) -> None {
        self.connect()
        content_len: int = -1
        if len(body) > 0 {
            content_len = len(body)
        }
        req: str = _request_head(method, url, self.host, self.port, content_len, headers)
        if len(body) > 0 {
            req = req + body
        }
        self.stream.send(req)
    }

    def getresponse() -> HTTPResponse {
        chunks: list[str] = []
        while True {
            const chunk: str = self.stream.recv(8192)
            if len(chunk) == 0 {
                break
            }
            chunks.append(chunk)
        }
        const raw: str = "".join(chunks)
        const sep: int = raw.find("\r\n\r\n")
        if sep < 0 {
            raise ValueError("malformed HTTP response: no header terminator")
        }
        const h: _ResponseHead = _parse_head(raw[0:sep])
        body: str = raw[sep + 4:len(raw)]
        if "chunked" in _header_value(h.headers, "Transfer-Encoding").lower() {
            body = _dechunk(body)
        }
        return HTTPResponse(self.stream, h.status, h.reason, h.headers, body)
    }

    def close() -> None {
        if self._connected {
            self.stream.close()
            self._connected = False
        }
    }
}


class HTTPSResponse {
    def(stream: SSLSocket, status: int, reason: str, headers: dict[str, str], body: str) {
        self.stream = stream
        self.status = status
        self.reason = reason
        self.headers = headers
        self._body = body
        self._consumed = False
    }

    def read() -> str {
        if self._consumed {
            return ""
        }
        self._consumed = True
        return self._body
    }

    def getheader(name: str, default: str = "") -> str {
        target: str = name.lower()
        for k in self.headers {
            if k.lower() == target {
                return self.headers[k]
            }
        }
        return default
    }

    def getheaders() -> list[tuple[str, str]] {
        out: list[tuple[str, str]] = []
        for k in self.headers {
            out.append((k, self.headers[k]))
        }
        return out
    }

    def close() -> None {
        self.stream.close()
    }
}


class HTTPSConnection {
    host: str
    port: int
    _ctx: SSLContext
    stream: SSLSocket
    _connected: bool

    def(host: str, port: int) {
        self.host = host
        self.port = port
        self._ctx = create_default_context()
        self._connected = False
    }

    def connect() -> None {
        if self._connected {
            return
        }
        raw: TcpStream = TcpStream.open(self.host, self.port)
        self.stream = self._ctx.wrap_socket(raw, False, self.host)
        self._connected = True
    }

    def request(method: str, url: str, body: str, headers: dict[str, str]) -> None {
        self.connect()
        content_len: int = -1
        if len(body) > 0 {
            content_len = len(body)
        }
        req: str = _request_head(method, url, self.host, self.port, content_len, headers)
        if len(body) > 0 {
            req = req + body
        }
        self.stream.send(req)
    }

    def getresponse() -> HTTPSResponse {
        chunks: list[str] = []
        while True {
            const chunk: str = self.stream.recv(8192)
            if len(chunk) == 0 {
                break
            }
            chunks.append(chunk)
        }
        const raw: str = "".join(chunks)
        const sep: int = raw.find("\r\n\r\n")
        if sep < 0 {
            raise ValueError("malformed HTTP response: no header terminator")
        }
        const h: _ResponseHead = _parse_head(raw[0:sep])
        body: str = raw[sep + 4:len(raw)]
        if "chunked" in _header_value(h.headers, "Transfer-Encoding").lower() {
            body = _dechunk(body)
        }
        return HTTPSResponse(self.stream, h.status, h.reason, h.headers, body)
    }

    def request_bytes(method: str, url: str, body: bytes, headers: dict[str, str]) -> None {
        self.connect()
        self.stream.send(_request_head(method, url, self.host, self.port,
                                          len(body), headers))
        if len(body) > 0 {
            self.stream.send_bytes(body)
        }
    }

    def getresponse_bytes() -> HTTPSBytesResponse {
        chunks: list[bytes] = []
        while True {
            c: bytes = self.stream.recv_bytes(65536)
            if len(c) == 0 {
                break
            }
            chunks.append(c)
        }
        raw: bytes = b"".join(chunks)
        n: int = len(raw)
        sep: int = -1
        i: int = 0
        while i + 3 < n {
            if raw[i] == 13 and raw[i + 1] == 10 and raw[i + 2] == 13 and raw[i + 3] == 10 {
                sep = i
                break
            }
            i = i + 1
        }
        if sep < 0 {
            raise ValueError("malformed HTTP response: no header terminator")
        }
        const h: _ResponseHead = _parse_head(raw[0:sep].decode("utf-8"))
        body: bytes = raw[sep + 4:n]

        te: str = ""
        for hk in h.headers {
            if hk.lower() == "transfer-encoding" {
                te = h.headers[hk]
            }
        }
        if "chunked" in te.lower() {
            raise ValueError("chunked response bodies are not supported by getresponse_bytes")
        }
        return HTTPSBytesResponse(h.status, h.reason, h.headers, body)
    }

    def close() -> None {
        if self._connected {
            self.stream.close()
            self._connected = False
        }
    }
}

class HTTPSBytesResponse {
    status: int
    reason: str
    headers: dict[str, str]
    body: bytes

    def(status: int, reason: str, headers: dict[str, str], body: bytes) {
        self.status = status
        self.reason = reason
        self.headers = headers
        self.body = body
    }

    def read() -> bytes {
        return self.body
    }

    def getheader(name: str, default: str = "") -> str {
        target: str = name.lower()
        for k in self.headers {
            if k.lower() == target {
                return self.headers[k]
            }
        }
        return default
    }
}


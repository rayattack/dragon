# JSON encode/decode in pure Dragon (minimal extern "C" for str<->number).
# Also home to the template[JSON] content type (D032).

from template import Template

# Extern C helpers (minimal - only for str<->number conversion)

extern "C" def dragon_str_to_int(s: str) -> int
extern "C" def dragon_str_to_float(s: str) -> float
extern "C" def dragon_int_to_str(value: int) -> str
extern "C" def dragon_float_to_str(value: float) -> str
# Generic serializer: dispatches on the boxed value's runtime tag and recurses
# through lists/dicts via their element tags. No user-facing generics needed.
extern "C" def dragon_json_dumps(obj: Any) -> str
# Byte-level scan primitives (D048): dragon_bytes_get reads a byte with zero
# allocation; dragon_chr/dragon_ord back the \uXXXX unescape.
extern "C" def dragon_bytes_get(b: bytes, idx: int) -> int
extern "C" def dragon_chr(code: int) -> str
extern "C" def dragon_ord(s: str) -> int

# Internal helpers

def _skip_ws(s: str, pos: int) -> int {
    # Advance pos past any whitespace characters.
    i: int = pos
    while i < len(s) {
        const ch: str = s[i:i + 1]
        if ch in " \t\n\r" {
            i = i + 1
        } else {
            return i
        }
    }
    return i
}

def _is_digit(ch: str) -> bool {
    return ch.isdigit()
}

# String escaping

def escape(s: str) -> str {
    # Escape special characters for JSON string encoding
    parts: list[str] = []
    i: int = 0
    while i < len(s) {
        const ch: str = s[i:i + 1]
        if ch == "\\" {
            parts.append("\\\\")
        } else {
            if ch == "\"" {
                parts.append("\\\"")
            } else {
                if ch == "\n" {
                    parts.append("\\n")
                } else {
                    if ch == "\t" {
                        parts.append("\\t")
                    } else {
                        if ch == "\r" {
                            parts.append("\\r")
                        } else {
                            parts.append(ch)
                        }
                    }
                }
            }
        }
        i = i + 1
    }
    return "".join(parts)
}

# Hex digit value, or -1 if not a hex digit.
def _hex_val(ch: str) -> int {
    const c: int = dragon_ord(ch)
    if c >= 48 and c <= 57 { return c - 48 }        # 0-9
    if c >= 97 and c <= 102 { return c - 97 + 10 }  # a-f
    if c >= 65 and c <= 70 { return c - 65 + 10 }   # A-F
    return -1
}

# Parse the 4 hex digits of a \uXXXX escape at s[i:i+4]; returns the 16-bit code
# unit, or -1 if there aren't 4 valid hex digits there.
def _parse_u4(s: str, i: int) -> int {
    if i + 4 > len(s) {
        return -1
    }
    const h0: int = _hex_val(s[i:i + 1])
    const h1: int = _hex_val(s[i + 1:i + 2])
    const h2: int = _hex_val(s[i + 2:i + 3])
    const h3: int = _hex_val(s[i + 3:i + 4])
    if h0 < 0 or h1 < 0 or h2 < 0 or h3 < 0 {
        return -1
    }
    return ((h0 * 16 + h1) * 16 + h2) * 16 + h3
}

def unescape(s: str) -> str {
    # Unescape JSON escapes (RFC 8259 §7): two-char escapes + \uXXXX (incl.
    # surrogate pairs). An unrecognized escape is kept verbatim.
    parts: list[str] = []
    i: int = 0
    const n: int = len(s)
    while i < n {
        const ch: str = s[i:i + 1]
        if ch != "\\" {
            parts.append(ch)
            i = i + 1
            continue
        }
        if i + 1 >= n {
            parts.append(ch)        # trailing lone backslash
            i = i + 1
            continue
        }
        const next: str = s[i + 1:i + 2]
        if next == "n" { parts.append("\n"); i = i + 2 }
        elif next == "t" { parts.append("\t"); i = i + 2 }
        elif next == "r" { parts.append("\r"); i = i + 2 }
        elif next == "b" { parts.append(dragon_chr(8)); i = i + 2 }
        elif next == "f" { parts.append(dragon_chr(12)); i = i + 2 }
        elif next == "\\" { parts.append("\\"); i = i + 2 }
        elif next == "\"" { parts.append("\""); i = i + 2 }
        elif next == "/" { parts.append("/"); i = i + 2 }
        elif next == "u" {
            const cu: int = _parse_u4(s, i + 2)
            if cu < 0 {
                parts.append(ch)    # malformed \u - keep the backslash
                i = i + 1
            } elif cu >= 0xD800 and cu <= 0xDBFF and i + 7 < n and s[i + 6:i + 7] == "\\" and s[i + 7:i + 8] == "u" {
                # High surrogate followed by a \u - try to combine with the low.
                const lo: int = _parse_u4(s, i + 8)
                if lo >= 0xDC00 and lo <= 0xDFFF {
                    const cp: int = 0x10000 + ((cu - 0xD800) * 1024) + (lo - 0xDC00)
                    parts.append(dragon_chr(cp))
                    i = i + 12
                } else {
                    parts.append(dragon_chr(cu))   # unpaired high surrogate
                    i = i + 6
                }
            } else {
                parts.append(dragon_chr(cu))
                i = i + 6
            }
        } else {
            parts.append(ch)        # unknown escape - keep verbatim
            i = i + 1
        }
    }
    return "".join(parts)
}

# Encoding functions (Dragon values -> JSON strings)

def dumps_str(value: str) -> str {
    # Encode a string as a JSON string with quotes and escaping
    return "\"" + escape(value) + "\""
}

def dumps_int(value: int) -> str {
    # Encode an integer as a JSON number
    return dragon_int_to_str(value)
}

def dumps_float(value: float) -> str {
    # Encode a float as a JSON number
    return dragon_float_to_str(value)
}

def dumps_bool(value: bool) -> str {
    # Encode a boolean as a JSON literal
    if value {
        return "true"
    }
    return "false"
}

def dumps_none() -> str {
    # Encode None/null as a JSON literal
    return "null"
}

# Generic dumps: serialize any value (scalar or nested list/dict) to JSON,
# dispatching on the runtime tag - Python parity for json.dumps(obj).
def dumps(obj: Any) -> str {
    return dragon_json_dumps(obj)
}

def dumps_list_str(items: list[str]) -> str {
    parts: list[str] = []
    i: int = 0
    while i < len(items) {
        parts.append(dumps_str(items[i]))
        i = i + 1
    }
    return "[" + ", ".join(parts) + "]"
}

def dumps_list_int(items: list[int]) -> str {
    parts: list[str] = []
    i: int = 0
    while i < len(items) {
        parts.append(dumps_int(items[i]))
        i = i + 1
    }
    return "[" + ", ".join(parts) + "]"
}

def dumps_list_float(items: list[float]) -> str {
    parts: list[str] = []
    i: int = 0
    while i < len(items) {
        parts.append(dumps_float(items[i]))
        i = i + 1
    }
    return "[" + ", ".join(parts) + "]"
}

def dumps_list_bool(items: list[bool]) -> str {
    parts: list[str] = []
    i: int = 0
    while i < len(items) {
        parts.append(dumps_bool(items[i]))
        i = i + 1
    }
    return "[" + ", ".join(parts) + "]"
}

# Internal parsing helpers

def _parse_string_value(s: str, pos: int) -> str {
    # Parse a JSON string at pos (the opening quote); returns unescaped content.
    # Caller advances past the closing quote.
    if pos >= len(s) {
        raise ValueError("unexpected end of JSON input")
    }
    if s[pos:pos + 1] != "\"" {
        raise ValueError("expected '\"' at start of JSON string")
    }
    i: int = pos + 1
    result: str = ""
    while i < len(s) {
        const ch: str = s[i:i + 1]
        if ch == "\"" {
            return result
        }
        if ch == "\\" {
            if i + 1 >= len(s) {
                raise ValueError("unexpected end of escape sequence")
            }
            const next: str = s[i + 1:i + 2]
            if next == "n" {
                result = result + "\n"
                i = i + 2
            } else {
                if next == "t" {
                    result = result + "\t"
                    i = i + 2
                } else {
                    if next == "r" {
                        result = result + "\r"
                        i = i + 2
                    } else {
                        if next == "\\" {
                            result = result + "\\"
                            i = i + 2
                        } else {
                            if next == "\"" {
                                result = result + "\""
                                i = i + 2
                            } else {
                                if next == "/" {
                                    result = result + "/"
                                    i = i + 2
                                } else {
                                    result = result + next
                                    i = i + 2
                                }
                            }
                        }
                    }
                }
            }
        } else {
            result = result + ch
            i = i + 1
        }
    }
    raise ValueError("unterminated JSON string")
}

def _find_string_end(s: str, pos: int) -> int {
    # Find the position of the closing quote for a JSON string starting at pos.
    # pos should point to the opening quote. Returns position AFTER closing quote.
    if pos >= len(s) {
        return pos
    }
    i: int = pos + 1
    while i < len(s) {
        const ch: str = s[i:i + 1]
        if ch == "\"" {
            return i + 1
        }
        if ch == "\\" {
            # Skip escaped character
            i = i + 2
        } else {
            i = i + 1
        }
    }
    return i
}

def _parse_number_str(s: str, pos: int) -> str {
    # Extract the raw number substring starting at pos.
    # Handles negative sign, digits, and decimal point.
    i: int = pos
    if i < len(s) {
        if s[i:i + 1] == "-" {
            i = i + 1
        }
    }
    while i < len(s) {
        const ch: str = s[i:i + 1]
        if _is_digit(ch) {
            i = i + 1
        } else {
            if ch == "." {
                i = i + 1
            } else {
                if ch == "e" {
                    i = i + 1
                    # Handle optional sign after exponent
                    if i < len(s) {
                        const ech: str = s[i:i + 1]
                        if ech == "+" {
                            i = i + 1
                        } else {
                            if ech == "-" {
                                i = i + 1
                            }
                        }
                    }
                } else {
                    if ch == "E" {
                        i = i + 1
                        if i < len(s) {
                            const ech: str = s[i:i + 1]
                            if ech == "+" {
                                i = i + 1
                            } else {
                                if ech == "-" {
                                    i = i + 1
                                }
                            }
                        }
                    } else {
                        return s[pos:i]
                    }
                }
            }
        }
    }
    return s[pos:i]
}

def _find_number_end(s: str, pos: int) -> int {
    # Find the end position of a number starting at pos.
    i: int = pos
    if i < len(s) {
        if s[i:i + 1] == "-" {
            i = i + 1
        }
    }
    while i < len(s) {
        const ch: str = s[i:i + 1]
        if _is_digit(ch) {
            i = i + 1
        } else {
            if ch == "." {
                i = i + 1
            } else {
                if ch == "e" {
                    i = i + 1
                    if i < len(s) {
                        const ech: str = s[i:i + 1]
                        if ech == "+" {
                            i = i + 1
                        } else {
                            if ech == "-" {
                                i = i + 1
                            }
                        }
                    }
                } else {
                    if ch == "E" {
                        i = i + 1
                        if i < len(s) {
                            const ech: str = s[i:i + 1]
                            if ech == "+" {
                                i = i + 1
                            } else {
                                if ech == "-" {
                                    i = i + 1
                                }
                            }
                        }
                    } else {
                        return i
                    }
                }
            }
        }
    }
    return i
}

# Decoding functions (JSON strings -> Dragon values)

def loads_str(json: str) -> str {
    # Parse a JSON string value. Input should be a JSON string like: "hello"
    pos: int = _skip_ws(json, 0)
    if pos >= len(json) {
        raise ValueError("empty JSON input")
    }
    return _parse_string_value(json, pos)
}

def loads_int(json: str) -> int {
    # Parse a JSON integer value. Input should be like: 42 or -7
    pos: int = _skip_ws(json, 0)
    if pos >= len(json) {
        raise ValueError("empty JSON input")
    }
    const num_str: str = _parse_number_str(json, pos)
    return dragon_str_to_int(num_str)
}

def loads_float(json: str) -> float {
    # Parse a JSON float value. Input should be like: 3.14 or -2.5e10
    pos: int = _skip_ws(json, 0)
    if pos >= len(json) {
        raise ValueError("empty JSON input")
    }
    const num_str: str = _parse_number_str(json, pos)
    return dragon_str_to_float(num_str)
}

def loads_bool(json: str) -> bool {
    # Parse a JSON boolean. Input should be: true or false
    pos: int = _skip_ws(json, 0)
    if pos >= len(json) {
        raise ValueError("empty JSON input")
    }
    const remaining: int = len(json) - pos
    if remaining >= 4 {
        if json[pos:pos + 4] == "true" {
            return true
        }
    }
    if remaining >= 5 {
        if json[pos:pos + 5] == "false" {
            return false
        }
    }
    raise ValueError("expected 'true' or 'false'")
}

def loads_is_null(json: str) -> bool {
    # Check if the JSON value is null. Returns true if input is: null
    pos: int = _skip_ws(json, 0)
    const remaining: int = len(json) - pos
    if remaining >= 4 {
        if json[pos:pos + 4] == "null" {
            return true
        }
    }
    return false
}

def loads_list_str(json: str) -> list[str] {
    # Parse a JSON array of strings. Input should be like: ["a", "b", "c"]
    result: list[str] = []
    pos: int = _skip_ws(json, 0)
    if pos >= len(json) {
        raise ValueError("empty JSON input")
    }
    if json[pos:pos + 1] != "[" {
        raise ValueError("expected '[' at start of JSON array")
    }
    pos = pos + 1
    pos = _skip_ws(json, pos)

    # Handle empty array
    if pos < len(json) {
        if json[pos:pos + 1] == "]" {
            return result
        }
    }

    # Parse elements
    while pos < len(json) {
        pos = _skip_ws(json, pos)
        if pos >= len(json) {
            raise ValueError("unexpected end of JSON array")
        }

        # Parse string element
        const val: str = _parse_string_value(json, pos)
        result.append(val)
        pos = _find_string_end(json, pos)

        # Skip whitespace, then comma or closing bracket
        pos = _skip_ws(json, pos)
        if pos >= len(json) {
            raise ValueError("unexpected end of JSON array")
        }
        const ch: str = json[pos:pos + 1]
        if ch == "]" {
            return result
        }
        if ch == "," {
            pos = pos + 1
        } else {
            raise ValueError("expected ',' or ']' in JSON array")
        }
    }
    raise ValueError("unterminated JSON array")
}

def loads_list_int(json: str) -> list[int] {
    # Parse a JSON array of integers. Input should be like: [1, 2, 3]
    result: list[int] = []
    pos: int = _skip_ws(json, 0)
    if pos >= len(json) {
        raise ValueError("empty JSON input")
    }
    if json[pos:pos + 1] != "[" {
        raise ValueError("expected '[' at start of JSON array")
    }
    pos = pos + 1
    pos = _skip_ws(json, pos)

    # Handle empty array
    if pos < len(json) {
        if json[pos:pos + 1] == "]" {
            return result
        }
    }

    # Parse elements
    while pos < len(json) {
        pos = _skip_ws(json, pos)
        if pos >= len(json) {
            raise ValueError("unexpected end of JSON array")
        }

        # Parse integer element
        const num_str: str = _parse_number_str(json, pos)
        result.append(dragon_str_to_int(num_str))
        pos = _find_number_end(json, pos)

        # Skip whitespace, then comma or closing bracket
        pos = _skip_ws(json, pos)
        if pos >= len(json) {
            raise ValueError("unexpected end of JSON array")
        }
        const ch: str = json[pos:pos + 1]
        if ch == "]" {
            return result
        }
        if ch == "," {
            pos = pos + 1
        } else {
            raise ValueError("expected ',' or ']' in JSON array")
        }
    }
    raise ValueError("unterminated JSON array")
}

def loads_list_float(json: str) -> list[float] {
    # Parse a JSON array of floats. Input should be like: [1.5, 2.7, 3.14]
    result: list[float] = []
    pos: int = _skip_ws(json, 0)
    if pos >= len(json) {
        raise ValueError("empty JSON input")
    }
    if json[pos:pos + 1] != "[" {
        raise ValueError("expected '[' at start of JSON array")
    }
    pos = pos + 1
    pos = _skip_ws(json, pos)

    # Handle empty array
    if pos < len(json) {
        if json[pos:pos + 1] == "]" {
            return result
        }
    }

    # Parse elements
    while pos < len(json) {
        pos = _skip_ws(json, pos)
        if pos >= len(json) {
            raise ValueError("unexpected end of JSON array")
        }

        # Parse float element
        const num_str: str = _parse_number_str(json, pos)
        result.append(dragon_str_to_float(num_str))
        pos = _find_number_end(json, pos)

        # Skip whitespace, then comma or closing bracket
        pos = _skip_ws(json, pos)
        if pos >= len(json) {
            raise ValueError("unexpected end of JSON array")
        }
        const ch: str = json[pos:pos + 1]
        if ch == "]" {
            return result
        }
        if ch == "," {
            pos = pos + 1
        } else {
            raise ValueError("expected ',' or ']' in JSON array")
        }
    }
    raise ValueError("unterminated JSON array")
}

def loads_list_bool(json: str) -> list[bool] {
    # Parse a JSON array of booleans. Input should be like: [true, false, true]
    result: list[bool] = []
    pos: int = _skip_ws(json, 0)
    if pos >= len(json) {
        raise ValueError("empty JSON input")
    }
    if json[pos:pos + 1] != "[" {
        raise ValueError("expected '[' at start of JSON array")
    }
    pos = pos + 1
    pos = _skip_ws(json, pos)

    # Handle empty array
    if pos < len(json) {
        if json[pos:pos + 1] == "]" {
            return result
        }
    }

    # Parse elements
    while pos < len(json) {
        pos = _skip_ws(json, pos)
        if pos >= len(json) {
            raise ValueError("unexpected end of JSON array")
        }

        # Parse boolean element
        const remaining: int = len(json) - pos
        if remaining >= 4 {
            if json[pos:pos + 4] == "true" {
                result.append(true)
                pos = pos + 4
            } else {
                if remaining >= 5 {
                    if json[pos:pos + 5] == "false" {
                        result.append(false)
                        pos = pos + 5
                    } else {
                        raise ValueError("expected 'true' or 'false' in JSON array")
                    }
                } else {
                    raise ValueError("expected 'true' or 'false' in JSON array")
                }
            }
        } else {
            raise ValueError("expected 'true' or 'false' in JSON array")
        }

        # Skip whitespace, then comma or closing bracket
        pos = _skip_ws(json, pos)
        if pos >= len(json) {
            raise ValueError("unexpected end of JSON array")
        }
        const ch: str = json[pos:pos + 1]
        if ch == "]" {
            return result
        }
        if ch == "," {
            pos = pos + 1
        } else {
            raise ValueError("expected ',' or ']' in JSON array")
        }
    }
    raise ValueError("unterminated JSON array")
}

# Value type detection

# JSON type constants
const JSON_NULL: int = 0
const JSON_BOOL: int = 1
const JSON_INT: int = 2
const JSON_FLOAT: int = 3
const JSON_STRING: int = 4
const JSON_ARRAY: int = 5
const JSON_OBJECT: int = 6

def detect_type(json: str) -> int {
    # Detect the JSON value type at the string start (returns a JSON_* constant).
    pos: int = _skip_ws(json, 0)
    if pos >= len(json) {
        return JSON_NULL
    }
    const ch: str = json[pos:pos + 1]
    if ch == "\"" {
        return JSON_STRING
    }
    if ch == "[" {
        return JSON_ARRAY
    }
    if ch == "{" {
        return JSON_OBJECT
    }
    if ch == "t" {
        return JSON_BOOL
    }
    if ch == "f" {
        return JSON_BOOL
    }
    if ch == "n" {
        return JSON_NULL
    }
    # Must be a number - check if it contains a decimal point or exponent
    const num_str: str = _parse_number_str(json, pos)
    i: int = 0
    while i < len(num_str) {
        const nc: str = num_str[i:i + 1]
        if nc == "." {
            return JSON_FLOAT
        }
        if nc == "e" {
            return JSON_FLOAT
        }
        if nc == "E" {
            return JSON_FLOAT
        }
        i = i + 1
    }
    return JSON_INT
}


# Generic decode loads -> Any (D048): byte-scanning recursive descent, zero
# per-char allocation. Materializes a boxed tree (the convenience tier; decode[T] is box-free).

# ASCII byte constants for the structural tokens.
const _B_LBRACE: int = 123       # {
const _B_RBRACE: int = 125       # }
const _B_LBRACKET: int = 91      # [
const _B_RBRACKET: int = 93      # ]
const _B_QUOTE: int = 34         # "
const _B_COLON: int = 58         # :
const _B_COMMA: int = 44         # ,
const _B_BACKSLASH: int = 92     # \
const _B_MINUS: int = 45         # -

def _is_ws_byte(c: int) -> bool {
    return c == 32 or c == 9 or c == 10 or c == 13     # space tab nl cr
}

def _is_digit_byte(c: int) -> bool {
    return c >= 48 and c <= 57
}

class _JsonParser {
    buf: bytes
    pos: int
    n: int

    def(buf: bytes) {
        self.buf = buf
        self.pos = 0
        self.n = len(buf)
    }

    def _fail(msg: str) -> None {
        raise ValueError(f"JSON decode error at byte {self.pos}: {msg}")
    }

    def _skip_ws() -> None {
        while self.pos < self.n {
            if _is_ws_byte(dragon_bytes_get(self.buf, self.pos)) {
                self.pos = self.pos + 1
            } else {
                break
            }
        }
    }

    # Current byte, or -1 at end of input.
    def _peek() -> int {
        if self.pos >= self.n {
            return -1
        }
        return dragon_bytes_get(self.buf, self.pos)
    }

    def parse_value() -> Any {
        self._skip_ws()
        const c: int = self._peek()
        if c < 0 {
            self._fail("unexpected end of input")
        }
        if c == _B_LBRACE { return self._parse_object() }
        if c == _B_LBRACKET { return self._parse_array() }
        if c == _B_QUOTE { return self._parse_string() }
        if c == 116 { return self._parse_keyword("true", 1) }     # t
        if c == 102 { return self._parse_keyword("false", 0) }    # f
        if c == 110 { return self._parse_keyword("null", -1) }    # n
        if c == _B_MINUS or _is_digit_byte(c) { return self._parse_number() }
        self._fail("unexpected character")
        return none     # unreachable (_fail raised); satisfies all-paths-return
    }

    # kind: 1 -> bool true, 0 -> bool false, -1 -> null.
    def _parse_keyword(word: str, kind: int) -> Any {
        const wlen: int = len(word)
        if self.pos + wlen > self.n {
            self._fail("truncated literal")
        }
        const wb: bytes = word.encode("utf-8")
        i: int = 0
        while i < wlen {
            if dragon_bytes_get(self.buf, self.pos + i) != dragon_bytes_get(wb, i) {
                self._fail("invalid literal")
            }
            i = i + 1
        }
        self.pos = self.pos + wlen
        if kind == 1 {
            return true
        }
        if kind == 0 {
            return false
        }
        return none
    }

    def _parse_string() -> str {
        # self.pos is at the opening quote.
        self.pos = self.pos + 1
        const start: int = self.pos
        while self.pos < self.n {
            const c: int = dragon_bytes_get(self.buf, self.pos)
            if c == _B_BACKSLASH {
                # Skip the backslash + its escaped byte; \uXXXX hex digits stay in
                # the span and unescape() decodes them.
                self.pos = self.pos + 2
                continue
            }
            if c == _B_QUOTE {
                break
            }
            self.pos = self.pos + 1
        }
        if self.pos >= self.n {
            self._fail("unterminated string")
        }
        const span: bytes = self.buf[start:self.pos]
        self.pos = self.pos + 1             # consume closing quote
        return unescape(span.decode("utf-8"))
    }

    def _parse_number() -> Any {
        # Validate the number grammar (-? int (.frac)? ([eE][+-]?exp)?) so a malformed
        # number raises instead of dragon_str_to_float returning a partial value.
        const start: int = self.pos
        is_float: bool = false
        if self._peek() == _B_MINUS {
            self.pos = self.pos + 1
        }
        # Integer part - at least one digit required.
        int_digits: int = 0
        while self.pos < self.n and _is_digit_byte(dragon_bytes_get(self.buf, self.pos)) {
            self.pos = self.pos + 1
            int_digits = int_digits + 1
        }
        if int_digits == 0 {
            self._fail("invalid number: no integer digits")
        }
        # Fraction - '.' must be followed by at least one digit.
        if self.pos < self.n and dragon_bytes_get(self.buf, self.pos) == 46 {   # .
            is_float = true
            self.pos = self.pos + 1
            frac_digits: int = 0
            while self.pos < self.n and _is_digit_byte(dragon_bytes_get(self.buf, self.pos)) {
                self.pos = self.pos + 1
                frac_digits = frac_digits + 1
            }
            if frac_digits == 0 {
                self._fail("invalid number: no digits after '.'")
            }
        }
        # Exponent - [eE] [+-]? must be followed by at least one digit.
        if self.pos < self.n {
            const ec: int = dragon_bytes_get(self.buf, self.pos)
            if ec == 101 or ec == 69 {                 # e E
                is_float = true
                self.pos = self.pos + 1
                if self.pos < self.n {
                    const sg: int = dragon_bytes_get(self.buf, self.pos)
                    if sg == 43 or sg == 45 {          # + -
                        self.pos = self.pos + 1
                    }
                }
                exp_digits: int = 0
                while self.pos < self.n and _is_digit_byte(dragon_bytes_get(self.buf, self.pos)) {
                    self.pos = self.pos + 1
                    exp_digits = exp_digits + 1
                }
                if exp_digits == 0 {
                    self._fail("invalid number: no digits in exponent")
                }
            }
        }
        const span: str = self.buf[start:self.pos].decode("utf-8")
        if is_float {
            return dragon_str_to_float(span)
        }
        return dragon_str_to_int(span)
    }

    def _parse_array() -> list[Any] {
        const arr: list[Any] = []
        self.pos = self.pos + 1             # consume [
        self._skip_ws()
        if self._peek() == _B_RBRACKET {
            self.pos = self.pos + 1
            return arr
        }
        while true {
            const v: Any = self.parse_value()
            arr.append(v)
            self._skip_ws()
            const c: int = self._peek()
            if c == _B_COMMA {
                self.pos = self.pos + 1
                continue
            }
            if c == _B_RBRACKET {
                self.pos = self.pos + 1
                break
            }
            self._fail("expected ',' or ']' in array")
        }
        return arr
    }

    def _parse_object() -> dict[str, Any] {
        const obj: dict[str, Any] = {}
        self.pos = self.pos + 1             # consume {
        self._skip_ws()
        if self._peek() == _B_RBRACE {
            self.pos = self.pos + 1
            return obj
        }
        while true {
            self._skip_ws()
            if self._peek() != _B_QUOTE {
                self._fail("expected string key in object")
            }
            const key: str = self._parse_string()
            self._skip_ws()
            if self._peek() != _B_COLON {
                self._fail("expected ':' after object key")
            }
            self.pos = self.pos + 1         # consume :
            const v: Any = self.parse_value()
            obj[key] = v
            self._skip_ws()
            const c: int = self._peek()
            if c == _B_COMMA {
                self.pos = self.pos + 1
                continue
            }
            if c == _B_RBRACE {
                self.pos = self.pos + 1
                break
            }
            self._fail("expected ',' or '}' in object")
        }
        return obj
    }
}

# D048 box-free cursor: reads native slots instead of a boxed Any tree. Driven
# by the compiler-emitted decode[T] skeleton; skip_value() allocates nothing.
class Cursor {
    p: _JsonParser
    _need_comma: bool

    def(buf: bytes) {
        self.p = _JsonParser(buf)
        self._need_comma = false
    }

    # Consume '{' or raise.
    def begin_object() -> None {
        self.p._skip_ws()
        if self.p._peek() != _B_LBRACE {
            self.p._fail("expected '{' at start of object")
        }
        self.p.pos = self.p.pos + 1
        self._need_comma = false
    }

    # True and advance to the next key; false consumes the closing '}'.
    def next_field() -> bool {
        self.p._skip_ws()
        const c: int = self.p._peek()
        if c == _B_RBRACE {
            self.p.pos = self.p.pos + 1
            return false
        }
        if self._need_comma {
            if c == _B_COMMA {
                self.p.pos = self.p.pos + 1
                self.p._skip_ws()
            } else {
                self.p._fail("expected ',' or '}' in object")
            }
        }
        self._need_comma = true
        return true
    }

    # Parse "key" and the following ':'; return the key.
    def field_key() -> str {
        self.p._skip_ws()
        if self.p._peek() != _B_QUOTE {
            self.p._fail("expected string key in object")
        }
        const k: str = self.p._parse_string()
        self.p._skip_ws()
        if self.p._peek() != _B_COLON {
            self.p._fail("expected ':' after object key")
        }
        self.p.pos = self.p.pos + 1
        return k
    }

    def parse_str() -> str {
        self.p._skip_ws()
        if self.p._peek() != _B_QUOTE {
            self.p._fail("expected string value")
        }
        return self.p._parse_string()
    }

    def parse_int() -> int {
        self.p._skip_ws()
        const start: int = self.p.pos
        const is_float: bool = self._scan_number()
        if is_float {
            self.p._fail("expected integer, got a number with a fraction/exponent")
        }
        return dragon_str_to_int(self.p.buf[start:self.p.pos].decode("utf-8"))
    }

    def parse_float() -> float {
        self.p._skip_ws()
        const start: int = self.p.pos
        self._scan_number()
        return dragon_str_to_float(self.p.buf[start:self.p.pos].decode("utf-8"))
    }

    def parse_bool() -> bool {
        self.p._skip_ws()
        const c: int = self.p._peek()
        if c == 116 {                       # t
            self._expect_lit("true")
            return true
        }
        if c == 102 {                       # f
            self._expect_lit("false")
            return false
        }
        self.p._fail("expected boolean")
        return false                        # unreachable (_fail raised)
    }

    # Consume '[' or raise.
    def array_begin() -> None {
        self.p._skip_ws()
        if self.p._peek() != _B_LBRACKET {
            self.p._fail("expected array")
        }
        self.p.pos = self.p.pos + 1
    }

    # True if another element follows; false consumes the closing ']'.
    def array_more(first: bool) -> bool {
        self.p._skip_ws()
        const c: int = self.p._peek()
        if c == _B_RBRACKET {
            self.p.pos = self.p.pos + 1
            return false
        }
        if first {
            return true
        }
        if c == _B_COMMA {
            self.p.pos = self.p.pos + 1
            return true
        }
        self.p._fail("expected ',' or ']' in array")
        return false
    }

    def parse_int_list() -> list[int] {
        const out: list[int] = []
        self.array_begin()
        first: bool = true
        while self.array_more(first) {
            first = false
            out.append(self.parse_int())
        }
        return out
    }

    def parse_float_list() -> list[float] {
        const out: list[float] = []
        self.array_begin()
        first: bool = true
        while self.array_more(first) {
            first = false
            out.append(self.parse_float())
        }
        return out
    }

    def parse_bool_list() -> list[bool] {
        const out: list[bool] = []
        self.array_begin()
        first: bool = true
        while self.array_more(first) {
            first = false
            out.append(self.parse_bool())
        }
        return out
    }

    def parse_str_list() -> list[str] {
        const out: list[str] = []
        self.array_begin()
        first: bool = true
        while self.array_more(first) {
            first = false
            out.append(self.parse_str())
        }
        return out
    }

    # dict[str, scalar] parsers. begin_object/next_field reset _need_comma, so a
    # completed nested dict must leave it true for the ENCLOSING field loop.
    def parse_int_dict() -> dict[str, int] {
        const out: dict[str, int] = {}
        self.begin_object()
        while self.next_field() {
            const k: str = self.field_key()
            out[k] = self.parse_int()
        }
        self._need_comma = true
        return out
    }

    def parse_float_dict() -> dict[str, float] {
        const out: dict[str, float] = {}
        self.begin_object()
        while self.next_field() {
            const k: str = self.field_key()
            out[k] = self.parse_float()
        }
        self._need_comma = true
        return out
    }

    def parse_bool_dict() -> dict[str, bool] {
        const out: dict[str, bool] = {}
        self.begin_object()
        while self.next_field() {
            const k: str = self.field_key()
            out[k] = self.parse_bool()
        }
        self._need_comma = true
        return out
    }

    def parse_str_dict() -> dict[str, str] {
        const out: dict[str, str] = {}
        self.begin_object()
        while self.next_field() {
            const k: str = self.field_key()
            out[k] = self.parse_str()
        }
        self._need_comma = true
        return out
    }

    # If the next value is null, consume it and return true.
    def try_null() -> bool {
        self.p._skip_ws()
        if self.p._peek() == 110 {          # n
            self._expect_lit("null")
            return true
        }
        return false
    }

    # Skip the next value and return its raw bytes (for a nested decode[T]).
    def capture_value() -> bytes {
        self.p._skip_ws()
        const start: int = self.p.pos
        self.skip_value()
        return self.p.buf[start:self.p.pos]
    }

    # Advance past any value; allocates nothing.
    def skip_value() -> None {
        self.p._skip_ws()
        const c: int = self.p._peek()
        if c < 0 {
            self.p._fail("unexpected end of input")
        }
        if c == _B_QUOTE { self._skip_string_span(); return }
        if c == _B_LBRACE { self._skip_object(); return }
        if c == _B_LBRACKET { self._skip_array(); return }
        if c == 116 { self._expect_lit("true"); return }        # t
        if c == 102 { self._expect_lit("false"); return }       # f
        if c == 110 { self._expect_lit("null"); return }        # n
        if c == _B_MINUS or _is_digit_byte(c) {
            self._scan_number()
            return
        }
        self.p._fail("unexpected character in value")
    }

    # Advance over a JSON number; true if it has a fraction/exponent.
    def _scan_number() -> bool {
        is_float: bool = false
        const b: bytes = self.p.buf
        const n: int = self.p.n
        if self.p._peek() == _B_MINUS {
            self.p.pos = self.p.pos + 1
        }
        int_digits: int = 0
        while self.p.pos < n and _is_digit_byte(dragon_bytes_get(b, self.p.pos)) {
            self.p.pos = self.p.pos + 1
            int_digits = int_digits + 1
        }
        if int_digits == 0 {
            self.p._fail("invalid number: no integer digits")
        }
        if self.p.pos < n and dragon_bytes_get(b, self.p.pos) == 46 {        # .
            is_float = true
            self.p.pos = self.p.pos + 1
            frac_digits: int = 0
            while self.p.pos < n and _is_digit_byte(dragon_bytes_get(b, self.p.pos)) {
                self.p.pos = self.p.pos + 1
                frac_digits = frac_digits + 1
            }
            if frac_digits == 0 {
                self.p._fail("invalid number: no digits after '.'")
            }
        }
        if self.p.pos < n {
            const ec: int = dragon_bytes_get(b, self.p.pos)
            if ec == 101 or ec == 69 {                                      # e E
                is_float = true
                self.p.pos = self.p.pos + 1
                if self.p.pos < n {
                    const sg: int = dragon_bytes_get(b, self.p.pos)
                    if sg == 43 or sg == 45 {                               # + -
                        self.p.pos = self.p.pos + 1
                    }
                }
                exp_digits: int = 0
                while self.p.pos < n and _is_digit_byte(dragon_bytes_get(b, self.p.pos)) {
                    self.p.pos = self.p.pos + 1
                    exp_digits = exp_digits + 1
                }
                if exp_digits == 0 {
                    self.p._fail("invalid number: no digits in exponent")
                }
            }
        }
        return is_float
    }

    # Skip a string span (pos at opening quote), escape-aware.
    def _skip_string_span() -> None {
        const b: bytes = self.p.buf
        const n: int = self.p.n
        self.p.pos = self.p.pos + 1                 # opening quote
        while self.p.pos < n {
            const c: int = dragon_bytes_get(b, self.p.pos)
            if c == _B_BACKSLASH {
                self.p.pos = self.p.pos + 2
                continue
            }
            if c == _B_QUOTE {
                break
            }
            self.p.pos = self.p.pos + 1
        }
        if self.p.pos >= n {
            self.p._fail("unterminated string")
        }
        self.p.pos = self.p.pos + 1                 # closing quote
    }

    # Verify and consume a bare literal (true/false/null).
    def _expect_lit(word: str) -> None {
        const wlen: int = len(word)
        if self.p.pos + wlen > self.p.n {
            self.p._fail("truncated literal")
        }
        const wb: bytes = word.encode("utf-8")
        i: int = 0
        while i < wlen {
            if dragon_bytes_get(self.p.buf, self.p.pos + i) != dragon_bytes_get(wb, i) {
                self.p._fail("invalid literal")
            }
            i = i + 1
        }
        self.p.pos = self.p.pos + wlen
    }

    # Skip an object (pos at '{'); keys skipped as spans so quoted braces don't miscount.
    def _skip_object() -> None {
        self.p.pos = self.p.pos + 1                 # consume {
        self.p._skip_ws()
        if self.p._peek() == _B_RBRACE {
            self.p.pos = self.p.pos + 1
            return
        }
        while true {
            self.p._skip_ws()
            if self.p._peek() != _B_QUOTE {
                self.p._fail("expected string key in object")
            }
            self._skip_string_span()
            self.p._skip_ws()
            if self.p._peek() != _B_COLON {
                self.p._fail("expected ':' after object key")
            }
            self.p.pos = self.p.pos + 1
            self.skip_value()
            self.p._skip_ws()
            const c: int = self.p._peek()
            if c == _B_COMMA {
                self.p.pos = self.p.pos + 1
                continue
            }
            if c == _B_RBRACE {
                self.p.pos = self.p.pos + 1
                break
            }
            self.p._fail("expected ',' or '}' in object")
        }
    }

    # Skip an array (pos at '[').
    def _skip_array() -> None {
        self.p.pos = self.p.pos + 1                 # consume [
        self.p._skip_ws()
        if self.p._peek() == _B_RBRACKET {
            self.p.pos = self.p.pos + 1
            return
        }
        while true {
            self.skip_value()
            self.p._skip_ws()
            const c: int = self.p._peek()
            if c == _B_COMMA {
                self.p.pos = self.p.pos + 1
                continue
            }
            if c == _B_RBRACKET {
                self.p.pos = self.p.pos + 1
                break
            }
            self.p._fail("expected ',' or ']' in array")
        }
    }
}


# Box-free streaming writer, the write-side mirror of Cursor: values written AT
# their type into one str buffer, joined once. (Not "Writer": io.Writer exists.)
class JsonWriter {
    _parts: list[str]
    _need_comma: bool

    def() {
        self._parts = []
        self._need_comma = false
    }

    # Emit the separating ',' when a sibling precedes; value writes leave the
    # flag set, key()/begin_*() clear it for what follows them.
    def _pre_value() -> None {
        if self._need_comma {
            self._parts.append(",")
        }
        self._need_comma = true
    }

    def begin_object() -> None {
        self._pre_value()
        self._parts.append("{")
        self._need_comma = false
    }

    def end_object() -> None {
        self._parts.append("}")
        self._need_comma = true
    }

    def begin_array() -> None {
        self._pre_value()
        self._parts.append("[")
        self._need_comma = false
    }

    def end_array() -> None {
        self._parts.append("]")
        self._need_comma = true
    }

    def key(name: str) -> None {
        self._pre_value()
        self._parts.append("\"")
        self._parts.append(escape(name))
        self._parts.append("\":")
        self._need_comma = false
    }

    def write_int(v: int) -> None {
        self._pre_value()
        self._parts.append(dragon_int_to_str(v))
    }

    def write_float(v: float) -> None {
        self._pre_value()
        self._parts.append(dragon_float_to_str(v))
    }

    def write_bool(v: bool) -> None {
        self._pre_value()
        if v {
            self._parts.append("true")
        } else {
            self._parts.append("false")
        }
    }

    def write_str(v: str) -> None {
        self._pre_value()
        self._parts.append("\"")
        self._parts.append(escape(v))
        self._parts.append("\"")
    }

    def write_null() -> None {
        self._pre_value()
        self._parts.append("null")
    }

    # Splice a pre-encoded JSON fragment verbatim (a nested encode[T] result).
    def write_raw(fragment: bytes) -> None {
        self._pre_value()
        self._parts.append(fragment.decode("utf-8"))
    }

    def write_int_list(items: list[int]) -> None {
        self.begin_array()
        i: int = 0
        while i < len(items) {
            self.write_int(items[i])
            i = i + 1
        }
        self.end_array()
    }

    def write_float_list(items: list[float]) -> None {
        self.begin_array()
        i: int = 0
        while i < len(items) {
            self.write_float(items[i])
            i = i + 1
        }
        self.end_array()
    }

    def write_bool_list(items: list[bool]) -> None {
        self.begin_array()
        i: int = 0
        while i < len(items) {
            self.write_bool(items[i])
            i = i + 1
        }
        self.end_array()
    }

    def write_str_list(items: list[str]) -> None {
        self.begin_array()
        i: int = 0
        while i < len(items) {
            self.write_str(items[i])
            i = i + 1
        }
        self.end_array()
    }

    def write_int_dict(items: dict[str, int]) -> None {
        self.begin_object()
        for k in items {
            self.key(k)
            self.write_int(items[k])
        }
        self.end_object()
    }

    def write_float_dict(items: dict[str, float]) -> None {
        self.begin_object()
        for k in items {
            self.key(k)
            self.write_float(items[k])
        }
        self.end_object()
    }

    def write_bool_dict(items: dict[str, bool]) -> None {
        self.begin_object()
        for k in items {
            self.key(k)
            self.write_bool(items[k])
        }
        self.end_object()
    }

    def write_str_dict(items: dict[str, str]) -> None {
        self.begin_object()
        for k in items {
            self.key(k)
            self.write_str(items[k])
        }
        self.end_object()
    }

    def finish() -> bytes {
        return "".join(self._parts).encode("utf-8")
    }
}


# D048 schema-directed decode into T. The compiler synthesizes each stamp's body
# from T's fields (one Cursor read per field); this template is never lowered.
def decode[T](body: bytes) -> T {
    raise ValueError("json.decode requires a concrete type: decode[T](body)")
}


# D052 mirror of decode: the compiler synthesizes each stamp from T's fields,
# one typed Writer call per field; this template is never lowered.
def encode[T](value: T) -> bytes {
    raise ValueError("json.encode requires a concrete type: encode[T](value)")
}


# Decode JSON bytes into a boxed Any tree (D048); raises ValueError with the byte
# offset on malformed input. Used by Request.json().
def loads_bytes(data: bytes) -> Any {
    const p: _JsonParser = _JsonParser(data)
    const v: Any = p.parse_value()
    p._skip_ws()
    if p.pos != p.n {
        p._fail("trailing data after JSON value")
    }
    return v
}

# Decode a JSON document (str) into a boxed Any tree. Python-parity name/shape.
def loads(s: str) -> Any {
    return loads_bytes(s.encode("utf-8"))
}

# Decode a JSON object into dict[str, Any] for the T(**loads_obj(s)) path (D047).
# Raises if the top-level value is not an object.
def loads_obj(s: str) -> dict[str, Any] {
    const v: Any = loads(s)
    if isinstance(v, dict) {
        const m: dict[str, Any] = v
        return m
    }
    raise ValueError("JSON top-level value is not an object")
}

# template[JSON] content type (D032 domain co-location). Auto-escapes each
# !{expr} as a JSON string body, then the compiler concatenates the segments.

class JSON(Template) {
    def(inner: str) {
        self._inner = inner
    }

    @staticmethod
    def escape(s: str) -> str {
        s = s.replace("\\", "\\\\")
        s = s.replace('"', '\\"')
        s = s.replace("\n", "\\n")
        s = s.replace("\r", "\\r")
        s = s.replace("\t", "\\t")
        return s
    }
}


# JSON Schema validation (Draft 7 subset) via the Schema class: type/enum/$ref,
# object required/properties, array items/min/maxItems, string + number bounds.

# The JSON kind of a runtime value, in JSON Schema's own vocabulary.
def _json_kind(v: Any) -> str {
    if isinstance(v, bool) {
        return "boolean"
    }
    if isinstance(v, int) {
        return "integer"
    }
    if isinstance(v, float) {
        return "number"
    }
    if isinstance(v, str) {
        return "string"
    }
    if isinstance(v, list) {
        return "array"
    }
    if isinstance(v, dict) {
        return "object"
    }
    return "null"
}


def _type_matches(want: str, kind: str) -> bool {
    if want == kind {
        return True
    }
    # JSON Schema: every integer is also a number.
    return want == "number" and kind == "integer"
}


# A numeric Any (int or float) as float, for bound comparisons.
def _num_val(v: Any) -> float {
    if isinstance(v, int) {
        const i: int = v
        return float(i)
    }
    const f: float = v
    return f
}


# Deep equality across two parsed JSON values (enum membership).
def _json_eq(a: Any, b: Any) -> bool {
    const ka: str = _json_kind(a)
    const kb: str = _json_kind(b)
    if ka != kb {
        return False
    }
    if ka == "null" {
        return True
    }
    if ka == "boolean" {
        const x: bool = a
        const y: bool = b
        return x == y
    }
    if ka == "integer" {
        const x: int = a
        const y: int = b
        return x == y
    }
    if ka == "number" {
        const x: float = a
        const y: float = b
        return x == y
    }
    if ka == "string" {
        const x: str = a
        const y: str = b
        return x == y
    }
    if ka == "array" {
        # Walk the Any values directly (header-dispatched len/subscript), so parsed
        # box lists and monomorphized Dragon lists compare alike.
        if len(a) != len(b) {
            return False
        }
        i: int = 0
        while i < len(a) {
            const xa: Any = a[i]
            const xb: Any = b[i]
            if not _json_eq(xa, xb) {
                return False
            }
            i = i + 1
        }
        return True
    }
    const xd: dict[str, Any] = a
    const yd: dict[str, Any] = b
    if len(xd) != len(yd) {
        return False
    }
    for k in xd {
        if not (k in yd) {
            return False
        }
        if not _json_eq(xd[k], yd[k]) {
            return False
        }
    }
    return True
}


# One violation: the JSON path of the offending value and what went wrong.
class ValidationError {
    path: str
    message: str

    def(path: str, message: str) {
        self.path = path
        self.message = message
    }
}


class ValidationResult {
    ok: bool
    errors: list[ValidationError]

    def(errors: list[ValidationError]) {
        self.errors = errors
        self.ok = len(errors) == 0
    }
}


# The walker. `refdepth` counts consecutive $ref hops (reset when the walk consumes
# structure), so a pure ref cycle is reported instead of overflowing the stack.
def _schema_check(schemas: dict[str, dict[str, Any]], schema: dict[str, Any],
                  value: Any, path: str, refdepth: int,
                  errors: list[ValidationError]) -> None {
    if "$ref" in schema {
        const refname: str = schema["$ref"]
        if refdepth >= 32 {
            errors.append(ValidationError(path, f"circular $ref chain at '{refname}'"))
            return
        }
        if not (refname in schemas) {
            errors.append(ValidationError(path, f"unknown $ref '{refname}'"))
            return
        }
        const target: dict[str, Any] = schemas[refname]
        _schema_check(schemas, target, value, path, refdepth + 1, errors)
        return
    }

    const kind: str = _json_kind(value)

    if "type" in schema {
        matched: bool = False
        want: str = ""
        const tv: Any = schema["type"]
        if isinstance(tv, str) {
            const t: str = tv
            want = t
            matched = _type_matches(t, kind)
        }
        if isinstance(tv, list) {
            names: list[str] = []
            for t0 in tv {
                const t1: str = t0
                names.append(t1)
                if _type_matches(t1, kind) {
                    matched = True
                }
            }
            want = " or ".join(names)
        }
        if not matched {
            errors.append(ValidationError(path, f"expected {want}, got {kind}"))
            # The wrong kind - none of the kind-specific keywords below apply.
            return
        }
    }

    if "enum" in schema {
        const allowed: Any = schema["enum"]
        found: bool = False
        for a in allowed {
            if _json_eq(a, value) {
                found = True
            }
        }
        if not found {
            errors.append(ValidationError(path, "value not in enum"))
        }
    }

    if kind == "string" {
        const s: str = value
        if "minLength" in schema {
            const m: int = schema["minLength"]
            if len(s) < m {
                errors.append(ValidationError(path, f"string shorter than minLength {m}"))
            }
        }
        if "maxLength" in schema {
            const m: int = schema["maxLength"]
            if len(s) > m {
                errors.append(ValidationError(path, f"string longer than maxLength {m}"))
            }
        }
    }

    if kind == "integer" or kind == "number" {
        const n: float = _num_val(value)
        if "minimum" in schema {
            const m: float = _num_val(schema["minimum"])
            if n < m {
                errors.append(ValidationError(path, "value below minimum"))
            }
        }
        if "maximum" in schema {
            const m: float = _num_val(schema["maximum"])
            if n > m {
                errors.append(ValidationError(path, "value above maximum"))
            }
        }
    }

    if kind == "array" {
        # Size/iterate the Any value directly (header-dispatched), so parsed box
        # lists and monomorphized Dragon lists validate identically.
        if "minItems" in schema {
            const m: int = schema["minItems"]
            if len(value) < m {
                errors.append(ValidationError(path, f"fewer than minItems {m}"))
            }
        }
        if "maxItems" in schema {
            const m: int = schema["maxItems"]
            if len(value) > m {
                errors.append(ValidationError(path, f"more than maxItems {m}"))
            }
        }
        if "items" in schema {
            const isch: dict[str, Any] = schema["items"]
            i: int = 0
            for x in value {
                _schema_check(schemas, isch, x, f"{path}[{i}]", 0, errors)
                i = i + 1
            }
        }
    }

    if kind == "object" {
        const obj: dict[str, Any] = value
        if "required" in schema {
            const req: Any = schema["required"]
            for r in req {
                const name: str = r
                if not (name in obj) {
                    errors.append(ValidationError(f"{path}.{name}", "required property missing"))
                }
            }
        }
        if "properties" in schema {
            const props: dict[str, Any] = schema["properties"]
            for name in props {
                if name in obj {
                    const sub: dict[str, Any] = props[name]
                    _schema_check(schemas, sub, obj[name], f"{path}.{name}", 0, errors)
                }
            }
        }
    }
}


# Schema validation entry point: owns a registry of named schemas ($ref by name).
# Register at startup (it mutates); validation is read-only and safe to share.
class Schema {
    _dialect: str
    _schemas: dict[str, dict[str, Any]]

    def(dialect: str) {
        const d: str = dialect.strip().lower()
        ok: bool = d == "draft-07" or d == "draft-7" or d == "draft7" or
                   d == "draft 7" or d == "2019-09" or d == "2020-12" or
                   d == "latest"
        if not ok {
            raise ValueError(f"unknown JSON Schema dialect '{dialect}'")
        }
        self._dialect = d
        self._schemas = {}
    }

    def register(name: str, schema: dict[str, Any]) -> None {
        self._schemas[name] = schema
    }

    def validate(name: str, payload: Any) -> ValidationResult {
        const s: dict[str, Any] = self._schemas[name]
        errors: list[ValidationError] = []
        _schema_check(self._schemas, s, payload, "$", 0, errors)
        return ValidationResult(errors)
    }
}

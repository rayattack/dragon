"""io.dr - file I/O over C stdio (extern "C", intc for ABI correctness): Reader/Writer
with context-manager support, plus the in-memory BytesIO/StringIO streams.
"""

extern "C" def fopen(path: str, mode: str) -> ptr
extern "C" def fclose(handle: ptr) -> intc
extern "C" def fread(buf: ptr, size: int, count: int, handle: ptr) -> int
extern "C" def fwrite(buf: str, size: int, count: int, handle: ptr) -> int
extern "C" def fseek(handle: ptr, offset: int, whence: intc) -> intc
extern "C" def ftell(handle: ptr) -> int
extern "C" def fflush(handle: ptr) -> intc
extern "C" def feof(handle: ptr) -> intc
extern "C" def ferror(handle: ptr) -> intc
extern "C" def rewind(handle: ptr)
extern "C" def fgets(buf: ptr, size: intc, handle: ptr) -> ptr
extern "C" def fputs(s: str, handle: ptr) -> intc
extern "C" def fgetc(handle: ptr) -> intc
extern "C" def fileno(handle: ptr) -> intc
extern "C" def ftruncate(fd: intc, length: int) -> intc
extern "C" def isatty(fd: intc) -> intc

# Memory
extern "C" def malloc(size: int) -> ptr
extern "C" def free(p: ptr)
extern "C" def memset(s: ptr, c: intc, n: int) -> ptr
extern "C" def strlen(s: ptr) -> int

# Wraps a raw byte buffer into a heap-tracked DragonString: a bare malloc'd ptr
# returned as `str` has no DragonObjectHeader, so scope-exit decref would free a
# misaligned address. Auto-detects ASCII (kind=1) vs UTF-8 (kind=4, one cp per slot).
extern "C" def dragon_string_alloc(src: ptr, byte_len: int) -> str

# Wraps a raw byte buffer as verbatim `bytes` (no codec), so binary reads don't
# silently UTF-8-decode (and corrupt) arbitrary bytes.
extern "C" def dragon_bytes_new(data: ptr, len: int) -> bytes

# UTF-8-safe file helpers: read_text never splits a code point mid-sequence, write_text
# encodes to UTF-8 before writing, readline has no line-length cap. See runtime_fileio.cpp.
extern "C" def dragon_file_read_text(handle: ptr, size: int) -> str
extern "C" def dragon_file_write_text(handle: ptr, s: str) -> int
extern "C" def dragon_file_write_bytes(handle: ptr, data: bytes) -> int
extern "C" def dragon_file_readline(handle: ptr) -> str

const SEEK_SET: int = 0
const SEEK_CUR: int = 1
const SEEK_END: int = 2

# Reader (open()): read-only by type, writing is a compile error. Whole-file reads
# self-close (leak-free, no `with`); streaming reads (line/take, for-loop) need `with open(p) as r`.
class Reader {
    def(path: str) {
        self.handle = fopen(path, "r")
        # fopen returns NULL on a missing file/bad path/perms; raise catchable FileNotFoundError.
        if not self.handle {
            raise FileNotFoundError("[Errno 2] No such file or directory: '" + path + "'")
        }
        self.path = path
        self.closed = false
    }

    def text() -> str {
        # Whole file as UTF-8 text, then close (the file is consumed).
        if self.closed {
            return ""
        }
        fseek(self.handle, 0, SEEK_END)
        const size: int = ftell(self.handle)
        fseek(self.handle, 0, SEEK_SET)
        const buf: ptr = malloc(size + 1)
        memset(buf, 0, size + 1)
        const n: int = fread(buf, 1, size, self.handle)
        const result: str = dragon_string_alloc(buf, n)
        free(buf)
        self.close()
        return result
    }

    def bytes() -> bytes {
        # Whole file as raw bytes (no UTF-8 decode), then close.
        if self.closed {
            return b""
        }
        fseek(self.handle, 0, SEEK_END)
        const size: int = ftell(self.handle)
        fseek(self.handle, 0, SEEK_SET)
        const buf: ptr = malloc(size + 1)
        const n: int = fread(buf, 1, size, self.handle)
        const result: bytes = dragon_bytes_new(buf, n)
        free(buf)
        self.close()
        return result
    }

    def lines() -> list[str] {
        # Every line (each keeps its trailing newline), then close.
        out: list[str] = []
        if self.closed {
            return out
        }
        while true {
            const line: str = dragon_file_readline(self.handle)
            if len(line) == 0 { break }
            out.append(line)
        }
        self.close()
        return out
    }

    def line() -> str {
        # One line with trailing newline, "" at EOF. Streaming: does not close.
        if self.closed {
            return ""
        }
        return dragon_file_readline(self.handle)
    }

    def take(n: int) -> str {
        # Up to n bytes of text; never splits a UTF-8 code point (the runtime
        # tops up trailing continuation bytes). Streaming - does not close.
        if self.closed {
            return ""
        }
        return dragon_file_read_text(self.handle, n)
    }

    def close() -> int {
        # Idempotent: a self-close in text()/bytes()/lines() plus a `with` exit must never double-fclose.
        if self.closed {
            return 0
        }
        self.closed = true
        return fclose(self.handle)
    }

    def __enter__() -> Reader {
        return self
    }

    def __exit__() -> int {
        self.close()
        return 0
    }

    def __iter__() -> Reader {
        return self
    }

    def __next__() -> str {
        # `for line in open(p)` - lazy, one line per iteration, memory-bounded.
        if self.closed {
            raise StopIteration("end of file")
        }
        const ln: str = dragon_file_readline(self.handle)
        if len(ln) == 0 {
            raise StopIteration("end of file")
        }
        return ln
    }
}

# Writer (make()/push()): write-only by type, reading is a compile error. Dragon has no
# finalizer, so scope it with `with make(p) as w { ... }` or close explicitly, else it leaks.
class Writer {
    def(path: str, mode: str) {
        self.handle = fopen(path, mode)
        if not self.handle {
            raise FileNotFoundError("[Errno 2] No such file or directory: '" + path + "'")
        }
        self.path = path
        self.closed = false
    }

    def write(data: str) -> int {
        # UTF-8-encode the text before writing (a bare fwrite of a non-ASCII
        # str would emit its raw UCS-4 buffer).
        return dragon_file_write_text(self.handle, data)
    }

    def write(data: bytes) -> int {
        # Verbatim binary write - no codec touches the buffer.
        return dragon_file_write_bytes(self.handle, data)
    }

    def line(data: str) -> int {
        const a: int = self.write(data)
        const b: int = self.write("\n")
        return a + b
    }

    def lines(items: list[str]) -> int {
        # Write each item verbatim (no separators added). Returns total bytes.
        total: int = 0
        for item in items {
            total = total + self.write(item)
        }
        return total
    }

    def flush() -> int {
        return fflush(self.handle)
    }

    def close() -> int {
        if self.closed {
            return 0
        }
        self.closed = true
        return fclose(self.handle)
    }

    def __enter__() -> Writer {
        return self
    }

    def __exit__() -> int {
        self.close()
        return 0
    }
}

# BytesIO - growable in-memory binary stream over the File read/seek API. Append-only
# writes join once in list[bytes] (O(n) not per-byte); materialized on read()/getvalue().
class BytesIO {
    def(initial: bytes = b"") {
        self._chunks: list[bytes] = []
        if len(initial) > 0 {
            self._chunks.append(initial)
        }
        self._len: int = len(initial)
        self._pos: int = 0
        self._flat: bytes = initial
        self._dirty: bool = false
    }

    def _join() -> bytes {
        if self._dirty {
            self._flat = b"".join(self._chunks)
            self._dirty = false
        }
        return self._flat
    }

    def write(data: bytes) -> int {
        const n: int = len(data)
        if self._pos >= self._len {
            # Append at end - fast path, defer the join.
            self._chunks.append(data)
            self._len = self._len + n
            self._pos = self._len
            self._dirty = true
        } else {
            # Overwrite at the cursor - flatten once and splice.
            const cur: bytes = self._join()
            const head: bytes = cur[0:self._pos]
            const tail_start: int = self._pos + n
            tail: bytes = b""
            if tail_start < len(cur) {
                tail = cur[tail_start:len(cur)]
            }
            self._flat = head + data + tail
            self._chunks = []
            self._chunks.append(self._flat)
            self._len = len(self._flat)
            self._pos = self._pos + n
            self._dirty = false
        }
        return n
    }

    def read(size: int = -1) -> bytes {
        const cur: bytes = self._join()
        const total: int = self._len
        if self._pos >= total {
            return b""
        }
        end: int = total
        if size >= 0 {
            const want: int = self._pos + size
            if want < total {
                end = want
            }
        }
        const out: bytes = cur[self._pos:end]
        self._pos = end
        return out
    }

    def getvalue() -> bytes {
        return self._join()
    }

    def seek(offset: int, whence: int = SEEK_SET) -> int {
        pos: int = offset
        if whence == SEEK_SET {
            if offset < 0 {
                raise ValueError(f"negative seek value {offset}")
            }
        } elif whence == SEEK_CUR {
            pos = self._pos + offset
        } else {
            pos = self._len + offset
        }
        if pos < 0 {
            pos = 0
        }
        self._pos = pos
        return self._pos
    }

    def tell() -> int {
        return self._pos
    }

    def truncate(size: int = -1) -> int {
        const cur: bytes = self._join()
        target: int = size
        if size < 0 {
            target = self._pos
        }
        if target < self._len {
            self._flat = cur[0:target]
            self._chunks = []
            self._chunks.append(self._flat)
            self._len = target
            self._dirty = false
        }
        return target
    }

    def readable() -> bool { return true }
    def writable() -> bool { return true }
    def seekable() -> bool { return true }

    def close() -> int { return 0 }

    def __enter__() -> BytesIO { return self }
    def __exit__() -> int { return 0 }
}

# StringIO - growable text buffer over the File API. Append-only writes join once in
# list[str] (O(n) not O(n^2)); seek()/tell() count CODE POINTS, unlike CPython's opaque cookie.
class StringIO {
    def(initial: str = "") {
        self._chunks: list[str] = []
        if len(initial) > 0 {
            self._chunks.append(initial)
        }
        self._len: int = len(initial)
        self._pos: int = 0
        self._flat: str = initial
        self._dirty: bool = false
    }

    def _join() -> str {
        if self._dirty {
            self._flat = "".join(self._chunks)
            self._dirty = false
        }
        return self._flat
    }

    def write(s: str) -> int {
        const slen: int = len(s)
        if self._pos == self._len {
            # Append at end - fast path, defer the join.
            self._chunks.append(s)
            self._len = self._len + slen
            self._pos = self._len
            self._dirty = true
        } else {
            # Overwrite at the cursor - flatten once and splice.
            const cur: str = self._join()
            const head: str = cur[0:self._pos]
            const tail_start: int = self._pos + slen
            tail: str = ""
            if tail_start < len(cur) {
                tail = cur[tail_start:len(cur)]
            }
            self._flat = head + s + tail
            self._chunks = []
            self._chunks.append(self._flat)
            self._len = len(self._flat)
            self._pos = self._pos + slen
            self._dirty = false
        }
        return slen
    }

    def getvalue() -> str {
        return self._join()
    }

    def read(size: int = -1) -> str {
        const cur: str = self._join()
        const total: int = self._len
        if self._pos >= total {
            return ""
        }
        end: int = total
        if size >= 0 {
            const want: int = self._pos + size
            if want < total {
                end = want
            }
        }
        const out: str = cur[self._pos:end]
        self._pos = end
        return out
    }

    def readline() -> str {
        const cur: str = self._join()
        const total: int = self._len
        if self._pos >= total {
            return ""
        }
        i: int = self._pos
        while i < total {
            if cur[i:i + 1] == "\n" {
                break
            }
            i = i + 1
        }
        end: int = i
        if i < total {
            end = i + 1
        }
        const out: str = cur[self._pos:end]
        self._pos = end
        return out
    }

    def readlines() -> list[str] {
        out: list[str] = []
        while true {
            const ln: str = self.readline()
            if len(ln) == 0 { break }
            out.append(ln)
        }
        return out
    }

    def writelines(lines: list[str]) -> int {
        total: int = 0
        for line in lines {
            total = total + self.write(line)
        }
        return total
    }

    def seek(offset: int, whence: int = SEEK_SET) -> int {
        if whence == SEEK_SET {
            self._pos = offset
        } elif whence == SEEK_CUR {
            self._pos = self._pos + offset
        } else {
            self._pos = self._len + offset
        }
        return self._pos
    }

    def tell() -> int {
        return self._pos
    }

    def truncate(size: int = -1) -> int {
        const cur: str = self._join()
        target: int = size
        if size < 0 {
            target = self._pos
        }
        if target < self._len {
            self._flat = cur[0:target]
            self._chunks = []
            self._chunks.append(self._flat)
            self._len = target
            self._dirty = false
        }
        return target
    }

    def readable() -> bool { return true }
    def writable() -> bool { return true }
    def seekable() -> bool { return true }

    def close() -> int { return 0 }

    def __enter__() -> StringIO { return self }
    def __exit__() -> int { return 0 }
}

def open(path: str) -> Reader {
    """One door per intent, no stringly-typed "r"/"w"/"a": open(p)->Reader, make(p)->Writer
    (truncate), push(p)->Writer (append).
    """
    return Reader(path)
}

def make(path: str) -> Writer {
    return Writer(path, "w")
}

def push(path: str) -> Writer {
    return Writer(path, "a")
}

def normalize_newlines(text: str) -> str {
    # Explicit, opt-in universal-newline op: CRLF and lone CR both collapse to LF.
    # Dragon has no hidden per-stream newline-translation mode.
    return text.replace("\r\n", "\n").replace("\r", "\n")
}

"""csv.dr - CSV read/write: quoted fields, escaped quotes, configurable delimiters.
Pure Dragon, no C dependencies."""

const COMMA: str = ","
const TAB: str = "\t"
const QUOTE: str = "\""
const NEWLINE: str = "\n"


def parse_row(line: str, delimiter: str) -> list[str] {
    # Splits into fields, handling quoted fields with embedded delimiters/escaped
    # quotes. Field text collects as spans, joined once per field, no per-char building.
    fields: list[str] = []
    parts: list[str] = []
    in_quotes: bool = false
    i: int = 0
    run: int = 0                # start of the current verbatim span
    const n: int = len(line)

    while i < n {
        const ch: str = line[i]

        if in_quotes {
            if ch == "\"" {
                if i > run { parts.append(line[run:i]) }
                if i + 1 < n and line[i + 1] == "\"" {
                    # Escaped quote "" - emit a single quote
                    parts.append("\"")
                    i = i + 2
                } else {
                    # Closing quote (also when the quote ends the line)
                    in_quotes = false
                    i = i + 1
                }
                run = i
            } else {
                i = i + 1
            }
        } else {
            if ch == "\"" {
                # Opening quote - only valid at start of field
                if i > run { parts.append(line[run:i]) }
                in_quotes = true
                i = i + 1
                run = i
            } elif ch == delimiter {
                if i > run { parts.append(line[run:i]) }
                fields.append("".join(parts))
                parts = []
                i = i + 1
                run = i
            } else {
                i = i + 1
            }
        }
    }

    if n > run { parts.append(line[run:n]) }
    fields.append("".join(parts))
    return fields
}

def parse_rows(text: str, delimiter: str) -> list[list[str]] {
    # One span-based scan over the whole document (RFC 4180): a "\n" inside a
    # quoted field stays in the field; an unquoted "\n" ends the row.
    rows: list[list[str]] = []
    fields: list[str] = []
    parts: list[str] = []
    in_quotes: bool = false
    i: int = 0
    run: int = 0
    last_flush: int = 0
    const n: int = len(text)

    while i < n {
        const ch: str = text[i]

        if in_quotes {
            if ch == "\"" {
                if i > run { parts.append(text[run:i]) }
                if i + 1 < n and text[i + 1] == "\"" {
                    parts.append("\"")
                    i = i + 2
                } else {
                    in_quotes = false
                    i = i + 1
                }
                run = i
            } else {
                i = i + 1
            }
        } else {
            if ch == "\"" {
                if i > run { parts.append(text[run:i]) }
                in_quotes = true
                i = i + 1
                run = i
            } elif ch == delimiter {
                if i > run { parts.append(text[run:i]) }
                fields.append("".join(parts))
                parts = []
                i = i + 1
                run = i
            } elif ch == "\n" {
                if i > run { parts.append(text[run:i]) }
                fields.append("".join(parts))
                rows.append(fields)
                fields = []
                parts = []
                i = i + 1
                run = i
                last_flush = i
            } else {
                i = i + 1
            }
        }
    }

    if n > run { parts.append(text[run:n]) }
    if n > last_flush {
        fields.append("".join(parts))
        rows.append(fields)
    }
    return rows
}

def parse_row_simple(line: str, delimiter: str) -> list[str] {
    # Simple split with no quote handling, for maximum performance.
    return line.split(delimiter)
}


def quote_field(field: str, delimiter: str) -> str {
    # Quotes if the field contains the delimiter, a quote, or a newline; internal
    # quotes are escaped by doubling.
    const has_delim: bool = field.contains(delimiter)
    const has_quote: bool = field.contains("\"")
    const has_newline: bool = field.contains("\n")

    if has_delim or has_quote or has_newline {
        escaped: str = field.replace("\"", "\"\"")
        return "\"" + escaped + "\""
    }

    return field
}

def format_row(fields: list[str], delimiter: str) -> str {
    # Fields are quoted only when necessary.
    parts: list[str] = []
    i: int = 0
    const n: int = len(fields)

    while i < n {
        parts.append(quote_field(fields[i], delimiter))
        i = i + 1
    }

    return delimiter.join(parts)
}

def format_rows(rows: list[list[str]], delimiter: str) -> str {
    # Rows are separated by newlines.
    parts: list[str] = []
    i: int = 0
    const n: int = len(rows)

    while i < n {
        parts.append(format_row(rows[i], delimiter))
        i = i + 1
    }

    return "\n".join(parts)
}


def field_count(line: str, delimiter: str) -> int {
    const fields: list[str] = parse_row(line, delimiter)
    return len(fields)
}

def has_header(text: str, delimiter: str) -> bool {
    # Heuristic, not definitive: true if the first row has no purely numeric fields.
    const rows: list[list[str]] = parse_rows(text, delimiter)
    if len(rows) == 0 { return false }

    const header: list[str] = rows[0]
    i: int = 0
    while i < len(header) {
        const field: str = header[i]
        if len(field) > 0 {
            if field.isdigit() {
                return false
            }
        }
        i = i + 1
    }
    return true
}


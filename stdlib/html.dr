"""html.dr - HTML entity escape/unescape, tag stripping, and entity codecs.
Also home to the template[X] markup types (HTML/CSS/XML, D032): each auto-escapes
!{expr} via its own @staticmethod escape, a separate namespace from module-level escape(s).
"""

from template import Template

def escape(s: str) -> str {
    # Single pass over spans; clean input is returned unchanged.
    const n: int = len(s)
    dirty: int = -1
    i: int = 0
    while i < n {
        const c: str = s[i]
        if c == "&" or c == "<" or c == ">" or c == "\"" or c == "'" {
            dirty = i
            break
        }
        i = i + 1
    }
    if dirty < 0 { return s }

    parts: list[str] = []
    run: int = 0
    i = dirty
    while i < n {
        const c: str = s[i]
        if c == "&" or c == "<" or c == ">" or c == "\"" or c == "'" {
            if i > run { parts.append(s[run:i]) }
            parts.append(encode_entity(c))
            i = i + 1
            run = i
        } else {
            i = i + 1
        }
    }
    if n > run { parts.append(s[run:n]) }
    return "".join(parts)
}

def unescape(s: str) -> str {
    # Text between entities is copied as whole spans; no-entity input is returned unchanged.
    parts: list[str] = []
    i: int = 0
    run: int = 0
    const n: int = len(s)

    while i < n {
        if s[i] != "&" {
            i = i + 1
            continue
        }
        const semi_pos: int = s.find(";", i)
        if semi_pos < 0 {
            i = i + 1
            continue
        }
        if i > run { parts.append(s[run:i]) }
        parts.append(decode_entity(s[i:semi_pos + 1]))
        i = semi_pos + 1
        run = i
    }

    if run == 0 { return s }        # no entity decoded
    if n > run { parts.append(s[run:n]) }
    return "".join(parts)
}

def strip_tags(s: str) -> str {
    # Text outside tags is copied as whole spans; an unterminated trailing tag is dropped.
    parts: list[str] = []
    in_tag: bool = false
    i: int = 0
    run: int = 0
    const n: int = len(s)

    while i < n {
        const ch: str = s[i]
        if in_tag {
            if ch == ">" {
                in_tag = false
                run = i + 1
            }
        } elif ch == "<" {
            if i > run { parts.append(s[run:i]) }
            in_tag = true
        }
        i = i + 1
    }

    if not in_tag and n > run { parts.append(s[run:n]) }
    return "".join(parts)
}

def encode_entity(ch: str) -> str {
    if ch == "&" { return "&amp;" }
    if ch == "<" { return "&lt;" }
    if ch == ">" { return "&gt;" }
    if ch == "\"" { return "&quot;" }
    if ch == "'" { return "&#x27;" }
    return ch
}

def decode_entity(entity: str) -> str {
    if entity == "&amp;" { return "&" }
    if entity == "&lt;" { return "<" }
    if entity == "&gt;" { return ">" }
    if entity == "&quot;" { return "\"" }
    if entity == "&apos;" { return "'" }

    # Numeric entities: &#NNN; or &#xHH;. Invalid or out-of-range references
    # stay verbatim.
    if entity.startswith("&#") {
        if entity.endswith(";") {
            const inner: str = entity[2:len(entity) - 1]

            if inner.startswith("x") {
                const hcode: int = _hex_to_int(inner[1:])
                if hcode >= 0 and hcode <= 1114111 {
                    return chr(hcode)
                }
            } elif len(inner) > 0 {
                if inner.isdigit() {
                    num: str = inner
                    z: int = 0
                    while z < len(num) - 1 and num[z] == "0" { z = z + 1 }
                    num = num[z:len(num)]
                    if len(num) <= 7 {
                        const dcode: int = int(num)
                        if dcode <= 1114111 {
                            return chr(dcode)
                        }
                    }
                }
            }
        }
    }

    return entity
}

def _hex_to_int(s: str) -> int {
    const n: int = len(s)
    if n == 0 { return -1 }
    result: int = 0
    i: int = 0
    while i < n {
        const digit: int = _hex_digit_value(s[i])
        if digit < 0 { return -1 }
        if result <= 1114111 {
            result = result * 16 + digit
        }
        i = i + 1
    }
    return result
}

def _hex_digit_value(ch: str) -> int {
    const c: int = ord(ch)
    if c >= 48 and c <= 57 { return c - 48 }
    if c >= 97 and c <= 102 { return c - 87 }
    if c >= 65 and c <= 70 { return c - 55 }
    return -1
}

# template[X] markup family (D032): each auto-escapes !{expr} via its `escape`
# static method; `class MyHTML(HTML)` inherits HTML's escape automatically.
class HTML(Template) {
    def(inner: str) {
        self._inner = inner
    }

    @staticmethod
    def escape(s: str) -> str {
        s = s.replace("&", "&amp;")
        s = s.replace("<", "&lt;")
        s = s.replace(">", "&gt;")
        s = s.replace('"', "&quot;")
        s = s.replace("'", "&#x27;")
        return s
    }
}


class CSS(Template) {
    def(inner: str) {
        self._inner = inner
    }

    @staticmethod
    def escape(s: str) -> str {
        s = s.replace("\\", "\\\\")
        s = s.replace('"', '\\"')
        s = s.replace("'", "\\'")
        s = s.replace("<", "\\<")
        s = s.replace(">", "\\>")
        s = s.replace("&", "\\&")
        return s
    }
}


class XML(Template) {
    def(inner: str) {
        self._inner = inner
    }

    @staticmethod
    def escape(s: str) -> str {
        s = s.replace("&", "&amp;")
        s = s.replace("<", "&lt;")
        s = s.replace(">", "&gt;")
        s = s.replace('"', "&quot;")
        s = s.replace("'", "&apos;")
        return s
    }
}


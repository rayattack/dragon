"""template.dr - base Template protocol for `template[X]` content types (D032).
Concrete types (HTML/CSS/XML, JSON, URL, SQL) live in their own domain
module, not here; the only compiler rule is that they extend Template.
"""


class Template {
    def(inner: str) {
        self._inner = inner
    }

    @staticmethod
    def escape(s: str) -> str {
        return s
    }

    @staticmethod
    def validate(content: str) -> None {
        pass
    }

    def to_str() -> str {
        return self._inner
    }

    def __str__() -> str {
        return self._inner
    }
}

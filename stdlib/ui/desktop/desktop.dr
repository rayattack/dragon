"""ui.desktop - desktop windows over the system webview (D031).

`Window` wraps the platform webview shell (an opaque `ptr` handle) behind a typed
Dragon API. The shell is selected at link time from the toolchain's platform/
tree: webview_linux.cpp (GTK3 + webkit2gtk) or webview_macos.mm (Cocoa +
WKWebView). The flat `extern "C"` surface below is what a new platform implements.
"""

from html import HTML

extern "C" def dragon_webview_init()
extern "C" def dragon_webview_window_new(title: str, width: intc, height: intc) -> ptr
extern "C" def dragon_webview_load_html(handle: ptr, html: str)
extern "C" def dragon_webview_show(handle: ptr)
extern "C" def dragon_webview_close(handle: ptr)
extern "C" def dragon_webview_enable_inspector(handle: ptr)
extern "C" def dragon_webview_pick_folder(title: str, start_dir: str) -> str


def pick_folder(title: str = "Open Folder", start_dir: str = "") -> str {
    """Open the OS-native folder chooser (the XDG portal dialog where one is
    running) and return the chosen absolute path, or "" if the user cancels.
    Blocks its caller until the dialog settles; call it from an rpc handler -
    those run on green threads, so the window itself stays live."""
    return dragon_webview_pick_folder(title, start_dir)
}


class Window {
    """A top-level desktop window hosting a webview document.

    The document is the window's `body` - an `HTML` value, exactly the markup
    type the [template system](/docs/1202-html-css-xml) produces and the web
    framework's `res.body` carries. Assigning it paints the window:

        win.body = template[HTML] { <h1>Hello</h1> }

    The setter loads the markup into the OS webview; the getter returns the
    document currently shown. There is no `str` seam - views are typed `HTML`
    end to end, so interpolations are escaped for the right context and a
    component can splice another component without double-escaping.
    """

    handle: ptr
    _body: HTML

    def(title: str, width: int, height: int, inspect: bool = false) {
        dragon_webview_init()
        self.handle = dragon_webview_window_new(title, width, height)
        self._body = HTML("")
        if inspect {
            dragon_webview_enable_inspector(self.handle)
        }
    }

    @property
    def body() -> HTML {
        """The HTML document currently shown in the window."""
        return self._body
    }

    @body.setter
    def body(view: HTML) -> None {
        """Paint `view` into the window's webview (replaces the current body)."""
        self._body = view
        dragon_webview_load_html(self.handle, view.to_str())
    }

    def show() -> None {
        """Realize and display the window."""
        dragon_webview_show(self.handle)
    }

    def enable_inspector() -> None {
        """Make this window inspectable; how you open the inspector is platform
        specific (Linux: right-click "Inspect Element", macOS: Safari's Develop
        menu). Same switch as `inspect=true` or DRAGON_UI_INSPECT=1."""
        dragon_webview_enable_inspector(self.handle)
    }

    def close() -> None {
        """Close the window - the same path as the user clicking its close
        button. When the last open window closes, `ui.App.run()` returns.
        Calling any method on a closed window is a no-op."""
        dragon_webview_close(self.handle)
    }
}


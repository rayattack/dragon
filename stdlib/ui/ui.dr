"""ui - Dragon UI toolkit (Decision 031).

Public surface: `App` (lifecycle / main loop), `Window` (via `ui.desktop`), and the
reactive `Signal` primitives (added in the reactivity phase). The renderer is the
operating system's webview; the platform shell lives in C++ as the only
"unexpressible platform glue" (stdlib/ui/desktop/webview_<platform>.cpp), exposed
here through `extern "C"`. Everything above the shell is `.dr`.

Phase 0 (this file + ui.desktop): open a window, load HTML, run the loop. The
JS<->Dragon bridge, the targeted-patch re-render protocol, and `Signal`/`effect`
land in the following phases.
"""

extern "C" def dragon_webview_run()
extern "C" def dragon_webview_run_timeout(ms: intc)
extern "C" def dragon_webview_set_handler(fn: ptr)
extern "C" def dragon_webview_eval_js(js: str)
extern "C" def dragon_webview_post(fn: ptr)
extern "C" def dragon_json_escape_str(s: str) -> str

from html import HTML
from threading import Lock


class App {
    """Application lifecycle. Hands control to the platform UI run loop."""

    @staticmethod
    def run() -> None {
        """Enter the UI run loop; returns when the last window closes."""
        dragon_webview_set_handler(_ui_dispatch)
        dragon_webview_run()
    }

    @staticmethod
    def timeout(ms: int) -> None {
        """Run the loop, then auto-quit after `ms` (smoke tests / timed demos)."""
        dragon_webview_set_handler(_ui_dispatch)
        dragon_webview_run_timeout(ms)
    }
}


_ui_callbacks: list[Callable[[], None]] = []

def register_callback(fn: Callable[[], None]) -> int {
    """Register an extracted event handler; returns the id the template emits
    into `window.dr.invoke()`. Called by compiler-generated template code."""
    cid: int = len(_ui_callbacks)
    _ui_callbacks.append(fn)
    return cid
}

def _ui_dispatch(msg: str) -> None {
    """Webview JS->Dragon message handler: an `rpc:` message routes to the
    JSON bridge; anything else is a callback id from `window.dr.invoke()`."""
    if msg.startswith("rpc:") {
        _rpc_dispatch(msg)
        return
    }
    cid: int = int(msg)
    if cid >= 0 and cid < len(_ui_callbacks) {
        _ui_callbacks[cid]()
    }
}


_rpc_handlers: dict[str, Callable[[str], str]] = {}
_rpc_done: list[tuple[int, bool, str]] = []
_rpc_lock: Lock = Lock()

def rpc(name: str, fn: Callable[[str], str]) -> None {
    """Register `fn` as the handler behind `window.dr.call(name, payload)`.
    Register everything before `App.run()`."""
    _rpc_handlers[name] = fn
}

def _settle_js(rid: int, ok: bool, data: str) -> str {
    const okjs: str = "true" if ok else "false"
    return "window.dr._settle(" + str(rid) + "," + okjs + "," +
           dragon_json_escape_str(data) + ")"
}

def _rpc_drain() -> None {
    """Runs on the UI thread (via dragon_webview_post): settle every finished
    rpc. Drain under the lock, eval outside it."""
    batch: list[tuple[int, bool, str]] = []
    with _rpc_lock {
        while len(_rpc_done) > 0 {
            batch.append(_rpc_done.pop())
        }
    }
    for item in batch {
        js: str = _settle_js(item[0], item[1], item[2])
        dragon_webview_eval_js(js)
    }
}

def _rpc_exec(rid: int, name: str, payload: str) -> None {
    handler: Callable[[str], str] = _rpc_handlers[name]
    ok: bool = true
    result: str = ""
    try {
        result = handler(payload)
    } except Exception as e {
        ok = false
        result = str(e)
    }
    with _rpc_lock {
        _rpc_done.append((rid, ok, result))
    }
    dragon_webview_post(_rpc_drain)
}

def _rpc_dispatch(msg: str) -> None {
    const rest: str = msg[4:]
    const p1: int = rest.find(":")
    if p1 < 0 {
        return
    }
    const rest2: str = rest[p1 + 1:]
    const p2: int = rest2.find(":")
    if p2 < 0 {
        return
    }
    const rid: int = int(rest[:p1])
    const name: str = rest2[:p2]
    const payload: str = rest2[p2 + 1:]
    if name not in _rpc_handlers {
        dragon_webview_eval_js(_settle_js(rid, false, f"no rpc handler named '{name}'"))
        return
    }
    fire _rpc_exec(rid, name, payload)
}


_effects: list[Callable[[], None]] = []
_active_effect: int = -1

def _run_effect(eid: int) -> None {
    global _active_effect
    prev: int = _active_effect
    _active_effect = eid
    _effects[eid]()
    _active_effect = prev
}


class Signal[T] {
    """A reactive value. Construct it directly - `count: Signal[int] = Signal(0)`
    - and the binding annotation pins `T` (generic-ctor inference, the `Box(99)`
    rule). Read with `s()` (Python parity via __call__) - which subscribes the
    currently-running effect - and write with `s.set(v)`, which re-runs every
    subscribed effect."""

    _value: T
    _subs: list[int]

    def(initial: T) {
        self._value = initial
        self._subs = []
    }

    def _read() -> T {
        if _active_effect >= 0 {
            if _active_effect not in self._subs {
                self._subs.append(_active_effect)
            }
        }
        return self._value
    }

    def __call__() -> T {
        return self._read()
    }

    def get() -> T {
        return self._read()
    }

    def set(v: T) -> None {
        self._value = v
        i: int = 0
        while i < len(self._subs) {
            _run_effect(self._subs[i])
            i = i + 1
        }
    }
}


def effect(fn: Callable[[], None]) -> None {
    """Run `fn` now (recording every Signal it reads) and re-run it automatically
    whenever any of those signals changes."""
    eid: int = len(_effects)
    _effects.append(fn)
    _run_effect(eid)
}


_node_id_counter: int = 0

def _next_node_id() -> int {
    """Allocate a process-unique DOM node id. A runtime counter (not a compile-
    time constant) so the same reactive template rendered twice gets distinct
    `data-dr` ids - no collision when one is patched."""
    global _node_id_counter
    nid: int = _node_id_counter
    _node_id_counter = _node_id_counter + 1
    return nid
}

def __patch_text_js(node_id: int, value: str) -> str {
    """Build the JS for a single text patch. `node_id` is an int (safe to
    inline); `value` is JSON-encoded (quoted + escaped) so an arbitrary string -
    quotes, newlines, `</script>`, anything - can never break out of the literal
    or inject script. Never raw-concat the value."""
    return "window.dr._patch({op:'text',id:'" + str(node_id) +
           "',value:" + dragon_json_escape_str(value) + "})"
}

def __patch_text(node_id: int, value: str) -> None {
    """Push a targeted text patch to DOM node `node_id` in the current window."""
    js: str = __patch_text_js(node_id, value)
    dragon_webview_eval_js(js)
}

def __bind_patcher(patcher: Callable[[], None]) -> None {
    """Register a patch closure as an effect and run it once. The first run is
    what records the closure's Signal subscriptions, so every binder must do it;
    the patch it emits is a no-op against a DOM the run loop has not loaded yet
    (the initial value is baked into the markup by the template)."""
    eid: int = len(_effects)
    _effects.append(patcher)
    _run_effect(eid)
}

def bind_text(render: Callable[[], str]) -> int {
    """Bind a reactive text slot: register `render` (a `() -> str` re-evaluator
    of the interpolation) as an effect that patches its DOM node on every signal
    change, and return the node id the template emits into `data-dr`. The first
    run records the signal subscriptions; its patch is a no-op against the DOM,
    which isn't loaded until the run loop starts (the initial value is baked into
    the markup), so subsequent `Signal.set()` calls drive every live update."""
    node_id: int = _next_node_id()
    patcher: Callable[[], None] = lambda () -> None { __patch_text(node_id, render()) }
    __bind_patcher(patcher)
    return node_id
}


def __patch_attr_js(node_id: int, name: str, value: str) -> str {
    """Build the JS for a single attribute patch. Both the attribute name and
    its value are JSON-encoded: a page title, a URL or a favicon data: URI is
    hostile input, and raw-concatenating any of it into the JS source would let
    a crafted tab title close the literal and run script with the chrome's
    privileges. Never raw-concat either one."""
    return "window.dr._patch({op:'attr',id:'" + str(node_id) +
           "',name:" + dragon_json_escape_str(name) +
           ",value:" + dragon_json_escape_str(value) + "})"
}

def __patch_attr(node_id: int, name: str, value: str) -> None {
    """Push a targeted attribute patch to DOM node `node_id`."""
    dragon_webview_eval_js(__patch_attr_js(node_id, name, value))
}

def bind_attr(name: str, render: Callable[[], str]) -> int {
    """Bind a reactive attribute: `render` re-evaluates the WHOLE value of
    attribute `name` on every signal change, and the returned node id goes in the
    element's `data-dr`. The value is whole because the patch is `setAttribute`,
    which replaces - so the closure, not the markup, owns that attribute
    (`class`, `aria-selected`, `style`, `title`).

    The compiler does not auto-bind interpolations inside attributes: a `!{}`
    directly after `attr="` is rendered once, statically. Reactive attributes are
    this call, written by hand, and the template emits only the `data-dr` id."""
    node_id: int = _next_node_id()
    patcher: Callable[[], None] = lambda () -> None { __patch_attr(node_id, name, render()) }
    __bind_patcher(patcher)
    return node_id
}


def __patch_html_js(node_id: int, markup: str) -> str {
    """Build the JS for a single innerHTML patch. The markup is JSON-encoded like
    every other value crossing the bridge; it stays markup because the receiving
    op assigns it to `innerHTML`, not because it skipped the encoder."""
    return "window.dr._patch({op:'html',id:'" + str(node_id) +
           "',value:" + dragon_json_escape_str(markup) + "})"
}

def __patch_html(node_id: int, markup: str) -> None {
    """Push a targeted innerHTML patch to DOM node `node_id`."""
    dragon_webview_eval_js(__patch_html_js(node_id, markup))
}

def bind_html(render: Callable[[], HTML]) -> int {
    """Bind a reactive container: `render` returns the markup for ALL of the
    element's children, and every signal change replaces them wholesale. This is
    the list primitive - a tab rail, a result list, a row of chips - because
    Dragon has no keyed reconciler: there is exactly one node id for the
    container, not one per row.

    `render` returns `HTML`, not `str`, so a list of hostile titles is escaped by
    the template that builds it rather than by remembering to escape here.

    Replacing children destroys them: focus, `:hover`, text selection, scroll
    position inside the container, CSS transitions mid-flight and any DOM state
    the browser holds for those nodes are gone. Bind the smallest container that
    actually changes, and drive per-item state (which tab is active) with
    `bind_attr` on the item instead of re-rendering the list. Scripts injected
    this way never execute - `innerHTML` does not run `<script>`."""
    node_id: int = _next_node_id()
    patcher: Callable[[], None] = lambda () -> None { __patch_html(node_id, render().to_str()) }
    __bind_patcher(patcher)
    return node_id
}


const HIDDEN_STYLE: str = "display:none"
const STYLE_ATTR: str = "style"

def bind_show(render: Callable[[], bool], visible_style: str = "") -> int {
    """Bind reactive visibility: hidden is `style="display:none"`, visible is
    `visible_style` (default: no inline style at all, so the stylesheet decides).

    This is deliberately `bind_attr` over `style` and not a fourth patch op,
    because visibility is not a distinct DOM operation - it is one attribute
    write, and a `show` op would be `attr` with the value picked in JS instead of
    in Dragon, which is where the state lives. The honest limitation this exposes
    is that the patch protocol can only SET an attribute, never remove one, so
    HTML's own `hidden` boolean attribute is unusable: `setAttribute('hidden','')`
    hides, and there is no value that un-hides. `style` is the attribute that
    round-trips through set-only, which is why it is the one used here.

    The closure owns the whole `style` attribute of that element, so give
    `visible_style` any inline style the element needs while shown, and keep the
    rest in a class."""
    styler: Callable[[], str] = lambda () -> str {
        if render() {
            return visible_style
        }
        return HIDDEN_STYLE
    }
    return bind_attr(STYLE_ATTR, styler)
}

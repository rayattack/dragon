"""Wraps libc rand()/srand(); not cryptographically secure. Self-seeds from the
OS CSPRNG on first use (call seed(n) for reproducibility); stream quality is still libc's LCG.
"""

extern "C" def rand() -> intc
extern "C" def srand(seed: intc)
extern "C" def clock_gettime(clockid: intc, tp: ptr) -> intc
extern "C" def malloc(size: int) -> ptr
extern "C" def free(p: ptr)
extern "C" def memset(s: ptr, c: intc, n: int) -> ptr
extern "C" def dragon_timespec_sec(ts: ptr) -> int
extern "C" def dragon_timespec_nsec(ts: ptr) -> int

extern "C" def dragon_urandom(n: int) -> bytes

const RAND_MAX: int = 2147483647

const _SEED_MASK: int = 2147483647

const _WARMUP: int = 16

const _CALL_STRIDE: int = 2654435761

_seeded: bool = false
_seed_time_calls: int = 0

def _srand_warm(s: int) {
    global _seeded
    srand(s & _SEED_MASK)
    i: int = 0
    while i < _WARMUP {
        rand()
        i = i + 1
    }
    _seeded = true
}

def _entropy_seed() -> int {
    const b: bytes = dragon_urandom(4)
    s: int = 0
    i: int = 0
    while i < 4 {
        s = (s << 8) | b[i]
        i = i + 1
    }
    return s
}

def _ensure_seeded() {
    if _seeded == false {
        _srand_warm(_entropy_seed())
    }
}

def seed(s: int) {
    _srand_warm(s)
}

def seed_time() {
    global _seed_time_calls
    const ts: ptr = malloc(16)
    memset(ts, 0, 16)
    clock_gettime(0, ts)
    const sec: int = dragon_timespec_sec(ts)
    const nsec: int = dragon_timespec_nsec(ts)
    free(ts)
    _seed_time_calls = _seed_time_calls + 1
    _srand_warm(sec * 1000000000 + nsec + _seed_time_calls * _CALL_STRIDE)
}

def random() -> float {
    _ensure_seeded()
    return float(rand()) / (float(RAND_MAX) + 1.0)
}

def randint(a: int, b: int) -> int {
    _ensure_seeded()
    if b < a { raise ValueError(f"empty range in randint({a}, {b})") }
    const range: int = b - a + 1
    return a + rand() % range
}

def randrange(start: int, stop: int) -> int {
    _ensure_seeded()
    const range: int = stop - start
    if range <= 0 { raise ValueError(f"empty range in randrange({start}, {stop})") }
    return start + rand() % range
}

def uniform(a: float, b: float) -> float {
    return a + (b - a) * random()
}

def choice(items: list[str]) -> str {
    _ensure_seeded()
    const n: int = len(items)
    if n == 0 { raise IndexError("Cannot choose from an empty sequence") }
    const idx: int = rand() % n
    return items[idx]
}

def choice_int(items: list[int]) -> int {
    _ensure_seeded()
    const n: int = len(items)
    if n == 0 { raise IndexError("Cannot choose from an empty sequence") }
    const idx: int = rand() % n
    return items[idx]
}

def shuffle(items: list[int]) -> list[int] {
    _ensure_seeded()
    result: list[int] = []
    i: int = 0
    while i < len(items) {
        result.append(items[i])
        i = i + 1
    }
    i = len(result) - 1
    while i > 0 {
        const j: int = rand() % (i + 1)
        const tmp: int = result[i]
        result[i] = result[j]
        result[j] = tmp
        i = i - 1
    }
    return result
}

def sample(items: list[int], k: int) -> list[int] {
    _ensure_seeded()
    if k < 0 or k > len(items) { raise ValueError("Sample larger than population or is negative") }
    result: list[int] = []
    i: int = 0
    while i < k {
        if i < len(items) {
            result.append(items[i])
        }
        i = i + 1
    }
    i = k
    while i < len(items) {
        const j: int = rand() % (i + 1)
        if j < k {
            result[j] = items[i]
        }
        i = i + 1
    }
    return result
}

"""Wraps libc rand()/srand(); not cryptographically secure. Self-seeds from the
OS CSPRNG on first use (call seed(n) for reproducibility); stream quality is still libc's LCG.
"""

extern "C" def rand() -> intc
extern "C" def srand(seed: intc)
extern "C" def clock_gettime(clockid: intc, tp: ptr) -> intc
extern "C" def malloc(size: int) -> ptr
extern "C" def free(p: ptr)
extern "C" def memset(s: ptr, c: intc, n: int) -> ptr
extern "C" def dragon_timespec_sec(ts: ptr) -> int
extern "C" def dragon_timespec_nsec(ts: ptr) -> int

# OS CSPRNG, declared directly (not via `secrets`) so a die-roll program doesn't
# drag base64/binascii/hmac into the binary.
extern "C" def dragon_urandom(n: int) -> bytes

const RAND_MAX: int = 2147483647

# srand() takes a C `unsigned int`; mask every seed into signed 32-bit range.
const _SEED_MASK: int = 2147483647

# libc rand() is an LCG whose first output tracks the seed almost linearly;
# burn a few draws after seeding so the first value doesn't leak the seed.
const _WARMUP: int = 16

# Knuth's multiplicative constant, mixed in per seed_time() call to separate
# seeds from calls landing in the same clock tick.
const _CALL_STRIDE: int = 2654435761

_seeded: bool = false
_seed_time_calls: int = 0

def _srand_warm(s: int) {
    # Single seeding path: mask, seed, diffuse, mark seeded so auto-entropy never re-runs.
    global _seeded
    srand(s & _SEED_MASK)
    i: int = 0
    while i < _WARMUP {
        rand()
        i = i + 1
    }
    _seeded = true
}

def _entropy_seed() -> int {
    # 32 bits straight from the OS CSPRNG.
    const b: bytes = dragon_urandom(4)
    s: int = 0
    i: int = 0
    while i < 4 {
        s = (s << 8) | b[i]
        i = i + 1
    }
    return s
}

def _ensure_seeded() {
    if _seeded == false {
        _srand_warm(_entropy_seed())
    }
}

def seed(s: int) {
    # Deterministic seeding; once called, nothing re-seeds behind you.
    _srand_warm(s)
}

def seed_time() {
    # Wall-clock seed + per-call stride, since CLOCK_REALTIME's tick is coarser
    # than its ns field and back-to-back calls could otherwise collide. Prefer seed(n) instead.
    global _seed_time_calls
    const ts: ptr = malloc(16)
    memset(ts, 0, 16)
    clock_gettime(0, ts)
    const sec: int = dragon_timespec_sec(ts)
    const nsec: int = dragon_timespec_nsec(ts)
    free(ts)
    _seed_time_calls = _seed_time_calls + 1
    _srand_warm(sec * 1000000000 + nsec + _seed_time_calls * _CALL_STRIDE)
}

def random() -> float {
    # Returns a random float in [0.0, 1.0)
    _ensure_seeded()
    return float(rand()) / (float(RAND_MAX) + 1.0)
}

def randint(a: int, b: int) -> int {
    # Returns a random integer N such that a <= N <= b
    _ensure_seeded()
    if b < a { raise ValueError(f"empty range in randint({a}, {b})") }
    const range: int = b - a + 1
    return a + rand() % range
}

def randrange(start: int, stop: int) -> int {
    # Returns a random integer N such that start <= N < stop
    _ensure_seeded()
    const range: int = stop - start
    if range <= 0 { raise ValueError(f"empty range in randrange({start}, {stop})") }
    return start + rand() % range
}

def uniform(a: float, b: float) -> float {
    # Returns a random float N such that a <= N <= b
    return a + (b - a) * random()
}

def choice(items: list[str]) -> str {
    _ensure_seeded()
    const n: int = len(items)
    if n == 0 { raise IndexError("Cannot choose from an empty sequence") }
    const idx: int = rand() % n
    return items[idx]
}

def choice_int(items: list[int]) -> int {
    _ensure_seeded()
    const n: int = len(items)
    if n == 0 { raise IndexError("Cannot choose from an empty sequence") }
    const idx: int = rand() % n
    return items[idx]
}

def shuffle(items: list[int]) -> list[int] {
    # Fisher-Yates shuffle (returns new shuffled list)
    _ensure_seeded()
    result: list[int] = []
    i: int = 0
    while i < len(items) {
        result.append(items[i])
        i = i + 1
    }
    i = len(result) - 1
    while i > 0 {
        const j: int = rand() % (i + 1)
        const tmp: int = result[i]
        result[i] = result[j]
        result[j] = tmp
        i = i - 1
    }
    return result
}

def sample(items: list[int], k: int) -> list[int] {
    # k unique random elements (without replacement), via reservoir sampling.
    _ensure_seeded()
    if k < 0 or k > len(items) { raise ValueError("Sample larger than population or is negative") }
    result: list[int] = []
    i: int = 0
    while i < k {
        if i < len(items) {
            result.append(items[i])
        }
        i = i + 1
    }
    i = k
    while i < len(items) {
        const j: int = rand() % (i + 1)
        if j < k {
            result[j] = items[i]
        }
        i = i + 1
    }
    return result
}

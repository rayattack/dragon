"""bisect.dr - binary search over sorted list[int], matching Python's bisect module API.
Pure Dragon, no C dependencies."""

def bisect_left(a: list[int], x: int) -> int {
    # Leftmost insertion index i: a[:i] < x, a[i:] >= x.
    lo: int = 0
    hi: int = len(a)
    while lo < hi {
        const mid: int = (lo + hi) // 2
        if a[mid] < x {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    return lo
}

def bisect_right(a: list[int], x: int) -> int {
    # Rightmost insertion index i: a[:i] <= x, a[i:] > x.
    lo: int = 0
    hi: int = len(a)
    while lo < hi {
        const mid: int = (lo + hi) // 2
        if x < a[mid] {
            hi = mid
        } else {
            lo = mid + 1
        }
    }
    return lo
}

def bisect(a: list[int], x: int) -> int {
    return bisect_right(a, x)
}

def insort_left(a: list[int], x: int) {
    # Insert x maintaining sort order; ties go to the left of existing entries.
    const idx: int = bisect_left(a, x)
    a.append(x)
    j: int = len(a) - 1
    while j > idx {
        a[j] = a[j - 1]
        j = j - 1
    }
    a[idx] = x
}

def insort_right(a: list[int], x: int) {
    # Insert x maintaining sort order; ties go to the right of existing entries.
    const idx: int = bisect_right(a, x)
    a.append(x)
    j: int = len(a) - 1
    while j > idx {
        a[j] = a[j - 1]
        j = j - 1
    }
    a[idx] = x
}

def insort(a: list[int], x: int) {
    insort_right(a, x)
}

def index(a: list[int], x: int) -> int {
    # Binary-search index of x; raises ValueError if absent.
    const i: int = bisect_left(a, x)
    if i < len(a) {
        if a[i] == x {
            return i
        }
    }
    raise ValueError("value not found in sorted list")
}

def contains(a: list[int], x: int) -> bool {
    # Binary-search membership test.
    const i: int = bisect_left(a, x)
    if i < len(a) {
        if a[i] == x {
            return true
        }
    }
    return false
}

"""shlex - simple lexical analysis for shell-like syntaxes (POSIX subset).

Pure Dragon, concrete `str` operations (no generics needed). Mirrors the most
used parts of CPython's `shlex`: `split`, `join`, `quote`. POSIX-mode splitting
honours single/double quotes and backslash escapes; `quote` shell-escapes a
single argument; `join` quotes and space-joins a list.
"""

# Characters that force quoting in a POSIX shell word.
const _UNSAFE: str = "|&;<>()$`\\\"' \t\n*?[#~=%!{}"


def split(s: str) -> list[str] {
    """Split a string using shell-like (POSIX) quoting rules."""
    tokens: list[str] = []
    parts: list[str] = []
    have_token: bool = False
    i: int = 0
    n: int = len(s)
    while i < n {
        c: str = s[i]
        if c == "\\" {
            if i + 1 < n {
                parts.append(s[i + 1])
                have_token = True
                i = i + 2
            } else {
                i = i + 1
            }
        } elif c == "'" {
            have_token = True
            i = i + 1
            sq_start: int = i
            while i < n and s[i] != "'" {
                i = i + 1
            }
            if i > sq_start {
                parts.append(s[sq_start:i])
            }
            i = i + 1
        } elif c == "\"" {
            have_token = True
            i = i + 1
            run: int = i
            while i < n and s[i] != "\"" {
                if s[i] == "\\" and i + 1 < n {
                    nxt: str = s[i + 1]
                    if nxt == "\"" or nxt == "\\" {
                        if i > run {
                            parts.append(s[run:i])
                        }
                        parts.append(nxt)
                        i = i + 2
                        run = i
                    } else {
                        i = i + 1
                    }
                } else {
                    i = i + 1
                }
            }
            if i > run {
                parts.append(s[run:i])
            }
            i = i + 1
        } elif c == " " or c == "\t" or c == "\n" {
            if have_token {
                tokens.append("".join(parts))
                parts = []
                have_token = False
            }
            i = i + 1
        } else {
            word_start: int = i
            while i < n {
                const wc: str = s[i]
                if wc == "\\" or wc == "'" or wc == "\"" or wc == " " or wc == "\t" or wc == "\n" {
                    break
                }
                i = i + 1
            }
            parts.append(s[word_start:i])
            have_token = True
        }
    }
    if have_token {
        tokens.append("".join(parts))
    }
    return tokens
}


def quote(s: str) -> str {
    """Return a shell-escaped version of `s` safe as a single word."""
    if s == "" {
        return "''"
    }
    safe: bool = True
    for ch in s {
        if ch in _UNSAFE {
            safe = False
        }
    }
    if safe {
        return s
    }
    # Wrap in single quotes; embedded single quotes become '"'"'.
    parts: list[str] = ["'"]
    run: int = 0
    i: int = 0
    const n: int = len(s)
    while i < n {
        if s[i] == "'" {
            if i > run {
                parts.append(s[run:i])
            }
            parts.append("'\"'\"'")
            run = i + 1
        }
        i = i + 1
    }
    if n > run {
        parts.append(s[run:n])
    }
    parts.append("'")
    return "".join(parts)
}


def join(parts: list[str]) -> str {
    """Quote and space-join a list of arguments (inverse of split)."""
    quoted: list[str] = []
    for p in parts {
        quoted.append(quote(p))
    }
    return " ".join(quoted)
}

const SIG2_ABC: str = "a377ba06339de184aa1a88b883d8558b704b96f7e4b2ac3e7984fc297e9549bd4ee1bcbb72553fc768400ec2395a702311e7aed969a713387b3377855a537701"
const SIG3_FOX: str = "5be4d500bb415c0095a7988d18f5a4dc84078ff64257a914255e153b63dd5cbbc13e2b6881bff075bddf5a88e4e8923281efd1e23f580faeba44265f194b490c"


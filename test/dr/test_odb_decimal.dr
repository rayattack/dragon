from unittest import TestCase, main
from odb.decimal import parse_decimal, DecParts, enc_decimal_body, check_decimal
from odb.errors import SchemaError


def _enc(s: str) -> bytes {
    return bytes(enc_decimal_body(s))
}


def _cmp(a: bytes, b: bytes) -> int {
    i: int = 0
    while i < len(a) and i < len(b) {
        if a[i] < b[i] {
            return -1
        }
        if a[i] > b[i] {
            return 1
        }
        i = i + 1
    }
    if len(a) < len(b) {
        return -1
    }
    if len(a) > len(b) {
        return 1
    }
    return 0
}


def _bad(s: str) -> bool {
    try {
        check_decimal(s)
    } except SchemaError {
        return True
    }
    return False
}


class DecimalParseTest(TestCase) {
    def test_plain_integer() -> None {
        const p: DecParts = parse_decimal("123")
        self.assertFalse(p.negative)
        self.assertEqual(p.coeff, "123")
        self.assertEqual(p.exp, 0)
        self.assertFalse(p.is_zero)
    }

    def test_fraction_scales_the_exponent() -> None {
        const p: DecParts = parse_decimal("1.50")
        self.assertEqual(p.coeff, "150")
        self.assertEqual(p.exp, -2)
    }

    def test_sign_and_exponent() -> None {
        const p: DecParts = parse_decimal("-2.5e3")
        self.assertTrue(p.negative)
        self.assertEqual(p.coeff, "25")
        self.assertEqual(p.exp, 2)
    }

    def test_leading_zeros_are_stripped() -> None {
        const p: DecParts = parse_decimal("000123.4")
        self.assertEqual(p.coeff, "1234")
        self.assertEqual(p.exp, -1)
    }

    def test_zero_forms() -> None {
        self.assertTrue(parse_decimal("0").is_zero)
        self.assertTrue(parse_decimal("-0").is_zero)
        self.assertTrue(parse_decimal("0.000").is_zero)
        self.assertTrue(parse_decimal("0e10").is_zero)
        self.assertTrue(parse_decimal(".0").is_zero)
    }

    def test_bare_fraction_and_trailing_point() -> None {
        self.assertEqual(parse_decimal(".5").coeff, "5")
        self.assertEqual(parse_decimal("5.").coeff, "5")
    }

    def test_rejects_malformed() -> None {
        self.assertTrue(_bad(""))
        self.assertTrue(_bad("."))
        self.assertTrue(_bad("1.2.3"))
        self.assertTrue(_bad("abc"))
        self.assertTrue(_bad("1e"))
        self.assertTrue(_bad("1e+"))
        self.assertTrue(_bad("NaN"))
        self.assertTrue(_bad("Infinity"))
        self.assertTrue(_bad("1 000"))
        self.assertTrue(_bad("0x10"))
        self.assertTrue(_bad("--1"))
        self.assertTrue(_bad("1,5"))
    }

    def test_rejects_out_of_range_magnitude() -> None {
        self.assertTrue(_bad("1e99999"))
        self.assertTrue(_bad("1e-99999"))
    }
}


class DecimalOrderTest(TestCase) {
    def test_encoding_sorts_numerically() -> None {
        ordered: list[str] = ["-1e10", "-12345.6789", "-1.5", "-1", "-0.55", "-0.5", "-0.001", "0", "0.001", "0.5", "0.55", "1", "1.5", "2", "10", "12345.6789", "1e10"]
        i: int = 1
        while i < len(ordered) {
            const prev: bytes = _enc(ordered[i - 1])
            const cur: bytes = _enc(ordered[i])
            self.assertEqual(_cmp(prev, cur), -1, ordered[i - 1] + " should sort below " + ordered[i])
            i = i + 1
        }
    }

    def test_equal_values_encode_identically() -> None {
        self.assertEqual(_cmp(_enc("1.5"), _enc("1.50")), 0)
        self.assertEqual(_cmp(_enc("1.5"), _enc("1.500")), 0)
        self.assertEqual(_cmp(_enc("1.5"), _enc("15e-1")), 0)
        self.assertEqual(_cmp(_enc("1.5"), _enc("0.15e1")), 0)
        self.assertEqual(_cmp(_enc("-1.5"), _enc("-1.50")), 0)
        self.assertEqual(_cmp(_enc("0"), _enc("-0")), 0)
        self.assertEqual(_cmp(_enc("0"), _enc("0.000")), 0)
        self.assertEqual(_cmp(_enc("0"), _enc("0e5")), 0)
    }

    def test_scale_does_not_leak_into_ordering() -> None {
        self.assertEqual(_cmp(_enc("2.0"), _enc("1.99999")), 1)
        self.assertEqual(_cmp(_enc("0.10"), _enc("0.1")), 0)
        self.assertEqual(_cmp(_enc("100"), _enc("1e2")), 0)
    }

    def test_high_precision_beyond_f64() -> None {
        const a: bytes = _enc("1.0000000000000000000000001")
        const b: bytes = _enc("1.0000000000000000000000002")
        self.assertEqual(_cmp(a, b), -1)
        const c: bytes = _enc("9007199254740993")
        const d: bytes = _enc("9007199254740992")
        self.assertEqual(_cmp(c, d), 1)
    }

    def test_zero_sits_between_negatives_and_positives() -> None {
        self.assertEqual(_cmp(_enc("-0.000001"), _enc("0")), -1)
        self.assertEqual(_cmp(_enc("0"), _enc("0.000001")), -1)
    }
}


main([DecimalParseTest(), DecimalOrderTest()])

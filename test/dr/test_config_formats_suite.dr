from unittest import TestCase, main
from csv import parse_row, parse_rows, format_row, format_rows, quote_field, field_count
from configparser import ConfigParser
import tomllib
from drs import parse, parse_with, loads_with, envs, Schema, DragonScriptSchemaError
from drs import loads, load
from io import make
from tempfile import mkdtemp
from os import makedirs
from os.path import join


class ParseTests(TestCase) {
    """csv module: quoted-field parsing and formatting.

    parse_row used to accumulate field text one character per concat and
    format_rows rebuilt the whole document per row (both quadratic); they now
    collect spans/parts and join. These tests pin the parse and format semantics,
    including escaped quotes, embedded delimiters, and round-trips.
    """

    def test_plain_fields() {
        const row: list[str] = parse_row("a,b,c", ",")
        self.assertEqual(len(row), 3)
        self.assertEqual(row[0], "a")
        self.assertEqual(row[1], "b")
        self.assertEqual(row[2], "c")
    }

    def test_quoted_field_with_delimiter() {
        const row: list[str] = parse_row("\"hello\",\"wor,ld\"", ",")
        self.assertEqual(len(row), 2)
        self.assertEqual(row[0], "hello")
        self.assertEqual(row[1], "wor,ld")
    }

    def test_escaped_quotes() {
        const row: list[str] = parse_row("\"say \"\"hi\"\"\",x", ",")
        self.assertEqual(len(row), 2)
        self.assertEqual(row[0], "say \"hi\"")
        self.assertEqual(row[1], "x")
    }

    def test_empty_fields() {
        const row: list[str] = parse_row("a,,c", ",")
        self.assertEqual(len(row), 3)
        self.assertEqual(row[1], "")
        const single: list[str] = parse_row("", ",")
        self.assertEqual(len(single), 1)
        self.assertEqual(single[0], "")
    }

    def test_trailing_delimiter() {
        const row: list[str] = parse_row("a,b,", ",")
        self.assertEqual(len(row), 3)
        self.assertEqual(row[2], "")
    }

    def test_quote_ends_line() {
        const row: list[str] = parse_row("a,\"b\"", ",")
        self.assertEqual(len(row), 2)
        self.assertEqual(row[1], "b")
    }

    def test_unquoted_prefix_and_suffix() {
        const row: list[str] = parse_row("ab\"cd\"ef", ",")
        self.assertEqual(len(row), 1)
        self.assertEqual(row[0], "abcdef")
    }

    def test_field_count() {
        self.assertEqual(field_count("a,b,\"c,d\"", ","), 3)
    }
}


class FormatTests(TestCase) {
    def test_quote_field() {
        self.assertEqual(quote_field("plain", ","), "plain")
        self.assertEqual(quote_field("a,b", ","), "\"a,b\"")
        self.assertEqual(quote_field("say \"hi\"", ","), "\"say \"\"hi\"\"\"")
    }

    def test_format_row() {
        const line: str = format_row(["a", "b,c", "d"], ",")
        self.assertEqual(line, "a,\"b,c\",d")
    }

    def test_format_rows_and_roundtrip() {
        rows: list[list[str]] = []
        rows.append(["name", "note"])
        rows.append(["ada", "says \"hi\", twice"])
        const text: str = format_rows(rows, ",")
        self.assertEqual(text, "name,note\nada,\"says \"\"hi\"\", twice\"")

        const back: list[list[str]] = parse_rows(text, ",")
        self.assertEqual(len(back), 2)
        self.assertEqual(back[1][0], "ada")
        self.assertEqual(back[1][1], "says \"hi\", twice")
    }
}


class MultilineFieldTests(TestCase) {
    def test_quoted_newline_is_one_field() {
        const text: str = "a,\"x\ny\"\nb,c"
        const rows: list[list[str]] = parse_rows(text, ",")
        self.assertEqual(len(rows), 2)
        self.assertEqual(rows[0][0], "a")
        self.assertEqual(rows[0][1], "x\ny")
        self.assertEqual(rows[1][0], "b")
        self.assertEqual(rows[1][1], "c")
    }

    def test_roundtrip_with_newline_field() {
        rows: list[list[str]] = []
        rows.append(["name", "note"])
        rows.append(["ada", "line1\nline2"])
        const text: str = format_rows(rows, ",")
        const back: list[list[str]] = parse_rows(text, ",")
        self.assertEqual(len(back), 2)
        self.assertEqual(back[1][0], "ada")
        self.assertEqual(back[1][1], "line1\nline2")
    }

    def test_escaped_quotes_across_newline() {
        const rows: list[list[str]] = parse_rows("\"he said \"\"hi\"\"\nbye\",x", ",")
        self.assertEqual(len(rows), 1)
        self.assertEqual(rows[0][0], "he said \"hi\"\nbye")
        self.assertEqual(rows[0][1], "x")
    }
}


class PlainRowsTests(TestCase) {
    def test_plain_rows_unchanged() {
        const rows: list[list[str]] = parse_rows("a,b\nc,d\n", ",")
        self.assertEqual(len(rows), 2)
        self.assertEqual(rows[0][0], "a")
        self.assertEqual(rows[1][1], "d")
    }

    def test_no_trailing_newline() {
        const rows: list[list[str]] = parse_rows("a,b\nc,d", ",")
        self.assertEqual(len(rows), 2)
        self.assertEqual(rows[1][1], "d")
    }

    def test_empty_line_mid_text() {
        const rows: list[list[str]] = parse_rows("a\n\nb", ",")
        self.assertEqual(len(rows), 3)
        self.assertEqual(rows[1][0], "")
    }

    def test_empty_text() {
        const rows: list[list[str]] = parse_rows("", ",")
        self.assertEqual(len(rows), 0)
    }

    def test_quoted_delimiter_still_works() {
        const rows: list[list[str]] = parse_rows("a,\"b,c\"\nd,e", ",")
        self.assertEqual(len(rows), 2)
        self.assertEqual(rows[0][1], "b,c")
    }
}


const _INI: str = "orphan = ignored\n[server]\nhost = localhost\nport: 8080\n# comment\n; also a comment\n\n[auth]\nuser = ada\nempty =\n"


def _parsed() -> ConfigParser {
    cp: ConfigParser = ConfigParser()
    cp.read_string(_INI)
    return cp
}


def _get_missing_section() {
    _parsed().get("nope", "host")
}


def _get_missing_key() {
    _parsed().get("server", "nope")
}


def _items_missing_section() {
    _parsed().items("nope")
}


class ConfigParserParseTests(TestCase) {
    def test_get_both_separators() {
        const cp: ConfigParser = _parsed()
        self.assertEqual(cp.get("server", "host"), "localhost")
        self.assertEqual(cp.get("server", "port"), "8080")
        self.assertEqual(cp.get("auth", "user"), "ada")
        self.assertEqual(cp.get("auth", "empty"), "")
    }

    def test_separator_in_value_kept() {
        cp: ConfigParser = ConfigParser()
        cp.read_string("[s]\nurl = http://x\nu: a=b\n")
        self.assertEqual(cp.get("s", "url"), "http://x")
        self.assertEqual(cp.get("s", "u"), "a=b")
    }

    def test_orphan_pairs_before_section_ignored() {
        const cp: ConfigParser = _parsed()
        self.assertFalse(cp.has_option("server", "orphan"))
        self.assertEqual(len(cp.sections()), 2)
    }

    def test_sections_insertion_order() {
        self.assertEqual(_parsed().sections(), ["server", "auth"])
    }

    def test_duplicate_section_header_merges() {
        cp: ConfigParser = ConfigParser()
        cp.read_string("[a]\nx = 1\n[b]\ny = 2\n[a]\nz = 3\nx = 9\n")
        self.assertEqual(cp.sections(), ["a", "b"])
        self.assertEqual(cp.get("a", "x"), "9")
        self.assertEqual(cp.get("a", "z"), "3")
        self.assertEqual(cp.get("b", "y"), "2")
    }
}


class ConfigParserApiTests(TestCase) {
    def test_has_section_and_option() {
        const cp: ConfigParser = _parsed()
        self.assertTrue(cp.has_section("server"))
        self.assertFalse(cp.has_section("nope"))
        self.assertTrue(cp.has_option("server", "host"))
        self.assertFalse(cp.has_option("server", "nope"))
        self.assertFalse(cp.has_option("nope", "host"))
    }

    def test_missing_lookups_raise() {
        self.assertRaises(ValueError, _get_missing_section)
        self.assertRaises(ValueError, _get_missing_key)
        self.assertRaises(ValueError, _items_missing_section)
    }

    def test_typed_getters() {
        cp: ConfigParser = ConfigParser()
        cp.read_string("[t]\nn = 42\nf = 2.5\nb1 = true\nb2 = yes\nb3 = on\nb4 = 1\nb5 = True\n")
        self.assertEqual(cp.get_int("t", "n"), 42)
        self.assertEqual(cp.get_float("t", "f"), 2.5)
        self.assertTrue(cp.get_bool("t", "b1"))
        self.assertTrue(cp.get_bool("t", "b2"))
        self.assertTrue(cp.get_bool("t", "b3"))
        self.assertTrue(cp.get_bool("t", "b4"))
        self.assertFalse(cp.get_bool("t", "b5"))
    }

    def test_set_creates_and_overwrites() {
        cp: ConfigParser = ConfigParser()
        cp.set("fresh", "k", "v1")
        self.assertTrue(cp.has_section("fresh"))
        self.assertEqual(cp.get("fresh", "k"), "v1")
        cp.set("fresh", "k", "v2")
        self.assertEqual(cp.get("fresh", "k"), "v2")
        self.assertEqual(len(cp.items("fresh")), 1)
    }

    def test_add_section_noop_when_present() {
        cp: ConfigParser = _parsed()
        cp.add_section("server")
        self.assertEqual(cp.sections(), ["server", "auth"])
        self.assertEqual(cp.get("server", "host"), "localhost")
    }

    def test_items_pairs_in_order() {
        const pairs: list[list[str]] = _parsed().items("server")
        self.assertEqual(len(pairs), 2)
        self.assertEqual(pairs[0], ["host", "localhost"])
        self.assertEqual(pairs[1], ["port", "8080"])
    }

    def test_to_string_roundtrip() {
        const cp: ConfigParser = _parsed()
        const text: str = cp.to_string()
        self.assertEqual(text, "[server]\nhost = localhost\nport = 8080\n\n[auth]\nuser = ada\nempty = \n")
        back: ConfigParser = ConfigParser()
        back.read_string(text)
        self.assertEqual(back.sections(), ["server", "auth"])
        self.assertEqual(back.get("server", "port"), "8080")
        self.assertEqual(back.get("auth", "empty"), "")
    }
}


class UnquoteTests(TestCase) {
    """tomllib: escape handling, typed getters, sections.

    _unquote used to build the unescaped string one character per concat through a
    six-level if pyramid; it now joins verbatim spans. These tests pin the escape
    semantics (known escapes decode, unknown escapes keep their backslash) and the
    underscore-stripping typed getters.
    """

    def test_basic_escapes() {
        const doc: tomllib.TomlDoc = tomllib.loads("s = \"a\\nb\\tc\"")
        self.assertEqual(doc.get("s"), "a\nb\tc")
    }

    def test_backslash_and_quote_escapes() {
        const doc: tomllib.TomlDoc = tomllib.loads("s = \"a\\\\b \\\"q\\\"\"")
        self.assertEqual(doc.get("s"), "a\\b \"q\"")
    }

    def test_unknown_escape_kept_verbatim() {
        const doc: tomllib.TomlDoc = tomllib.loads("s = \"a\\xb\"")
        self.assertEqual(doc.get("s"), "a\\xb")
    }

    def test_no_escapes_verbatim() {
        const doc: tomllib.TomlDoc = tomllib.loads("s = \"plain value\"")
        self.assertEqual(doc.get("s"), "plain value")
    }

    def test_literal_single_quoted() {
        const doc: tomllib.TomlDoc = tomllib.loads("s = 'no \\n escapes here'")
        self.assertEqual(doc.get("s"), "no \\n escapes here")
    }
}


class GetterTests(TestCase) {
    def test_int_with_underscores() {
        const doc: tomllib.TomlDoc = tomllib.loads("n = 1_000_000")
        self.assertEqual(doc.get_int("n"), 1000000)
    }

    def test_float_with_underscores() {
        const doc: tomllib.TomlDoc = tomllib.loads("f = 1_0.5")
        self.assertEqual(doc.get_float("f"), 10.5)
    }

    def test_bool_and_sections() {
        const text: str = "[server]\nhost = \"localhost\"\nport = 8080\nsecure = true\n# comment\n"
        const doc: tomllib.TomlDoc = tomllib.loads(text)
        self.assertEqual(doc.get("server.host"), "localhost")
        self.assertEqual(doc.get_int("server.port"), 8080)
        self.assertEqual(doc.get_bool("server.secure"), true)
        self.assertEqual(doc.has("server.missing"), false)
    }
}


def _get_missing() {
    tomllib.loads("a = 1").get("missing")
}


class TomlDocStorageTests(TestCase) {
    def test_all_keys_insertion_order() {
        const doc: tomllib.TomlDoc = tomllib.loads("z = 1\na = 2\n[sec]\nm = 3\n")
        self.assertEqual(doc.all_keys(), ["z", "a", "sec.m"])
    }

    def test_duplicate_key_overwrites_in_place() {
        const doc: tomllib.TomlDoc = tomllib.loads("k = \"old\"\nj = 2\nk = \"new\"\n")
        self.assertEqual(doc.get("k"), "new")
        self.assertEqual(doc.all_keys(), ["k", "j"])
    }

    def test_has_and_missing_raise() {
        const doc: tomllib.TomlDoc = tomllib.loads("a = 1")
        self.assertTrue(doc.has("a"))
        self.assertFalse(doc.has("b"))
        self.assertRaises(ValueError, _get_missing)
    }
}


def _manifest_schema() -> Schema {
    s: Schema = Schema()
    s.field("name", "str", true)
    s.field("version", "str", true)
    s.optional("entry", "str", "main.dr")
    s.field("eggs", "dict", false)
    return s
}

def _missing_required() -> None {
    s: Schema = _manifest_schema()
    d: dict[str, Any] = parse(s, "{ version = '0.1.0' }")
}

def _wrong_type() -> None {
    s: Schema = _manifest_schema()
    d: dict[str, Any] = parse(s, "{ name = 5\n version = '0.1.0' }")
}

def _unknown_key() -> None {
    s: Schema = _manifest_schema()
    d: dict[str, Any] = parse(s, "{ name = 'x'\n version = '0.1.0'\n nam = 'typo' }")
}


class SchemaParseTests(TestCase) {
    def test_parse_reads_fields() {
        s: Schema = _manifest_schema()
        src: str = "{\n  name = 'myapp'\n  version = '0.1.0'\n  eggs = { http = { version = '^1.0' } }\n}"
        d: dict[str, Any] = parse(s, src)
        self.assertEqual(d["name"], "myapp")
        self.assertEqual(d["version"], "0.1.0")
    }

    def test_default_filled_when_absent() {
        s: Schema = _manifest_schema()
        d: dict[str, Any] = parse(s, "{ name = 'myapp'\n version = '0.1.0' }")
        self.assertEqual(d["entry"], "main.dr")
    }

    def test_missing_required_raises() {
        self.assertRaises(DragonScriptSchemaError, _missing_required)
    }

    def test_wrong_type_raises() {
        self.assertRaises(DragonScriptSchemaError, _wrong_type)
    }

    def test_unknown_key_raises() {
        self.assertRaises(DragonScriptSchemaError, _unknown_key)
    }
}


class EnvInjectionTests(TestCase) {
    def test_envs_linux_branch() {
        e: dict[str, Any] = envs(platform="linux")
        d: dict[str, Any] = loads_with("{ if platform == 'linux' { kind = 'penguin' } else { kind = 'other' } }", e)
        self.assertEqual(d["kind"], "penguin")
    }

    def test_envs_other_branch() {
        e: dict[str, Any] = envs(platform="mac")
        d: dict[str, Any] = loads_with("{ if platform == 'linux' { kind = 'penguin' } else { kind = 'other' } }", e)
        self.assertEqual(d["kind"], "other")
    }

    def test_parse_with_seeds_conditional() {
        s: Schema = Schema()
        s.field("kind", "str", true)
        e: dict[str, Any] = envs(platform="linux", arch="x86_64")
        d: dict[str, Any] = parse_with(s, "{ if platform == 'linux' { kind = 'penguin' } else { kind = 'other' } }", e)
        self.assertEqual(d["kind"], "penguin")
    }
}


def _range_bomb() -> None {
    d: dict[str, Any] = loads("{\n  xs = for i in range(99999999) { i }\n}")
}
def _include_from_string() -> None {
    d: dict[str, Any] = loads("include 'x.drs'\n{\n  a = 1\n}")
}

def _setup_dir() -> str {
    d: str = mkdtemp("drs_harden_", "")
    makedirs(join(d, "sub"))
    with make(join(d, "base.drs")) as w { n0: int = w.write("shared = 'hello'\n") }
    with make(join(d, "uses.drs")) as w { n1: int = w.write("include 'base.drs'\n{\n  greeting = ${shared}\n}\n") }
    with make(join(d, "evil_abs.drs")) as w { n2: int = w.write("include '/etc/passwd'\n{\n  a = 1\n}\n") }
    with make(join(join(d, "sub"), "evil_parent.drs")) as w { n3: int = w.write("include '../base.drs'\n{\n  a = 1\n}\n") }
    return d
}
const _DIR: str = _setup_dir()

def _include_absolute() -> None {
    d: dict[str, Any] = load(join(_DIR, "evil_abs.drs"))
}
def _include_parent() -> None {
    d: dict[str, Any] = load(join(join(_DIR, "sub"), "evil_parent.drs"))
}

class DrsHardeningTests(TestCase) {
    def test_range_capped() {
        self.assertRaises(Exception, _range_bomb)
    }
    def test_string_include_rejected() {
        self.assertRaises(Exception, _include_from_string)
    }
    def test_absolute_include_rejected() {
        self.assertRaises(Exception, _include_absolute)
    }
    def test_parent_traversal_include_rejected() {
        self.assertRaises(Exception, _include_parent)
    }
    def test_small_range_still_works() {
        const d: dict[str, Any] = loads("{\n  xs = for i in range(3) { 8080 + i }\n}")
        const xs: list[Any] = d["xs"]
        self.assertEqual(len(xs), 3)
    }
    def test_confined_sibling_include_works() {
        const d: dict[str, Any] = load(join(_DIR, "uses.drs"))
        self.assertEqual(d["greeting"], "hello")
    }
}


main([ParseTests(), FormatTests(), MultilineFieldTests(), PlainRowsTests(),
      ConfigParserParseTests(), ConfigParserApiTests(),
      UnquoteTests(), GetterTests(), TomlDocStorageTests(),
      SchemaParseTests(), EnvInjectionTests(), DrsHardeningTests()])

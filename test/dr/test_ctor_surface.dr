from unittest import TestCase, main

class Base {
    name: str

    def (name: str) {
        self.name = name
    }

    def describe() -> str {
        return "base:" + self.name
    }
}

class NoCtorChild(Base) {
    def tag() -> str {
        return "child"
    }
}

class DelegatingChild(Base) {
    def (name: str) {
        super(name)
    }
}

class CtorSurface(TestCase) {
    def test_no_ctor_subclass_zero_args() {
        c: NoCtorChild = NoCtorChild()
        self.assertEqual(c.tag(), "child")
    }

    def test_super_delegation() {
        d: DelegatingChild = DelegatingChild("rex")
        self.assertEqual(d.describe(), "base:rex")
    }

    def test_own_ctor_still_checked() {
        b: Base = Base("ada")
        self.assertEqual(b.describe(), "base:ada")
    }
}

main([CtorSurface()])

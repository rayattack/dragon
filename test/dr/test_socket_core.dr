from unittest import TestCase, main
from socket import TcpListener, TcpStream, UdpSocket, SocketHandle, AF_INET, SOCK_STREAM, SOL_SOCKET
from http.server import FdReader
from time import sleep_ms, monotonic
import os

extern "C" def socket(domain: intc, type: intc, protocol: intc) -> intc
extern "C" def connect(fd: intc, addr: ptr, addrlen: intc) -> intc
extern "C" def malloc(size: int) -> ptr
extern "C" def free(p: ptr)
extern "C" def setsockopt(fd: intc, level: intc, optname: intc, optval: ptr, optlen: intc) -> intc
extern "C" def dragon_sockaddr_in_new(port: intc, addr: str) -> ptr
extern "C" def dragon_sockaddr_in_size() -> intc
extern "C" def dragon_ptr_write_i32(p: ptr, offset: intc, val: intc)
extern "C" def dragon_close_fd(fd: int)

const _carriers_pinned: int = os.setenv("DRAGON_WORKER_THREADS", "2", 1)
const _carrier_cap_pinned: int = os.setenv("DRAGON_MAX_CARRIERS", "2", 1)

const TWO_POW_62: int = 4611686018427387904
const INT64_MAX: int = 9223372036854775807
const SO_LINGER: int = 13
const LINGER_STRUCT_BYTES: int = 8
const LINGER_SECONDS_OFFSET: int = 4


def _peer(l: TcpListener) -> None {
    conn: TcpStream = l.accept()
    conn.send("hello")
    conn.recv(16)
    conn.close()
}


def _slow_peer(l: TcpListener) -> None {
    conn: TcpStream = l.accept()
    sleep_ms(60)
    conn.send("hello")
    conn.recv(16)
    conn.close()
}


def _echo_once(lis: TcpListener) -> None {
    const conn: TcpStream = lis.accept()
    const msg: str = conn.recv(1024)
    conn.send("echo:" + msg)
    conn.close()
}


def _udp_park_receiver(s: UdpSocket) -> str {
    return s.recvfrom(64)
}


def _probe() -> int {
    return 7
}


def _rst_peer(l: TcpListener) -> None {
    const conn: TcpStream = l.accept()
    const linger: ptr = malloc(LINGER_STRUCT_BYTES)
    dragon_ptr_write_i32(linger, 0, 1)
    dragon_ptr_write_i32(linger, LINGER_SECONDS_OFFSET, 0)
    setsockopt(conn.raw_fd(), SOL_SOCKET, SO_LINGER, linger, LINGER_STRUCT_BYTES)
    free(linger)
    conn.close()
}


def _poisoned_stream() -> TcpStream {
    const c: TcpStream = TcpStream(SocketHandle.adopt_raw(socket(AF_INET, SOCK_STREAM, 0)))
    c.close()
    return c
}


def _recvfrom_on_a_closed_socket() -> None {
    const s: UdpSocket = UdpSocket("127.0.0.1", 0)
    s.close()
    s.recvfrom(64)
}


def _recv_on_a_closed_stream() -> None {
    _poisoned_stream().recv(16)
}


def _recv_bytes_on_a_closed_stream() -> None {
    _poisoned_stream().recv_bytes(16)
}


def _recv_timeout_on_a_closed_stream() -> None {
    _poisoned_stream().recv_timeout(16, 50)
}


def _recv_deadline_on_a_closed_stream() -> None {
    const c: TcpStream = _poisoned_stream()
    c.set_timeout(50)
    c.recv(16)
}


class SocketHandleTest(TestCase) {
    def test_adopt_and_read() -> None {
        h: SocketHandle = SocketHandle.adopt_raw(42)
        self.assertEqual(h.fd(), 42)
    }

    def test_close_poisons_and_is_idempotent() -> None {
        h: SocketHandle = SocketHandle.adopt_raw(42)
        h.close()
        self.assertEqual(h.fd(), -1)
        h.close()
        self.assertEqual(h.fd(), -1)
    }

    def test_fdreader_owns_the_claim() -> None {
        lis: TcpListener = TcpListener("127.0.0.1", 54479)
        lis.bind()
        lis.listen(4)

        t: Task[None] = fire _peer(lis)

        c: TcpStream = TcpStream.open("127.0.0.1", 54479)
        reader: FdReader = FdReader(own c)
        self.assertTrue(reader.socket_fd() > 0)
        got: bytes = reader.recv(16)
        self.assertEqual(got.decode(), "hello")

        reader.send("bye")
        reader.close()
        self.assertEqual(reader.socket_fd(), -1)
        self.assertEqual(reader.send("x"), -1)
        reader.close()

        await t
        lis.close()
    }
}


class SocketVthreadTests(TestCase) {
    def test_fire_server_roundtrip() {
        lis: TcpListener = TcpListener("127.0.0.1", 54421)
        lis.bind()
        lis.listen(8)
        t: Task[None] = fire _echo_once(lis)

        const c: TcpStream = TcpStream.open("127.0.0.1", 54421)
        c.send("ping")
        const reply: str = c.recv(1024)
        await t
        c.close()
        lis.close()

        self.assertEqual(reply, "echo:ping")
    }
}


class SocketRecvOomTests(TestCase) {
    def test_recv_size_failure_raises_not_segv() -> None {
        lis: TcpListener = TcpListener("127.0.0.1", 54484)
        lis.bind()
        lis.listen(4)
        t: Task[None] = fire _peer(lis)
        c: TcpStream = TcpStream.open("127.0.0.1", 54484)

        caught: int = 0
        try {
            s: str = c.recv(TWO_POW_62)
            print(len(s))
        } except MemoryError {
            caught = caught + 1
        }
        try {
            s2: str = c.recv(INT64_MAX)
            print(len(s2))
        } except MemoryError {
            caught = caught + 1
        }
        try {
            bs: bytes = c.recv_bytes(TWO_POW_62)
            print(len(bs))
        } except MemoryError {
            caught = caught + 1
        }
        try {
            bt: bytes = c.recv_timeout(TWO_POW_62, 200)
            print(len(bt))
        } except MemoryError {
            caught = caught + 1
        }
        self.assertEqual(caught, 4)

        got: str = c.recv(16)
        self.assertEqual(got, "hello")
        c.send("bye")
        c.close()
    }
}


class ForeignSocketTests(TestCase) {
    """A socket the runtime never armed still reads and writes.

    You hand Dragon a descriptor from somewhere else - your own `socket()` and
    `connect()`, an inherited fd, a C library's connection - and wrap it in a
    TcpStream. Nothing in that path ever set O_NONBLOCK, so a recv that arrives
    before the peer writes has nothing to return. The receive must still park the
    green thread and deliver the bytes when they land, never hold its carrier
    waiting and never lose the payload.
    """

    def test_recv_and_send_on_an_unarmed_descriptor() {
        lis: TcpListener = TcpListener("127.0.0.1", 54491)
        lis.bind()
        lis.listen(4)
        t: Task[None] = fire _slow_peer(lis)

        const fd: int = socket(AF_INET, SOCK_STREAM, 0)
        const addr: ptr = dragon_sockaddr_in_new(54491, "127.0.0.1")
        const addrlen: int = dragon_sockaddr_in_size()
        const rc: int = connect(fd, addr, addrlen)
        free(addr)
        self.assertEqual(rc, 0)

        const c: TcpStream = TcpStream(SocketHandle.adopt_raw(fd))
        self.assertEqual(c.recv(16), "hello")
        c.send("bye")
        c.close()

        await t
        lis.close()
    }
}


class UdpParkingTests(TestCase) {
    """A datagram receive must park the green thread, not sit on its carrier.

    This file pins the scheduler to two carriers and caps it at two, so a receive
    that holds its carrier cannot be rescued by the sysmon spawning a third: two
    blocked receivers own every carrier in the process and nothing else can run.
    """

    def test_recvfrom_parks_instead_of_holding_its_carrier() {
        const a: UdpSocket = UdpSocket("127.0.0.1", 54551)
        a.bind()
        const b: UdpSocket = UdpSocket("127.0.0.1", 54552)
        b.bind()

        r1: Task[str] = fire _udp_park_receiver(a)
        r2: Task[str] = fire _udp_park_receiver(b)
        sleep_ms(50)

        p: Task[int] = fire _probe()
        const t0: float = monotonic()
        while p.is_alive() and monotonic() - t0 < 2.0 {
            sleep_ms(5)
        }
        const probe_ran: bool = not p.is_alive()

        const sender: UdpSocket = UdpSocket("127.0.0.1", 0)
        sender.sendto("alpha", "127.0.0.1", 54551)
        sender.sendto("beta", "127.0.0.1", 54552)
        const got1: str = r1.join()
        const got2: str = r2.join()
        const probe_value: int = p.join()
        sender.close()
        a.close()
        b.close()

        self.assertTrue(probe_ran, "probe starved: recvfrom held both carriers instead of parking")
        self.assertEqual(got1, "alpha")
        self.assertEqual(got2, "beta")
        self.assertEqual(probe_value, 7)
    }

    def test_a_parked_receiver_gets_the_whole_datagram() {
        const s: UdpSocket = UdpSocket("127.0.0.1", 54553)
        s.bind()
        const r: Task[str] = fire _udp_park_receiver(s)
        sleep_ms(30)
        const sender: UdpSocket = UdpSocket("127.0.0.1", 0)
        sender.sendto("0123456789abcdef", "127.0.0.1", 54553)
        self.assertEqual(r.join(), "0123456789abcdef")
        sender.close()
        s.close()
    }
}


class RecvErrorTests(TestCase) {
    """A receive that fails must say so, not hand back an empty read.

    Every one of these reads looks like EOF to the caller if the failure is
    swallowed: the loop ends, the connection is treated as finished, and nothing
    in the program ever learns the kernel refused the read.
    """

    def test_recvfrom_error_raises_instead_of_an_empty_datagram() {
        self.assertRaises(OSError, _recvfrom_on_a_closed_socket)
    }

    def test_recv_error_raises_instead_of_eof() {
        self.assertRaises(OSError, _recv_on_a_closed_stream)
    }

    def test_recv_bytes_error_raises_instead_of_eof() {
        self.assertRaises(OSError, _recv_bytes_on_a_closed_stream)
    }

    def test_recv_timeout_error_raises_instead_of_eof() {
        self.assertRaises(OSError, _recv_timeout_on_a_closed_stream)
    }

    def test_deadline_recv_error_raises_instead_of_eof() {
        self.assertRaises(OSError, _recv_deadline_on_a_closed_stream)
    }

    def test_a_reset_peer_raises_connection_reset() {
        const lis: TcpListener = TcpListener("127.0.0.1", 54554)
        lis.bind()
        lis.listen(4)
        const t: Task[None] = fire _rst_peer(lis)
        const c: TcpStream = TcpStream.open("127.0.0.1", 54554)

        caught: str = "nothing"
        try {
            c.recv(64)
            caught = "returned"
        } except ConnectionResetError {
            caught = "reset"
        } except OSError {
            caught = "oserror"
        }

        await t
        c.close()
        lis.close()
        self.assertEqual(caught, "reset")
    }
}


class CloseVisibilityTests(TestCase) {
    """Closing a socket goes through the runtime, so the descriptor is really gone.

    A close the runtime never sees leaves the descriptor registered in its
    readiness set; the number it occupied is the honest witness that the close
    reached the kernel through the one path the runtime controls.
    """

    def test_close_frees_the_descriptor_number() {
        const first: int = socket(AF_INET, SOCK_STREAM, 0)
        self.assertTrue(first > 0)
        const h: SocketHandle = SocketHandle.adopt_raw(first)
        h.close()
        self.assertEqual(h.fd(), -1)
        h.close()
        self.assertEqual(h.fd(), -1)

        const reused: int = socket(AF_INET, SOCK_STREAM, 0)
        dragon_close_fd(reused)
        self.assertEqual(reused, first, "close() never reached the kernel: the descriptor number stayed taken")
    }

    def test_a_live_stream_closes_through_the_same_one_path() {
        const lis: TcpListener = TcpListener("127.0.0.1", 54555)
        lis.bind()
        lis.listen(4)
        const t: Task[None] = fire _peer(lis)

        const c: TcpStream = TcpStream.open("127.0.0.1", 54555)
        self.assertTrue(c.raw_fd() > 0)
        self.assertEqual(c.recv(16), "hello")
        c.send("bye")
        await t
        lis.close()

        c.close()
        self.assertEqual(c.raw_fd(), -1)
        c.close()
        self.assertEqual(c.raw_fd(), -1)
    }

    def test_a_closed_stream_refuses_to_read_a_recycled_descriptor() {
        const c: TcpStream = _poisoned_stream()
        self.assertEqual(c.raw_fd(), -1)
        self.assertRaises(OSError, _recv_on_a_closed_stream)
    }
}


main([SocketHandleTest(), SocketVthreadTests(), SocketRecvOomTests(),
      ForeignSocketTests(), UdpParkingTests(), RecvErrorTests(),
      CloseVisibilityTests()])

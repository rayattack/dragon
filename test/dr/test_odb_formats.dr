from unittest import TestCase, main
from odb import ODB, Documents, Document
from odb.vfs import SimVFS
from odb.pager import create, Pager
from odb.errors import SchemaError, PrepareError


def _mem() -> ODB {
    sim: SimVFS = SimVFS()
    p: Pager = create(sim, 4096)
    return ODB(sim, p)
}


def _events(db: ODB) -> Documents {
    return db.schema("events", { "type": "object",
                                 "properties": { "id": {"type": "integer"},
                                                 "at": {"type": "string", "format": "date-time"},
                                                 "day": {"type": "string", "format": "date"},
                                                 "amount": {"type": "string", "format": "decimal"} },
                                 "required": ["id", "at", "day", "amount"] })
}


def _ids(rows: list[Document]) -> list[int] {
    out: list[int] = []
    for r in rows {
        const i: int = r["id"]
        out.append(i)
    }
    return out
}


class DateTimeOrderTest(TestCase) {
    def _seed(db: ODB) -> Documents {
        ev: Documents = _events(db)
        ev.save({id: 1, at: "2026-08-19T12:00:00Z", day: "2026-08-19", amount: "10"})
        ev.save({id: 2, at: "2026-08-19T12:00:00.500000Z", day: "2026-08-20", amount: "9.50"})
        ev.save({id: 3, at: "2026-08-19T11:00:00Z", day: "2026-08-18", amount: "100"})
        return ev
    }

    def test_fractional_seconds_sort_after_whole_seconds() -> None {
        db: ODB = _mem()
        self._seed(db)
        const rows: list[Document] = db.find("events ? at > '2026-08-19T12:00:00Z' { id }")
        self.assertEqual(_ids(rows), [2])
    }

    def test_date_time_range_uses_instants_not_text() -> None {
        db: ODB = _mem()
        self._seed(db)
        const rows: list[Document] = db.find("events ? at < '2026-08-19T12:00:00Z' { id }")
        self.assertEqual(_ids(rows), [3])
    }

    def test_offset_literal_compares_as_the_same_instant() -> None {
        db: ODB = _mem()
        self._seed(db)
        const rows: list[Document] = db.find("events ? at == '2026-08-19T13:00:00+01:00' { id }")
        self.assertEqual(_ids(rows), [1])
    }

    def test_date_ordering() -> None {
        db: ODB = _mem()
        self._seed(db)
        const rows: list[Document] = db.find("events ? day >= '2026-08-19' { id }")
        const got: list[int] = _ids(rows)
        self.assertEqual(len(got), 2)
    }

    def test_projection_returns_the_original_text() -> None {
        db: ODB = _mem()
        self._seed(db)
        const rows: list[Document] = db.find("events ? id == 2 { id, at, amount }")
        const at: str = rows[0]["at"]
        const amt: str = rows[0]["amount"]
        self.assertEqual(at, "2026-08-19T12:00:00.500000Z")
        self.assertEqual(amt, "9.50")
    }
}


class DecimalOrderTest(TestCase) {
    def _seed(db: ODB) -> Documents {
        ev: Documents = _events(db)
        ev.save({id: 1, at: "2026-01-01T00:00:00Z", day: "2026-01-01", amount: "10"})
        ev.save({id: 2, at: "2026-01-01T00:00:00Z", day: "2026-01-01", amount: "9.50"})
        ev.save({id: 3, at: "2026-01-01T00:00:00Z", day: "2026-01-01", amount: "100"})
        return ev
    }

    def test_decimal_compares_numerically_not_lexicographically() -> None {
        db: ODB = _mem()
        self._seed(db)
        const rows: list[Document] = db.find("events ? amount > '10' { id }")
        self.assertEqual(_ids(rows), [3])
    }

    def test_decimal_compares_against_a_numeric_literal() -> None {
        db: ODB = _mem()
        self._seed(db)
        const rows: list[Document] = db.find("events ? amount > 10 { id }")
        self.assertEqual(_ids(rows), [3])
    }

    def test_scale_does_not_affect_equality() -> None {
        db: ODB = _mem()
        self._seed(db)
        const rows: list[Document] = db.find("events ? amount == '9.5' { id }")
        self.assertEqual(_ids(rows), [2])
    }

    def test_min_and_max_respect_numeric_order() -> None {
        db: ODB = _mem()
        self._seed(db)
        const rows: list[Document] = db.find("events { lo: min!(amount), hi: max!(amount) }")
        const lo: str = rows[0]["lo"]
        const hi: str = rows[0]["hi"]
        self.assertEqual(lo, "9.50")
        self.assertEqual(hi, "100")
    }

    def test_sum_over_decimal_is_a_prepare_time_error() -> None {
        db: ODB = _mem()
        self._seed(db)
        raised: bool = False
        msg: str = ""
        try {
            db.find("events { total: sum!(amount) }")
        } except PrepareError as e {
            raised = True
            msg = str(e)
        }
        self.assertTrue(raised)
        self.assertTrue("decimal" in msg)
    }

    def test_arithmetic_on_decimal_is_a_prepare_time_error() -> None {
        db: ODB = _mem()
        self._seed(db)
        raised: bool = False
        try {
            db.find("events ? amount + 1 > 5 { id }")
        } except PrepareError {
            raised = True
        }
        self.assertTrue(raised)
    }
}


class IndexedFormatTest(TestCase) {
    def test_date_time_index_round_trips() -> None {
        db: ODB = _mem()
        ev: Documents = _events(db)
        ev.meta({ "primary": "id", "index": ["at", "amount"] })
        ev.save({id: 1, at: "2026-08-19T12:00:00Z", day: "2026-08-19", amount: "10"})
        ev.save({id: 2, at: "2026-08-19T12:00:00.500000Z", day: "2026-08-20", amount: "9.50"})
        const rows: list[Document] = db.find("events ? at > '2026-08-19T12:00:00Z' { id }")
        self.assertEqual(_ids(rows), [2])
    }

    def test_unique_decimal_treats_equal_values_as_duplicates() -> None {
        db: ODB = _mem()
        ev: Documents = _events(db)
        ev.meta({ "primary": "id", "unique": ["amount"] })
        ev.save({id: 1, at: "2026-08-19T12:00:00Z", day: "2026-08-19", amount: "1.5"})
        raised: bool = False
        try {
            ev.save({id: 2, at: "2026-08-19T12:00:00Z", day: "2026-08-19", amount: "1.50"})
        } except Exception {
            raised = True
        }
        self.assertTrue(raised)
    }
}


class BytesFieldTest(TestCase) {
    def test_bytes_round_trip_through_the_db() -> None {
        db: ODB = _mem()
        blobs: Documents = db.schema("blobs", { "type": "object",
                                               "properties": { "id": {"type": "integer"},
                                                               "payload": {"type": "string", "format": "bytes"} },
                                               "required": ["id", "payload"] })
        blobs.save({id: 1, payload: "aGVsbG8gd29ybGQ="})
        const d: Document = blobs.read(1)
        const p: str = d["payload"]
        self.assertEqual(p, "aGVsbG8gd29ybGQ=")
    }

    def test_invalid_base64_is_refused_at_save() -> None {
        db: ODB = _mem()
        blobs: Documents = db.schema("blobs", { "type": "object",
                                               "properties": { "id": {"type": "integer"},
                                                               "payload": {"type": "string", "format": "bytes"} },
                                               "required": ["id", "payload"] })
        raised: bool = False
        try {
            blobs.save({id: 1, payload: "%%%not base64%%%"})
        } except SchemaError {
            raised = True
        }
        self.assertTrue(raised)
    }
}



class SortAndRejectionTest(TestCase) {
    def _seed(db: ODB) -> Documents {
        ev: Documents = _events(db)
        ev.save({id: 1, at: "2026-08-19T12:00:00Z", day: "2026-08-19", amount: "10"})
        ev.save({id: 2, at: "2026-08-19T12:00:00.500000Z", day: "2026-08-20", amount: "9.50"})
        ev.save({id: 3, at: "2026-08-19T11:00:00Z", day: "2026-08-18", amount: "100"})
        return ev
    }

    def test_sort_by_date_time_uses_instants() -> None {
        db: ODB = _mem()
        self._seed(db)
        const rows: list[Document] = db.find("events { id, at } | sort at")
        self.assertEqual(_ids(rows), [3, 1, 2])
    }

    def test_sort_by_decimal_is_numeric() -> None {
        db: ODB = _mem()
        self._seed(db)
        const rows: list[Document] = db.find("events { id, amount } | sort amount")
        self.assertEqual(_ids(rows), [2, 1, 3])
    }

    def test_sort_by_decimal_descending() -> None {
        db: ODB = _mem()
        self._seed(db)
        const rows: list[Document] = db.find("events { id, amount } | sort -amount")
        self.assertEqual(_ids(rows), [3, 1, 2])
    }

    def test_comparing_an_array_field_is_refused_at_prepare() -> None {
        db: ODB = _mem()
        bags: Documents = db.schema("bags", { "type": "object",
                                             "properties": { "id": {"type": "integer"},
                                                             "tags": {"type": "array", "items": {"type": "string"}},
                                                             "meta": {"type": "object", "properties": {"k": {"type": "string"}}} },
                                             "required": ["id", "tags", "meta"] })
        inner: dict[str, Any] = {}
        inner["k"] = "v"
        tags: list[Any] = ["a"]
        bags.save({id: 1, tags: tags, meta: inner})
        raised: bool = False
        msg: str = ""
        try {
            db.find("bags ? tags == 'a' { id }")
        } except PrepareError as e {
            raised = True
            msg = str(e)
        }
        self.assertTrue(raised)
        self.assertTrue("array" in msg)
    }

    def test_comparing_an_object_field_is_refused_at_prepare() -> None {
        db: ODB = _mem()
        bags: Documents = db.schema("bags2", { "type": "object",
                                              "properties": { "id": {"type": "integer"},
                                                              "meta": {"type": "object", "properties": {"k": {"type": "string"}}} },
                                              "required": ["id", "meta"] })
        raised: bool = False
        try {
            db.find("bags2 ? meta > 'x' { id }")
        } except PrepareError {
            raised = True
        }
        self.assertTrue(raised)
    }

    def test_sorting_by_an_array_field_is_refused_at_prepare() -> None {
        db: ODB = _mem()
        bags: Documents = db.schema("bags3", { "type": "object",
                                              "properties": { "id": {"type": "integer"},
                                                              "tags": {"type": "array", "items": {"type": "string"}} },
                                              "required": ["id", "tags"] })
        raised: bool = False
        try {
            db.find("bags3 { id } | sort tags")
        } except PrepareError {
            raised = True
        }
        self.assertTrue(raised)
    }

    def test_null_check_on_a_composite_field_still_works() -> None {
        db: ODB = _mem()
        bags: Documents = db.schema("bags4", { "type": "object",
                                              "properties": { "id": {"type": "integer"},
                                                              "tags": {"type": ["array", "null"], "items": {"type": "string"}} },
                                              "required": ["id", "tags"] })
        const nil: Any = None
        bags.save({id: 1, tags: nil})
        const rows: list[Document] = db.find("bags4 ? tags == null { id }")
        self.assertEqual(_ids(rows), [1])
    }
}


main([DateTimeOrderTest(), DecimalOrderTest(), IndexedFormatTest(), BytesFieldTest(), SortAndRejectionTest()])

# test/dr/test_header_injection.dr - Response header CR/LF rejection.
#
# A header value carrying CR/LF ends the current header and starts a new one
# on the wire, so a single tainted value becomes an attacker-chosen header
# (or, with a doubled CRLF, an entire forged response). `set_header` has
# always rejected control bytes; the `res.headers = k, v` shorthand is the
# other documented way to write the same header and must reject them too.
#
# Both spellings write the same dict, so both must enforce the same rule.

from unittest import TestCase, main
from http.server import Response


const TAINTED: str = "ok\r\nX-Injected: yes"


class HeaderInjectionTests(TestCase) {
    def test_set_header_rejects_crlf_in_value() {
        res: Response = Response()
        def run() {
            res.set_header("x-trace", TAINTED)
        }
        self.assertRaises(ValueError, run)
    }

    def test_tuple_setter_rejects_crlf_in_value() {
        # The shorthand form the docstring recommends for brevity.
        res: Response = Response()
        def run() {
            res.headers = "x-trace", TAINTED
        }
        self.assertRaises(ValueError, run)
    }

    def test_tuple_setter_rejects_crlf_in_name() {
        res: Response = Response()
        def run() {
            res.headers = "x-bad\r\nX-Injected", "ok"
        }
        self.assertRaises(ValueError, run)
    }

    def test_tuple_setter_still_sets_ordinary_headers() {
        # The guard must not break the normal case.
        res: Response = Response()
        res.body = "hi"
        res.headers = "x-trace", "abc123"
        const wire: str = res.serialize()
        self.assertIn("x-trace: abc123", wire)
    }

    def test_injected_header_never_reaches_the_wire() {
        # Belt-and-braces: whatever the failure mode, a forged header must
        # not appear in serialized output.
        res: Response = Response()
        res.body = "hi"
        try {
            res.headers = "x-trace", TAINTED
        } except ValueError {
            pass
        }
        self.assertNotIn("X-Injected", res.serialize())
    }
}


main([HeaderInjectionTests()])


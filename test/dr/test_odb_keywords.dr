from unittest import TestCase, main
from odb.schema import compile_schema, CompiledSchema
from odb.dbon import encode, decode
from odb.errors import SchemaError


def _compile(schema: dict[str, Any]) -> CompiledSchema {
    return compile_schema("t", schema, 1, 1, "{}")
}


def _bad_schema(schema: dict[str, Any]) -> bool {
    try {
        _compile(schema)
    } except SchemaError {
        return True
    }
    return False
}


def _one(field: dict[str, Any]) -> CompiledSchema {
    props: dict[str, Any] = {}
    props["v"] = field
    s: dict[str, Any] = {}
    s["type"] = "object"
    s["properties"] = props
    req: list[Any] = ["v"]
    s["required"] = req
    return _compile(s)
}


def _accepts(cs: CompiledSchema, v: Any) -> bool {
    doc: dict[str, Any] = {}
    doc["v"] = v
    try {
        encode(cs, doc)
    } except SchemaError {
        return False
    }
    return True
}


def _round(cs: CompiledSchema, v: Any) -> Any {
    doc: dict[str, Any] = {}
    doc["v"] = v
    const back: dict[str, Any] = decode(cs, encode(cs, doc))
    return back["v"]
}


class EnumAndConstTest(TestCase) {
    def test_enum_is_enforced() -> None {
        const cs: CompiledSchema = _one({"type": "string", "enum": ["red", "green"]})
        self.assertTrue(_accepts(cs, "red"))
        self.assertTrue(_accepts(cs, "green"))
        self.assertFalse(_accepts(cs, "purple"))
    }

    def test_enum_over_integers() -> None {
        const cs: CompiledSchema = _one({"type": "integer", "enum": [1, 2, 3]})
        self.assertTrue(_accepts(cs, 2))
        self.assertFalse(_accepts(cs, 4))
    }

    def test_enum_compares_numbers_across_int_and_float() -> None {
        const cs: CompiledSchema = _one({"type": "number", "enum": [1, 2.5]})
        self.assertTrue(_accepts(cs, 1.0))
        self.assertTrue(_accepts(cs, 2.5))
        self.assertFalse(_accepts(cs, 3.0))
    }

    def test_empty_enum_is_refused_at_compile() -> None {
        props: dict[str, Any] = {}
        empty: list[Any] = []
        props["v"] = {"type": "string", "enum": empty}
        s: dict[str, Any] = {}
        s["properties"] = props
        self.assertTrue(_bad_schema(s))
    }

    def test_enum_entry_that_violates_the_field_is_refused() -> None {
        props: dict[str, Any] = {}
        props["v"] = {"type": "integer", "enum": ["not-an-integer"]}
        s: dict[str, Any] = {}
        s["properties"] = props
        self.assertTrue(_bad_schema(s))
    }

    def test_const_is_enforced() -> None {
        const cs: CompiledSchema = _one({"type": "string", "const": "fixed"})
        self.assertTrue(_accepts(cs, "fixed"))
        self.assertFalse(_accepts(cs, "other"))
    }
}


class PatternTest(TestCase) {
    def test_pattern_is_enforced() -> None {
        const cs: CompiledSchema = _one({"type": "string", "pattern": "^[a-z]+$"})
        self.assertTrue(_accepts(cs, "abc"))
        self.assertFalse(_accepts(cs, "1234!!"))
    }

    def test_pattern_is_an_unanchored_search_like_json_schema() -> None {
        const cs: CompiledSchema = _one({"type": "string", "pattern": "[0-9]+"})
        self.assertTrue(_accepts(cs, "ab12cd"))
        self.assertFalse(_accepts(cs, "abcd"))
    }

    def test_invalid_regex_is_refused_at_compile() -> None {
        props: dict[str, Any] = {}
        props["v"] = {"type": "string", "pattern": "([unclosed"}
        s: dict[str, Any] = {}
        s["properties"] = props
        self.assertTrue(_bad_schema(s))
    }

    def test_pattern_on_a_non_string_is_refused() -> None {
        props: dict[str, Any] = {}
        props["v"] = {"type": "integer", "pattern": "^[0-9]+$"}
        s: dict[str, Any] = {}
        s["properties"] = props
        self.assertTrue(_bad_schema(s))
    }
}


class BoundsTest(TestCase) {
    def test_exclusive_maximum_is_enforced() -> None {
        const cs: CompiledSchema = _one({"type": "integer", "exclusiveMaximum": 10})
        self.assertTrue(_accepts(cs, 9))
        self.assertFalse(_accepts(cs, 10))
        self.assertFalse(_accepts(cs, 11))
    }

    def test_exclusive_minimum_is_enforced() -> None {
        const cs: CompiledSchema = _one({"type": "integer", "exclusiveMinimum": 0})
        self.assertTrue(_accepts(cs, 1))
        self.assertFalse(_accepts(cs, 0))
        self.assertFalse(_accepts(cs, -1))
    }

    def test_inclusive_bounds_still_work() -> None {
        const cs: CompiledSchema = _one({"type": "integer", "minimum": 1, "maximum": 10})
        self.assertTrue(_accepts(cs, 1))
        self.assertTrue(_accepts(cs, 10))
        self.assertFalse(_accepts(cs, 0))
        self.assertFalse(_accepts(cs, 11))
    }

    def test_draft4_boolean_exclusive_minimum_is_refused() -> None {
        props: dict[str, Any] = {}
        props["v"] = {"type": "integer", "minimum": 1, "exclusiveMinimum": True}
        s: dict[str, Any] = {}
        s["properties"] = props
        self.assertTrue(_bad_schema(s))
    }

    def test_bounds_on_a_string_are_refused() -> None {
        props: dict[str, Any] = {}
        props["v"] = {"type": "string", "minimum": 1}
        s: dict[str, Any] = {}
        s["properties"] = props
        self.assertTrue(_bad_schema(s))
    }
}


class ItemCountTest(TestCase) {
    def test_min_items_is_enforced() -> None {
        const cs: CompiledSchema = _one({"type": "array", "items": {"type": "string"}, "minItems": 2})
        two: list[Any] = ["a", "b"]
        one: list[Any] = ["a"]
        none: list[Any] = []
        self.assertTrue(_accepts(cs, two))
        self.assertFalse(_accepts(cs, one))
        self.assertFalse(_accepts(cs, none))
    }

    def test_max_items_is_enforced() -> None {
        const cs: CompiledSchema = _one({"type": "array", "items": {"type": "string"}, "maxItems": 2})
        two: list[Any] = ["a", "b"]
        three: list[Any] = ["a", "b", "c"]
        self.assertTrue(_accepts(cs, two))
        self.assertFalse(_accepts(cs, three))
    }

    def test_contradictory_item_counts_are_refused() -> None {
        props: dict[str, Any] = {}
        props["v"] = {"type": "array", "minItems": 5, "maxItems": 2}
        s: dict[str, Any] = {}
        s["properties"] = props
        self.assertTrue(_bad_schema(s))
    }

    def test_item_counts_on_a_non_array_are_refused() -> None {
        props: dict[str, Any] = {}
        props["v"] = {"type": "string", "minItems": 1}
        s: dict[str, Any] = {}
        s["properties"] = props
        self.assertTrue(_bad_schema(s))
    }
}


class RejectedKeywordTest(TestCase) {
    def _refuses(k: str, v: Any) -> bool {
        props: dict[str, Any] = {}
        inner: dict[str, Any] = {}
        inner["type"] = "string"
        inner[k] = v
        props["v"] = inner
        s: dict[str, Any] = {}
        s["properties"] = props
        return _bad_schema(s)
    }

    def test_pattern_properties_is_refused() -> None {
        empty: dict[str, Any] = {}
        self.assertTrue(self._refuses("patternProperties", empty))
    }

    def test_not_is_refused() -> None {
        empty: dict[str, Any] = {}
        self.assertTrue(self._refuses("not", empty))
    }

    def test_any_of_and_all_of_are_refused() -> None {
        empty: list[Any] = []
        self.assertTrue(self._refuses("anyOf", empty))
        self.assertTrue(self._refuses("allOf", empty))
    }

    def test_conditionals_are_refused() -> None {
        empty: dict[str, Any] = {}
        self.assertTrue(self._refuses("if", empty))
        self.assertTrue(self._refuses("then", empty))
        self.assertTrue(self._refuses("else", empty))
        self.assertTrue(self._refuses("dependentSchemas", empty))
    }

    def test_unevaluated_properties_is_refused() -> None {
        self.assertTrue(self._refuses("unevaluatedProperties", False))
    }

    def test_prefix_items_is_refused() -> None {
        empty: list[Any] = []
        self.assertTrue(self._refuses("prefixItems", empty))
    }

    def test_unimplemented_keywords_are_refused_rather_than_ignored() -> None {
        self.assertTrue(self._refuses("multipleOf", 3))
        self.assertTrue(self._refuses("uniqueItems", True))
        self.assertTrue(self._refuses("contains", 1))
        self.assertTrue(self._refuses("propertyNames", 1))
        self.assertTrue(self._refuses("dependentRequired", 1))
        self.assertTrue(self._refuses("madeUpKeyword", 1))
    }

    def test_annotations_are_accepted_and_ignored() -> None {
        const cs: CompiledSchema = _one({"type": "string", "title": "A title", "description": "prose", "$comment": "note", "deprecated": False, "readOnly": True})
        self.assertTrue(_accepts(cs, "anything"))
    }

    def test_required_naming_an_unknown_property_is_refused() -> None {
        props: dict[str, Any] = {}
        props["a"] = {"type": "integer"}
        s: dict[str, Any] = {}
        s["properties"] = props
        req: list[Any] = ["a", "ghost"]
        s["required"] = req
        self.assertTrue(_bad_schema(s))
    }
}


class FormatTest(TestCase) {
    def test_date_time_is_validated_and_round_trips() -> None {
        const cs: CompiledSchema = _one({"type": "string", "format": "date-time"})
        self.assertTrue(_accepts(cs, "2026-08-19T12:34:56Z"))
        self.assertFalse(_accepts(cs, "not-a-date"))
        self.assertFalse(_accepts(cs, "2026-08-19"))
        const back: str = _round(cs, "2026-08-19T12:34:56Z")
        self.assertEqual(back, "2026-08-19T12:34:56Z")
    }

    def test_date_time_offsets_normalise_to_utc() -> None {
        const cs: CompiledSchema = _one({"type": "string", "format": "date-time"})
        const back: str = _round(cs, "2026-08-19T12:00:00+01:00")
        self.assertEqual(back, "2026-08-19T11:00:00Z")
    }

    def test_date_is_validated_and_round_trips() -> None {
        const cs: CompiledSchema = _one({"type": "string", "format": "date"})
        self.assertTrue(_accepts(cs, "2026-08-19"))
        self.assertFalse(_accepts(cs, "2026-02-30"))
        self.assertFalse(_accepts(cs, "nope"))
        const back: str = _round(cs, "2026-08-19")
        self.assertEqual(back, "2026-08-19")
    }

    def test_pre_epoch_date_round_trips() -> None {
        const cs: CompiledSchema = _one({"type": "string", "format": "date"})
        const back: str = _round(cs, "1901-05-06")
        self.assertEqual(back, "1901-05-06")
    }

    def test_decimal_is_validated_and_keeps_its_scale() -> None {
        const cs: CompiledSchema = _one({"type": "string", "format": "decimal"})
        self.assertTrue(_accepts(cs, "1.50"))
        self.assertTrue(_accepts(cs, "-0.001"))
        self.assertFalse(_accepts(cs, "1.2.3"))
        self.assertFalse(_accepts(cs, "NaN"))
        const back: str = _round(cs, "1.50")
        self.assertEqual(back, "1.50")
    }

    def test_decimal_keeps_precision_beyond_f64() -> None {
        const cs: CompiledSchema = _one({"type": "string", "format": "decimal"})
        const back: str = _round(cs, "9007199254740993")
        self.assertEqual(back, "9007199254740993")
    }

    def test_bytes_round_trips_through_base64() -> None {
        const cs: CompiledSchema = _one({"type": "string", "format": "bytes"})
        self.assertTrue(_accepts(cs, "aGVsbG8="))
        self.assertFalse(_accepts(cs, "!!!not base64!!!"))
        const back: str = _round(cs, "aGVsbG8=")
        self.assertEqual(back, "aGVsbG8=")
    }

    def test_unknown_format_is_refused() -> None {
        props: dict[str, Any] = {}
        props["v"] = {"type": "string", "format": "email"}
        s: dict[str, Any] = {}
        s["properties"] = props
        self.assertTrue(_bad_schema(s))
    }

    def test_format_on_a_non_string_is_refused() -> None {
        props: dict[str, Any] = {}
        props["v"] = {"type": "integer", "format": "date"}
        s: dict[str, Any] = {}
        s["properties"] = props
        self.assertTrue(_bad_schema(s))
    }

    def test_nullable_formatted_field_stores_null() -> None {
        types: list[Any] = ["string", "null"]
        const cs: CompiledSchema = _one({"type": types, "format": "date"})
        const nil: Any = None
        self.assertTrue(_accepts(cs, nil))
        self.assertTrue(_accepts(cs, "2026-08-19"))
    }
}


class DefsAndRefTest(TestCase) {
    def test_ref_reuses_a_shape() -> None {
        defs: dict[str, Any] = {}
        defs["money"] = {"type": "string", "format": "decimal"}
        props: dict[str, Any] = {}
        props["total"] = {"$ref": "#/$defs/money"}
        s: dict[str, Any] = {}
        s["$defs"] = defs
        s["properties"] = props
        req: list[Any] = ["total"]
        s["required"] = req
        const cs: CompiledSchema = _compile(s)
        doc: dict[str, Any] = {}
        doc["total"] = "12.34"
        const back: dict[str, Any] = decode(cs, encode(cs, doc))
        const t: str = back["total"]
        self.assertEqual(t, "12.34")
        bad: dict[str, Any] = {}
        bad["total"] = "not-a-number"
        raised: bool = False
        try {
            encode(cs, bad)
        } except SchemaError {
            raised = True
        }
        self.assertTrue(raised)
    }

    def test_sibling_keywords_override_the_ref() -> None {
        defs: dict[str, Any] = {}
        defs["name"] = {"type": "string", "maxLength": 100}
        props: dict[str, Any] = {}
        props["code"] = {"$ref": "#/$defs/name", "maxLength": 3}
        s: dict[str, Any] = {}
        s["$defs"] = defs
        s["properties"] = props
        req: list[Any] = ["code"]
        s["required"] = req
        const cs: CompiledSchema = _compile(s)
        doc: dict[str, Any] = {}
        doc["code"] = "abcd"
        raised: bool = False
        try {
            encode(cs, doc)
        } except SchemaError {
            raised = True
        }
        self.assertTrue(raised)
    }

    def test_cross_file_ref_is_refused() -> None {
        props: dict[str, Any] = {}
        props["v"] = {"$ref": "other.schema.json#/$defs/thing"}
        s: dict[str, Any] = {}
        s["properties"] = props
        self.assertTrue(_bad_schema(s))
    }

    def test_missing_def_is_refused() -> None {
        defs: dict[str, Any] = {}
        props: dict[str, Any] = {}
        props["v"] = {"$ref": "#/$defs/ghost"}
        s: dict[str, Any] = {}
        s["$defs"] = defs
        s["properties"] = props
        self.assertTrue(_bad_schema(s))
    }

    def test_recursive_ref_is_refused() -> None {
        inner: dict[str, Any] = {}
        inner["self"] = {"$ref": "#/$defs/node"}
        defs: dict[str, Any] = {}
        defs["node"] = {"type": "object", "properties": inner}
        props: dict[str, Any] = {}
        props["root"] = {"$ref": "#/$defs/node"}
        s: dict[str, Any] = {}
        s["$defs"] = defs
        s["properties"] = props
        self.assertTrue(_bad_schema(s))
    }
}


class NestedObjectTest(TestCase) {
    def _addr_schema() -> CompiledSchema {
        inner: dict[str, Any] = {}
        inner["city"] = {"type": "string", "minLength": 2}
        inner["postcode"] = {"type": "string", "pattern": "^[0-9]{5}$"}
        ireq: list[Any] = ["city"]
        props: dict[str, Any] = {}
        props["address"] = {"type": "object", "properties": inner, "required": ireq}
        s: dict[str, Any] = {}
        s["properties"] = props
        req: list[Any] = ["address"]
        s["required"] = req
        return _compile(s)
    }

    def test_nested_constraints_are_enforced() -> None {
        const cs: CompiledSchema = self._addr_schema()
        good: dict[str, Any] = {}
        addr: dict[str, Any] = {}
        addr["city"] = "Lagos"
        addr["postcode"] = "10001"
        good["address"] = addr
        self.assertTrue(_accepts_named(cs, "address", addr))

        bad: dict[str, Any] = {}
        bad["city"] = "L"
        self.assertFalse(_accepts_named(cs, "address", bad))

        badpc: dict[str, Any] = {}
        badpc["city"] = "Lagos"
        badpc["postcode"] = "nope"
        self.assertFalse(_accepts_named(cs, "address", badpc))
    }

    def test_missing_nested_required_field_is_refused() -> None {
        const cs: CompiledSchema = self._addr_schema()
        empty: dict[str, Any] = {}
        self.assertFalse(_accepts_named(cs, "address", empty))
    }

    def test_nested_object_round_trips() -> None {
        const cs: CompiledSchema = self._addr_schema()
        addr: dict[str, Any] = {}
        addr["city"] = "Lagos"
        addr["postcode"] = "10001"
        doc: dict[str, Any] = {}
        doc["address"] = addr
        const back: dict[str, Any] = decode(cs, encode(cs, doc))
        const got: dict[str, Any] = back["address"]
        const city: str = got["city"]
        self.assertEqual(city, "Lagos")
    }
}


class ArrayItemTest(TestCase) {
    def test_object_items_are_validated() -> None {
        inner: dict[str, Any] = {}
        inner["sku"] = {"type": "string", "minLength": 3}
        ireq: list[Any] = ["sku"]
        props: dict[str, Any] = {}
        props["items"] = {"type": "array", "items": {"type": "object", "properties": inner, "required": ireq}}
        s: dict[str, Any] = {}
        s["properties"] = props
        req: list[Any] = ["items"]
        s["required"] = req
        const cs: CompiledSchema = _compile(s)

        ok1: dict[str, Any] = {}
        ok1["sku"] = "ABC"
        good: list[Any] = [ok1]
        self.assertTrue(_accepts_named(cs, "items", good))

        bad1: dict[str, Any] = {}
        bad1["sku"] = "A"
        bad: list[Any] = [bad1]
        self.assertFalse(_accepts_named(cs, "items", bad))

        miss: dict[str, Any] = {}
        missing: list[Any] = [miss]
        self.assertFalse(_accepts_named(cs, "items", missing))
    }

    def test_formatted_items_are_validated() -> None {
        props: dict[str, Any] = {}
        props["days"] = {"type": "array", "items": {"type": "string", "format": "date"}}
        s: dict[str, Any] = {}
        s["properties"] = props
        req: list[Any] = ["days"]
        s["required"] = req
        const cs: CompiledSchema = _compile(s)
        good: list[Any] = ["2026-08-19"]
        bad: list[Any] = ["2026-02-30"]
        self.assertTrue(_accepts_named(cs, "days", good))
        self.assertFalse(_accepts_named(cs, "days", bad))
    }

    def test_items_on_a_non_array_is_refused() -> None {
        props: dict[str, Any] = {}
        props["v"] = {"type": "string", "items": {"type": "string"}}
        s: dict[str, Any] = {}
        s["properties"] = props
        self.assertTrue(_bad_schema(s))
    }
}


def _accepts_named(cs: CompiledSchema, name: str, v: Any) -> bool {
    doc: dict[str, Any] = {}
    doc[name] = v
    try {
        encode(cs, doc)
    } except SchemaError {
        return False
    }
    return True
}


main([EnumAndConstTest(), PatternTest(), BoundsTest(), ItemCountTest(), RejectedKeywordTest(), FormatTest(), DefsAndRefTest(), NestedObjectTest(), ArrayItemTest()])

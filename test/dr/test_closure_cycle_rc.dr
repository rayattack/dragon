# The cycle collector sees through closures + captured envs (was an unbounded RSS-proven leak,
# invisible to LSan). Pins the dangerous direction: a LIVE cycle must survive a forced collection.

from unittest import TestCase, main

extern "C" def dragon_gc_collect() -> int


class Node {
    n: int
    cb: Callable[[], int]
    def(seed: int) {
        self.n = seed
        self.cb = lambda () -> int { self.n = self.n + 1; return self.n }
    }
}


class Handler {
    n: int
    cb: Callable[[int], int]
    def(seed: int) {
        self.n = seed
        self.cb = getattr(self, "act")
    }
    def act(x: int) -> int { return self.n + x }
}


class ClosureCycleTests(TestCase) {
    def test_live_instance_cycles_survive_collection() {
        live: list[Node] = []
        i: int = 0
        while i < 300 {
            live.append(Node(i))
            i = i + 1
        }
        dragon_gc_collect()
        dragon_gc_collect()
        # Each cb() mutates+reads self.n -> seed+1. Wrong-collection => UAF/garbage.
        total: int = 0
        j: int = 0
        while j < 300 {
            nd: Node = live[j]
            total = total + nd.cb()
            j = j + 1
        }
        self.assertEqual(total, 45150)
    }

    def test_shared_closure_two_holders_survives() {
        shared_cb: Callable[[], int] = lambda () -> int { return 99 }
        a: Node = Node(1)
        b: Node = Node(2)
        a.cb = shared_cb
        b.cb = shared_cb
        dragon_gc_collect()
        self.assertEqual(a.cb() + b.cb(), 198)
    }

    def test_live_list_capture_cycle_survives() {
        keep: list[Callable[[], int]] = []
        xs: list[Callable[[], int]] = []
        c2: Callable[[], int] = lambda () -> int { return len(xs) + 5 }
        xs.append(c2)
        keep.append(c2)
        dragon_gc_collect()
        fn: Callable[[], int] = keep[0]
        self.assertEqual(fn(), 6)
    }

    def test_bound_method_cycle_survives() {
        live: list[Handler] = []
        i: int = 0
        while i < 150 {
            live.append(Handler(i))
            i = i + 1
        }
        dragon_gc_collect()
        total: int = 0
        j: int = 0
        while j < 150 {
            h: Handler = live[j]
            total = total + h.cb(1)
            j = j + 1
        }
        self.assertEqual(total, 11325)
    }

    def test_drop_half_keeps_live() {
        kept: list[Node] = []
        k: int = 0
        while k < 400 {
            nd: Node = Node(k)
            if k % 2 == 0 { kept.append(nd) }
            k = k + 1
        }
        dragon_gc_collect()
        dragon_gc_collect()
        s: int = 0
        m: int = 0
        while m < 200 {
            nd2: Node = kept[m]
            s = s + nd2.cb()
            m = m + 1
        }
        self.assertEqual(s, 40000)
    }
}


main([ClosureCycleTests()])

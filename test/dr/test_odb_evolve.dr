from unittest import TestCase, main
from odb import ODB, Documents, Document, connect
from odb.vfs import SimVFS
from odb.pager import create, Pager
from odb.errors import SchemaError, NotFound
from tempfile import mktemp


def _mem() -> ODB {
    v: SimVFS = SimVFS()
    p: Pager = create(v, 4096)
    return ODB(v, p)
}


def _v1() -> dict[str, Any] {
    return { "type": "object",
             "properties": { "created": {"type": "integer"},
                             "name": {"type": "string"} },
             "required": ["created"] }
}


def _bad_redefine(db: ODB, definition: dict[str, Any]) -> bool {
    try {
        db.redefine("people", definition)
    } except SchemaError {
        return True
    }
    return False
}


class RedefineTest(TestCase) {
    def test_adding_an_optional_field_keeps_old_documents_readable() -> None {
        db: ODB = _mem()
        p: Documents = db.schema("people", _v1())
        p.save({created: 1, name: "Ada"})

        db.redefine("people", { "type": "object",
                                "properties": { "billing": {"type": "string"},
                                                "created": {"type": "integer"},
                                                "name": {"type": "string"} },
                                "required": ["created"] })

        const d: Document = db.schema("people").read(1)
        const nm: str = d["name"]
        const cr: int = d["created"]
        self.assertEqual(nm, "Ada")
        self.assertEqual(cr, 1)
    }

    def test_an_early_sorting_required_field_does_not_corrupt_old_records() -> None {
        db: ODB = _mem()
        p: Documents = db.schema("people", _v1())
        p.save({created: 7, name: "Grace"})

        db.redefine("people", { "type": "object",
                                "properties": { "billing": {"type": "integer", "default": 0},
                                                "created": {"type": "integer"},
                                                "name": {"type": "string"} },
                                "required": ["billing", "created"] })

        const d: Document = db.schema("people").read(1)
        const cr: int = d["created"]
        const nm: str = d["name"]
        self.assertEqual(cr, 7)
        self.assertEqual(nm, "Grace")
    }

    def test_new_writes_use_the_new_layout() -> None {
        db: ODB = _mem()
        p: Documents = db.schema("people", _v1())
        p.save({created: 1, name: "Ada"})
        const p2: Documents = db.redefine("people", { "type": "object",
                                                     "properties": { "billing": {"type": "integer", "default": 5},
                                                                     "created": {"type": "integer"},
                                                                     "name": {"type": "string"} },
                                                     "required": ["billing", "created"] })
        p2.save({created: 2, name: "Bob"})
        const old: Document = db.schema("people").read(1)
        const fresh: Document = db.schema("people").read(2)
        const on: str = old["name"]
        const fn: str = fresh["name"]
        const fb: int = fresh["billing"]
        self.assertEqual(on, "Ada")
        self.assertEqual(fn, "Bob")
        self.assertEqual(fb, 5)
    }

    def test_rename_keeps_the_value() -> None {
        db: ODB = _mem()
        p: Documents = db.schema("people", _v1())
        p.save({created: 1, name: "Ada"})
        rn: dict[str, str] = {}
        rn["name"] = "full_name"
        db.redefine("people", { "type": "object",
                                "properties": { "created": {"type": "integer"},
                                                "full_name": {"type": "string"} },
                                "required": ["created"] }, rn)
        const d: Document = db.schema("people").read(1)
        const fn: str = d["full_name"]
        self.assertEqual(fn, "Ada")
    }

    def test_a_type_change_is_refused() -> None {
        db: ODB = _mem()
        db.schema("people", _v1())
        self.assertTrue(_bad_redefine(db, { "type": "object",
                                            "properties": { "created": {"type": "string"},
                                                            "name": {"type": "string"} },
                                            "required": ["created"] }))
    }

    def test_a_new_required_field_without_a_default_is_refused() -> None {
        db: ODB = _mem()
        db.schema("people", _v1())
        self.assertTrue(_bad_redefine(db, { "type": "object",
                                            "properties": { "created": {"type": "integer"},
                                                            "name": {"type": "string"},
                                                            "tier": {"type": "string"} },
                                            "required": ["created", "tier"] }))
    }

    def test_making_a_required_field_optional_is_refused() -> None {
        db: ODB = _mem()
        db.schema("people", _v1())
        self.assertTrue(_bad_redefine(db, { "type": "object",
                                            "properties": { "created": {"type": "integer"},
                                                            "name": {"type": "string"} },
                                            "required": [] }))
    }

    def test_dropping_an_indexed_field_is_refused() -> None {
        db: ODB = _mem()
        p: Documents = db.schema("people", _v1())
        idx: list[Any] = ["created"]
        m: dict[str, Any] = {}
        m["index"] = idx
        p.meta(m)
        self.assertTrue(_bad_redefine(db, { "type": "object",
                                            "properties": { "name": {"type": "string"} },
                                            "required": [] }))
    }

    def test_a_tightened_bound_that_existing_documents_violate_is_refused() -> None {
        db: ODB = _mem()
        p: Documents = db.schema("people", _v1())
        p.save({created: 3, name: "Ada"})
        raised: bool = False
        msg: str = ""
        try {
            db.redefine("people", { "type": "object",
                                    "properties": { "created": {"type": "integer", "minimum": 100},
                                                    "name": {"type": "string"} },
                                    "required": ["created"] })
        } except SchemaError as e {
            raised = True
            msg = str(e)
        }
        self.assertTrue(raised)
        self.assertTrue("stored documents" in msg)
    }

    def test_a_tightened_bound_every_document_satisfies_is_accepted() -> None {
        db: ODB = _mem()
        p: Documents = db.schema("people", _v1())
        p.save({created: 500, name: "Ada"})
        db.redefine("people", { "type": "object",
                                "properties": { "created": {"type": "integer", "minimum": 100},
                                                "name": {"type": "string"} },
                                "required": ["created"] })
        const d: Document = db.schema("people").read(1)
        const cr: int = d["created"]
        self.assertEqual(cr, 500)
    }

    def test_a_refused_redefine_leaves_the_old_schema_in_place() -> None {
        db: ODB = _mem()
        p: Documents = db.schema("people", _v1())
        p.save({created: 3, name: "Ada"})
        self.assertTrue(_bad_redefine(db, { "type": "object",
                                            "properties": { "created": {"type": "string"},
                                                            "name": {"type": "string"} },
                                            "required": ["created"] }))
        p.save({created: 4, name: "Bob"})
        self.assertEqual(db.schema("people").count(), 2)
    }

    def test_redefining_an_unknown_schema_raises() -> None {
        db: ODB = _mem()
        raised: bool = False
        try {
            db.redefine("ghost", _v1())
        } except NotFound {
            raised = True
        }
        self.assertTrue(raised)
    }

    def test_renaming_a_field_that_does_not_exist_is_refused() -> None {
        db: ODB = _mem()
        db.schema("people", _v1())
        rn: dict[str, str] = {}
        rn["ghost"] = "spook"
        raised: bool = False
        try {
            db.redefine("people", _v1(), rn)
        } except SchemaError {
            raised = True
        }
        self.assertTrue(raised)
    }
}


class VersionHistoryTest(TestCase) {
    def test_old_layouts_survive_a_reopen() -> None {
        const path: str = mktemp("odb_evo_", ".odb")
        db: ODB = connect(path)
        p: Documents = db.schema("people", _v1())
        p.save({created: 11, name: "Ada"})
        db.redefine("people", { "type": "object",
                                "properties": { "billing": {"type": "integer", "default": 0},
                                                "created": {"type": "integer"},
                                                "name": {"type": "string"} },
                                "required": ["billing", "created"] })
        db.close()

        again: ODB = connect(path)
        const d: Document = again.schema("people").read(1)
        const cr: int = d["created"]
        const nm: str = d["name"]
        self.assertEqual(cr, 11)
        self.assertEqual(nm, "Ada")
        again.close()
    }

    def test_two_bumps_keep_the_oldest_readable() -> None {
        const path: str = mktemp("odb_evo2_", ".odb")
        db: ODB = connect(path)
        p: Documents = db.schema("people", _v1())
        p.save({created: 1, name: "first"})

        const p2: Documents = db.redefine("people", { "type": "object",
                                                     "properties": { "aaa": {"type": "integer", "default": 0},
                                                                     "created": {"type": "integer"},
                                                                     "name": {"type": "string"} },
                                                     "required": ["aaa", "created"] })
        p2.save({created: 2, name: "second"})

        const p3: Documents = db.redefine("people", { "type": "object",
                                                     "properties": { "aaa": {"type": "integer", "default": 0},
                                                                     "abb": {"type": "integer", "default": 0},
                                                                     "created": {"type": "integer"},
                                                                     "name": {"type": "string"} },
                                                     "required": ["aaa", "abb", "created"] })
        p3.save({created: 3, name: "third"})
        db.close()

        again: ODB = connect(path)
        const one: Document = again.schema("people").read(1)
        const two: Document = again.schema("people").read(2)
        const three: Document = again.schema("people").read(3)
        const n1: str = one["name"]
        const n2: str = two["name"]
        const n3: str = three["name"]
        self.assertEqual(n1, "first")
        self.assertEqual(n2, "second")
        self.assertEqual(n3, "third")
        again.close()
    }

    def test_an_edit_upgrades_the_document_to_the_current_version() -> None {
        db: ODB = _mem()
        p: Documents = db.schema("people", _v1())
        p.save({created: 1, name: "Ada"})
        db.redefine("people", { "type": "object",
                                "properties": { "billing": {"type": "integer", "default": 9},
                                                "created": {"type": "integer"},
                                                "name": {"type": "string"} },
                                "required": ["billing", "created"] })
        const d: Document = db.schema("people").read(1)
        d.edit({name: "Ada L"})
        const after: Document = db.schema("people").read(1)
        const nm: str = after["name"]
        const bl: int = after["billing"]
        self.assertEqual(nm, "Ada L")
        self.assertEqual(bl, 9)
    }
}


main([RedefineTest(), VersionHistoryTest()])

from unittest import TestCase, main
from odb import ODB, Documents, Document
from odb.vfs import SimVFS
from odb.pager import create, Pager
from odb.errors import SchemaError, IntegrityError


def _nullable(ty: str) -> dict[str, Any] {
    lst: list[Any] = [ty, "null"]
    p: dict[str, Any] = {}
    p["type"] = lst
    return p
}

def _plain(ty: str) -> dict[str, Any] {
    p: dict[str, Any] = {}
    p["type"] = ty
    return p
}

def _teams(db: ODB) -> Documents {
    props: dict[str, Any] = {}
    props["id"] = _plain("integer")
    props["name"] = _plain("string")
    s: dict[str, Any] = {}
    s["type"] = "object"
    s["properties"] = props
    req: list[Any] = ["id", "name"]
    s["required"] = req
    meta: dict[str, Any] = {}
    pk: list[Any] = ["id"]
    meta["primary"] = pk
    return db.schema("teams", s).meta(meta)
}

def _people(db: ODB, on_delete: str, nullable: bool) -> Documents {
    props: dict[str, Any] = {}
    props["id"] = _plain("integer")
    if nullable {
        props["team_id"] = _nullable("integer")
    } else {
        props["team_id"] = _plain("integer")
    }
    s: dict[str, Any] = {}
    s["type"] = "object"
    s["properties"] = props
    req: list[Any] = ["id", "team_id"]
    s["required"] = req

    refspec: dict[str, Any] = {}
    refspec["to"] = "teams.id"
    refspec["on_delete"] = on_delete
    refs: dict[str, Any] = {}
    refs["team_id"] = refspec
    meta: dict[str, Any] = {}
    pk: list[Any] = ["id"]
    meta["primary"] = pk
    meta["refs"] = refs
    return db.schema("people", s).meta(meta)
}

def _fresh() -> ODB {
    v: SimVFS = SimVFS()
    p: Pager = create(v, 4096)
    return ODB(v, p)
}


class SetNullTest(TestCase) {
    def test_deleting_a_target_nulls_its_referrers() -> None {
        db: ODB = _fresh()
        teams: Documents = _teams(db)
        people: Documents = _people(db, "set_null", True)

        t: dict[str, Any] = {}
        t["id"] = 10
        t["name"] = "core"
        teams.save(t)
        a: dict[str, Any] = {}
        a["id"] = 1
        a["team_id"] = 10
        people.save(a)
        b: dict[str, Any] = {}
        b["id"] = 2
        b["team_id"] = 10
        people.save(b)

        const target: Document = teams.read(id=10)
        target.wipe()

        self.assertEqual(people.count(), 2)
        const p1: Document = people.read(id=1)
        const p2: Document = people.read(id=2)
        self.assertTrue(p1["team_id"] is None)
        self.assertTrue(p2["team_id"] is None)
    }

    def test_set_null_requires_a_nullable_field() -> None {
        db: ODB = _fresh()
        _teams(db)
        raised: bool = False
        try {
            _people(db, "set_null", False)
        } except SchemaError {
            raised = True
        }
        self.assertTrue(raised)
    }

    def test_restrict_still_blocks() -> None {
        db: ODB = _fresh()
        teams: Documents = _teams(db)
        people: Documents = _people(db, "restrict", True)

        t: dict[str, Any] = {}
        t["id"] = 10
        t["name"] = "core"
        teams.save(t)
        a: dict[str, Any] = {}
        a["id"] = 1
        a["team_id"] = 10
        people.save(a)

        raised: bool = False
        try {
            const target: Document = teams.read(id=10)
            target.wipe()
        } except IntegrityError {
            raised = True
        }
        self.assertTrue(raised)
    }

    def test_detach_is_still_refused_with_a_clear_reason() -> None {
        db: ODB = _fresh()
        _teams(db)
        raised: bool = False
        try {
            _people(db, "detach", True)
        } except SchemaError {
            raised = True
        }
        self.assertTrue(raised)
    }
}


class NullIndexTest(TestCase) {
    def test_a_null_value_can_be_indexed() -> None {
        db: ODB = _fresh()
        props: dict[str, Any] = {}
        props["id"] = _plain("integer")
        props["note"] = _nullable("string")
        s: dict[str, Any] = {}
        s["type"] = "object"
        s["properties"] = props
        req: list[Any] = ["id", "note"]
        s["required"] = req
        meta: dict[str, Any] = {}
        pk: list[Any] = ["id"]
        idx: list[Any] = ["note"]
        meta["primary"] = pk
        meta["index"] = idx
        coll: Documents = db.schema("t", s).meta(meta)

        a: dict[str, Any] = {}
        a["id"] = 1
        a["note"] = None
        coll.save(a)
        b: dict[str, Any] = {}
        b["id"] = 2
        b["note"] = "b"
        coll.save(b)
        self.assertEqual(coll.count(), 2)

        const got: Document = coll.read(id=1)
        self.assertTrue(got["note"] is None)
    }

    def test_nulls_sort_before_values() -> None {
        db: ODB = _fresh()
        props: dict[str, Any] = {}
        props["id"] = _plain("integer")
        props["note"] = _nullable("string")
        s: dict[str, Any] = {}
        s["type"] = "object"
        s["properties"] = props
        req: list[Any] = ["id", "note"]
        s["required"] = req
        meta: dict[str, Any] = {}
        pk: list[Any] = ["id"]
        meta["primary"] = pk
        coll: Documents = db.schema("t", s).meta(meta)

        b: dict[str, Any] = {}
        b["id"] = 2
        b["note"] = "b"
        coll.save(b)
        a: dict[str, Any] = {}
        a["id"] = 1
        a["note"] = None
        coll.save(a)

        const rows: list[Document] = db.find("t ? id > 0 { id, note } | sort note")
        self.assertEqual(len(rows), 2)
        const first: Document = rows[0]
        const fid: int = first["id"]
        self.assertEqual(fid, 1)
    }
}


main([SetNullTest(), NullIndexTest()])

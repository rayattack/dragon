from unittest import TestCase, main
from odb.vfs import SimVFS, VFS
from odb.pager import create, open_pager, Pager, Snapshot, PT_DATA, PT_FREELIST
from odb.codec import blank, put_u64, get_u64
from odb.errors import CorruptionError
from odb.sim import run_crash_trials, run_state_crash_trials, SimResult


def _payload(counter: int, csn: int) -> bytes {
    buf: list[int] = blank(64)
    put_u64(buf, 0, counter)
    put_u64(buf, 8, csn)
    return bytes(buf)
}

def _commit_counter(p: Pager, counter: int) -> int {
    newpg: int = p.alloc()
    p.stage(newpg, PT_DATA, _payload(counter, p.last_csn + 1))
    old: int = p.catalog_root
    p.set_catalog_root(newpg)
    if old != 0 {
        p.free(old)
    }
    p.commit()
    return newpg
}


class PagerBasicsTest(TestCase) {
    def test_create_commit_reopen() -> None {
        v: SimVFS = SimVFS()
        p: Pager = create(v, 4096)
        self.assertEqual(p.last_csn, 1)
        self.assertEqual(p.high_water, 3)

        n: int = 0
        while n < 20 {
            _commit_counter(p, n + 1)
            n = n + 1
        }
        self.assertEqual(p.last_csn, 21)

        rp: Pager = open_pager(v)
        self.assertEqual(rp.last_csn, 21)
        page: bytes = rp.read_page(rp.catalog_root)
        self.assertEqual(get_u64(page, 0), 20)
        self.assertEqual(get_u64(page, 8), 21)
    }

    def test_empty_reopen() -> None {
        v: SimVFS = SimVFS()
        p: Pager = create(v, 4096)
        rp: Pager = open_pager(v)
        self.assertEqual(rp.last_csn, 1)
        self.assertEqual(rp.catalog_root, 0)
        self.assertEqual(rp.high_water, 3)
    }
}


class ChecksumTest(TestCase) {
    def test_corrupt_page_detected() -> None {
        v: SimVFS = SimVFS()
        p: Pager = create(v, 4096)
        root: int = _commit_counter(p, 7)

        off: int = root * 4096 + 3
        v.live[off] = v.live[off] ^ 0xFF
        v.durable = v.live[:]

        rp: Pager = open_pager(v)
        raised: bool = False
        try {
            rp.read_page(root)
        } except CorruptionError {
            raised = True
        }
        self.assertTrue(raised)
    }

    def test_torn_meta_falls_back() -> None {
        v: SimVFS = SimVFS()
        p: Pager = create(v, 4096)
        _commit_counter(p, 1)
        _commit_counter(p, 2)

        v.live[2 * 4096 + 10] = v.live[2 * 4096 + 10] ^ 0xFF
        v.durable = v.live[:]

        rp: Pager = open_pager(v)
        self.assertEqual(rp.last_csn, 2)
        page: bytes = rp.read_page(rp.catalog_root)
        self.assertEqual(get_u64(page, 0), 1)
    }
}


class ReuseSafetyTest(TestCase) {
    def test_reader_pins_pages() -> None {
        v: SimVFS = SimVFS()
        p: Pager = create(v, 4096)
        _commit_counter(p, 1)
        root_at_snapshot: int = p.catalog_root

        snap: Snapshot = p.begin_read()

        n: int = 0
        while n < 5 {
            newpg: int = p.alloc()
            self.assertNotEqual(newpg, root_at_snapshot)
            p.stage(newpg, PT_DATA, _payload(100 + n, p.last_csn + 1))
            old: int = p.catalog_root
            p.set_catalog_root(newpg)
            p.free(old)
            p.commit()
            n = n + 1
        }

        page: bytes = snap.page(root_at_snapshot)
        self.assertEqual(get_u64(page, 0), 1)
        snap.close()
    }
}


class CountingVFS(VFS) {
    length: int
    fl_pages: int

    def() {
        self.length = 0
        self.fl_pages = 0
    }

    def write_at(off: int, data: bytes) -> None {
        if len(data) == 4096 {
            if data[4088] == PT_FREELIST {
                self.fl_pages = self.fl_pages + 1
            }
        }
        end: int = off + len(data)
        if end > self.length {
            self.length = end
        }
    }

    def sync() -> None {
        pass
    }

    def truncate(n: int) -> None {
        if n > self.length {
            self.length = n
        }
    }

    def size() -> int {
        return self.length
    }

    def close() -> None {
        pass
    }
}


class FreelistScalingTest(TestCase) {
    """The free list must never self-feed: per-commit freelist I/O tracks the
    commit's own churn, not accumulated history. A retention window wider than
    one freelist page's entry capacity (~255 txns at 4 KiB pages) plus steady
    churn is exactly the regime that made a full-rewrite freelist quadratic
    (odb-pager-scaling.md finding 1)."""

    def test_freelist_io_stays_flat_under_wide_window() -> None {
        v: CountingVFS = CountingVFS()
        p: Pager = create(v, 4096)
        window: int = 400
        churn: int = 8
        roots: list[int] = []
        j: int = 0
        while j < churn {
            roots.append(0)
            j = j + 1
        }

        early: int = 0
        late: int = 0
        mark: int = 0
        n: int = 1
        while n <= 800 {
            k: int = 0
            while k < churn {
                pg: int = p.alloc()
                p.stage(pg, PT_DATA, _payload(n, p.last_csn + 1))
                if roots[k] != 0 {
                    p.free(roots[k])
                }
                roots[k] = pg
                k = k + 1
            }
            p.commit()
            floor: int = p.last_csn - window
            if floor < 1 {
                floor = 1
            }
            p.retain_floor = floor

            if n == 200 or n == 700 {
                mark = v.fl_pages
            }
            if n == 300 {
                early = v.fl_pages - mark
            }
            if n == 800 {
                late = v.fl_pages - mark
            }
            n = n + 1
        }

        self.assertTrue(late < early * 4)
        self.assertTrue(late <= 400)
    }
}


class CrashRecoveryTest(TestCase) {
    def test_crash_at_every_boundary() -> None {
        res: SimResult = run_crash_trials(600)
        self.assertEqual(res.trials, 600)
        self.assertEqual(res.failures, 0)
        self.assertTrue(res.recovered_old > 0)
        self.assertTrue(res.recovered_new > 0)
    }

    def test_state_flip_crash_at_every_boundary() -> None {
        res: SimResult = run_state_crash_trials(400)
        self.assertEqual(res.trials, 400)
        self.assertEqual(res.failures, 0, res.message)
        self.assertTrue(res.recovered_old > 0)
        self.assertTrue(res.recovered_new > 0)
    }
}


main([PagerBasicsTest(), ChecksumTest(), ReuseSafetyTest(), FreelistScalingTest(), CrashRecoveryTest()])

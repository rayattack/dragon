# Owned heap temps passed to BORROW callees must be released after the call; transfer callees
# (list.append, dict set) adopt the +1 and are NOT drained (a wrong-kind decref was a proven UAF).

from unittest import TestCase, main


def list_len_default(items: list[int] = [10, 20, 30]) -> int {
    return len(items)
}


class BorrowArgRcTests(TestCase) {
    def test_str_method_owned_temp_args() {
        hits: int = 0
        i: int = 0
        while i < 500 {
            s: str = "alpha beta alpha"
            n: int = s.find("al" + str(i % 1))
            r: str = s.replace("a" + str(i % 1), "A")
            parts: list[str] = s.split(" " + str(i % 1))
            if n < 0 {
                hits = hits + 1
            }
            i = i + 1
        }
        self.assertEqual(hits, 500)
    }

    def test_collection_borrow_method_owned_temp_args() {
        total: int = 0
        i: int = 0
        while i < 500 {
            xs: list[str] = ["x", "y", "z"]
            c: int = xs.count("q" + str(i % 1))
            d: dict[str, int] = {"k": 1}
            v: int = d.get("z" + str(i % 1), 7)
            st: set[str] = {"m", "n"}
            u: set[str] = st.union({"p" + str(i % 1)})
            total = total + c + v + len(u)
            i = i + 1
        }
        self.assertEqual(total, 5000)
    }

    def test_builtin_borrow_owned_temp_args() {
        total: int = 0
        i: int = 0
        while i < 500 {
            n: int = len("ab" + str(i % 1))
            v: int = int("4" + str(i % 1))
            sm: int = sum([1, 2, i])
            total = total + n + v + sm
            i = i + 1
        }
        self.assertEqual(total, 147750)
    }

    def test_default_arg_owned_temp() {
        total: int = 0
        i: int = 0
        while i < 500 {
            total = total + list_len_default()
            i = i + 1
        }
        self.assertEqual(total, 1500)
    }
}


main([BorrowArgRcTests()])

# Pre-fix: the OOM raise dup'd its message through dragon_xmalloc and recursed to stack death
# (A/B-proven 3700-frame SIGSEGV). Not test_*.dr on purpose: registered capped (RLIMIT_AS) in test/CMakeLists.txt.

from unittest import TestCase, main

def unit_len() -> int {
    return 8
}

def hoard_until_dead(cap_slots: int) -> int {
    xs: list[str] = [""] * cap_slots
    deaths: int = 0
    i: int = 0
    while i < cap_slots {
        try {
            xs[i] = "x" * unit_len()
        } except MemoryError {
            deaths = deaths + 1
        }
        if deaths >= 200 {
            break
        }
        i = i + 1
    }
    return deaths
}

class Cell {
    label: str
    def (label: str) {
        self.label = label
    }
}

def hoard_cells_until_dead(cap_slots: int) -> int {
    label: str = "x" * unit_len()
    cells: list[Cell] = [Cell(label)] * cap_slots
    deaths: int = 0
    i: int = 0
    while i < cap_slots {
        try {
            cells[i] = Cell(label)
        } except MemoryError {
            deaths = deaths + 1
        }
        if deaths >= 200 {
            break
        }
        i = i + 1
    }
    return deaths
}

class Packet {
    payload: bytes
    def (payload: bytes) {
        self.payload = payload
    }
}

def hoard_packets_until_dead(cap_slots: int) -> int {
    payload: bytes = b"x" * unit_len()
    packets: list[Packet] = [Packet(payload)] * cap_slots
    deaths: int = 0
    i: int = 0
    while i < cap_slots {
        try {
            packets[i] = Packet(payload)
        } except MemoryError {
            deaths = deaths + 1
        }
        if deaths >= 200 {
            break
        }
        i = i + 1
    }
    return deaths
}

class SustainedOomTests(TestCase) {
    def test_memoryerror_stays_catchable_under_sustained_oom() {
        deaths: int = hoard_until_dead(6000000)
        self.assertEqual(deaths, 200)
        ys: list[str] = ["ok"] * 4
        self.assertEqual(len(ys), 4)
        self.assertEqual(ys[3], "ok")
    }

    def test_constructor_oom_stays_catchable() {
        deaths: int = hoard_cells_until_dead(8000000)
        self.assertEqual(deaths, 200)
        survivor: Cell = Cell("ok")
        self.assertEqual(survivor.label, "ok")
    }

    def test_tracked_constructor_oom_stays_catchable() {
        deaths: int = hoard_packets_until_dead(8000000)
        self.assertEqual(deaths, 200)
        survivor: Packet = Packet(b"ok")
        self.assertEqual(survivor.payload, b"ok")
    }
}

main([SustainedOomTests()])

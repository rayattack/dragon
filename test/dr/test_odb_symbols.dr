from unittest import TestCase, main
from odb import ODB, Documents, Document, connect
from odb.schema import compile_schema, compile_schema_with_symbols, CompiledSchema
from odb.dbon import encode, decode
from odb.vfs import SimVFS
from odb.pager import create, open_pager, Pager
from tempfile import mktemp


def _mem() -> ODB {
    v: SimVFS = SimVFS()
    p: Pager = create(v, 4096)
    return ODB(v, p)
}


def _schema(names: list[str], required: list[Any]) -> dict[str, Any] {
    props: dict[str, Any] = {}
    for n in names {
        t: dict[str, Any] = {}
        t["type"] = "string"
        props[n] = t
    }
    s: dict[str, Any] = {}
    s["type"] = "object"
    s["properties"] = props
    s["required"] = required
    return s
}


class SymbolAssignmentTest(TestCase) {
    def test_fresh_compile_numbers_alphabetically() -> None {
        const names: list[str] = ["created", "name"]
        const req: list[Any] = ["created"]
        const cs: CompiledSchema = compile_schema("t", _schema(names, req), 1, 1, "{}")
        self.assertEqual(cs.symbols["created"], 0)
        self.assertEqual(cs.symbols["name"], 1)
    }

    def test_an_early_sorting_property_does_not_remap_existing_ids() -> None {
        const names: list[str] = ["created", "name"]
        const req: list[Any] = ["created"]
        const v1: CompiledSchema = compile_schema("t", _schema(names, req), 1, 1, "{}")

        const grown: list[str] = ["billing", "created", "name"]
        const v2: CompiledSchema = compile_schema_with_symbols("t", _schema(grown, req), 1, 2, "{}", v1.symbols)

        self.assertEqual(v2.symbols["created"], 0)
        self.assertEqual(v2.symbols["name"], 1)
        self.assertEqual(v2.symbols["billing"], 2)
        self.assertEqual(v2.by_name["created"].field_id, 0)
        self.assertEqual(v2.by_name["name"].field_id, 1)
    }

    def test_without_the_table_the_ids_would_shift() -> None {
        const grown: list[str] = ["billing", "created", "name"]
        const req: list[Any] = ["created"]
        const fresh: CompiledSchema = compile_schema("t", _schema(grown, req), 1, 2, "{}")
        self.assertEqual(fresh.symbols["billing"], 0)
        self.assertEqual(fresh.symbols["created"], 1)
        self.assertEqual(fresh.symbols["name"], 2)
    }

    def test_an_optional_tail_written_under_v1_reads_back_under_v2() -> None {
        const names: list[str] = ["created", "name"]
        const req: list[Any] = ["created"]
        const v1: CompiledSchema = compile_schema("t", _schema(names, req), 1, 1, "{}")

        doc: dict[str, Any] = {}
        doc["created"] = "yesterday"
        doc["name"] = "Ada"
        const blob: bytes = encode(v1, doc)

        const grown: list[str] = ["billing", "created", "name"]
        const v2: CompiledSchema = compile_schema_with_symbols("t", _schema(grown, req), 1, 2, "{}", v1.symbols)
        const back: dict[str, Any] = decode(v2, blob)
        const nm: str = back["name"]
        const cr: str = back["created"]
        self.assertEqual(nm, "Ada")
        self.assertEqual(cr, "yesterday")
    }

    def test_a_shifted_table_misreads_the_tail() -> None {
        const names: list[str] = ["created", "name"]
        const req: list[Any] = ["created"]
        const v1: CompiledSchema = compile_schema("t", _schema(names, req), 1, 1, "{}")
        doc: dict[str, Any] = {}
        doc["created"] = "yesterday"
        doc["name"] = "Ada"
        const blob: bytes = encode(v1, doc)

        const grown: list[str] = ["billing", "created", "name"]
        const shifted: CompiledSchema = compile_schema("t", _schema(grown, req), 1, 2, "{}")
        const back: dict[str, Any] = decode(shifted, blob)
        self.assertFalse("name" in back)
        const clobbered: str = back["created"]
        self.assertEqual(clobbered, "Ada")
    }

    def test_renaming_by_keeping_the_id_preserves_the_value() -> None {
        const names: list[str] = ["created", "name"]
        const req: list[Any] = ["created"]
        const v1: CompiledSchema = compile_schema("t", _schema(names, req), 1, 1, "{}")
        doc: dict[str, Any] = {}
        doc["created"] = "yesterday"
        doc["name"] = "Ada"
        const blob: bytes = encode(v1, doc)

        renamed: dict[str, int] = {}
        renamed["created"] = v1.symbols["created"]
        renamed["full_name"] = v1.symbols["name"]
        const renames: list[str] = ["created", "full_name"]
        const v2: CompiledSchema = compile_schema_with_symbols("t", _schema(renames, req), 1, 2, "{}", renamed)
        const back: dict[str, Any] = decode(v2, blob)
        const fn: str = back["full_name"]
        self.assertEqual(fn, "Ada")
    }
}


class SymbolPersistenceTest(TestCase) {
    def test_documents_still_read_after_a_reopen() -> None {
        const path: str = mktemp("odb_sym_", ".odb")
        db: ODB = connect(path)
        o: Documents = db.schema("orders", { "type": "object",
                                            "properties": { "id": {"type": "integer"},
                                                            "status": {"type": "string"},
                                                            "note": {"type": "string"} },
                                            "required": ["id", "status"] })
        o.save({id: 1, status: "paid", note: "first"})
        db.close()

        again: ODB = connect(path)
        const d: Document = again.schema("orders").read(1)
        const st: str = d["status"]
        const nt: str = d["note"]
        self.assertEqual(st, "paid")
        self.assertEqual(nt, "first")
        again.close()
    }
}


main([SymbolAssignmentTest(), SymbolPersistenceTest()])

from unittest import TestCase, main
from odb import ODB, Documents, Document
from odb.vfs import SimVFS
from odb.pager import create, Pager
from odb.errors import SchemaError, IntegrityError


def _mem() -> ODB {
    v: SimVFS = SimVFS()
    p: Pager = create(v, 4096)
    return ODB(v, p)
}


def _order_schema() -> dict[str, Any] {
    return { "type": "object",
             "properties": { "id": {"type": "integer"},
                             "number": {"type": "string"},
                             "referrer_code": {"type": "string"},
                             "billing": {"type": "object",
                                         "properties": {"city": {"type": "string"},
                                                        "postcode": {"type": "string"}},
                                         "required": ["city", "postcode"]},
                             "items": {"type": "array",
                                       "items": {"type": "object",
                                                 "properties": {"sku": {"type": "string"},
                                                                "qty": {"type": "integer"}},
                                                 "required": ["sku", "qty"]}},
                             "tags": {"type": "array", "items": {"type": "string"}} },
             "required": ["id", "number", "billing", "items", "tags"] }
}


def _orders(db: ODB, meta: dict[str, Any]) -> Documents {
    return db.schema("orders", _order_schema()).meta(meta)
}


def _item(sku: str, qty: int) -> dict[str, Any] {
    d: dict[str, Any] = {}
    d["sku"] = sku
    d["qty"] = qty
    return d
}


def _billing(city: str, postcode: str) -> dict[str, Any] {
    d: dict[str, Any] = {}
    d["city"] = city
    d["postcode"] = postcode
    return d
}


def _bad_meta(db: ODB, meta: dict[str, Any]) -> bool {
    try {
        _orders(db, meta)
    } except SchemaError {
        return True
    }
    return False
}


class NestedPathIndexTest(TestCase) {
    def test_nested_path_is_indexed() -> None {
        db: ODB = _mem()
        meta: dict[str, Any] = {}
        meta["primary"] = "id"
        const uniq: list[Any] = ["billing.postcode"]
        meta["unique"] = uniq
        o: Documents = _orders(db, meta)

        const items: list[Any] = [_item("A1", 1)]
        const tags: list[Any] = ["x"]
        o.save({id: 1, number: "N1", billing: _billing("Lagos", "10001"), items: items, tags: tags})

        raised: bool = False
        try {
            o.save({id: 2, number: "N2", billing: _billing("Abuja", "10001"), items: items, tags: tags})
        } except IntegrityError {
            raised = True
        }
        self.assertTrue(raised)

        o.save({id: 3, number: "N3", billing: _billing("Abuja", "10002"), items: items, tags: tags})
        self.assertEqual(o.count(), 2)
    }

    def test_composite_nested_path() -> None {
        db: ODB = _mem()
        meta: dict[str, Any] = {}
        meta["primary"] = "id"
        const pair: list[Any] = ["billing.city", "billing.postcode"]
        const uniq: list[Any] = [pair]
        meta["unique"] = uniq
        o: Documents = _orders(db, meta)
        const items: list[Any] = [_item("A1", 1)]
        const tags: list[Any] = ["x"]
        o.save({id: 1, number: "N1", billing: _billing("Lagos", "10001"), items: items, tags: tags})
        o.save({id: 2, number: "N2", billing: _billing("Abuja", "10001"), items: items, tags: tags})
        raised: bool = False
        try {
            o.save({id: 3, number: "N3", billing: _billing("Lagos", "10001"), items: items, tags: tags})
        } except IntegrityError {
            raised = True
        }
        self.assertTrue(raised)
    }

    def test_path_ending_on_an_object_is_refused() -> None {
        db: ODB = _mem()
        meta: dict[str, Any] = {}
        meta["primary"] = "id"
        const idx: list[Any] = ["billing"]
        meta["index"] = idx
        self.assertTrue(_bad_meta(db, meta))
    }

    def test_unknown_nested_segment_is_refused() -> None {
        db: ODB = _mem()
        meta: dict[str, Any] = {}
        meta["primary"] = "id"
        const idx: list[Any] = ["billing.ghost"]
        meta["index"] = idx
        self.assertTrue(_bad_meta(db, meta))
    }

    def test_walking_into_a_scalar_is_refused() -> None {
        db: ODB = _mem()
        meta: dict[str, Any] = {}
        meta["primary"] = "id"
        const idx: list[Any] = ["number.inner"]
        meta["index"] = idx
        self.assertTrue(_bad_meta(db, meta))
    }
}


class ArrayPathIndexTest(TestCase) {
    def test_element_subfield_is_indexed() -> None {
        db: ODB = _mem()
        meta: dict[str, Any] = {}
        meta["primary"] = "id"
        const uniq: list[Any] = ["items[].sku"]
        meta["unique"] = uniq
        o: Documents = _orders(db, meta)

        const tags: list[Any] = ["x"]
        const first: list[Any] = [_item("A1", 1), _item("A2", 2)]
        o.save({id: 1, number: "N1", billing: _billing("Lagos", "10001"), items: first, tags: tags})

        const clash: list[Any] = [_item("A2", 9)]
        raised: bool = False
        try {
            o.save({id: 2, number: "N2", billing: _billing("Lagos", "10002"), items: clash, tags: tags})
        } except IntegrityError {
            raised = True
        }
        self.assertTrue(raised)

        const fresh: list[Any] = [_item("B1", 1)]
        o.save({id: 3, number: "N3", billing: _billing("Lagos", "10003"), items: fresh, tags: tags})
        self.assertEqual(o.count(), 2)
    }

    def test_duplicate_element_subfields_within_one_document() -> None {
        db: ODB = _mem()
        meta: dict[str, Any] = {}
        meta["primary"] = "id"
        const uniq: list[Any] = ["items[].sku"]
        meta["unique"] = uniq
        o: Documents = _orders(db, meta)
        const tags: list[Any] = ["x"]
        const dupes: list[Any] = [_item("A1", 1), _item("A1", 2)]
        o.save({id: 1, number: "N1", billing: _billing("Lagos", "10001"), items: dupes, tags: tags})
        self.assertEqual(o.count(), 1)
    }

    def test_empty_array_indexes_nothing_and_still_stores() -> None {
        db: ODB = _mem()
        meta: dict[str, Any] = {}
        meta["primary"] = "id"
        const idx: list[Any] = ["items[].sku"]
        meta["index"] = idx
        o: Documents = _orders(db, meta)
        const tags: list[Any] = ["x"]
        const empty: list[Any] = []
        o.save({id: 1, number: "N1", billing: _billing("Lagos", "10001"), items: empty, tags: tags})
        self.assertEqual(o.count(), 1)
    }

    def test_bare_scalar_array_still_works() -> None {
        db: ODB = _mem()
        meta: dict[str, Any] = {}
        meta["primary"] = "id"
        const idx: list[Any] = ["tags"]
        meta["index"] = idx
        o: Documents = _orders(db, meta)
        const items: list[Any] = [_item("A1", 1)]
        const tags: list[Any] = ["red", "green"]
        o.save({id: 1, number: "N1", billing: _billing("Lagos", "10001"), items: items, tags: tags})
        self.assertEqual(o.count(), 1)
    }

    def test_explicit_brackets_on_a_scalar_array() -> None {
        db: ODB = _mem()
        meta: dict[str, Any] = {}
        meta["primary"] = "id"
        const idx: list[Any] = ["tags[]"]
        meta["index"] = idx
        o: Documents = _orders(db, meta)
        const items: list[Any] = [_item("A1", 1)]
        const tags: list[Any] = ["red", "green"]
        o.save({id: 1, number: "N1", billing: _billing("Lagos", "10001"), items: items, tags: tags})
        self.assertEqual(o.count(), 1)
    }

    def test_implicit_multikey_through_an_array_is_refused() -> None {
        db: ODB = _mem()
        meta: dict[str, Any] = {}
        meta["primary"] = "id"
        const idx: list[Any] = ["items.sku"]
        meta["index"] = idx
        self.assertTrue(_bad_meta(db, meta))
    }

    def test_indexing_an_array_of_objects_wholesale_is_refused() -> None {
        db: ODB = _mem()
        meta: dict[str, Any] = {}
        meta["primary"] = "id"
        const idx: list[Any] = ["items[]"]
        meta["index"] = idx
        self.assertTrue(_bad_meta(db, meta))
    }

    def test_two_array_paths_in_one_entry_are_refused() -> None {
        db: ODB = _mem()
        meta: dict[str, Any] = {}
        meta["primary"] = "id"
        const pair: list[Any] = ["items[].sku", "tags[]"]
        const idx: list[Any] = [pair]
        meta["index"] = idx
        self.assertTrue(_bad_meta(db, meta))
    }

    def test_double_brackets_are_refused() -> None {
        db: ODB = _mem()
        meta: dict[str, Any] = {}
        meta["primary"] = "id"
        const idx: list[Any] = ["items[].tags[]"]
        meta["index"] = idx
        self.assertTrue(_bad_meta(db, meta))
    }
}


class SparseIndexTest(TestCase) {
    def _sparse_meta(sparse: bool) -> dict[str, Any] {
        entry: dict[str, Any] = {}
        entry["path"] = "referrer_code"
        entry["sparse"] = sparse
        const uniq: list[Any] = [entry]
        meta: dict[str, Any] = {}
        meta["primary"] = "id"
        meta["unique"] = uniq
        return meta
    }

    def test_optional_path_needs_sparse() -> None {
        db: ODB = _mem()
        self.assertTrue(_bad_meta(db, self._sparse_meta(False)))
    }

    def test_sparse_lets_documents_omit_the_path() -> None {
        db: ODB = _mem()
        o: Documents = _orders(db, self._sparse_meta(True))
        const items: list[Any] = [_item("A1", 1)]
        const tags: list[Any] = ["x"]
        o.save({id: 1, number: "N1", billing: _billing("Lagos", "10001"), items: items, tags: tags})
        o.save({id: 2, number: "N2", billing: _billing("Lagos", "10002"), items: items, tags: tags})
        self.assertEqual(o.count(), 2)
    }

    def test_sparse_unique_still_rejects_duplicate_present_values() -> None {
        db: ODB = _mem()
        o: Documents = _orders(db, self._sparse_meta(True))
        const items: list[Any] = [_item("A1", 1)]
        const tags: list[Any] = ["x"]
        o.save({id: 1, number: "N1", referrer_code: "ABC",
                billing: _billing("Lagos", "10001"), items: items, tags: tags})
        raised: bool = False
        try {
            o.save({id: 2, number: "N2", referrer_code: "ABC",
                    billing: _billing("Lagos", "10002"), items: items, tags: tags})
        } except IntegrityError {
            raised = True
        }
        self.assertTrue(raised)

        o.save({id: 3, number: "N3", referrer_code: "XYZ",
                billing: _billing("Lagos", "10003"), items: items, tags: tags})
        self.assertEqual(o.count(), 2)
    }

    def test_sparse_entry_survives_an_edit_that_adds_the_field() -> None {
        db: ODB = _mem()
        o: Documents = _orders(db, self._sparse_meta(True))
        const items: list[Any] = [_item("A1", 1)]
        const tags: list[Any] = ["x"]
        const d: Document = o.save({id: 1, number: "N1",
                                    billing: _billing("Lagos", "10001"), items: items, tags: tags})
        d.edit({referrer_code: "LATER"})
        o.save({id: 2, number: "N2", billing: _billing("Lagos", "10002"), items: items, tags: tags})
        raised: bool = False
        try {
            o.save({id: 3, number: "N3", referrer_code: "LATER",
                    billing: _billing("Lagos", "10003"), items: items, tags: tags})
        } except IntegrityError {
            raised = True
        }
        self.assertTrue(raised)
    }

    def test_sparse_object_form_accepts_a_composite_path() -> None {
        entry: dict[str, Any] = {}
        const pair: list[Any] = ["referrer_code", "number"]
        entry["path"] = pair
        entry["sparse"] = True
        const idx: list[Any] = [entry]
        meta: dict[str, Any] = {}
        meta["primary"] = "id"
        meta["index"] = idx
        db: ODB = _mem()
        o: Documents = _orders(db, meta)
        const items: list[Any] = [_item("A1", 1)]
        const tags: list[Any] = ["x"]
        o.save({id: 1, number: "N1", billing: _billing("Lagos", "10001"), items: items, tags: tags})
        self.assertEqual(o.count(), 1)
    }

    def test_object_entry_without_path_is_refused() -> None {
        entry: dict[str, Any] = {}
        entry["sparse"] = True
        const idx: list[Any] = [entry]
        meta: dict[str, Any] = {}
        meta["primary"] = "id"
        meta["index"] = idx
        db: ODB = _mem()
        self.assertTrue(_bad_meta(db, meta))
    }
}


main([NestedPathIndexTest(), ArrayPathIndexTest(), SparseIndexTest()])

from json import Data
from unittest import TestCase, main
from html import HTML, strip_tags

const JS: str = template("tmpl_bang_data.js")

const LAMBDA_ITEMS: list[str] = ["a", "b"]

const LAMBDA_INLINE: HTML = template[HTML] {<ul>!{ for it in LAMBDA_ITEMS { :{ <li>!{(lambda: it.upper())()}</li> } } }</ul>}

const LAMBDA_LIST: HTML = template[HTML] {<ul>!{ for it in LAMBDA_ITEMS { :{ <li>!{(lambda: it + "!")()}</li> } } }</ul>}

const LAMBDA_FROM_FILE: HTML = template[HTML]("tmpl_lambda_frag.html")


def tmpl_pair(p: tuple[str, str]) -> str {
    h: HTML = template[HTML] {!{p[0]}=!{p[1]}}
    return h.to_str()
}


def tmpl_mixed(t: tuple[int, str]) -> str {
    h: HTML = template[HTML] {!{t[0]}:!{t[1]}}
    return h.to_str()
}


def tmpl_block(pairs: list[tuple[str, str]]) -> str {
    h: HTML = template[HTML] {
        <ul>!{ for p in pairs { :{ <li>!{p[0]}=!{p[1]}</li> } } }</ul>
    }
    return h.to_str()
}


def render_nothing() -> HTML {
    return template[HTML] {}
}


def shout(s: str) -> str {
    return s.upper()
}


def quoted(s: str) -> str {
    return '"' + s + '"'
}


def emphasize(s: str) -> HTML {
    return template[HTML] {<em>!{s}</em>}
}


def tmpl_user_filter(title: str) -> str {
    h: HTML = template[HTML] {<b>!{title | shout}</b>}
    return h.to_str()
}


def tmpl_raw_filter(title: str) -> str {
    h: HTML = template[HTML] {<b>!{title | raw}</b>}
    return h.to_str()
}


def tmpl_html_filter(title: str) -> str {
    h: HTML = template[HTML] {<b>!{title | html}</b>}
    return h.to_str()
}


def tmpl_url_filter(q: str) -> str {
    h: HTML = template[HTML] {<a href="?q=!{q | url}">go</a>}
    return h.to_str()
}


def tmpl_html_returning_filter(title: str) -> str {
    h: HTML = template[HTML] {<b>!{title | emphasize}</b>}
    return h.to_str()
}


def tmpl_filter_in_loop(items: list[str]) -> str {
    h: HTML = template[HTML] {
        <ul>!{ for it in items { :{ <li>!{it | shout}</li> } } }</ul>
    }
    return h.to_str()
}


def tmpl_imported_filter(title: str) -> str {
    h: HTML = template[HTML] {<b>!{title | strip_tags}</b>}
    return h.to_str()
}


def tmpl_filter_on_int(n: int) -> str {
    h: HTML = template[HTML] {<b>!{n | quoted}</b>}
    return h.to_str()
}


def tmpl_untyped_filter(title: str) -> str {
    return template {<b>!{title | shout}</b>}
}


def tmpl_pair_from_file(p: tuple[str, str]) -> str {
    h: HTML = template[HTML]("tmpl_pair_frag.html")
    return h.to_str()
}


def tmpl_nested_from_file(who: str) -> str {
    h: HTML = template[HTML]("tmpl_outer_frag.html")
    return h.to_str()
}


class TemplateFileBangTests(TestCase) {
    """A file template containing `!!` must embed, not hang the compiler.

    You write ordinary, correct-looking Dragon:

        const X: str = template("f.js")

    and f.js is ordinary JavaScript using the standard boolean-coercion idiom:

        var a = !!b;

    You did nothing wrong: only `!!{` and `!!}` are template escapes, so a bare
    `!!` is plain literal text. But the template body scanner broke its literal
    run at ANY `!!` while the escape dispatcher consumed nothing, so `dragon
    build` spun forever on a byte position that never advanced. `dragon check`
    passed (file templates are read at codegen), which made it look like a
    backend hang, not a source issue. Data minified JS triggered it (htmx has 2
    occurrences of `!!`, Alpine 7).

    Now the literal-run break mirrors the dispatcher exactly: it stops only at
    `!{`, `!!{`, or `!!}`. The same program compiles and the file embeds
    byte-for-byte, escapes still applied. The data file also ends in `!!` at EOF
    with no trailing newline - the other former hang - and carries one
    `!!{ok!!}` escape to pin that file templates keep processing escapes.
    """

    def test_file_embeds_byte_for_byte_with_escapes_applied() {
        expected: str = "var a = !!b;\nvar re = !!t ? \"gim\" : \"im\";\nvar c = ! !d;\nesc !{ok}\n!!"
        self.assertEqual(JS, expected)
    }

    def test_double_bang_survives_verbatim() {
        self.assertTrue("var a = !!b;" in JS)
        self.assertTrue("!!t" in JS)
    }
}


class TemplateTupleInterpTests(TestCase) {
    """template interpolations must flow at their native type (root-cause fix).

    You write ordinary, correct-looking Dragon:

        const pairs: list[tuple[str, str]] = [("a", "x")]
        for p in pairs {
            const t: HTML = template[HTML] {!{p[0]}=!{p[1]}}
        }

    and the SAME `p[0]` that renders as `a` in an f-string used to render as a big
    decimal (`94577401478784`) inside a template. You did nothing wrong: the
    template body was re-parsed and lowered ONLY in codegen, so the TypeChecker
    never saw `p[0]`. With no static type on the subscript, codegen could not turn
    the i64 that `dragon_tuple_get` returns back into the native `str*` - it printed
    the raw pointer instead of the value.

    Now the Parser splits the template body into typed parts and the TypeChecker
    walks each interpolation, so `p[0]` carries its element type and materializes
    the value. This test asserts on VALUES (not stdout): a tuple element
    interpolated in a template equals its f-string rendering, never a pointer.
    """

    def test_str_tuple_matches_fstring() {
        p: tuple[str, str] = ("a", "x")
        self.assertEqual(tmpl_pair(p).strip(), "a=x")
        self.assertEqual(tmpl_pair(p).strip(), f"{p[0]}={p[1]}")
    }

    def test_mixed_tuple_elements() {
        t: tuple[int, str] = (42, "hi")
        self.assertEqual(tmpl_mixed(t).strip(), "42:hi")
    }

    def test_tuple_subscript_in_block_interp() {
        pairs: list[tuple[str, str]] = [("a", "x"), ("b", "y")]
        out: str = ""
        i: int = 0
        while i < 20 {
            out = tmpl_block(pairs)
            i = i + 1
        }
        self.assertTrue("<li>a=x</li>" in out)
        self.assertTrue("<li>b=y</li>" in out)
        self.assertTrue("=x</li>" in out)
        self.assertFalse("0x" in out)
    }

    def test_tuple_from_list_iteration() {
        pairs: list[tuple[str, str]] = [("k1", "v1"), ("k2", "v2")]
        joined: str = ""
        for p in pairs {
            joined = joined + tmpl_pair(p).strip() + ";"
        }
        self.assertEqual(joined, "k1=v1;k2=v2;")
    }
}


class EmptyTypedTemplateTests(TestCase) {
    """An empty typed template literal must be a real instance, not a segfault.

    You write ordinary, correct-looking Dragon - the idiomatic "render
    nothing" fragment a page helper returns when there is no error to show:

        def error_banner(msg: str) -> HTML {
            if msg == "" { return template[HTML] {} }
            return template[HTML] {<p class="err">!{msg}</p>}
        }

    You did nothing wrong: `template[HTML] { }` with one space works, and
    `template {}` untyped works, but the typed empty literal killed the whole
    process with SIGSEGV the moment anything touched the value - before any
    exception handler could run, so a server just vanished mid-request.

    An empty body lowers zero parts, and the zero-parts path returned a bare
    headerless byte pointer AND skipped the content-type constructor, so a
    value typed `HTML` was never an HTML instance. `to_str()` then read an
    object field out of string bytes. Now the empty result is a real Dragon
    string and flows through the same constructor wrap as every other body.

    Before: `error_banner("")` crashed the process. After: it returns an HTML
    instance whose `to_str()` is `""`, and it embeds into a page as nothing.
    """

    def test_empty_typed_literal_is_a_real_instance() {
        const e: HTML = template[HTML] {}
        self.assertEqual(e.to_str(), "")
        self.assertEqual(len(e.to_str()), 0)
    }

    def test_empty_fragment_returned_from_helper() {
        const banner: HTML = render_nothing()
        self.assertEqual(banner.to_str(), "")
    }

    def test_empty_fragment_embeds_into_page() {
        const page: HTML = template[HTML] {<div>!{render_nothing()}</div>}
        self.assertEqual(page.to_str(), "<div></div>")
    }

    def test_single_space_body_still_wraps() {
        const s: HTML = template[HTML] { }
        self.assertEqual(s.to_str(), " ")
    }

    def test_untyped_empty_is_empty_str() {
        const s: str = template {}
        self.assertEqual(s, "")
        self.assertEqual(len(s), 0)
    }
}


class TemplateFilterTrustTests(TestCase) {
    def test_user_filter_result_is_escaped() {
        const out: str = tmpl_user_filter("<script>x</script>")
        self.assertEqual(out, "<b>&lt;SCRIPT&gt;X&lt;/SCRIPT&gt;</b>")
    }

    def test_filter_output_is_escaped_even_when_input_is_clean() {
        self.assertEqual(tmpl_filter_on_int(5), "<b>&quot;5&quot;</b>")
    }

    def test_raw_still_opts_out() {
        self.assertEqual(tmpl_raw_filter("<i>ok</i>"), "<b><i>ok</i></b>")
    }

    def test_html_filter_is_not_double_escaped() {
        self.assertEqual(tmpl_html_filter("<a>"), "<b>&lt;a&gt;</b>")
    }

    def test_url_filter_percent_encodes() {
        self.assertEqual(tmpl_url_filter("a b&c"), "<a href=\"?q=a%20b%26c\">go</a>")
    }

    def test_filter_returning_content_type_is_markup() {
        self.assertEqual(tmpl_html_returning_filter("a&b"),
                         "<b><em>a&amp;b</em></b>")
    }

    def test_filter_inside_loop_block_is_escaped() {
        const out: str = tmpl_filter_in_loop(["<a>", "<b>"])
        self.assertTrue("&lt;A&gt;" in out)
        self.assertFalse("<A>" in out)
    }

    def test_imported_function_is_a_usable_filter() {
        self.assertEqual(tmpl_imported_filter("<i>hi</i>"), "<b>hi</b>")
    }

    def test_untyped_template_still_does_not_escape() {
        self.assertEqual(tmpl_untyped_filter("<a>"), "<b><A></b>")
    }
}


class TemplateIncludeTests(TestCase) {
    def test_lambda_in_a_block_reads_the_loop_variable() {
        const out: str = LAMBDA_INLINE.to_str()
        self.assertTrue("<li>A</li>" in out)
        self.assertTrue("<li>B</li>" in out)
    }

    def test_lambda_returning_a_concatenation_in_a_block() {
        const out: str = LAMBDA_LIST.to_str()
        self.assertTrue("<li>a!</li>" in out)
        self.assertTrue("<li>b!</li>" in out)
    }

    def test_lambda_in_an_included_block_reads_the_loop_variable() {
        const out: str = LAMBDA_FROM_FILE.to_str()
        self.assertTrue("<li>A</li>" in out)
        self.assertTrue("<li>B</li>" in out)
    }

    def test_include_slot_is_typed_like_an_inline_one() {
        const p: tuple[str, str] = ("a", "x")
        self.assertEqual(tmpl_pair_from_file(p).strip(), "a=x")
        self.assertEqual(tmpl_pair_from_file(p).strip(), tmpl_pair(p).strip())
    }

    def test_include_escapes_like_an_inline_template() {
        const p: tuple[str, str] = ("<k>", "<v>")
        self.assertEqual(tmpl_pair_from_file(p).strip(),
                         "&lt;k&gt;=&lt;v&gt;")
    }

    def test_include_nests_relative_to_its_own_file() {
        self.assertEqual(tmpl_nested_from_file("ada"),
                         "<div><span>ada</span></div>")
    }

    def test_nested_include_escapes_its_slot() {
        self.assertEqual(tmpl_nested_from_file("<b>"),
                         "<div><span>&lt;b&gt;</span></div>")
    }
}


main([TemplateFileBangTests(), TemplateTupleInterpTests(),
      EmptyTypedTemplateTests(), TemplateFilterTrustTests(),
      TemplateIncludeTests()])

# This program is EXPECTED TO DIE. Its ctest entry asserts exit 134 (SIGABRT)
# and the "out of memory" diagnostic on stderr. it oft died with 139
# (SIGSEGV) and printed nothing, which is the regression being pinned:
# list.append and dict[k]=v under the identical cap already abort cleanly.


def main() {
    s: set[int] = set()
    i: int = 0
    while i < 5000000 {
        s.add(i)
        i = i + 1
    }
    print("FAIL: never reached the allocation failure - the cap is too loose")
}


main()


from unittest import TestCase, main
from collide_classes_one import one_point, one_greet_via_base
from collide_classes_two import two_point, two_greet_via_base, probe_two
from collide_generics_one import one_box_int, one_box_str, one_pick_int
from collide_generics_two import two_box_int, two_pick_int, Box
from collide_generics_importer import importer_box_int, importer_alias_boxes
from collide_generics_importer import importer_pick_int, importer_qualified_picks
from collide_generics_importer import importer_firstish
from collide_generic_methods_one import one_wrap
from collide_generic_methods_two import two_wrap
from collide_generic_methods_importer import importer_wrap
from collide_decode_one import one_roundtrip
from collide_decode_two import two_roundtrip
from collide_decode_importer import importer_decode
from collide_methret_one import one_poke, one_lift
import collide_generic_methods_one
import collide_generic_methods_two
from collide_methret_two import two_poke


class Decoy {
    def() {
        self.d: str = "entry-decoy"
    }

    def flip() -> str {
        return "flip:" + self.d
    }
}


class Crate {
    def() {
        self.c: str = "entry-crate"
    }

    def summon() -> Decoy {
        return Decoy()
    }
}


def entry_summon() -> str {
    c: Crate = Crate()
    return c.summon().flip()
}


def entry_box_int() -> int {
    b: Box[int] = Box[int](3)
    return b.get() + b.stamped()
}


def entry_wrap_both() -> str {
    first: collide_generic_methods_one.Holder = collide_generic_methods_one.Holder("one")
    second: collide_generic_methods_two.Holder = collide_generic_methods_two.Holder(4)
    return first.wrap[int](5) + "|" + second.wrap[int](6)
}


class CollideClassesTests(TestCase) {
    """Same-named classes in different modules must not share compiler metadata.
    Pre-fix: bare-name layout/vtable/exception maps, last write wins."""

    def test_field_layouts_stay_per_module() {
        self.assertEqual(one_point(), 7)
        self.assertEqual(two_point(), "axis:9")
    }

    def test_exception_identity_stays_per_module() {
        self.assertEqual(probe_two(), "passed-through")
    }

    def test_virtual_dispatch_stays_per_module() {
        self.assertEqual(one_greet_via_base(), "one-kid")
        self.assertEqual(two_greet_via_base(), "two-kid")
    }
}


class CollideGenericsTests(TestCase) {
    """Same-named generic templates in different modules must stamp their own.
    Pre-fix: the template registries folded across modules, first dep wins, so
    a losing call either failed to bind its type parameter or silently ran the
    winner's body."""

    def test_one_stamps_its_own_template() {
        self.assertEqual(one_box_int(), 7)
        self.assertEqual(one_box_str(), "alpha")
        self.assertEqual(one_pick_int(), 11)
    }

    def test_two_stamps_its_own_template() {
        self.assertEqual(two_box_int(), 104)
        self.assertEqual(two_pick_int(), 33)
    }

    def test_import_pins_template_across_registration_order() {
        self.assertEqual(importer_box_int(), 102)
        self.assertEqual(importer_pick_int(), 40)
    }

    def test_both_modules_templates_coexist_in_one_module() {
        self.assertEqual(importer_alias_boxes(), "1|101")
        self.assertEqual(importer_qualified_picks(), 24)
    }

    def test_stamped_body_resolves_names_in_its_own_module() {
        self.assertEqual(importer_firstish([4, 5, 6]), 6)
    }

    def test_entry_stamp_is_not_captured_by_a_dependency_stamp() {
        self.assertEqual(entry_box_int(), 102)
    }
}


class CollideGenericMethodsTests(TestCase) {
    """Generic method stamps must land in their own class across modules.
    Pre-fix: the stamp request carried only a bare owning-class name."""

    def test_one_stamps_into_its_own_holder() {
        self.assertEqual(one_wrap(), "one:5")
    }

    def test_two_stamps_into_its_own_holder() {
        self.assertEqual(two_wrap(), "9#x")
    }

    def test_imported_holder_uses_its_own_template() {
        self.assertEqual(importer_wrap(), "4#6")
    }

    def test_same_argument_stamps_land_in_their_own_class() {
        self.assertEqual(entry_wrap_both(), "one:5|4#6")
    }
}


class CollideDecodeTests(TestCase) {
    """decode[T] must synthesize against T's own class, not a same-named one.
    Pre-fix: the synthesizer read fields from a first-wins by-name registry."""

    def test_one_decodes_its_own_shape() {
        self.assertEqual(one_roundtrip(), "seven:7")
    }

    def test_two_decodes_its_own_shape() {
        self.assertEqual(two_roundtrip(), "ex:9")
    }

    def test_imported_class_pins_decoder_across_fold_order() {
        self.assertEqual(importer_decode(), "im:4")
    }
}


class CollideMethretTests(TestCase) {
    """Method return-class metadata must resolve by module-scoped identity.
    Pre-fix: chained calls resolved the receiver's module through a last-wins
    bare class map, then fell back to a bare Class_method key, so another
    module's (or the entry's) same-named class supplied the return class.
    Sharing this program with CollideGenericsTests also pins DRG-85: the plain
    Box here and the Box[T] template there must coexist in one graph."""

    def test_chained_call_return_class_stays_per_module() {
        self.assertEqual(one_poke(), "shout:one-payload")
        self.assertEqual(two_poke(), "rattle:two-gadget")
    }

    def test_inherited_return_class_resolves_through_parent_chain() {
        self.assertEqual(one_lift(), "shout:one-payload")
    }

    def test_entry_module_classes_keep_bare_keys() {
        self.assertEqual(entry_summon(), "flip:entry-decoy")
    }
}


main([CollideClassesTests(), CollideGenericsTests(), CollideGenericMethodsTests(), CollideDecodeTests(), CollideMethretTests()])

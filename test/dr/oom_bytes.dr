from unittest import TestCase, main
from crypto import ed25519_keypair, ed25519_sign

class BytesOomTests(TestCase) {
    def test_slice_oom_is_catchable() {
        big: bytes = b"x" * 167772160
        caught: bool = False
        try {
            c: bytes = big[1:]
            print(len(c))
        } except MemoryError {
            caught = True
        }
        self.assertTrue(caught)
    }
    def test_ed25519_sign_oom_is_catchable() {
        big: bytes = b"x" * 167772160
        keys: tuple[bytes, bytes] = ed25519_keypair()
        caught: bool = False
        try {
            sig: bytes = ed25519_sign(keys[0], big)
            print(len(sig))
        } except MemoryError {
            caught = True
        }
        self.assertTrue(caught)
    }
    def test_concat_oom_is_catchable() {
        a: bytes = b"x" * 94371840
        b: bytes = b"y" * 94371840
        caught: bool = False
        try {
            c: bytes = a + b
            print(len(c))
        } except MemoryError {
            caught = True
        }
        self.assertTrue(caught)
        d: bytes = b"ok" * 2
        self.assertEqual(len(d), 4)
    }
}

main([BytesOomTests()])

# longjmp unwinding skips codegen scope cleanup, so owned heap locals in unwound frames leaked;
# the cleanup stack frees exactly those. Dangerous direction: no double-free on the CAUGHT path.

from unittest import TestCase, main


class AppError(Exception) {
    code: int
    payload: str
    def(code: int, payload: str) {
        self.code = code
        self.payload = payload
    }
}


class WrapError(Exception) {
    note: str
    def(note: str) {
        self.note = note
    }
}


def boom(n: int) {
    raise AppError(n, "payload " + str(n))
}


def raise_saved(n: int) {
    saved: AppError = AppError(n, "saved " + str(n))
    raise saved
}


class ExcInstanceTests(TestCase) {
    def test_unbound_catch_churn() {
        caught: int = 0
        i: int = 0
        while i < 2000 {
            try {
                boom(i)
            } except AppError {
                caught = caught + 1
            }
            i = i + 1
        }
        self.assertEqual(caught, 2000)
    }

    def test_bound_catch_reads_fields() {
        code: int = 0
        got: str = ""
        try {
            boom(41)
        } except AppError as e {
            code = e.code
            got = e.payload
        }
        self.assertEqual(code, 41)
        self.assertEqual(got, "payload 41")
    }

    def test_bound_catch_churn() {
        total: int = 0
        i: int = 0
        while i < 2000 {
            try {
                boom(i)
            } except AppError as e {
                total = total + e.code
            }
            i = i + 1
        }
        self.assertEqual(total, 1999000)
    }

    def test_raise_inside_bound_handler() {
        caught: int = 0
        i: int = 0
        while i < 500 {
            try {
                try {
                    boom(i)
                } except AppError as e {
                    raise WrapError("wrapped " + str(e.code))
                }
            } except WrapError as w {
                caught = caught + 1
            }
            i = i + 1
        }
        self.assertEqual(caught, 500)
    }

    def test_reraise_binding() {
        code: int = 0
        try {
            try {
                boom(7)
            } except AppError as e {
                raise e
            }
        } except AppError as e2 {
            code = e2.code
        }
        self.assertEqual(code, 7)
    }

    def test_raise_saved_local_churn() {
        caught: int = 0
        i: int = 0
        while i < 500 {
            try {
                raise_saved(i)
            } except AppError {
                caught = caught + 1
            }
            i = i + 1
        }
        self.assertEqual(caught, 500)
    }

    def test_finally_reraise_keeps_instance() {
        code: int = 0
        ran_finally: int = 0
        try {
            try {
                boom(9)
            } finally {
                ran_finally = 1
            }
        } except AppError as e {
            code = e.code
        }
        self.assertEqual(ran_finally, 1)
        self.assertEqual(code, 9)
    }
}


class UErr(Exception) {
    code: int
    def(c: int) { self.code = c }
}


def adder(n: int) -> Callable[[int], int] {
    def add(x: int) -> int { return x + n }
    return add
}

def count_gen(nv: int) {
    k: int = 0
    while k < nv { yield k; k = k + 1 }
}

def returns_from_try() -> int {
    try {
        s: str = "ret-" + str(1)
        return 99
    } except Exception {
        return -1
    }
    return 0
}

def int_slots(n: int) -> dict[int, bool] {
    d: dict[int, bool] = {}
    i: int = 0
    while i < n {
        d[i] = True
        i = i + 1
    }
    return d
}


def int_items(n: int) -> list[int] {
    l: list[int] = []
    i: int = 0
    while i < n {
        l.append(i)
        i = i + 1
    }
    return l
}


def raise_in_dict_loop(d: dict[int, bool]) -> int {
    for k in d { raise UErr(k) }
    return 0
}


def raise_in_keys_loop(d: dict[int, bool]) -> int {
    for k in d.keys() { raise UErr(k) }
    return 0
}


def raise_in_list_temp_loop(n: int) -> int {
    for e in int_items(n) { raise UErr(e) }
    return 0
}


def leaf() {
    raise ValueError("deep")
}
def mid(i: int) -> int {
    s: str = "midframe-" + str(i)
    f: Callable[[int], int] = adder(i)
    leaf()
    return len(s) + f(0)
}


class ExceptionUnwindCleanupTests(TestCase) {
    def test_cross_function_unwind() {
        caught: int = 0
        try {
            mid(5)
        } except ValueError {
            caught = 1
        }
        self.assertEqual(caught, 1)
    }

    # Reassignment inside the try then raise: the snapshot must be current,
    # else the stale (freed) value double-frees and the new one leaks.
    def test_reassign_in_try_then_raise() {
        got: str = "no"
        try {
            s: str = "first-" + str(1)
            s = "second-" + str(2)
            s = "third-" + str(3)
            raise ValueError("boom")
        } except ValueError {
            got = "caught"
        }
        self.assertEqual(got, "caught")
    }

    def test_raise_local_instance() {
        code: int = -1
        try {
            e: UErr = UErr(42)
            raise e
        } except UErr as caught {
            code = caught.code
        }
        self.assertEqual(code, 42)
    }

    def test_container_locals_caught() {
        ok: int = 0
        try {
            lst: list[int] = [1, 2, 3]
            d: dict[str, int] = {"a": 1}
            obj: UErr = UErr(7)
            raise ValueError("c")
        } except ValueError {
            ok = 1
        }
        self.assertEqual(ok, 1)
    }

    def test_union_local_unwind() {
        ok: int = 0
        try {
            u: int | str = "boxed-" + str(9)
            raise ValueError("u")
        } except ValueError {
            ok = 1
        }
        self.assertEqual(ok, 1)
    }

    def test_nested_try() {
        result: str = "no"
        try {
            outer: str = "outer-" + str(1)
            try {
                inner: str = "inner-" + str(2)
                raise ValueError("inner")
            } except ValueError {
                mid_s: str = "mid-" + str(3)
            }
            raise KeyError("outer")
        } except KeyError {
            result = "ok"
        }
        self.assertEqual(result, "ok")
    }

    def test_break_out_of_try() {
        n: int = 0
        i: int = 0
        while i < 10 {
            try {
                s: str = "iter-" + str(i)
                if i == 3 { break }
            } except Exception {
                n = -1
            }
            n = n + 1
            i = i + 1
        }
        self.assertEqual(n, 3)
    }

    def test_return_out_of_try() {
        self.assertEqual(returns_from_try(), 99)
    }

    def test_generator_loop_body_raise() {
        caught: int = 0
        try {
            for x in count_gen(5) {
                t: str = "body-" + str(x)
                if x == 3 { raise ValueError("midloop") }
            }
        } except ValueError {
            caught = 1
        }
        self.assertEqual(caught, 1)
    }

    def test_dict_loop_keys_released_when_the_body_raises() {
        d: dict[int, bool] = int_slots(4)
        caught: int = 0
        i: int = 0
        while i < 300 {
            try {
                n: int = raise_in_dict_loop(d)
            } except UErr {
                caught = caught + 1
            }
            i = i + 1
        }
        self.assertEqual(caught, 300)
        self.assertEqual(len(d), 4)
    }

    def test_dict_keys_loop_released_when_the_body_raises() {
        d: dict[int, bool] = int_slots(4)
        caught: int = 0
        i: int = 0
        while i < 300 {
            try {
                n: int = raise_in_keys_loop(d)
            } except UErr {
                caught = caught + 1
            }
            i = i + 1
        }
        self.assertEqual(caught, 300)
    }

    def test_list_temp_loop_released_when_the_body_raises() {
        caught: int = 0
        i: int = 0
        while i < 300 {
            try {
                n: int = raise_in_list_temp_loop(4)
            } except UErr {
                caught = caught + 1
            }
            i = i + 1
        }
        self.assertEqual(caught, 300)
    }

    def test_dict_loop_keys_released_when_the_same_frame_catches() {
        d: dict[int, bool] = int_slots(4)
        caught: int = 0
        i: int = 0
        while i < 300 {
            try {
                for k in d { raise UErr(k) }
            } except UErr {
                caught = caught + 1
            }
            i = i + 1
        }
        self.assertEqual(caught, 300)
    }
}


class InlineTempLeakOnRaise(TestCase) {
    """Inline temp operands must be released when the callee raises (issue-3).

    Regression for the codegen unwind-bookkeeping leak: when a runtime call raises
    mid-expression (longjmp), the borrow temps of that expression were only drained
    on the normal-return path, so `b"abc".index(b"zz")` leaked the receiver and the
    argument on every caught ValueError. Binding operands to locals hides the leak
    (locals are cleanup-stack tracked); every case here deliberately keeps the
    operands INLINE.

    Each loop is bounded (3000 iterations) per the memory house rules; leaks are
    linear, so a few thousand iterations is plenty for LSan. This file must run
    clean under ASAN_OPTIONS=detect_leaks=1:hard_rss_limit_mb=2048.
    """

    def test_bytes_index_inline_receiver_and_arg() {
        i: int = 0
        hits: int = 0
        while i < 3000 {
            try {
                b"abc".index(b"zz")
            } except ValueError {
                hits = hits + 1
            }
            i = i + 1
        }
        self.assertEqual(hits, 3000)
    }

    def test_list_remove_inline_receiver() {
        i: int = 0
        hits: int = 0
        while i < 3000 {
            try {
                [1, 2].remove(9)
            } except ValueError {
                hits = hits + 1
            }
            i = i + 1
        }
        self.assertEqual(hits, 3000)
    }

    def test_list_index_inline_receiver() {
        i: int = 0
        hits: int = 0
        while i < 3000 {
            try {
                [1, 2].index(9)
            } except ValueError {
                hits = hits + 1
            }
            i = i + 1
        }
        self.assertEqual(hits, 3000)
    }

    def test_str_index_computed_receiver_and_arg() {
        i: int = 0
        hits: int = 0
        while i < 3000 {
            try {
                ("ab" + "cd").index("z" + "z")
            } except ValueError {
                hits = hits + 1
            }
            i = i + 1
        }
        self.assertEqual(hits, 3000)
    }

    def test_set_remove_inline_receiver() {
        i: int = 0
        hits: int = 0
        while i < 3000 {
            try {
                {1, 2}.remove(9)
            } except KeyError {
                hits = hits + 1
            }
            i = i + 1
        }
        self.assertEqual(hits, 3000)
    }

    def test_bytes_fromhex_invalid() {
        i: int = 0
        hits: int = 0
        while i < 3000 {
            try {
                bytes.fromhex("z" + "z")
            } except ValueError {
                hits = hits + 1
            }
            i = i + 1
        }
        self.assertEqual(hits, 3000)
    }

    def test_tuple_subscript_inline_receiver() {
        i: int = 0
        hits: int = 0
        while i < 3000 {
            try {
                (1, 2)[9]
            } except IndexError {
                hits = hits + 1
            }
            i = i + 1
        }
        self.assertEqual(hits, 3000)
    }

    def test_list_subscript_inline_receiver() {
        i: int = 0
        hits: int = 0
        while i < 3000 {
            try {
                [1, 2][9]
            } except IndexError {
                hits = hits + 1
            }
            i = i + 1
        }
        self.assertEqual(hits, 3000)
    }

    def test_dict_subscript_inline_receiver() {
        i: int = 0
        hits: int = 0
        while i < 3000 {
            try {
                {1: 2}[9]
            } except KeyError {
                hits = hits + 1
            }
            i = i + 1
        }
        self.assertEqual(hits, 3000)
    }

    def test_str_subscript_inline_receiver() {
        i: int = 0
        hits: int = 0
        while i < 3000 {
            try {
                ("ab" + "cd")[9]
            } except IndexError {
                hits = hits + 1
            }
            i = i + 1
        }
        self.assertEqual(hits, 3000)
    }
}


main([ExcInstanceTests(), ExceptionUnwindCleanupTests(), InlineTempLeakOnRaise()])

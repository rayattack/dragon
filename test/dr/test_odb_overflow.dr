from unittest import TestCase, main
from odb.vfs import SimVFS
from odb.pager import create, open_pager, Pager
from odb.btree import BTree
from odb.checker import check_tree, CheckResult
from odb.errors import ODBError
from odb.overflow import MAX_VALUE_BYTES


def _blob(n: int, seed: int) -> bytes {
    unit: list[int] = []
    i: int = 0
    while i < 256 {
        unit.append((i * 7 + seed) & 0xFF)
        i = i + 1
    }
    out: bytes = bytes(unit)
    while len(out) < n {
        out = out + out
    }
    return out[0:n]
}


def _fresh() -> Pager {
    v: SimVFS = SimVFS()
    return create(v, 4096)
}


class OverflowRoundTripTest(TestCase) {
    def test_sizes_across_the_inline_threshold() -> None {
        p: Pager = _fresh()
        t: BTree = BTree(p, 0)
        sizes: list[int] = [0, 1, 1021, 1022, 1023, 1024, 4096, 65536, 1000000]
        i: int = 0
        while i < len(sizes) {
            t.insert(i, _blob(sizes[i], i))
            i = i + 1
        }
        i = 0
        while i < len(sizes) {
            got: bytes = t.get(i)
            self.assertEqual(len(got), sizes[i])
            self.assertEqual(got, _blob(sizes[i], i))
            i = i + 1
        }
    }

    def test_spilled_value_survives_reopen() -> None {
        v: SimVFS = SimVFS()
        p: Pager = create(v, 4096)
        t: BTree = BTree(p, 0)
        payload: bytes = _blob(300000, 3)
        t.insert(42, payload)
        p.set_catalog_root(t.root)
        p.commit()

        rp: Pager = open_pager(v)
        rt: BTree = BTree(rp, rp.catalog_root)
        self.assertEqual(rt.get(42), payload)

        chk: CheckResult = check_tree(rp, rp.catalog_root)
        self.assertTrue(chk.ok, chk.message)
    }

    def test_many_spilled_values_coexist() -> None {
        p: Pager = _fresh()
        t: BTree = BTree(p, 0)
        i: int = 0
        while i < 40 {
            t.insert(i, _blob(5000 + i * 100, i))
            i = i + 1
        }
        i = 0
        while i < 40 {
            self.assertEqual(t.get(i), _blob(5000 + i * 100, i))
            i = i + 1
        }
        self.assertEqual(t.count(), 40)
    }
}


class OverflowMutationTest(TestCase) {
    def test_spilled_to_larger_spilled() -> None {
        p: Pager = _fresh()
        t: BTree = BTree(p, 0)
        t.insert(1, _blob(20000, 1))
        t.insert(1, _blob(90000, 2))
        self.assertEqual(t.get(1), _blob(90000, 2))
        self.assertEqual(t.count(), 1)
    }

    def test_spilled_shrinks_back_to_inline() -> None {
        p: Pager = _fresh()
        t: BTree = BTree(p, 0)
        t.insert(1, _blob(50000, 1))
        t.insert(1, _blob(10, 2))
        self.assertEqual(t.get(1), _blob(10, 2))
    }

    def test_inline_grows_into_spilled() -> None {
        p: Pager = _fresh()
        t: BTree = BTree(p, 0)
        t.insert(1, _blob(10, 1))
        t.insert(1, _blob(50000, 2))
        self.assertEqual(t.get(1), _blob(50000, 2))
    }

    def test_delete_removes_a_spilled_value() -> None {
        p: Pager = _fresh()
        t: BTree = BTree(p, 0)
        t.insert(1, _blob(70000, 1))
        t.insert(2, _blob(80000, 2))
        self.assertTrue(t.delete(1))
        self.assertFalse(t.contains(1))
        self.assertEqual(t.get(2), _blob(80000, 2))
    }
}


class OverflowPageReuseTest(TestCase) {
    def test_deleting_a_chain_returns_its_pages() -> None {
        v: SimVFS = SimVFS()
        p: Pager = create(v, 4096)
        t: BTree = BTree(p, 0)
        t.insert(1, _blob(200000, 1))
        p.set_catalog_root(t.root)
        p.commit()
        const after_first: int = p.high_water

        t.delete(1)
        p.set_catalog_root(t.root)
        p.commit()

        t.insert(2, _blob(200000, 2))
        p.set_catalog_root(t.root)
        p.commit()
        const after_reuse: int = p.high_water

        self.assertEqual(t.get(2), _blob(200000, 2))
        self.assertTrue(after_reuse < after_first * 2,
            "file grew from " + str(after_first) + " to " + str(after_reuse) + " pages, chain pages were not reused")
    }

    def test_repeated_overwrites_stay_bounded() -> None {
        v: SimVFS = SimVFS()
        p: Pager = create(v, 4096)
        t: BTree = BTree(p, 0)
        t.insert(1, _blob(100000, 0))
        p.set_catalog_root(t.root)
        p.commit()
        const baseline: int = p.high_water

        i: int = 1
        while i <= 30 {
            t.insert(1, _blob(100000, i))
            p.set_catalog_root(t.root)
            p.commit()
            i = i + 1
        }
        self.assertEqual(t.get(1), _blob(100000, 30))
        self.assertTrue(p.high_water < baseline * 4,
            "30 overwrites grew the file from " + str(baseline) + " to " + str(p.high_water) + " pages")
    }
}


class OverflowLimitTest(TestCase) {
    def test_value_past_the_document_limit_is_refused() -> None {
        p: Pager = _fresh()
        t: BTree = BTree(p, 0)
        raised: bool = False
        try {
            t.insert(1, _blob(MAX_VALUE_BYTES + 1, 1))
        } except ODBError {
            raised = True
        }
        self.assertTrue(raised)
    }
}


main([OverflowRoundTripTest(), OverflowMutationTest(), OverflowPageReuseTest(), OverflowLimitTest()])

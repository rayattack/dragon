from unittest import TestCase, main
from odb.schema import compile_schema, CompiledSchema
from odb.dbon import encode, decode
from odb.errors import SchemaError


def _compile(schema: dict[str, Any]) -> CompiledSchema {
    return compile_schema("t", schema, 1, 1, "{}")
}


def _bad_schema(schema: dict[str, Any]) -> bool {
    try {
        _compile(schema)
    } except SchemaError {
        return True
    }
    return False
}


def _payment_schema() -> CompiledSchema {
    card: dict[str, Any] = { "type": "object",
                             "properties": { "kind": {"type": "string", "const": "card"},
                                             "last4": {"type": "string", "minLength": 4, "maxLength": 4} },
                             "required": ["kind", "last4"] }
    bank: dict[str, Any] = { "type": "object",
                             "properties": { "kind": {"type": "string", "const": "bank"},
                                             "iban": {"type": "string", "minLength": 5} },
                             "required": ["kind", "iban"] }
    const both: list[Any] = [card, bank]
    props: dict[str, Any] = {}
    props["id"] = {"type": "integer"}
    props["method"] = {"oneOf": both}
    s: dict[str, Any] = {}
    s["type"] = "object"
    s["properties"] = props
    const req: list[Any] = ["id", "method"]
    s["required"] = req
    return _compile(s)
}


def _accepts(cs: CompiledSchema, method: dict[str, Any]) -> bool {
    doc: dict[str, Any] = {}
    doc["id"] = 1
    doc["method"] = method
    try {
        encode(cs, doc)
    } except SchemaError {
        return False
    }
    return True
}


def _card(last4: str) -> dict[str, Any] {
    d: dict[str, Any] = {}
    d["kind"] = "card"
    d["last4"] = last4
    return d
}


def _bank(iban: str) -> dict[str, Any] {
    d: dict[str, Any] = {}
    d["kind"] = "bank"
    d["iban"] = iban
    return d
}


class DiscriminatedUnionTest(TestCase) {
    def test_each_branch_is_accepted() -> None {
        const cs: CompiledSchema = _payment_schema()
        self.assertTrue(_accepts(cs, _card("4242")))
        self.assertTrue(_accepts(cs, _bank("GB33BUKB")))
    }

    def test_the_selected_branch_constraints_are_enforced() -> None {
        const cs: CompiledSchema = _payment_schema()
        self.assertFalse(_accepts(cs, _card("42")))
        self.assertFalse(_accepts(cs, _bank("GB")))
    }

    def test_the_selected_branch_still_requires_its_own_fields() -> None {
        const cs: CompiledSchema = _payment_schema()
        mixed: dict[str, Any] = {}
        mixed["kind"] = "card"
        mixed["iban"] = "GB33BUKB"
        self.assertFalse(_accepts(cs, mixed))
    }

    def test_an_unknown_tag_is_refused() -> None {
        const cs: CompiledSchema = _payment_schema()
        other: dict[str, Any] = {}
        other["kind"] = "crypto"
        other["last4"] = "4242"
        self.assertFalse(_accepts(cs, other))
    }

    def test_a_missing_tag_is_refused() -> None {
        const cs: CompiledSchema = _payment_schema()
        untagged: dict[str, Any] = {}
        untagged["last4"] = "4242"
        self.assertFalse(_accepts(cs, untagged))
    }

    def test_a_union_round_trips() -> None {
        const cs: CompiledSchema = _payment_schema()
        doc: dict[str, Any] = {}
        doc["id"] = 1
        doc["method"] = _bank("GB33BUKB6202")
        const back: dict[str, Any] = decode(cs, encode(cs, doc))
        const m: dict[str, Any] = back["method"]
        const kind: str = m["kind"]
        const iban: str = m["iban"]
        self.assertEqual(kind, "bank")
        self.assertEqual(iban, "GB33BUKB6202")
    }
}


class UnionRejectionTest(TestCase) {
    def _union(branches: list[Any]) -> dict[str, Any] {
        props: dict[str, Any] = {}
        props["method"] = {"oneOf": branches}
        s: dict[str, Any] = {}
        s["properties"] = props
        return s
    }

    def test_undiscriminated_union_is_refused() -> None {
        a: dict[str, Any] = { "type": "object",
                              "properties": {"x": {"type": "string"}},
                              "required": ["x"] }
        b: dict[str, Any] = { "type": "object",
                              "properties": {"y": {"type": "string"}},
                              "required": ["y"] }
        const both: list[Any] = [a, b]
        self.assertTrue(_bad_schema(self._union(both)))
    }

    def test_a_repeated_const_is_refused() -> None {
        a: dict[str, Any] = { "type": "object",
                              "properties": {"kind": {"type": "string", "const": "same"}},
                              "required": ["kind"] }
        b: dict[str, Any] = { "type": "object",
                              "properties": {"kind": {"type": "string", "const": "same"}},
                              "required": ["kind"] }
        const both: list[Any] = [a, b]
        self.assertTrue(_bad_schema(self._union(both)))
    }

    def test_an_optional_discriminator_is_refused() -> None {
        const noreq: list[Any] = []
        a: dict[str, Any] = { "type": "object",
                              "properties": {"kind": {"type": "string", "const": "card"}},
                              "required": noreq }
        b: dict[str, Any] = { "type": "object",
                              "properties": {"kind": {"type": "string", "const": "bank"}},
                              "required": noreq }
        const both: list[Any] = [a, b]
        self.assertTrue(_bad_schema(self._union(both)))
    }

    def test_a_single_branch_is_refused() -> None {
        a: dict[str, Any] = { "type": "object",
                              "properties": {"kind": {"type": "string", "const": "card"}},
                              "required": ["kind"] }
        const one: list[Any] = [a]
        self.assertTrue(_bad_schema(self._union(one)))
    }

    def test_an_ambiguous_discriminator_is_refused() -> None {
        a: dict[str, Any] = { "type": "object",
                              "properties": {"kind": {"type": "string", "const": "card"},
                                             "tier": {"type": "string", "const": "gold"}},
                              "required": ["kind", "tier"] }
        b: dict[str, Any] = { "type": "object",
                              "properties": {"kind": {"type": "string", "const": "bank"},
                                             "tier": {"type": "string", "const": "silver"}},
                              "required": ["kind", "tier"] }
        const both: list[Any] = [a, b]
        self.assertTrue(_bad_schema(self._union(both)))
    }

    def test_a_union_with_properties_is_refused() -> None {
        a: dict[str, Any] = { "type": "object",
                              "properties": {"kind": {"type": "string", "const": "card"}},
                              "required": ["kind"] }
        b: dict[str, Any] = { "type": "object",
                              "properties": {"kind": {"type": "string", "const": "bank"}},
                              "required": ["kind"] }
        const both: list[Any] = [a, b]
        inner: dict[str, Any] = {}
        props: dict[str, Any] = {}
        props["method"] = {"oneOf": both, "properties": inner}
        s: dict[str, Any] = {}
        s["properties"] = props
        self.assertTrue(_bad_schema(s))
    }

    def test_a_non_object_type_on_a_union_is_refused() -> None {
        a: dict[str, Any] = { "type": "object",
                              "properties": {"kind": {"type": "string", "const": "card"}},
                              "required": ["kind"] }
        b: dict[str, Any] = { "type": "object",
                              "properties": {"kind": {"type": "string", "const": "bank"}},
                              "required": ["kind"] }
        const both: list[Any] = [a, b]
        props: dict[str, Any] = {}
        props["method"] = {"oneOf": both, "type": "string"}
        s: dict[str, Any] = {}
        s["properties"] = props
        self.assertTrue(_bad_schema(s))
    }

    def test_any_of_and_all_of_stay_refused() -> None {
        a: dict[str, Any] = { "type": "object",
                              "properties": {"kind": {"type": "string", "const": "card"}},
                              "required": ["kind"] }
        const one: list[Any] = [a]
        props: dict[str, Any] = {}
        props["method"] = {"anyOf": one}
        s: dict[str, Any] = {}
        s["properties"] = props
        self.assertTrue(_bad_schema(s))

        props2: dict[str, Any] = {}
        props2["method"] = {"allOf": one}
        s2: dict[str, Any] = {}
        s2["properties"] = props2
        self.assertTrue(_bad_schema(s2))
    }
}


main([DiscriminatedUnionTest(), UnionRejectionTest()])

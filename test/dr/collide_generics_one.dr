"""Minimal Box[T] and a pick[T]; collide_generics_two.dr declares richer ones
under the same two names."""


class Box[T] {
    def(v: T) {
        self.v = v
    }

    def get() -> T {
        return self.v
    }
}


def one_box_int() -> int {
    b: Box[int] = Box[int](7)
    return b.get()
}


def one_box_str() -> str {
    b: Box[str] = Box[str]("alpha")
    return b.get()
}


def pick[T](xs: list[T]) -> T {
    return xs[0]
}


def one_pick_int() -> int {
    return pick([11, 22, 33])
}

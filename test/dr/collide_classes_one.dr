"""Declares Point / Boom / Base / Kid; collide_classes_two.dr reuses the names."""


class Point {
    def(x: int, y: int) {
        self.x: int = x
        self.y: int = y
    }

    def sum() -> int {
        return self.x + self.y
    }
}


class Boom(Exception) {
    def(msg: str) {
        self.msg: str = msg
    }
}


class Base {
    def() {
        self.kind: str = "base"
    }

    def greet() -> str {
        return "base"
    }
}


class Kid(Base) {
    def() {
        self.kind: str = "kid"
    }

    def greet() -> str {
        return "one-kid"
    }

    def only_in_one() -> str {
        return "one-extra"
    }
}


def one_point() -> int {
    p: Point = Point(3, 4)
    return p.sum()
}


def throw_one() -> None {
    raise Boom("from-one")
}


def one_greet_via_base() -> str {
    b: Base = Kid()
    return b.greet()
}

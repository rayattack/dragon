# Static-method dispatch built no argTemps drain: every owned-temp arg leaked once per call
# (LSan A/B: clean with the drain, 2 str objects per iteration reverted). A double-free crashes here.

from unittest import TestCase, main


class Mathy {
    @staticmethod
    def combine(a: str, b: str) -> int {
        return len(a) + len(b)
    }

    @staticmethod
    def first_char(s: str) -> str {
        return s[0:1]
    }
}


class StaticArgRcTests(TestCase) {
    def test_owned_temp_str_args() {
        total: int = 0
        i: int = 0
        while i < 1000 {
            total = total + Mathy.combine(str(i), str(i * 7))
            i = i + 1
        }
        self.assertEqual(total > 0, True)
    }

    def test_owned_temp_slice_arg() {
        seen: int = 0
        i: int = 0
        while i < 1000 {
            c: str = Mathy.first_char(str(i) + "z")
            if c == "1" {
                seen = seen + 1
            }
            i = i + 1
        }
        self.assertEqual(seen, 111)
    }
}


main([StaticArgRcTests()])

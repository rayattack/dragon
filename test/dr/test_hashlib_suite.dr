from unittest import TestCase, main
from hashlib import md5, sha1, sha256, sha224, sha384, sha512, new, Hash, hexdigest
from crypto import sha224 as hsha224, sha384 as hsha384, sha512 as hsha512
from time import monotonic
import hashlib
import hmac

const _SHA1_EMPTY: str = "da39a3ee5e6b4b0d3255bfef95601890afd80709"
const _SHA1_ABC: str   = "a9993e364706816aba3e25717850c26c9cd0d89d"
const _SHA1_LONG: str  = "84983e441c3bd26ebaae4aa1f95129e5e54670f1"

const _SHA256_EMPTY: str = "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
const _SHA256_ABC: str   = "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
const _SHA256_LONG: str  = "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1"

const _224_EMPTY: str = "d14a028c2a3a2bc9476102bb288234c415a2b01f828ea62ac5b3e42f"
const _224_ABC: str   = "23097d223405d8228642a477bda255b32aadbce4bda0b3f7e36c9da7"

const _384_EMPTY: str = "38b060a751ac96384cd9327eb1b1e36a21fdb71114be07434c0cc7bf63f6e1da274edebfe76f65fbd51ad2f14898b95b"
const _384_ABC: str   = "cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed8086072ba1e7cc2358baeca134c825a7"

const _512_EMPTY: str = "cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e"
const _512_ABC: str   = "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f"
const _512_LONG: str  = "8e959b75dae313da8cf4f72814fc143f8f7779c6eb9f7fa17299aeadb6889018501d289e4900f7e4331b99dec4b5433ac7d329eeb6dd26545e96e55b874be909"

const _HMAC224: str = "a30e01098bc6dbbf45690f3a7e9e6d0f8bbea2a39e6148008fd05e44"
const _HMAC384: str = "af45d2e376484031617f78d2b58a6b1b9c7ef464f5a01b47e42ec3736322445e8e2240ca5e69e2c78b3239ecfab21649"
const _HMAC512: str = "164b7a7bfcf819e2e395fbe73b56e0a387bd64222e831fd610270cd7ea2505549758bf75c05a994a6d034f65f8f0e6fdcaeab1a34d4a6b4b636e070a38bce737"

const UPDATE_COUNT: int = 20000
const UPDATE_BUDGET_SECS: float = 2.0

class Md5Tests(TestCase) {
    def test_rfc1321_suite() {
        self.assertEqual(md5(b"").hexdigest(),
            "d41d8cd98f00b204e9800998ecf8427e")
        self.assertEqual(md5(b"a").hexdigest(),
            "0cc175b9c0f1b6a831c399e269772661")
        self.assertEqual(md5(b"abc").hexdigest(),
            "900150983cd24fb0d6963f7d28e17f72")
        self.assertEqual(md5(b"message digest").hexdigest(),
            "f96b697d7cb7938d525a2f31aaf161d0")
        self.assertEqual(md5(b"abcdefghijklmnopqrstuvwxyz").hexdigest(),
            "c3fcd3d76192e4007dfb496cca67e13b")
        self.assertEqual(
            md5(b"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789").hexdigest(),
            "d174ab98d277d9f5a5611c2c9f419d9f")
        self.assertEqual(
            md5(b"12345678901234567890123456789012345678901234567890123456789012345678901234567890").hexdigest(),
            "57edf4a22be3c955ac49da2e2107b67a")
    }

    def test_new_constructor() {
        self.assertEqual(new("md5", b"abc").hexdigest(),
            "900150983cd24fb0d6963f7d28e17f72")
    }

    def test_metadata() {
        h: Hash = md5(b"abc")
        self.assertEqual(h.digest_size(), 16)
        self.assertEqual(h.block_size(), 64)
        self.assertEqual(h.name(), "md5")
    }

    def test_incremental_equiv() {
        h: Hash = md5(b"")
        h.update(b"ab")
        h.update(b"c")
        self.assertEqual(h.hexdigest(), "900150983cd24fb0d6963f7d28e17f72")
    }
}

class Sha1Tests(TestCase) {
    def test_empty() {
        self.assertEqual(sha1(b"").hexdigest(), _SHA1_EMPTY)
    }

    def test_abc() {
        self.assertEqual(sha1(b"abc").hexdigest(), _SHA1_ABC)
    }

    def test_long_56byte() {
        msg: bytes = b"abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"
        self.assertEqual(sha1(msg).hexdigest(), _SHA1_LONG)
    }

    def test_new_constructor() {
        self.assertEqual(new("sha1", b"abc").hexdigest(), _SHA1_ABC)
    }

    def test_metadata() {
        h: Hash = sha1(b"abc")
        self.assertEqual(h.digest_size(), 20)
        self.assertEqual(h.block_size(), 64)
        self.assertEqual(h.name(), "sha1")
    }

    def test_incremental_equiv() {
        h: Hash = sha1(b"")
        h.update(b"a")
        h.update(b"b")
        h.update(b"c")
        self.assertEqual(h.hexdigest(), _SHA1_ABC)
    }
}

class Sha256Tests(TestCase) {
    def test_empty() {
        self.assertEqual(sha256(b"").hexdigest(), _SHA256_EMPTY)
    }

    def test_abc() {
        self.assertEqual(sha256(b"abc").hexdigest(), _SHA256_ABC)
    }

    def test_long_56byte() {
        msg: bytes = b"abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"
        self.assertEqual(sha256(msg).hexdigest(), _SHA256_LONG)
    }

    def test_new_constructor() {
        self.assertEqual(new("sha256", b"abc").hexdigest(), _SHA256_ABC)
    }

    def test_metadata() {
        h: Hash = sha256(b"abc")
        self.assertEqual(h.digest_size(), 32)
        self.assertEqual(h.block_size(), 64)
        self.assertEqual(h.name(), "sha256")
    }

    def test_incremental_equiv() {
        h: Hash = sha256(b"")
        h.update(b"a")
        h.update(b"b")
        h.update(b"c")
        self.assertEqual(h.hexdigest(), _SHA256_ABC)
    }

    def test_update_after_initial() {
        h: Hash = sha256(b"a")
        h.update(b"bc")
        self.assertEqual(h.hexdigest(), _SHA256_ABC)
    }

    def test_copy_independent() {
        h: Hash = sha256(b"ab")
        c: Hash = h.copy()
        c.update(b"c")
        self.assertEqual(h.hexdigest(), sha256(b"ab").hexdigest())
        self.assertEqual(c.hexdigest(), _SHA256_ABC)
    }
}

class ShaWideTests(TestCase) {
    def test_sha224() {
        self.assertEqual(sha224(b"").hexdigest(), _224_EMPTY)
        self.assertEqual(sha224(b"abc").hexdigest(), _224_ABC)
    }

    def test_sha384() {
        self.assertEqual(sha384(b"").hexdigest(), _384_EMPTY)
        self.assertEqual(sha384(b"abc").hexdigest(), _384_ABC)
    }

    def test_sha512() {
        self.assertEqual(sha512(b"").hexdigest(), _512_EMPTY)
        self.assertEqual(sha512(b"abc").hexdigest(), _512_ABC)
    }

    def test_sha512_multiblock() {
        msg: bytes = b"abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu"
        self.assertEqual(sha512(msg).hexdigest(), _512_LONG)
    }

    def test_new_constructor() {
        self.assertEqual(new("sha512", b"abc").hexdigest(), _512_ABC)
        self.assertEqual(new("sha384", b"abc").hexdigest(), _384_ABC)
        self.assertEqual(new("sha224", b"abc").hexdigest(), _224_ABC)
    }

    def test_one_shot_hexdigest() {
        self.assertEqual(hexdigest("sha512", b"abc"), _512_ABC)
    }

    def test_metadata() {
        h: Hash = sha512(b"abc")
        self.assertEqual(h.digest_size(), 64)
        self.assertEqual(h.block_size(), 128)
        self.assertEqual(h.name(), "sha512")

        h2: Hash = sha384(b"abc")
        self.assertEqual(h2.digest_size(), 48)
        self.assertEqual(h2.block_size(), 128)

        h3: Hash = sha224(b"abc")
        self.assertEqual(h3.digest_size(), 28)
        self.assertEqual(h3.block_size(), 64)
    }

    def test_incremental_equiv() {
        h: Hash = sha512(b"")
        h.update(b"a")
        h.update(b"b")
        h.update(b"c")
        self.assertEqual(h.hexdigest(), _512_ABC)
    }

    def test_crypto_str_helpers() {
        self.assertEqual(hsha512("abc"), _512_ABC)
        self.assertEqual(hsha384("abc"), _384_ABC)
        self.assertEqual(hsha224("abc"), _224_ABC)
    }

    def test_hmac_wide() {
        key: bytes = b"Jefe"
        msg: bytes = b"what do ya want for nothing?"
        self.assertEqual(hmac.new(key, msg, "sha512").hexdigest(), _HMAC512)
        self.assertEqual(hmac.new(key, msg, "sha384").hexdigest(), _HMAC384)
        self.assertEqual(hmac.new(key, msg, "sha224").hexdigest(), _HMAC224)
    }
}

class IncrementalUpdatePerfTests(TestCase) {
    def test_many_small_updates_within_time_budget() {
        const piece: bytes = b"0123456789abcdef" * 4
        const t0: float = monotonic()
        h: hashlib.Hash = hashlib.sha256()
        i: int = 0
        while i < UPDATE_COUNT {
            h.update(piece)
            i = i + 1
        }
        const d: str = h.hexdigest()
        const elapsed: float = monotonic() - t0
        one_shot: hashlib.Hash = hashlib.sha256(piece * UPDATE_COUNT)
        self.assertEqual(d, one_shot.hexdigest())
        self.assertTrue(elapsed < UPDATE_BUDGET_SECS)
    }
}

class IncrementalSemanticsTests(TestCase) {
    def test_digest_then_more_updates() {
        h: hashlib.Hash = hashlib.sha512(b"first")
        const d1: bytes = h.digest()
        self.assertEqual(d1, hashlib.sha512(b"first").digest())
        h.update(b"second")
        self.assertEqual(h.digest(), hashlib.sha512(b"firstsecond").digest())
    }

    def test_digest_twice_is_stable() {
        h: hashlib.Hash = hashlib.md5(b"stable")
        self.assertEqual(h.digest(), h.digest())
    }

    def test_all_algorithms_incremental_match_one_shot() {
        for alg in hashlib.algorithms_available() {
            h: hashlib.Hash = hashlib.new(alg)
            h.update(b"part-one|")
            h.update(b"part-two")
            self.assertEqual(
                h.hexdigest(),
                hashlib.new(alg, b"part-one|part-two").hexdigest())
        }
    }

    def test_interleaved_copy_update_chains() {
        a: hashlib.Hash = hashlib.sha256(b"seed")
        b: hashlib.Hash = a.copy()
        c: hashlib.Hash = b.copy()
        a.update(b"-a1")
        b.update(b"-b1")
        a.update(b"-a2")
        c.update(b"-c1")
        self.assertEqual(a.hexdigest(), hashlib.sha256(b"seed-a1-a2").hexdigest())
        self.assertEqual(b.hexdigest(), hashlib.sha256(b"seed-b1").hexdigest())
        self.assertEqual(c.hexdigest(), hashlib.sha256(b"seed-c1").hexdigest())
    }

    def test_update_spanning_block_boundaries() {
        const chunk: bytes = b"z" * 61
        h: hashlib.Hash = hashlib.sha384()
        i: int = 0
        while i < 5 {
            h.update(chunk)
            i = i + 1
        }
        self.assertEqual(h.hexdigest(), hashlib.sha384(chunk * 5).hexdigest())
    }
}

main([Md5Tests(), Sha1Tests(), Sha256Tests(), ShaWideTests(), IncrementalUpdatePerfTests(), IncrementalSemanticsTests()])

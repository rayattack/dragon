from unittest import TestCase, main
from time import sleep_ms
from threading import Lock
from json import Data
from fire_readers.reader import count_keys, count_items, longest_key
from fire_readers.reader import count_with_bonus, count_with_tags, make_items

extern "C" def dragon_fire_pool_size() -> int

const SUM_OF_SQUARES_1_TO_50: int = 42925


def square(n: int) -> int {
    return n * n
}


def make_task(n: int) -> Task[int] {
    t: Task[int] = fire square(n)
    return t
}


def consume(task: Task[int]) -> int {
    return await task
}


def make_and_pass(n: int) -> int {
    t: Task[int] = fire square(n)
    return consume(t)
}


def fire_unused(n: int) -> None {
    t: Task[int] = fire square(n)
}


def poll_no_join(n: int) -> int {
    t: Task[int] = fire square(n)
    spins: int = 0
    while t.is_alive() {
        spins = spins + 1
        if spins > 1000000 {
            return spins
        }
    }
    return spins
}


# CONDITIONAL await (the case that used to leak): the await path consumes and empties the slot,
# the drop path frees the still-held handle at scope exit. No leak or double-free on EITHER path.
def conditional(n: int, c: bool) -> int {
    t: Task[int] = fire square(n)
    if c {
        return await t
    }
    return -1
}


def poll_then_await(n: int) -> int {
    t: Task[int] = fire square(n)
    while t.is_alive() {
        sleep_ms(1)
    }
    return await t
}


side_effects: int = 0
effect_lock: Lock = Lock()

def bump_effect() -> None {
    global side_effects
    with effect_lock { side_effects = side_effects + 1 }
}

def read_effects() -> int {
    n: int = 0
    with effect_lock { n = side_effects }
    return n
}

def reset_effects() -> None {
    global side_effects
    with effect_lock { side_effects = 0 }
}

async def make_payload(n: int) -> str {
    return "p" * 64 + str(n)
}

async def effectful(n: int) -> str {
    bump_effect()
    return f"ran:{n}"
}

async def nested_inner(n: int) -> str {
    bump_effect()
    return f"inner:{n}"
}

def wait_for_effects(target: int) -> int {
    waited: int = 0
    while read_effects() < target and waited < 400 {
        sleep_ms(5)
        waited = waited + 1
    }
    return read_effects()
}


def sum_lengths(s: list[str]) -> int {
    n: int = 0
    i: int = 0
    while i < len(s) {
        n = n + len(s[i])
        i = i + 1
    }
    return n
}


def sum_values(d: dict[str, int]) -> int {
    total: int = 0
    total = total + d["a"]
    total = total + d["b"]
    total = total + d["c"]
    return total
}


# fire/thread block capture: referencing an enclosing local used to emit invalid cross-function IR.
# Captured locals marshal as spawn args (read-only borrow); heap captures pin the no-double-free path.

def fire_int_capture() -> int {
    n: int = 10
    t: Task[int] = fire { return n + 1 }
    return t.join()
}

def fire_str_capture() -> int {
    s: str = "hello"
    t: Task[int] = fire { return len(s) }
    return t.join()
}

def fire_no_capture() -> int {
    t: Task[int] = fire { return 42 }
    return t.join()
}

def thread_int_capture() -> int {
    out: list[int] = [0]
    n: int = 5
    thread { out[0] = n * n }
    return out[0]
}

def thread_str_capture() -> int {
    out: list[int] = [0]
    s: str = "dragon"
    thread { out[0] = len(s) }
    return out[0]
}


gate_open: int = 0


def gate_is_open() -> bool {
    n: int = 0
    with effect_lock { n = gate_open }
    return n == 1
}


def open_gate() -> None {
    global gate_open
    with effect_lock { gate_open = 1 }
}


def gated_square(n: int) -> int {
    spins: int = 0
    while not gate_is_open() and spins < 60000 {
        sleep_ms(1)
        spins = spins + 1
    }
    return n * n
}


class TaskBox {
    held: Task[int]

    def (t: Task[int]) {
        self.held = t
    }
}


module_task: Task[int] = fire gated_square(6)
module_pool: list[Task[int]] = [fire gated_square(7)]
module_box: TaskBox = TaskBox(fire gated_square(8))


class ModuleTaskProbe {
    """Every method reads a module-level binding declared before this class."""

    def still_running() -> bool {
        return module_task.is_alive()
    }

    def pooled_running() -> bool {
        return module_pool[0].is_alive()
    }

    def boxed_running() -> bool {
        return module_box.held.is_alive()
    }

    def settled() -> bool {
        spins: int = 0
        while spins < 60000 {
            live: int = 0
            if module_task.is_alive() { live = live + 1 }
            if module_pool[0].is_alive() { live = live + 1 }
            if module_box.held.is_alive() { live = live + 1 }
            if live == 0 { return True }
            sleep_ms(1)
            spins = spins + 1
        }
        return False
    }

    def guarded_sum(a: int, b: int) -> int {
        total: int = 0
        with effect_lock { total = a + b }
        return total
    }
}


class TaskDetachRcTests(TestCase) {
    """Task scope-exit lifetime - bound-Task tail + conditional-await.

    Source of truth: a bound `Task[T]` is owned by its SCOPE. `await t` / `t.join()`
    CONSUME it (the runtime frees the vthread) and codegen then blanks t's slot to
    NULL; at scope exit the scope frees whatever Task is STILL in its slot - i.e. the
    abandoned ones. So:
      - bound + never used        -> abandoned -> scope frees it (no leak)
      - bound + is_alive-polled   -> abandoned -> scope frees it (no leak)
      - bound + await on SOME paths, dropped on others -> the drop path's scope frees
        it; the await path emptied the slot so the scope-exit detach is a no-op (no
        double-free) - this is the conditional-await case that used to leak
      - returned / passed / stored / captured -> TRANSFERRED -> the new owner frees it
    A second `await t` / `t.join()` / `t.is_alive()` after a consume is a compile
    error (the result moves out exactly once); polling BEFORE the await stays legal.
    All cases below are ASan/LSan-clean (no leak, no UAF, no double-free); the
    leak/UAF magnitudes are A/B-proven in the scratch probes.
    """

    def test_returned_task_awaited_by_caller() {
        i: int = 1
        total: int = 0
        while i <= 50 {
            t: Task[int] = make_task(i)
            total = total + await t
            i = i + 1
        }
        self.assertEqual(total, SUM_OF_SQUARES_1_TO_50)
    }

    def test_passed_task_joined_in_callee() {
        total: int = 0
        i: int = 1
        while i <= 50 {
            total = total + make_and_pass(i)
            i = i + 1
        }
        self.assertEqual(total, SUM_OF_SQUARES_1_TO_50)
    }

    def test_straightline_join_still_correct() {
        # await consumes + empties the slot; scope-exit detach is a no-op. Result
        # must be correct and there must be no double-free.
        i: int = 1
        total: int = 0
        while i <= 50 {
            t: Task[int] = fire square(i)
            total = total + await t
            i = i + 1
        }
        self.assertEqual(total, SUM_OF_SQUARES_1_TO_50)
    }

    def test_bound_fire_and_forget_does_not_crash() {
        i: int = 0
        while i < 50 {
            fire_unused(i)
            i = i + 1
        }
        self.assertTrue(True)
    }

    def test_is_alive_poll_no_join_detached() {
        i: int = 0
        while i < 50 {
            const _spins: int = poll_no_join(i)
            i = i + 1
        }
        self.assertTrue(True)
    }

    def test_conditional_await_both_paths() {
        i: int = 1
        awaited: int = 0
        dropped: int = 0
        while i <= 50 {
            awaited = awaited + conditional(i, True)
            dropped = dropped + conditional(i, False)
            i = i + 1
        }
        self.assertEqual(awaited, SUM_OF_SQUARES_1_TO_50)
        self.assertEqual(dropped, -50)
    }

    def test_poll_then_await_no_uaf() {
        i: int = 1
        total: int = 0
        while i <= 50 {
            total = total + poll_then_await(i)
            i = i + 1
        }
        self.assertEqual(total, SUM_OF_SQUARES_1_TO_50)
    }
}


def _joined_text(a: str) -> str {
    return a + "def"
}


def _joined_items(n: int) -> list[int] {
    out: list[int] = []
    i: int = 0
    while i < n {
        out.append(i)
        i = i + 1
    }
    return out
}


class TaskOwnershipTests(TestCase) {
    """Task result ownership (docs/1604 outbound edge): the result slot is an own
    field of the task, join/await moves it out, del detaches, and a task that dies
    unclaimed releases what it still owns. ASan CI proves the release; the value
    assertions here prove the moves and the del path still run the work."""

    def test_joined_str_in_argument_position_is_released() {
        t: Task[str] = fire _joined_text("abc")
        self.assertEqual(t.join(), "abcdef")
    }

    def test_joined_list_in_argument_position_is_released() {
        t: Task[list[int]] = fire _joined_items(5)
        self.assertEqual(len(t.join()), 5)
    }

    def test_await_moves_result_out() {
        got: str = await make_payload(7)
        self.assertEqual(got, "p" * 64 + "7")
    }

    def test_fanout_handles_each_own_their_result() {
        a: Task[str] = make_payload(1)
        b: Task[str] = make_payload(2)
        ra: str = await a
        rb: str = await b
        self.assertEqual(ra, "p" * 64 + "1")
        self.assertEqual(rb, "p" * 64 + "2")
    }

    def test_del_detaches_but_task_still_runs() {
        reset_effects()
        i: int = 0
        while i < 50 {
            t: Task[str] = effectful(i)
            del t
            i = i + 1
        }
        self.assertEqual(wait_for_effects(50), 50)
    }

    def test_dropped_bound_task_still_runs() {
        reset_effects()
        i: int = 0
        while i < 50 {
            t: Task[str] = effectful(i)
            i = i + 1
        }
        self.assertEqual(wait_for_effects(50), 50)
    }

    def test_fire_on_async_def_runs_nested_task() {
        reset_effects()
        fire nested_inner(9)
        self.assertEqual(wait_for_effects(1), 1)
    }

    def test_join_returns_the_moved_value() {
        t: Task[str] = make_payload(3)
        got: str = t.join()
        self.assertEqual(got, "p" * 64 + "3")
    }
}


class FireForgetTests(TestCase) {
    def test_fire_and_forget_runs_and_frees() {
        reset_effects()
        n: int = 0
        while n < 500 {
            fire bump_effect()
            n = n + 1
        }
        self.assertEqual(wait_for_effects(500), 500)
    }
}


class FireReadOnlyShareTests(TestCase) {
    """A read-only value fans out across `fire` at zero copy.

    You want the obvious worker-pool shape - fire one task per worker over the SAME
    shared data, then join them all:

        shared: list[str] = build()
        while w < N {
            t: Task[int] = fire worker(shared)   # every worker READS `shared`
            tasks.append(t)
            w = w + 1
        }
        for t in tasks { total = total + t.join() }

    Before door 5 this was E10 ("'shared' deleted on iteration 1; iteration 2 would
    use a dead name"): the single-task lend could track only ONE outstanding borrow
    and killed `shared` on the back edge. But `fire` already marks every heap arg
    SHARED (atomic refcount via mark_shared_deep), so N tasks reading the same value
    concurrently cannot race on its refcount - and because `worker` provably never
    MUTATES its parameter, there is no data race on its contents either. So it is
    safe to share at zero copy, and no `dub` is needed.

    The invariant this locks in: a plain `fire worker(shared)` that COMPILES is proof
    the worker only reads `shared`. If it mutated, you would have had to say
    `dub shared` (a visible copy) or `own shared` (a move). `dub` stays the marker
    that a copy was needed. Memory-safety of the fan-out is proven under ASan/LSan by
    the scratch probe (12 workers x 3000 reads over 8 shared strings, clean); this
    test locks in the rendered VALUES end to end.
    """

    def test_list_fanout_joins_to_expected_total() {
        shared: list[str] = ["item_a", "item_b", "item_c"]
        tasks: list[Task[int]] = []
        w: int = 0
        while w < 8 {
            t: Task[int] = fire sum_lengths(shared)
            tasks.append(t)
            w = w + 1
        }
        total: int = 0
        for t in tasks {
            total = total + t.join()
        }
        self.assertEqual(total, 144)
    }

    def test_dict_fanout_joins_to_expected_total() {
        cfg: dict[str, int] = {a: 10, b: 20, c: 30}
        tasks: list[Task[int]] = []
        w: int = 0
        while w < 5 {
            t: Task[int] = fire sum_values(cfg)
            tasks.append(t)
            w = w + 1
        }
        total: int = 0
        for t in tasks {
            total = total + t.join()
        }
        self.assertEqual(total, 300)
    }

    def test_imported_reader_shares_dict_of_data() {
        doc: dict[str, Data] = {"name": "auth-api", "replicas": 3, "tags": ["a", "b"]}
        tasks: list[Task[int]] = []
        w: int = 0
        while w < 6 {
            t: Task[int] = fire count_keys(doc)
            tasks.append(t)
            w = w + 1
        }
        total: int = 0
        for t in tasks {
            total = total + t.join()
        }
        self.assertEqual(total, 18)
        self.assertEqual(len(doc), 3)
    }

    def test_imported_reader_shares_list_of_data() {
        items: list[Data] = [1, "two", 3.5, [4], {"five": 5}]
        t: Task[int] = fire count_items(items)
        self.assertEqual(t.join(), 5)
        self.assertEqual(len(items), 5)
    }

    def test_imported_reader_keyword_argument_shares() {
        doc: dict[str, Data] = {"name": "auth-api", "replicas": 3}
        t: Task[int] = fire longest_key(d=doc)
        self.assertEqual(t.join(), 8)
    }

    def test_dub_of_dict_of_data_crosses_fire() {
        doc: dict[str, Data] = {"name": "auth-api", "replicas": 3}
        t: Task[int] = fire count_keys(dub doc)
        doc["mine"] = "kept"
        self.assertEqual(t.join(), 2)
        self.assertEqual(len(doc), 3)
    }

    def test_imported_reader_omitted_default_shares() {
        doc: dict[str, Data] = {"name": "auth-api", "replicas": 3}
        t: Task[int] = fire count_with_bonus(doc)
        self.assertEqual(t.join(), 7)
        u: Task[int] = fire count_with_bonus(doc, bonus=1)
        self.assertEqual(u.join(), 3)
    }

    def test_default_container_is_fresh_per_fire() {
        doc: dict[str, Data] = {"name": "auth-api"}
        i: int = 0
        while i < 500 {
            t: Task[int] = fire count_with_tags(doc)
            self.assertEqual(t.join(), 1)
            i = i + 1
        }
    }

    def test_fresh_result_crosses_fire() {
        i: int = 0
        while i < 500 {
            t: Task[int] = fire count_items(make_items())
            self.assertEqual(t.join(), 3)
            i = i + 1
        }
    }
}


class ModuleTaskInMethodTests(TestCase) {
    """A module-level Task reached from inside a class method.

    The Task receiver used to be classified from a bare-name table that is only
    written when the binding's own statement is lowered, and class bodies are
    lowered before the module body runs. So `module_task.is_alive()` inside a
    method matched no dispatch path and the build stopped on a program that
    `dragon check` had just accepted. The receiver's checked type answers first
    now, so a Task dispatches wherever it is reached from: a module global, an
    element of a module-level list, a field of a module-level instance. The gate
    keeps every handle unfinished until this case opens it, so `is_alive` is
    True by construction rather than by timing.

    `is_alive` observes and moves nothing, so it is legal on every receiver.
    `join` moves the result out exactly once and is legal only through the
    binding that owns the task; the refusals live in TypeCheckerTest.
    """

    def test_module_task_reached_from_a_method() {
        probe: ModuleTaskProbe = ModuleTaskProbe()
        self.assertTrue(probe.still_running())
        self.assertTrue(probe.pooled_running())
        self.assertTrue(probe.boxed_running())
        self.assertEqual(probe.guarded_sum(20, 22), 42)
        open_gate()
        self.assertTrue(probe.settled())
    }
}


class ConcurrencyCaptureTests(TestCase) {
    def test_fire_captures_int() { self.assertEqual(fire_int_capture(), 11) }
    def test_fire_captures_str() { self.assertEqual(fire_str_capture(), 5) }
    def test_fire_no_capture() { self.assertEqual(fire_no_capture(), 42) }
    def test_thread_captures_int() { self.assertEqual(thread_int_capture(), 25) }
    def test_thread_captures_str() { self.assertEqual(thread_str_capture(), 6) }
}


def deep_sum(depth: int) -> int {
    if depth <= 0 {
        return 0
    }
    return depth + deep_sum(depth - 1)
}


def shallow_mark(n: int) -> int {
    return n * 2 + 1
}


def raiser_then_value(n: int) -> int {
    try {
        if n % 2 == 0 {
            raise ValueError("even")
        }
        return n
    } except ValueError as e {
        return -n
    }
}


def park_then_value(n: int) -> int {
    sleep_ms(1)
    return n
}


def counter_upto(n: int) {
    k: int = 0
    while k < n {
        yield k
        k = k + 1
    }
}


def drain_counter(n: int) -> int {
    t: int = 0
    for v in counter_upto(n) {
        t = t + v
    }
    return t
}


class CoroutineRecycleTests(TestCase) {
    """Every `fire` and every generator runs on its own coroutine stack, and the
    runtime is free to hand a finished task's stack to the next one.

    You write the obvious thing - fire a task, join it, fire another - and never
    see the stack at all. Recycling is invisible by contract: a reused stack still
    carries the last task's bytes, its exception landing pads and its parked
    frames, so the axes below pin the values end to end. A wrong answer here means
    a task read what the task before it left behind.
    """

    def test_deep_then_shallow_alternating() {
        i: int = 0
        while i < 300 {
            deep: Task[int] = fire deep_sum(2000)
            self.assertEqual(deep.join(), 2001000)
            small: Task[int] = fire shallow_mark(i)
            self.assertEqual(small.join(), i * 2 + 1)
            i = i + 1
        }
    }

    def test_sequential_churn_keeps_every_result() {
        i: int = 0
        total: int = 0
        while i < 2000 {
            t: Task[int] = fire shallow_mark(i)
            total = total + t.join()
            i = i + 1
        }
        self.assertEqual(total, 4000000)
    }

    def test_exception_landing_pads_survive_reuse() {
        i: int = 0
        total: int = 0
        while i < 2000 {
            t: Task[int] = fire raiser_then_value(i)
            total = total + t.join()
            i = i + 1
        }
        self.assertEqual(total, 1000)
    }

    def test_parked_tasks_reuse_cleanly() {
        i: int = 0
        total: int = 0
        while i < 300 {
            t: Task[int] = fire park_then_value(i)
            total = total + t.join()
            i = i + 1
        }
        self.assertEqual(total, 44850)
    }

    def test_generators_and_fires_share_the_pool() {
        i: int = 0
        total: int = 0
        while i < 500 {
            total = total + drain_counter(20)
            t: Task[int] = fire shallow_mark(1)
            total = total + t.join()
            i = i + 1
        }
        self.assertEqual(total, 96500)
    }

    def test_concurrent_wave_joins_in_order() {
        tasks: list[Task[int]] = []
        w: int = 0
        while w < 300 {
            tasks.append(fire deep_sum(500))
            w = w + 1
        }
        total: int = 0
        for t in tasks {
            total = total + t.join()
        }
        self.assertEqual(total, 37575000)
    }

    def test_finished_stacks_return_to_a_bounded_pool() {
        tasks: list[Task[int]] = []
        w: int = 0
        while w < 400 {
            tasks.append(fire shallow_mark(w))
            w = w + 1
        }
        for t in tasks {
            t.join()
        }
        self.assertLessEqual(float(dragon_fire_pool_size()), 64.0,
                             "finished coroutine stacks grew past the pool cap")
    }

    def test_nested_spawn_from_a_carrier() {
        i: int = 0
        total: int = 0
        while i < 500 {
            t: Task[int] = fire make_and_pass(i)
            total = total + t.join()
            i = i + 1
        }
        self.assertEqual(total, 41541750)
    }
}


def linger_holding_a_string() -> int {
    held: str = "still-parked-at-exit"
    sleep_ms(4000)
    return len(held)
}


lingering: Task[int] = fire linger_holding_a_string()


class LingeringFireTests(TestCase) {
    """A fire that is still parked when main returns keeps a live execution
    context: its args block and whatever its stack holds. Those are reachable
    from a running coroutine, so a leak report here means the checker cannot
    see that context, not that the program lost memory."""

    def test_a_still_parked_fire_is_alive_not_leaked() {
        quick: Task[int] = fire square(6)
        self.assertEqual(quick.join(), 36)
    }
}


main([ModuleTaskInMethodTests(), TaskDetachRcTests(), TaskOwnershipTests(),
      FireForgetTests(), FireReadOnlyShareTests(), ConcurrencyCaptureTests(),
      CoroutineRecycleTests(), LingeringFireTests()])

# Pre-fix: dragon_nb_recv_str malloc'd max_len + 1 unchecked, so a huge
# recv size wrote the NUL terminator through a NULL buffer (SIGSEGV), and
# max_len == INT64_MAX wrapped the +1 before that. recv_bytes/recv_timeout
# shared the unchecked malloc. All three now raise catchable MemoryError
# before touching the socket, so the connection stays usable. The 2^62
# request is deterministic uncapped: no 64-bit VA space can map it.

from unittest import TestCase, main
from socket import TcpListener, TcpStream


def _peer(l: TcpListener) -> None {
    conn: TcpStream = l.do_accept()
    conn.do_send("hello")
    conn.do_recv(16)
    conn.close()
}


class SocketRecvOomTests(TestCase) {
    def test_recv_size_failure_raises_not_segv() -> None {
        lis: TcpListener = TcpListener("127.0.0.1", 54483)
        lis.do_bind()
        lis.do_listen(4)
        t: Task[None] = fire _peer(lis)
        c: TcpStream = TcpStream.open("127.0.0.1", 54483)

        caught: int = 0
        try {
            s: str = c.do_recv(4611686018427387904)
            print(len(s))
        } except MemoryError {
            caught = caught + 1
        }
        try {
            s2: str = c.do_recv(9223372036854775807)    # the +1 wrap case
            print(len(s2))
        } except MemoryError {
            caught = caught + 1
        }
        try {
            bs: bytes = c.recv_bytes(4611686018427387904)
            print(len(bs))
        } except MemoryError {
            caught = caught + 1
        }
        try {
            bt: bytes = c.recv_timeout(4611686018427387904, 200)
            print(len(bt))
        } except MemoryError {
            caught = caught + 1
        }
        self.assertEqual(caught, 4)

        # The connection survives every failed receive.
        got: str = c.do_recv(16)
        self.assertEqual(got, "hello")
        c.do_send("bye")
        c.close()
    }
}

main([SocketRecvOomTests()])


from unittest import TestCase, main
from socket import TcpListener, TcpStream


def _peer(l: TcpListener) -> None {
    conn: TcpStream = l.accept()
    conn.send("hello")
    conn.recv(16)
    conn.close()
}


class SocketRecvOomTests(TestCase) {
    def test_recv_size_failure_raises_not_segv() -> None {
        lis: TcpListener = TcpListener("127.0.0.1", 54483)
        lis.bind()
        lis.listen(4)
        t: Task[None] = fire _peer(lis)
        c: TcpStream = TcpStream.open("127.0.0.1", 54483)

        caught: int = 0
        try {
            s: str = c.recv(4611686018427387904)
            print(len(s))
        } except MemoryError {
            caught = caught + 1
        }
        try {
            s2: str = c.recv(9223372036854775807)
            print(len(s2))
        } except MemoryError {
            caught = caught + 1
        }
        try {
            bs: bytes = c.recv_bytes(4611686018427387904)
            print(len(bs))
        } except MemoryError {
            caught = caught + 1
        }
        try {
            bt: bytes = c.recv_timeout(4611686018427387904, 200)
            print(len(bt))
        } except MemoryError {
            caught = caught + 1
        }
        self.assertEqual(caught, 4)

        got: str = c.recv(16)
        self.assertEqual(got, "hello")
        c.send("bye")
        c.close()
    }
}

main([SocketRecvOomTests()])


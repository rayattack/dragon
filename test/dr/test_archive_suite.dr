from unittest import TestCase, main
import zipfile
from zipfile import open as zip_open, ZipFile
from tarfile import open as tar_open, TarFile, TarInfo
from tempfile import mkdtemp
import os
from os import makedirs
from os.path import join, exists
import shutil
import binascii
import struct


extern "C" def dragon_read_file_bytes(path: str) -> bytes


const _ROOT: str = "/tmp/dr_zipfile_test"


def _compressible() -> bytes {
    parts: list[int] = []
    i: int = 0
    while i < 2000 {
        parts.append(0x41)
        i = i + 1
    }
    return bytes(parts)
}


def _binary() -> bytes {
    return bytes([0, 255, 13, 10, 0x48, 0x69, 0, 254, 127, 128, 65, 66, 67])
}


class ZipFileTests(TestCase) {
    """zipfile - PKWARE ZIP read/write round-trip + binary fidelity + CRC.

    Builds a real .zip on disk with a STORED entry, a DEFLATED entry (highly
    compressible text), and a binary entry carrying 0x00 / 0xFF / embedded data;
    closes it; reopens it; and asserts namelist + infolist match, every payload
    reads back byte-for-byte, the CRC validates (read() raises on mismatch), and
    the deflated entry's compress_size is strictly smaller than its file_size for
    compressible input. Also checks the on-disk signatures (local 0x04034b50,
    end-of-central-directory 0x06054b50) are present, proving a conforming PKWARE
    container - not just a self-consistent blob."""

    def _archive_path() -> str {
        return join(_ROOT, "round.zip")
    }

    def _build() -> str {
        if exists(_ROOT) {
            shutil.rmtree(_ROOT)
        }
        os.mkdir(_ROOT, 0o755)
        path: str = self._archive_path()

        zf: zipfile.ZipFile = zipfile.open(path, "w")
        zf.writestr("stored.txt", "hi".encode("utf-8"), zipfile.ZIP_STORED)
        zf.writestr("deflated.txt", _compressible(), zipfile.ZIP_DEFLATED)
        zf.writestr("blob.bin", _binary(), zipfile.ZIP_DEFLATED)
        zf.close()
        return path
    }

    def test_namelist_and_count() {
        path: str = self._build()
        zf: zipfile.ZipFile = zipfile.open(path, "r")
        names: list[str] = zf.namelist()
        self.assertEqual(len(names), 3)
        self.assertEqual(names[0], "stored.txt")
        self.assertEqual(names[1], "deflated.txt")
        self.assertEqual(names[2], "blob.bin")
        infos: list[zipfile.ZipInfo] = zf.infolist()
        self.assertEqual(len(infos), 3)
        zf.close()
        shutil.rmtree(_ROOT)
    }

    def test_stored_roundtrip() {
        path: str = self._build()
        zf: zipfile.ZipFile = zipfile.open(path, "r")
        got: bytes = zf.read("stored.txt")
        self.assertEqual(got.decode("utf-8"), "hi")
        info: zipfile.ZipInfo = zf.getinfo("stored.txt")
        self.assertEqual(info.compress_type, zipfile.ZIP_STORED)
        self.assertEqual(info.file_size, 2)
        self.assertEqual(info.compress_size, 2)
        zf.close()
        shutil.rmtree(_ROOT)
    }

    def test_deflated_roundtrip_and_smaller() {
        path: str = self._build()
        original: bytes = _compressible()
        zf: zipfile.ZipFile = zipfile.open(path, "r")
        got: bytes = zf.read("deflated.txt")
        self.assertEqual(len(got), len(original))
        i: int = 0
        while i < len(original) {
            self.assertEqual(got[i], original[i])
            i = i + 1
        }
        info: zipfile.ZipInfo = zf.getinfo("deflated.txt")
        self.assertEqual(info.compress_type, zipfile.ZIP_DEFLATED)
        self.assertEqual(info.file_size, len(original))
        self.assertTrue(info.compress_size < info.file_size)
        zf.close()
        shutil.rmtree(_ROOT)
    }

    def test_binary_survives_verbatim() {
        path: str = self._build()
        payload: bytes = _binary()
        zf: zipfile.ZipFile = zipfile.open(path, "r")
        got: bytes = zf.read("blob.bin")
        self.assertEqual(len(got), len(payload))
        j: int = 0
        while j < len(payload) {
            self.assertEqual(got[j], payload[j])
            j = j + 1
        }
        self.assertEqual(got[0], 0)
        self.assertEqual(got[1], 255)
        self.assertEqual(got[6], 0)
        self.assertEqual(got[7], 254)
        self.assertEqual(got[9], 128)
        zf.close()
        shutil.rmtree(_ROOT)
    }

    def test_crc_matches_binascii() {
        path: str = self._build()
        zf: zipfile.ZipFile = zipfile.open(path, "r")
        data: bytes = zf.read("deflated.txt")
        info: zipfile.ZipInfo = zf.getinfo("deflated.txt")
        self.assertEqual(info.CRC, binascii.crc32(data, 0))
        zf.close()
        shutil.rmtree(_ROOT)
    }

    def test_signatures_present() {
        path: str = self._build()
        raw: bytes = dragon_read_file_bytes(path)
        self.assertEqual(struct.unpack_u32_le(raw, 0), 0x04034b50)
        eocd_at: int = len(raw) - 22
        self.assertEqual(struct.unpack_u32_le(raw, eocd_at), 0x06054b50)
        shutil.rmtree(_ROOT)
    }

    def test_extract_writes_file() {
        path: str = self._build()
        zf: zipfile.ZipFile = zipfile.open(path, "r")
        out_dir: str = join(_ROOT, "out")
        os.mkdir(out_dir, 0o755)
        target: str = zf.extract("deflated.txt", out_dir)
        self.assertTrue(exists(target))
        on_disk: bytes = dragon_read_file_bytes(target)
        self.assertEqual(len(on_disk), len(_compressible()))
        zf.close()
        shutil.rmtree(_ROOT)
    }

    def test_missing_name_raises() {
        path: str = self._build()
        zf: zipfile.ZipFile = zipfile.open(path, "r")
        raised: bool = false
        try {
            zf.read("nope.txt")
        } except KeyError {
            raised = true
        }
        self.assertTrue(raised)
        zf.close()
        shutil.rmtree(_ROOT)
    }
}


def _write_hostile_tar(path: str, member_name: str) {
    const t: TarFile = tar_open(path, "w")
    info: TarInfo = TarInfo(member_name)
    info.data = b"escaped\n"
    info.size = len(info.data)
    t.addfile(info)
    t.close()
}


class TarTraversalTests(TestCase) {
    def test_dotdot_member_is_refused() {
        const tmp: str = mkdtemp("dragon-slip-", "")
        const deep: str = join(join(tmp, "root"), join("deep", "deeper"))
        makedirs(deep)
        const arc: str = join(tmp, "hostile.tar")
        _write_hostile_tar(arc, "../../ESCAPED.txt")

        const t: TarFile = tar_open(arc, "r")
        def run() {
            t.extractall(deep)
        }
        self.assertRaises(ValueError, run)
        t.close()

        self.assertFalse(exists(join(join(tmp, "root"), "ESCAPED.txt")),
                         "member escaped the extraction directory")
    }

    def test_absolute_member_is_refused() {
        const tmp: str = mkdtemp("dragon-slip-abs-", "")
        const dest: str = join(tmp, "dest")
        makedirs(dest)
        const arc: str = join(tmp, "hostile-abs.tar")
        _write_hostile_tar(arc, "/tmp/DRAGON_ABS_ESCAPE.txt")

        const t: TarFile = tar_open(arc, "r")
        def run() {
            t.extractall(dest)
        }
        self.assertRaises(ValueError, run)
        t.close()

        self.assertFalse(exists("/tmp/DRAGON_ABS_ESCAPE.txt"),
                         "absolute member name escaped to an absolute path")
    }

    def test_ordinary_member_still_extracts() {
        const tmp: str = mkdtemp("dragon-ok-", "")
        const dest: str = join(tmp, "dest")
        makedirs(dest)
        const arc: str = join(tmp, "fine.tar")
        _write_hostile_tar(arc, "sub/ok.txt")

        const t: TarFile = tar_open(arc, "r")
        t.extractall(dest)
        t.close()

        self.assertTrue(exists(join(dest, join("sub", "ok.txt"))),
                        "a legitimate member failed to extract")
    }

    def test_interior_dotdot_that_stays_inside_is_allowed() {
        const tmp: str = mkdtemp("dragon-interior-", "")
        const dest: str = join(tmp, "dest")
        makedirs(dest)
        const arc: str = join(tmp, "interior.tar")
        _write_hostile_tar(arc, "sub/../ok.txt")

        const t: TarFile = tar_open(arc, "r")
        t.extractall(dest)
        t.close()

        self.assertTrue(exists(join(dest, "ok.txt")),
                        "an interior '..' that stays inside was wrongly refused")
    }
}


class ZipTraversalTests(TestCase) {
    def test_dotdot_entry_is_refused() {
        const tmp: str = mkdtemp("dragon-zipslip-", "")
        const deep: str = join(join(tmp, "root"), join("deep", "deeper"))
        makedirs(deep)
        const arc: str = join(tmp, "hostile.zip")

        const w: ZipFile = zip_open(arc, "w")
        w.writestr("../../ZIP_ESCAPED.txt", b"escaped\n")
        w.close()

        const z: ZipFile = zip_open(arc, "r")
        def run() {
            z.extractall(deep)
        }
        self.assertRaises(ValueError, run)
        z.close()

        self.assertFalse(exists(join(join(tmp, "root"), "ZIP_ESCAPED.txt")),
                         "zip entry escaped the extraction directory")
    }

    def test_ordinary_entry_still_extracts() {
        const tmp: str = mkdtemp("dragon-zipok-", "")
        const dest: str = join(tmp, "dest")
        makedirs(dest)
        const arc: str = join(tmp, "fine.zip")

        const w: ZipFile = zip_open(arc, "w")
        w.writestr("sub/ok.txt", b"fine\n")
        w.close()

        const z: ZipFile = zip_open(arc, "r")
        z.extractall(dest)
        z.close()

        self.assertTrue(exists(join(dest, join("sub", "ok.txt"))),
                        "a legitimate zip entry failed to extract")
    }
}


class ChecksumTests(TestCase) {
    """binascii CRC-32 and CRC-32C - known answers, the chaining law, the
    8-byte fast path with every tail length, odb's page-plus-trailer shape,
    the out-of-range guards, and agreement with a pure-Dragon table loop."""

    def _reference_table() -> list[int] {
        t: list[int] = [0] * 256
        n: int = 0
        while n < 256 {
            c: int = n
            k: int = 0
            while k < 8 {
                if (c & 1) != 0 {
                    c = (c >> 1) ^ 0x82F63B78
                } else {
                    c = c >> 1
                }
                k = k + 1
            }
            t[n] = c
            n = n + 1
        }
        return t
    }

    def _reference(data: bytes, value: int) -> int {
        table: list[int] = self._reference_table()
        c: int = (value ^ 0xFFFFFFFF) & 0xFFFFFFFF
        i: int = 0
        n: int = len(data)
        while i < n {
            idx: int = (c ^ data[i]) & 0xFF
            c = (table[idx] ^ (c >> 8)) & 0xFFFFFFFF
            i = i + 1
        }
        return (c ^ 0xFFFFFFFF) & 0xFFFFFFFF
    }

    def _pattern(n: int) -> bytes {
        out: list[int] = [0] * n
        i: int = 0
        while i < n {
            out[i] = (i * 7 + 3) & 0xFF
            i = i + 1
        }
        return bytes(out)
    }

    def _pseudo_random(n: int, seed: int) -> bytes {
        out: list[int] = [0] * n
        state: int = seed
        i: int = 0
        while i < n {
            state = (state * 1103515245 + 12345) & 0x7FFFFFFF
            out[i] = (state >> 16) & 0xFF
            i = i + 1
        }
        return bytes(out)
    }

    def test_crc32c_check_vector() {
        self.assertEqual(binascii.crc32c(b"123456789"), 0xE3069283)
    }

    def test_crc32_check_vector() {
        self.assertEqual(binascii.crc32(b"123456789"), 0xCBF43926)
    }

    def test_empty_and_single_byte() {
        self.assertEqual(binascii.crc32c(b""), 0)
        self.assertEqual(binascii.crc32(b""), 0)
        self.assertEqual(binascii.crc32c(b"a"), 0xC1D04330)
        self.assertEqual(binascii.crc32(b"a"), 0xE8B7BE43)
    }

    def test_seed_carries_like_python() {
        const data: bytes = self._pattern(300)
        const head: int = binascii.crc32c(data[0:100])
        self.assertEqual(binascii.crc32c(data[100:300], head), binascii.crc32c(data))
    }

    def test_range_covers_whole_buffer() {
        const data: bytes = self._pattern(777)
        self.assertEqual(binascii.crc32c_range(data, 0, 777, 0), binascii.crc32c(data))
    }

    def test_chaining_law_with_midpoint_and_empty_range() {
        const data: bytes = self._pattern(1000)
        const whole: int = binascii.crc32c(data)
        const a: int = binascii.crc32c_range(data, 0, 137, 0)
        const b: int = binascii.crc32c_range(data, 137, 0, a)
        const c: int = binascii.crc32c_range(data, 137, 400, b)
        const d: int = binascii.crc32c_range(data, 537, 463, c)
        self.assertEqual(b, a)
        self.assertEqual(d, whole)
    }

    def test_every_tail_length() {
        n: int = 0
        while n <= 19 {
            const chunk: bytes = self._pattern(n)
            self.assertEqual(binascii.crc32c(chunk), self._reference(chunk, 0),
                             f"crc32c disagrees with the table loop at length {n}")
            n = n + 1
        }
    }

    def test_unaligned_start_every_offset() {
        const data: bytes = self._pattern(64)
        start: int = 0
        while start < 8 {
            self.assertEqual(binascii.crc32c_range(data, start, 64 - start, 0),
                             self._reference(data[start:64], 0),
                             f"crc32c_range disagrees at start {start}")
            start = start + 1
        }
    }

    def test_odb_page_with_trailer_prefix() {
        const page: bytes = self._pattern(12) + bytes([0] * 4080)
        self.assertEqual(len(page), 4092)
        const trailer: int = binascii.crc32c_range(page, 0, 12, 0)
        const both: int = binascii.crc32c_range(page, 12, 4080, trailer)
        self.assertEqual(both, binascii.crc32c(page))
        self.assertEqual(both, self._reference(page, 0))
    }

    def test_negative_start_raises() {
        const data: bytes = self._pattern(32)
        def run() {
            binascii.crc32c_range(data, -1, 4, 0)
        }
        self.assertRaises(IndexError, run)
    }

    def test_negative_length_raises() {
        const data: bytes = self._pattern(32)
        def run() {
            binascii.crc32c_range(data, 4, -1, 0)
        }
        self.assertRaises(IndexError, run)
    }

    def test_range_past_the_end_raises() {
        const data: bytes = self._pattern(32)
        def run() {
            binascii.crc32c_range(data, 30, 4, 0)
        }
        self.assertRaises(IndexError, run)
    }

    def test_agrees_with_reference_on_random_data() {
        seed: int = 1
        while seed <= 8 {
            const data: bytes = self._pseudo_random(255 + seed * 37, seed)
            self.assertEqual(binascii.crc32c(data), self._reference(data, 0),
                             f"crc32c disagrees with the table loop for seed {seed}")
            const head: int = binascii.crc32c_range(data, 0, 61, 0)
            self.assertEqual(binascii.crc32c_range(data, 61, len(data) - 61, head),
                             self._reference(data, 0),
                             f"chained crc32c_range disagrees for seed {seed}")
            seed = seed + 1
        }
    }
}


main([ZipFileTests(), TarTraversalTests(), ZipTraversalTests(), ChecksumTests()])

type Boxed = int | float | bool | str | bytes | none | list[int] | list[str] | list[Boxed] | dict[str, int] | dict[str, str] | dict[str, Boxed]

from unittest import TestCase, main
from math import sqrt as root
from math import isqrt as iq
from string import zfill, capwords


class IssubclassTests(TestCase) {
    """Regression tests from a compiler bug-fix campaign.

    Covers the runtime-behavior fixes (the check-time-only diagnostics - L4, M1,
    M2, M3, C9 - are compile errors, not runtime behavior, so they're verified by
    their repros in the campaign, not here):

      H5  - set ordering operators (< <= > >=), single and chained
      issubclass - single-inheritance hierarchy fold
      C4  - len()/repr of inline set-method results (union/intersection/.../copy)
      C5  - nested-container repr (list of list/dict, dict of list)
      L3  - partition()/rpartition() return a 3-tuple
      map - map(f, xs) over int/float/str callables
      H12 - ternary expressions with mixed-type arms (no crash, correct value)
      object - `object` annotation behaves as Boxed
    """

    def test_hierarchy() {
        self.assertTrue(issubclass(Dog, Animal))
        self.assertFalse(issubclass(Animal, Dog))
        self.assertTrue(issubclass(Dog, Dog))
        # There is no universal base class in Dragon, so there is no
        # `issubclass(X, object)` to assert: a class is related only to the
        # classes it actually declares.
        self.assertFalse(issubclass(Cat, Dog))
    }
}


class Animal {
    def() { }
}
class Dog(Animal) {
    def() { }
}
class Cat(Animal) {
    def() { }
}


class NestedReprTests(TestCase) {
    def test_dict_of_list() {
        d: dict[str, list[int]] = {"a": [1, 2]}
        self.assertEqual(str(d), "{'a': [1, 2]}")
    }
}


class PartitionTests(TestCase) {
    def test_partition_tuple() {
        self.assertEqual(str("k=v".partition("=")), "('k', '=', 'v')")
        self.assertEqual(str("no-sep".partition("=")), "('no-sep', '', '')")
    }

    def test_rpartition_and_unpack() {
        k, sep, v = "name=dragon".partition("=")
        self.assertEqual(k, "name")
        self.assertEqual(v, "dragon")
    }
}


def dbl(x: int) -> int {
    return x * 2
}
def halve(x: int) -> float {
    return x / 2.0
}


class MapTests(TestCase) {
    def test_map_int() {
        nums: list[int] = [1, 2, 3]
        r: list[int] = map(dbl, nums)
        self.assertEqual(r[0], 2)
        self.assertEqual(r[1], 4)
        self.assertEqual(r[2], 6)
    }

    def test_map_float() {
        nums: list[int] = [2, 4]
        r: list[float] = map(halve, nums)
        self.assertEqual(r[0], 1.0)
        self.assertEqual(r[1], 2.0)
    }
}


class TernaryTests(TestCase) {
    def test_numeric() {
        n: int = 5
        i: int = 7 if n > 0 else 9
        self.assertEqual(i, 7)
        f: float = 1.5 if n > 0 else 3
        self.assertEqual(f, 1.5)
        g: float = 1.5 if n < 0 else 3
        self.assertEqual(g, 3.0)
    }

    def test_str_int_to_any() {
        n: int = 5
        s: Boxed = "yes" if n > 0 else n
        self.assertEqual(s, "yes")
    }

    def test_str_none() {
        n: int = 5
        x: Boxed = "x" if n > 0 else None
        self.assertEqual(x, "x")
        y: Boxed = "x" if n < 0 else None
        self.assertIsNone(y)
    }

    def test_object_alias() {
        v: Boxed = "hi"
        self.assertEqual(v, "hi")
    }
}


_handlers: dict[str, Callable[[int], int]] = {}

def register(name: str) -> Callable[[Callable[[int], int]], Callable[[int], int]] {
    def deco(fn: Callable[[int], int]) -> Callable[[int], int] {
        global _handlers
        _handlers[name] = fn
        return fn
    }
    return deco
}

@register("square")
def reg_square(x: int) -> int { return x * x }

def multiply(factor: int) -> Callable[[Callable[[int], int]], Callable[[int], int]] {
    def deco(fn: Callable[[int], int]) -> Callable[[int], int] {
        def wrapper(x: int) -> int { return fn(x) * factor }
        return wrapper
    }
    return deco
}

@multiply(10)
def inc(x: int) -> int { return x + 1 }

def tag(label: str) -> Callable[[Callable[[int], int]], Callable[[int], int]] {
    def deco(fn: Callable[[int], int]) -> Callable[[int], int] { return fn }
    return deco
}

@tag("noop")
def tagged_square(x: int) -> int { return x * x }


class DecoratorFactoryTests(TestCase) {
    def test_capturing_factory_registers_and_calls() {
        self.assertEqual(_handlers["square"](6), 36)
        self.assertEqual(reg_square(6), 36)
    }

    def test_wrapping_factory() {
        self.assertEqual(inc(4), 50)
    }

    def test_non_capturing_factory() {
        self.assertEqual(tagged_square(6), 36)
    }
}


class NumericBuiltins(TestCase) {
    """Regression tests for the builtin/codegen quick-wins pass.

    Each block guards a root-caused-and-fixed language gap:
      1. pow / round / divmod were rejected by Sema ("undefined name") even though
         CodeGen handlers existed; divmod additionally printed garbage because it
         was typed list[any] instead of tuple[int,int].
      2. `from math import sqrt as root` failed codegen ("Unknown function: root")
         because the alias bucket mapped the rename to the per-module-mangled
         symbol while the extern "C" function keeps its bare C symbol.
      3. `del d[key]` was a no-op (no SubscriptExpr branch / no runtime delete).
      4. abs(float) and `int ** float` hit LLVM verify failures (int-only codegen
         paths fed f64 operands).
    """

    def test_pow() {
        self.assertEqual(pow(2, 10), 1024)
        self.assertEqual(pow(3, 0), 1)
    }

    def test_round() {
        self.assertEqual(round(2.7), 3)
        self.assertEqual(round(2.4), 2)
    }

    def test_divmod_tuple() {
        q, r = divmod(17, 5)
        self.assertEqual(q, 3)
        self.assertEqual(r, 2)
    }

    def test_divmod_floor_semantics() {
        q, r = divmod(-7, 3)
        self.assertEqual(q, -3)
        self.assertEqual(r, 2)
    }
}


class ImportAlias(TestCase) {
    def test_extern_c_alias() {
        self.assertAlmostEqual(root(16.0), 4.0)
    }

    def test_dr_function_alias() {
        self.assertEqual(iq(17), 4)
    }
}


class DictDelete(TestCase) {
    def test_del_str_keyed() {
        d: dict[str, int] = {"a": 1, "b": 2, "c": 3}
        del d["b"]
        self.assertEqual(len(d), 2)
        self.assertTrue("a" in d)
        self.assertFalse("b" in d)
        self.assertEqual(d["c"], 3)
    }

    def test_del_int_keyed() {
        di: dict[int, str] = {1: "x", 2: "y", 3: "z"}
        del di[2]
        self.assertEqual(len(di), 2)
        self.assertFalse(2 in di)
        self.assertEqual(di[3], "z")
    }

    def test_del_str_value_no_corruption() {
        ds: dict[str, str] = {"k1": "v1", "k2": "v2"}
        del ds["k1"]
        self.assertEqual(len(ds), 1)
        self.assertEqual(ds["k2"], "v2")
    }
}


class FloatNumerics(TestCase) {
    def test_abs_float() {
        self.assertAlmostEqual(abs(-3.5), 3.5)
        self.assertAlmostEqual(abs(3.5), 3.5)
    }

    def test_abs_int() {
        self.assertEqual(abs(-7), 7)
        self.assertEqual(abs(7), 7)
    }

    def test_int_pow_float() {
        const n: int = 9
        self.assertAlmostEqual(n ** 0.5, 3.0)
    }

    def test_float_pow() {
        self.assertAlmostEqual(2.0 ** 0.5, 1.4142135, 5)
        self.assertAlmostEqual(2.0 ** 10.0, 1024.0)
    }
}


class ZfillTests(TestCase) {
    def test_negative_sign_stays_leading() {
        self.assertEqual(zfill("-5", 4), "-005")
        self.assertEqual(zfill("-42", 5), "-0042")
    }

    def test_plus_sign_stays_leading() {
        self.assertEqual(zfill("+5", 4), "+005")
    }

    def test_no_padding_needed() {
        self.assertEqual(zfill("-42", 2), "-42")
        self.assertEqual(zfill("-42", 3), "-42")
    }

    def test_bare_sign() {
        self.assertEqual(zfill("-", 3), "-00")
        self.assertEqual(zfill("+", 2), "+0")
    }

    def test_unsigned_unchanged() {
        self.assertEqual(zfill("42", 5), "00042")
        self.assertEqual(zfill("", 3), "000")
    }
}


class CapwordsTests(TestCase) {
    def test_leading_whitespace_dropped() {
        self.assertEqual(capwords(" hello"), "Hello")
        self.assertEqual(capwords("  hello world"), "Hello World")
    }

    def test_trailing_and_repeated_whitespace_dropped() {
        self.assertEqual(capwords("hello  world  "), "Hello World")
    }

    def test_tabs_and_newlines_split() {
        self.assertEqual(capwords("a\tb\nc"), "A B C")
    }

    def test_plain() {
        self.assertEqual(capwords("hello world"), "Hello World")
        self.assertEqual(capwords(""), "")
    }
}


main([IssubclassTests(), NestedReprTests(), PartitionTests(), MapTests(),
      TernaryTests(), DecoratorFactoryTests(), NumericBuiltins(), ImportAlias(),
      DictDelete(), FloatNumerics(), ZfillTests(), CapwordsTests()])

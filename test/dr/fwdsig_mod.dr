# Helper module for test_fwd_import_sig.dr. The load-bearing shape:
# build_bundle FORWARD-calls collect (defined below it), and collect's
# parameter type is a class imported from another module.


from fwdsig_store import fwd_connect, FwdStore


def build_bundle(path: str) -> dict[str, Any] {
    src: FwdStore = fwd_connect(path)
    const bundle: dict[str, Any] = {
        rows: collect(src, "x")
    }
    src.close()
    return bundle
}


def collect(src: FwdStore, name: str) -> list[dict[str, Any]] {
    out: list[dict[str, Any]] = []
    out.append({a: src.n})
    return out
}

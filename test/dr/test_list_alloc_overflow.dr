# test/dr/test_list_alloc_overflow.dr - `list * n` must never undersize its buffer.
#
# Pre-fix, `[1] * n` with n = 2^61+2 cleared dragon_list_repeat's
# `count > INT64_MAX / size` element-count guard, then capacity(2^61+2) *
# elem_size(8) WRAPPED inside dragon_list_new_tagged: malloc served 16 bytes
# (24 usable), returned a valid heap pointer, and the repeat memcpy then marched
# 2.3 quintillion elements through the heap. Verified under gdb - a controlled
# heap overflow, not an allocation failure.
#
# Two distinct halves are pinned here, because fixing only one leaves a hole:
#   1. WRAP  - the byte count is a lie. Trapped by dragon_alloc_bytes.
#   2. NULL  - the byte count is honest but unservable (2^40 elems = 8TB).
#              malloc returns NULL and the old code wrote straight through it
#              at an attacker-scaled offset. Trapped by dragon_xmalloc.
# Both must surface as a CATCHABLE MemoryError, never a SIGSEGV

from unittest import TestCase, main

# Kept behind a call so nothing can constant-fold the count at the use site.
def wrapping_count() -> int {
    base: int = 2305843009213693952   # 2^61; * 8 == 2^64 -> wraps to 0
    return base + 2                   # -> a 16-byte request
}

def unservable_count() -> int {
    return 1099511627776              # 2^40 elems * 8B = 8TB, no wrap
}

class ListAllocOverflowTests(TestCase) {
    def test_repeat_wrapping_count_raises() {
        def run() -> None {
            xs: list[int] = [1] * wrapping_count()
        }
        self.assertRaises(MemoryError, run)
    }

    def test_repeat_unservable_count_raises() {
        def run() -> None {
            xs: list[int] = [1] * unservable_count()
        }
        self.assertRaises(MemoryError, run)
    }

    # bool lists use the 1-byte stride and the memset fast path, so they wrap at
    # a different count - the trap must be on the byte count, not a hardcoded
    # per-tag threshold.
    def test_repeat_bool_unservable_raises() {
        def run() -> None {
            flags: list[bool] = [True] * unservable_count()
        }
        self.assertRaises(MemoryError, run)
    }

    # list[Any] is a DragonListBox: 16B stride, so it wraps at 2^60, not 2^61.
    # A trap written against the 8B layout would miss this one entirely.
    def test_repeat_box_wrapping_count_raises() {
        def run() -> None {
            src: list[Any] = [1]
            xs: list[Any] = src * 1152921504606846978   # 2^60 + 2
        }
        self.assertRaises(MemoryError, run)
    }

    # The guard must not have cost the ordinary cases their behavior.
    def test_normal_repeat_still_works() {
        xs: list[int] = [1, 2] * 3
        self.assertEqual(len(xs), 6)
        self.assertEqual(xs[0], 1)
        self.assertEqual(xs[5], 2)
    }

    def test_zero_and_negative_repeat_still_empty() {
        self.assertEqual(len([1, 2] * 0), 0)
        self.assertEqual(len([1, 2] * -3), 0)
    }

    def test_bool_repeat_still_works() {
        flags: list[bool] = [True] * 5
        self.assertEqual(len(flags), 5)
        self.assertTrue(flags[4])
    }

    def test_str_element_repeat_still_increfs() {
        xs: list[str] = ["ab"] * 3
        self.assertEqual(len(xs), 3)
        self.assertEqual(xs[2], "ab")
    }

    # A trapped repeat must leave the process usable, not just un-crashed:
    # the allocator raises by longjmp, so anything it had half-built has to be
    # unwound cleanly.
    def test_process_survives_trapped_repeat() {
        def run() -> None {
            xs: list[int] = [1] * wrapping_count()
        }
        self.assertRaises(MemoryError, run)
        after: list[int] = [7] * 4
        self.assertEqual(len(after), 4)
        self.assertEqual(after[3], 7)
    }
}

main([ListAllocOverflowTests()])

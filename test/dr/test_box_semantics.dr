from unittest import TestCase, main


class Holder {
    params: list[Any]

    def(p: list[Any]) {
        self.params = p
    }

    def collect() -> list[str] {
        out: list[str] = []
        for v in self.params {
            out.append(str(v))
        }
        return out
    }
}


def _mixed() -> list[Any] {
    xs: list[Any] = [42, "Ada", 2.5, True]
    return xs
}


class BoxSubscriptTests(TestCase) {
    def test_int_list_index() {
        a: Any = [10, 20, 30]
        self.assertEqual(a[0], 10)
        self.assertEqual(a[1], 20)
        self.assertEqual(a[2], 30)
    }

    def test_negative_index() {
        a: Any = [10, 20, 30]
        self.assertEqual(a[-1], 30)
        self.assertEqual(a[-3], 10)
    }

    def test_float_list_index() {
        b: Any = [1.5, 2.5, 3.5]
        self.assertEqual(b[1], 2.5)
    }

    def test_bool_list_index() {
        bl: Any = [True, False, True]
        self.assertEqual(bl[0], True)
        self.assertEqual(bl[1], False)
    }

    def test_str_list_index() {
        c: Any = ["x", "y", "z"]
        self.assertEqual(c[2], "z")
    }

    def test_nested_list_index() {
        d: Any = [[1, 2], [3, 4]]
        self.assertEqual(d[1], [3, 4])
    }

    def test_str_keyed_dict() {
        m: Any = {"name": "Ada", "age": 42}
        self.assertEqual(m["name"], "Ada")
        self.assertEqual(m["age"], 42)
    }

    def test_int_keyed_dict() {
        n: Any = {1: "one", 2: "two"}
        self.assertEqual(n[1], "one")
        self.assertEqual(n[2], "two")
    }

    def test_string_index() {
        s: Any = "hello"
        self.assertEqual(s[1], "e")
        self.assertEqual(s[-1], "o")
    }

    def test_unbox_into_typed_slot() {
        a: Any = [10, 20, 30]
        x: int = a[1]
        self.assertEqual(x, 20)
        self.assertEqual(x + 5, 25)
    }

    def test_unbox_str_into_typed_slot() {
        m: Any = {"name": "Ada"}
        nm: str = m["name"]
        self.assertEqual(nm.upper(), "ADA")
    }

    def test_index_out_of_range_raises() {
        a: Any = [1, 2, 3]
        raised: bool = False
        try {
            print(a[10])
        } except IndexError {
            raised = True
        }
        self.assertTrue(raised)
    }

    def test_missing_dict_key_raises() {
        m: Any = {"x": 1}
        raised: bool = False
        try {
            print(m["y"])
        } except KeyError {
            raised = True
        }
        self.assertTrue(raised)
    }

    def test_not_subscriptable_raises() {
        a: Any = 5
        raised: bool = False
        try {
            print(a[0])
        } except TypeError {
            raised = True
        }
        self.assertTrue(raised)
    }

    def test_wrong_index_type_raises() {
        a: Any = [1, 2, 3]
        k: Any = "x"
        raised: bool = False
        try {
            print(a[k])
        } except TypeError {
            raised = True
        }
        self.assertTrue(raised)
    }
}


class BoxArithmeticTests(TestCase) {
    def test_sum_list_any_into_int() {
        xs: list[Any] = [1, 2, 3, 4]
        total: int = 0
        for v in xs {
            total += v
        }
        self.assertEqual(total, 10)
    }

    def test_int_promotes_into_float_accumulator() {
        xs: list[Any] = [1, 2, 3]
        ftot: float = 0.0
        for v in xs {
            ftot += v
        }
        self.assertEqual(ftot, 6.0)
    }

    def test_numeric_tower() {
        a: Any = 10
        b: Any = 3
        self.assertEqual(a + b, 13)
        self.assertEqual(a - b, 7)
        self.assertEqual(a * b, 30)
        self.assertEqual(a // b, 3)
        self.assertEqual(a % b, 1)
        self.assertEqual(a ** b, 1000)
    }

    def test_true_division_is_float() {
        a: Any = 10
        b: Any = 4
        self.assertEqual(a / b, 2.5)
    }

    def test_mixed_int_float_promotes() {
        a: Any = 10
        f: Any = 2.5
        self.assertEqual(a + f, 12.5)
        self.assertEqual(f * a, 25.0)
    }

    def test_negative_floordiv_and_mod_python_semantics() {
        a: Any = -7
        b: Any = 2
        self.assertEqual(a // b, -4)
        self.assertEqual(a % b, 1)
    }

    def test_str_concat_and_repeat() {
        a: Any = "ab"
        b: Any = "cd"
        self.assertEqual(a + b, "abcd")
        self.assertEqual(a * 3, "ababab")
    }

    def test_bytes_concat_and_repeat() {
        a: Any = b"xy"
        n: Any = 2
        self.assertEqual(a + b"z", b"xyz")
        self.assertEqual(a * n, b"xyxy")
    }

    def test_list_any_repeat() {
        xs: list[Any] = [1, 2]
        self.assertEqual(xs * 2, [1, 2, 1, 2])
    }

    def test_box_result_into_typed_str_slot() {
        a: Any = "ab"
        b: Any = "cd"
        res: str = a + b
        self.assertEqual(res, "abcd")
    }

    def test_typeerror_str_plus_int() {
        a: Any = "x"
        b: Any = 5
        raised: bool = False
        try {
            c: Any = a + b
            print(c)
        } except TypeError {
            raised = True
        }
        self.assertTrue(raised)
    }

    def test_typeerror_float_any_into_int_slot() {
        total: int = 0
        v: Any = 2.5
        raised: bool = False
        try {
            total += v
        } except TypeError {
            raised = True
        }
        self.assertTrue(raised)
    }

    def test_zero_division() {
        a: Any = 7
        b: Any = 0
        raised: bool = False
        try {
            c: Any = a // b
        } except ZeroDivisionError {
            raised = True
        }
        self.assertTrue(raised)
    }
}


class BoxComparisonTests(TestCase) {
    def test_numeric_ordering() {
        a: Any = 5
        b: Any = 7
        self.assertTrue(a < b)
        self.assertTrue(a <= b)
        self.assertFalse(a > b)
        self.assertFalse(a >= b)
        self.assertTrue(b > a)
    }

    def test_int_float_promotion_ordering() {
        a: Any = 2
        b: Any = 2.5
        self.assertTrue(a < b)
        self.assertFalse(a >= b)
    }

    def test_str_ordering() {
        a: Any = "abc"
        b: Any = "abd"
        self.assertTrue(a < b)
        self.assertFalse(a >= b)
        self.assertTrue(b > a)
    }

    def test_bytes_ordering_prefix_tiebreak() {
        a: Any = b"ab"
        b: Any = b"abc"
        self.assertTrue(a < b)
        self.assertFalse(b < a)
    }

    def test_equality_still_works() {
        a: Any = 5
        b: Any = 5
        self.assertTrue(a == b)
        self.assertFalse(a != b)
    }

    def test_chained_ordering() {
        a: Any = 1
        b: Any = 2
        c: Any = 3
        self.assertTrue(a < b < c)
        self.assertFalse(a < c < b)
        self.assertTrue(a <= b <= c)
    }

    def test_incomparable_raises_typeerror() {
        a: Any = 5
        b: Any = "x"
        raised: bool = False
        try {
            print(a < b)
        } except TypeError {
            raised = True
        }
        self.assertTrue(raised)
    }
}


class ListAnySubscriptStoreTests(TestCase) {
    def test_store_scalar_then_read() {
        xs: list[Any] = [0, 0, 0]
        xs[0] = 42
        xs[1] = "hi"
        xs[2] = True
        self.assertEqual(xs[0], 42)
        self.assertEqual(xs[1], "hi")
        self.assertEqual(xs[2], True)
    }

    def test_store_overwrites_old_value() {
        anys: list[Any] = [1, "two", 3]
        anys[1] = "TWO"
        self.assertEqual(anys[1], "TWO")
    }

    def test_store_heap_element() {
        xs: list[Any] = [0, 0]
        xs[0] = [9, 8]
        xs[1] = "z"
        self.assertEqual(xs[0], [9, 8])
        self.assertEqual(xs[1], "z")
    }

    def test_overwrite_heap_with_other_type() {
        xs: list[Any] = [[1, 2, 3]]
        xs[0] = "done"
        self.assertEqual(xs[0], "done")
        xs[0] = [4, 5]
        self.assertEqual(xs[0], [4, 5])
    }

    def test_negative_index_store() {
        xs: list[Any] = [1, 2, 3]
        xs[-1] = "last"
        self.assertEqual(xs[-1], "last")
        self.assertEqual(xs[2], "last")
    }
}


class ListAnyStrReprTests(TestCase) {
    def test_str_scalar_mix() {
        xs: list[Any] = [42, "hi", True]
        self.assertEqual(str(xs), "[42, 'hi', True]")
    }

    def test_str_nested_list() {
        xs: list[Any] = [42, "hi", [9, 8]]
        self.assertEqual(str(xs), "[42, 'hi', [9, 8]]")
    }

    def test_fstring_interpolation() {
        xs: list[Any] = [1, "two", 3]
        self.assertEqual(f"val={xs}", "val=[1, 'two', 3]")
    }

    def test_str_empty() {
        xs: list[Any] = []
        self.assertEqual(str(xs), "[]")
    }

    def test_str_none_and_float() {
        xs: list[Any] = [None, 3.5, "x"]
        self.assertEqual(str(xs), "[None, 3.5, 'x']")
    }
}


class ListAnyIterTest(TestCase) {
    """for-loops over list[Any] must read 16-byte box slots, never 8-byte strides.

    Regression test: iterating a list[Any] held in a CLASS FIELD (`for v in
    h.params`) walked the DragonListBox at the native stride and yielded
    interleaved tag/payload words (shifted values, garbage first element), while
    the identical loop over a local alias was correct. All list[Any] sources now
    route through the box-dispatch loop
    """

    def test_field_iteration_direct() -> None {
        h: Holder = Holder(_mixed())
        got: list[str] = []
        for v in h.params {
            got.append(str(v))
        }
        self.assertEqual(len(got), 4)
        self.assertEqual(got[0], "42")
        self.assertEqual(got[1], "Ada")
        self.assertEqual(got[2], "2.5")
        self.assertEqual(got[3], "True")
    }

    def test_self_field_iteration_in_method() -> None {
        h: Holder = Holder(_mixed())
        got: list[str] = h.collect()
        self.assertEqual(len(got), 4)
        self.assertEqual(got[0], "42")
        self.assertEqual(got[1], "Ada")
    }

    def test_local_alias_matches_field() -> None {
        h: Holder = Holder(_mixed())
        via_field: list[str] = []
        for v in h.params {
            via_field.append(str(v))
        }
        ps: list[Any] = h.params
        via_alias: list[str] = []
        for v in ps {
            via_alias.append(str(v))
        }
        self.assertEqual(len(via_field), len(via_alias))
        i: int = 0
        for s in via_field {
            self.assertEqual(s, via_alias[i])
            i = i + 1
        }
    }

    def test_call_result_iteration() -> None {
        got: list[str] = []
        for v in _mixed() {
            got.append(str(v))
        }
        self.assertEqual(len(got), 4)
        self.assertEqual(got[1], "Ada")
    }

    def test_dict_transfer_loop() -> None {
        h: Holder = Holder(_mixed())
        binds: dict[str, Any] = {}
        i: int = 0
        for v in h.params {
            binds[str(i)] = v
            i = i + 1
        }
        self.assertEqual(len(binds), 4)
        a: int = binds["0"]
        self.assertEqual(a, 42)
        b: str = binds["1"]
        self.assertEqual(b, "Ada")
    }
}


main([BoxSubscriptTests(), BoxArithmeticTests(), BoxComparisonTests(), ListAnySubscriptStoreTests(), ListAnyStrReprTests(), ListAnyIterTest()])

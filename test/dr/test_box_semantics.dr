type Boxed = int | float | bool | str | bytes | list[int] | list[float] | list[bool] | list[str] | list[list[int]] | list[Boxed] | dict[str, int] | dict[str, str] | dict[str, Boxed] | None | dict[int, str]

from unittest import TestCase, main


class Holder {
    params: list[Boxed]

    def(p: list[Boxed]) {
        self.params = p
    }

    def collect() -> list[str] {
        out: list[str] = []
        for v in self.params {
            out.append(str(v))
        }
        return out
    }
}


def _mixed() -> list[Boxed] {
    xs: list[Boxed] = [42, "Ada", 2.5, True]
    return xs
}


class BoxSubscriptTests(TestCase) {
    def test_int_list_index() {
        a: Boxed = [10, 20, 30]
        ac: list[int] = a        # checked downcast to the declared arm
        self.assertEqual(ac[0], 10)
        self.assertEqual(ac[1], 20)
        self.assertEqual(ac[2], 30)
    }

    def test_negative_index() {
        a: Boxed = [10, 20, 30]
        ac: list[int] = a        # checked downcast to the declared arm
        self.assertEqual(ac[-1], 30)
        self.assertEqual(ac[-3], 10)
    }

    def test_float_list_index() {
        b: Boxed = [1.5, 2.5, 3.5]
        bc: list[float] = b        # checked downcast to the declared arm
        self.assertEqual(bc[1], 2.5)
    }

    def test_bool_list_index() {
        bl: Boxed = [True, False, True]
        blc: list[bool] = bl        # checked downcast to the declared arm
        self.assertEqual(blc[0], True)
        self.assertEqual(blc[1], False)
    }

    def test_str_list_index() {
        c: Boxed = ["x", "y", "z"]
        cc: list[str] = c        # checked downcast to the declared arm
        self.assertEqual(cc[2], "z")
    }

    def test_nested_list_index() {
        d: Boxed = [[1, 2], [3, 4]]
        dc: list[list[int]] = d        # checked downcast to the declared arm
        self.assertEqual(dc[1], [3, 4])
    }

    def test_str_keyed_dict() {
        m: Boxed = {"name": "Ada", "age": 42}
        mc: dict[str, Boxed] = m        # heterogeneous values: the boxed arm
        const nm: str = mc["name"]
        const age: int = mc["age"]
        self.assertEqual(nm, "Ada")
        self.assertEqual(age, 42)
    }

    def test_int_keyed_dict() {
        n: Boxed = {1: "one", 2: "two"}
        nc: dict[int, str] = n        # checked downcast to the declared arm
        self.assertEqual(nc[1], "one")
        self.assertEqual(nc[2], "two")
    }

    def test_string_index() {
        s: Boxed = "hello"
        sv: str = s        # checked downcast to the declared arm
        self.assertEqual(sv[1], "e")
        self.assertEqual(sv[-1], "o")
    }

    def test_unbox_into_typed_slot() {
        a: Boxed = [10, 20, 30]
        ac: list[int] = a        # checked downcast to the declared arm
        x: int = ac[1]
        self.assertEqual(x, 20)
        self.assertEqual(x + 5, 25)
    }

    def test_unbox_str_into_typed_slot() {
        m: Boxed = {"name": "Ada"}
        mc: dict[str, str] = m        # checked downcast to the declared arm
        nm: str = mc["name"]
        self.assertEqual(nm.upper(), "ADA")
    }

    def test_index_out_of_range_raises() {
        a: Boxed = [1, 2, 3]
        ac: list[int] = a        # checked downcast to the declared arm
        raised: bool = False
        try {
            print(ac[10])
        } except IndexError {
            raised = True
        }
        self.assertTrue(raised)
    }

    def test_missing_dict_key_raises() {
        m: Boxed = {"x": 1}
        mc: dict[str, int] = m        # checked downcast to the declared arm
        raised: bool = False
        try {
            print(mc["y"])
        } except KeyError {
            raised = True
        }
        self.assertTrue(raised)
    }

    def test_scalar_arm_downcast_raises() {
        """Subscripting a non-container is refused at COMPILE time now, so the
        runtime check worth asserting is reading a scalar box at a wrong arm."""
        a: Boxed = 5
        raised: bool = False
        try {
            const as1: str = a        # holds an int: the tag check must raise
            print(as1)
        } except TypeError {
            raised = True
        }
        self.assertTrue(raised)
    }

    def test_wrong_arm_index_downcast_raises() {
        """A wrong INDEX type is now a compile error, so the runtime behaviour
        worth asserting is the checked downcast: reading the boxed index at an
        arm it is not holding raises instead of reinterpreting the payload."""
        a: Boxed = [1, 2, 3]
        ac: list[int] = a        # checked downcast to the declared arm
        k: Boxed = "x"
        raised: bool = False
        try {
            const ki: int = k    # holds a str: the tag check must raise
            print(ac[ki])
        } except TypeError {
            raised = True
        }
        self.assertTrue(raised)
    }
}


class BoxArithmeticTests(TestCase) {
    def test_sum_list_any_into_int() {
        xs: list[Boxed] = [1, 2, 3, 4]
        total: int = 0
        for v in xs {
            const n: int = v        # checked downcast per element
            total += n
        }
        self.assertEqual(total, 10)
    }

    def test_int_promotes_into_float_accumulator() {
        xs: list[Boxed] = [1, 2, 3]
        ftot: float = 0.0
        for v in xs {
            const n: int = v        # checked downcast per element
            ftot += float(n)
        }
        self.assertEqual(ftot, 6.0)
    }

    def test_numeric_tower() {
        a: Boxed = 10
        av: int = a        # checked downcast to the declared arm
        b: Boxed = 3
        bv: int = b        # checked downcast to the declared arm
        self.assertEqual(av + bv, 13)
        self.assertEqual(av - bv, 7)
        self.assertEqual(av * bv, 30)
        self.assertEqual(av // bv, 3)
        self.assertEqual(av % bv, 1)
        self.assertEqual(av ** bv, 1000)
    }

    def test_true_division_is_float() {
        a: Boxed = 10
        av: int = a        # checked downcast to the declared arm
        b: Boxed = 4
        bv: int = b        # checked downcast to the declared arm
        self.assertEqual(av / bv, 2.5)
    }

    def test_mixed_int_float_promotes() {
        a: Boxed = 10
        av: int = a        # checked downcast to the declared arm
        f: Boxed = 2.5
        fv: float = f        # checked downcast to the declared arm
        self.assertEqual(av + fv, 12.5)
        self.assertEqual(fv * av, 25.0)
    }

    def test_negative_floordiv_and_mod_python_semantics() {
        a: Boxed = -7
        av: int = a        # checked downcast to the declared arm
        b: Boxed = 2
        bv: int = b        # checked downcast to the declared arm
        self.assertEqual(av // bv, -4)
        self.assertEqual(av % bv, 1)
    }

    def test_str_concat_and_repeat() {
        a: Boxed = "ab"
        av: str = a        # checked downcast to the declared arm
        b: Boxed = "cd"
        bv: str = b        # checked downcast to the declared arm
        self.assertEqual(av + bv, "abcd")
        self.assertEqual(av * 3, "ababab")
    }

    def test_bytes_concat_and_repeat() {
        a: Boxed = b"xy"
        av: bytes = a        # checked downcast to the declared arm
        n: Boxed = 2
        nv: int = n        # checked downcast to the declared arm
        self.assertEqual(av + b"z", b"xyz")
        self.assertEqual(av * nv, b"xyxy")
    }

    def test_list_any_repeat() {
        xs: list[Boxed] = [1, 2]
        self.assertEqual(xs * 2, [1, 2, 1, 2])
    }

    def test_box_result_into_typed_str_slot() {
        a: Boxed = "ab"
        av: str = a        # checked downcast to the declared arm
        b: Boxed = "cd"
        bv: str = b        # checked downcast to the declared arm
        res: str = av + bv
        self.assertEqual(res, "abcd")
    }

    def test_typeerror_wrong_arm_downcast() {
        """With a closed domain, `str + int` is refused at COMPILE time, so the
        runtime error worth asserting is the checked downcast: reading a value
        at an arm it is not holding raises rather than reinterpreting it."""
        a: Boxed = "x"
        raised: bool = False
        try {
            n: int = a        # holds a str: the tag check must raise
            print(n)
        } except TypeError {
            raised = True
        }
        self.assertTrue(raised)
    }

    def test_typeerror_float_box_read_as_int() {
        """`int += float` is a compile error now; the runtime check that
        remains is reading a float box at the int arm."""
        v: Boxed = 2.5
        raised: bool = False
        try {
            const n: int = v        # holds a float: the tag check must raise
            print(n)
        } except TypeError {
            raised = True
        }
        self.assertTrue(raised)
    }

    def test_zero_division() {
        a: Boxed = 7
        av: int = a        # checked downcast to the declared arm
        b: Boxed = 0
        bv: int = b        # checked downcast to the declared arm
        raised: bool = False
        try {
            c: Boxed = av // bv
        } except ZeroDivisionError {
            raised = True
        }
        self.assertTrue(raised)
    }
}


class BoxComparisonTests(TestCase) {
    def test_numeric_ordering() {
        a: Boxed = 5
        av: int = a        # checked downcast to the declared arm
        b: Boxed = 7
        bv: int = b        # checked downcast to the declared arm
        self.assertTrue(av < bv)
        self.assertTrue(av <= bv)
        self.assertFalse(av > bv)
        self.assertFalse(av >= bv)
        self.assertTrue(bv > av)
    }

    def test_int_float_promotion_ordering() {
        a: Boxed = 2
        av: int = a        # checked downcast to the declared arm
        b: Boxed = 2.5
        bv: float = b        # checked downcast to the declared arm
        self.assertTrue(av < bv)
        self.assertFalse(av >= bv)
    }

    def test_str_ordering() {
        a: Boxed = "abc"
        av: str = a        # checked downcast to the declared arm
        b: Boxed = "abd"
        bv: str = b        # checked downcast to the declared arm
        self.assertTrue(av < bv)
        self.assertFalse(av >= bv)
        self.assertTrue(bv > av)
    }

    def test_bytes_ordering_prefix_tiebreak() {
        a: Boxed = b"ab"
        av: bytes = a        # checked downcast to the declared arm
        b: Boxed = b"abc"
        bv: bytes = b        # checked downcast to the declared arm
        self.assertTrue(av < bv)
        self.assertFalse(bv < av)
    }

    def test_equality_still_works() {
        a: Boxed = 5
        av: int = a        # checked downcast to the declared arm
        b: Boxed = 5
        bv: int = b        # checked downcast to the declared arm
        self.assertTrue(av == bv)
        self.assertFalse(av != bv)
    }

    def test_chained_ordering() {
        a: Boxed = 1
        av: int = a        # checked downcast to the declared arm
        b: Boxed = 2
        bv: int = b        # checked downcast to the declared arm
        c: Boxed = 3
        cv: int = c        # checked downcast to the declared arm
        self.assertTrue(av < bv < cv)
        self.assertFalse(av < cv < bv)
        self.assertTrue(av <= bv <= cv)
    }

    def test_incomparable_arms_refused_at_compile_time() {
        """`int < str` no longer reaches the runtime: with a closed domain the
        compiler refuses the comparison. What remains checkable at runtime is
        that reading a box at the wrong arm raises rather than comparing
        whatever bits happen to be there."""
        b: Boxed = "x"
        raised: bool = False
        try {
            const n: int = b        # holds a str: the tag check must raise
            print(n < 5)
        } except TypeError {
            raised = True
        }
        self.assertTrue(raised)
    }
}


class ListAnySubscriptStoreTests(TestCase) {
    def test_store_scalar_then_read() {
        xs: list[Boxed] = [0, 0, 0]
        xs[0] = 42
        xs[1] = "hi"
        xs[2] = True
        self.assertEqual(xs[0], 42)
        self.assertEqual(xs[1], "hi")
        self.assertEqual(xs[2], True)
    }

    def test_store_overwrites_old_value() {
        anys: list[Boxed] = [1, "two", 3]
        anys[1] = "TWO"
        self.assertEqual(anys[1], "TWO")
    }

    def test_store_heap_element() {
        xs: list[Boxed] = [0, 0]
        xs[0] = [9, 8]
        xs[1] = "z"
        self.assertEqual(xs[0], [9, 8])
        self.assertEqual(xs[1], "z")
    }

    def test_overwrite_heap_with_other_type() {
        xs: list[Boxed] = [[1, 2, 3]]
        xs[0] = "done"
        self.assertEqual(xs[0], "done")
        xs[0] = [4, 5]
        self.assertEqual(xs[0], [4, 5])
    }

    def test_negative_index_store() {
        xs: list[Boxed] = [1, 2, 3]
        xs[-1] = "last"
        self.assertEqual(xs[-1], "last")
        self.assertEqual(xs[2], "last")
    }
}


class ListAnyStrReprTests(TestCase) {
    def test_str_scalar_mix() {
        xs: list[Boxed] = [42, "hi", True]
        self.assertEqual(str(xs), "[42, 'hi', True]")
    }

    def test_str_nested_list() {
        xs: list[Boxed] = [42, "hi", [9, 8]]
        self.assertEqual(str(xs), "[42, 'hi', [9, 8]]")
    }

    def test_fstring_interpolation() {
        xs: list[Boxed] = [1, "two", 3]
        self.assertEqual(f"val={xs}", "val=[1, 'two', 3]")
    }

    def test_str_empty() {
        xs: list[Boxed] = []
        self.assertEqual(str(xs), "[]")
    }

    def test_str_none_and_float() {
        xs: list[Boxed] = [None, 3.5, "x"]
        self.assertEqual(str(xs), "[None, 3.5, 'x']")
    }
}


class ListAnyIterTest(TestCase) {
    """for-loops over list[Boxed] must read 16-byte box slots, never 8-byte strides.

    Regression test: iterating a list[Boxed] held in a CLASS FIELD (`for v in
    h.params`) walked the DragonListBox at the native stride and yielded
    interleaved tag/payload words (shifted values, garbage first element), while
    the identical loop over a local alias was correct. All list[Boxed] sources now
    route through the box-dispatch loop
    """

    def test_field_iteration_direct() -> None {
        h: Holder = Holder(_mixed())
        got: list[str] = []
        for v in h.params {
            got.append(str(v))
        }
        self.assertEqual(len(got), 4)
        self.assertEqual(got[0], "42")
        self.assertEqual(got[1], "Ada")
        self.assertEqual(got[2], "2.5")
        self.assertEqual(got[3], "True")
    }

    def test_self_field_iteration_in_method() -> None {
        h: Holder = Holder(_mixed())
        got: list[str] = h.collect()
        self.assertEqual(len(got), 4)
        self.assertEqual(got[0], "42")
        self.assertEqual(got[1], "Ada")
    }

    def test_local_alias_matches_field() -> None {
        h: Holder = Holder(_mixed())
        via_field: list[str] = []
        for v in h.params {
            via_field.append(str(v))
        }
        ps: list[Boxed] = h.params
        via_alias: list[str] = []
        for v in ps {
            via_alias.append(str(v))
        }
        self.assertEqual(len(via_field), len(via_alias))
        i: int = 0
        for s in via_field {
            self.assertEqual(s, via_alias[i])
            i = i + 1
        }
    }

    def test_call_result_iteration() -> None {
        got: list[str] = []
        for v in _mixed() {
            got.append(str(v))
        }
        self.assertEqual(len(got), 4)
        self.assertEqual(got[1], "Ada")
    }

    def test_dict_transfer_loop() -> None {
        h: Holder = Holder(_mixed())
        binds: dict[str, Boxed] = {}
        i: int = 0
        for v in h.params {
            binds[str(i)] = v
            i = i + 1
        }
        self.assertEqual(len(binds), 4)
        a: int = binds["0"]
        self.assertEqual(a, 42)
        b: str = binds["1"]
        self.assertEqual(b, "Ada")
    }
}


main([BoxSubscriptTests(), BoxArithmeticTests(), BoxComparisonTests(), ListAnySubscriptStoreTests(), ListAnyStrReprTests(), ListAnyIterTest()])

type Boxed = int | float | bool | str | bytes | list[Boxed] | dict[str, Boxed]

from unittest import TestCase, main
from time import sleep_ms


class Store {
    tag: str = "s"

    def read(**keys: Boxed) -> int {
        return len(keys)
    }

    def query(docid: int, **keys: Boxed) -> int {
        return docid * 100 + len(keys)
    }

    def collect(*xs: int) -> int {
        s: int = 0
        for x in xs {
            s = s + x
        }
        return s
    }

    def named(**kw: int) -> int {
        t: int = 0
        for k in kw {
            t = t + kw[k]
        }
        return t
    }

    def echo(key: str, **keys: Boxed) -> str {
        v: Boxed = keys[key]
        return str(v)
    }
}


class Bag {
    saved: str = ""
    pack: dict[str, Boxed] = {}

    def keep_value(key: str, **keys: Boxed) -> None {
        self.saved = str(keys[key])
    }

    def keep_pack(**keys: Boxed) -> None {
        self.pack = keys
    }
}


class Counter {
    limit: int
    start: int
    def(start: int, limit: int) {
        self.start = start
        self.limit = limit
    }
    def values() {
        k: int = self.start
        while k < self.limit {
            yield k
            k = k + 1
        }
    }
    def labels() {
        k: int = self.start
        while k < self.limit {
            yield "v" + str(k)
            k = k + 1
        }
    }
    def total() -> int {
        t: int = 0
        for x in self.values() {
            t = t + x
        }
        return t
    }
    def upto_or_raise(bad: int) {
        k: int = self.start
        while k < self.limit {
            if k == bad {
                raise ValueError("hit bad")
            }
            yield k
            k = k + 1
        }
    }
}


class Squares {
    @staticmethod
    def of(n: int) {
        k: int = 0
        while k < n {
            yield k * k
            k = k + 1
        }
    }
}


class IterCounter {
    def(limit: int) {
        self.limit: int = limit
    }

    def __iter__() -> CounterIter {
        return CounterIter(self.limit)
    }
}


class CounterIter {
    def(limit: int) {
        self.limit: int = limit
        self.i: int = 0
    }

    def __next__() -> int {
        if self.i >= self.limit {
            raise StopIteration("done")
        }
        self.i = self.i + 1
        return self.i
    }
}


class Words {
    def() {
        self.done: bool = False
    }

    def __iter__() -> WordsIter {
        return WordsIter()
    }
}


class WordsIter {
    def() {
        self.i: int = 0
    }

    def __next__() -> str {
        if self.i >= 2 {
            raise StopIteration("done")
        }
        self.i = self.i + 1
        return "w" + str(self.i)
    }
}


class Job {
    def(name: str) {
        self.name: str = name
    }

    def run() -> str {
        return "ran:" + self.name
    }
}


class Jobs {
    def() {
        self.i: int = 0
    }

    def __iter__() -> Jobs {
        return self
    }

    def __next__() -> Job {
        if self.i >= 1 {
            raise StopIteration("done")
        }
        self.i = self.i + 1
        return Job("j1")
    }
}


class MethodKwargsTests(TestCase) {
    """Typed `**kwargs` / `*args` on METHODS (compiler gap, not a rule).

    Typed variadics work on free functions (`def f(**kw: int)`, `def g(*xs: int)`)
    but were broken on methods: `q.read(id=1)` errored "unexpected keyword
    argument", and a positional-plus-`**keys` call emitted a null LLVM operand
    (verify fail). This is the method-side of the same surface, including the
    refcount-sensitive `**keys: Boxed` case where each kwarg value is a heap string:
    the packed dict is a call-site-owned temporary and must be released after the
    call, and its owned entries must survive being read back.
    """

    def test_kwargs_only() {
        q: Store = Store()
        self.assertEqual(q.read(id=1), 1)
        self.assertEqual(q.read(id=1, name=2), 2)
    }

    def test_positional_plus_kwargs() {
        q: Store = Store()
        self.assertEqual(q.query(0), 0)
        self.assertEqual(q.query(3, a=1, b=2), 302)
    }

    def test_varargs() {
        q: Store = Store()
        self.assertEqual(q.collect(1, 2, 3), 6)
        self.assertEqual(q.collect(), 0)
    }

    def test_named_int_kwargs() {
        q: Store = Store()
        self.assertEqual(q.named(x=10, y=3), 13)
    }

    def test_any_heap_value_read_back() {
        q: Store = Store()
        self.assertEqual(q.echo("host", host="db.local", port="5432"), "db.local")
    }

    def test_heap_kwargs_no_leak() {
        q: Store = Store()
        i: int = 0
        while i < 3000 {
            borrowed: str = "host-" + str(i % 7)
            n: int = q.read(host=borrowed, port=str(i % 5))
            self.assertEqual(n, 2)
            i = i + 1
        }
    }
}


class MethodKwargsEscapeTests(TestCase) {
    """Escape safety: a `**kwargs` value or the whole pack that outlives the call.

    The packed `**kwargs` dict is a call-site-owned temporary the method BORROWS,
    and it is freed the instant the call returns. So a method that KEEPS a kwarg
    value (stores it in a field) or keeps the whole pack must take its own
    reference, or the stored value is a use-after-free the moment the pack is
    freed. This proves the borrow-plus-incref-on-store discipline holds with no
    `own`/`del`/`dub` annotation: the pack is a fresh temp, so there is no caller
    binding to move, and `own` on a variadic parameter is a parse error by design.
    """

    def test_value_escapes_pack_lifetime() {
        b: Bag = Bag()
        i: int = 0
        while i < 2000 {
            b.keep_value("host", host="db-" + str(i % 9), port="5432")
            self.assertTrue(len(b.saved) > 0)
            i = i + 1
        }
    }

    def test_pack_escapes_call() {
        b: Bag = Bag()
        i: int = 0
        while i < 2000 {
            b.keep_pack(a="x-" + str(i % 5), bb="y")
            self.assertEqual(len(b.pack), 2)
            i = i + 1
        }
    }
}


class MethodGeneratorTests(TestCase) {
    def test_self_generator_in_method() {
        c: Counter = Counter(0, 5)
        self.assertEqual(c.total(), 10)
    }

    def test_external_obj_generator() {
        c: Counter = Counter(2, 6)
        s: int = 0
        for x in c.values() {
            s = s + x
        }
        self.assertEqual(s, 14)
    }

    def test_heap_yield_with_field() {
        c: Counter = Counter(0, 3)
        out: list[str] = []
        for v in c.labels() {
            out.append(v)
        }
        self.assertEqual(out, ["v0", "v1", "v2"])
    }

    def test_static_method_generator() {
        s: int = 0
        for v in Squares.of(4) {
            s = s + v
        }
        self.assertEqual(s, 14)
    }

    def test_method_generator_body_raise_caught() {
        c: Counter = Counter(0, 10)
        seen: int = 0
        caught: int = 0
        try {
            for x in c.upto_or_raise(3) {
                seen = seen + 1
            }
        } except ValueError {
            caught = 1
        }
        self.assertEqual(seen, 3)
        self.assertEqual(caught, 1)
    }
}


class IterProtocolClassTests(TestCase) {
    """The __iter__/__next__ protocol with a separate iterator class, and typed
    loop variables from __next__'s declared return. Pre-fix: __next__ resolved
    against the iterable's class, so a non-self-returning __iter__ crashed the
    compiler, and a protocol loop variable stayed untyped (fire w.run() reported
    Task[<unknown>])."""

    def test_separate_iterator_class() {
        total: int = 0
        for n in IterCounter(3) {
            total = total + n
        }
        self.assertEqual(total, 6)
    }

    def test_separate_iterator_str_elements() {
        joined: str = ""
        for w in Words() {
            joined = joined + w.upper()
        }
        self.assertEqual(joined, "W1W2")
    }

    def test_fire_on_protocol_loop_var() {
        out: str = ""
        for j in Jobs() {
            t: Task[str] = fire j.run()
            out = t.join()
        }
        self.assertEqual(out, "ran:j1")
    }
}


class Labeler {
    @staticmethod
    def scale(a: int, factor: int = 3) -> int {
        return a * factor
    }

    @staticmethod
    def tag(name: str, suffix: str = "-dr", upper: bool = false) -> str {
        out: str = name + suffix
        if upper {
            return out.upper()
        }
        return out
    }
}


class StaticMethodDefaultTests(TestCase) {
    """Default arguments on @staticmethod calls. Call sites that omitted a
    defaulted parameter used to reach codegen with too few LLVM arguments and
    die at module verification ('Incorrect number of arguments passed to called
    function'), even same-module; ctors and instance methods already filled
    defaults via the shared fillDefaultArgs path. The 5000-iteration loop is the
    adversarial rc probe: a materialized str default is a call-site temp that
    must be decref'd per call, not leaked (pinned by the ASan/LSan tree)."""

    def test_omitted_int_default() {
        self.assertEqual(Labeler.scale(7), 21)
    }

    def test_explicit_arg_still_wins() {
        self.assertEqual(Labeler.scale(7, 2), 14)
    }

    def test_omitted_heap_defaults() {
        self.assertEqual(Labeler.tag("box"), "box-dr")
        self.assertEqual(Labeler.tag("box", "!"), "box!")
        self.assertEqual(Labeler.tag("box", "!", true), "BOX!")
    }

    def test_omitted_str_default_loop_no_leak() {
        i: int = 0
        while i < 5000 {
            const t: str = Labeler.tag("k")
            self.assertEqual(t, "k-dr")
            i = i + 1
        }
    }
}


class GenErr(Exception) {
    code: int
    def(c: int) { self.code = c }
}


class YieldHolder {
    tag: str
    def(t: str) { self.tag = t }
}


def str_across(prefix: str, n: int) {
    k: int = 0
    while k < n {
        s: str = prefix + str(k)
        yield k
        k = k + 1
    }
}


def list_across(n: int) {
    k: int = 0
    while k < n {
        xs: list[int] = [k, k + 1, k + 2]
        yield xs[0]
        k = k + 1
    }
}


def obj_across(n: int) {
    k: int = 0
    while k < n {
        h: YieldHolder = YieldHolder("h" + str(k))
        yield k
        k = k + 1
    }
}


def raiser(n: int, bad: int) {
    k: int = 0
    while k < n {
        if k == bad { raise GenErr(k) }
        yield k
        k = k + 1
    }
}


def try_around_yield(n: int) {
    k: int = 0
    while k < n {
        try {
            if k == 1 { raise GenErr(k) }
            yield k
        } except GenErr {
            yield -1
        }
        k = k + 1
    }
}


def finally_around_yield(n: int, sink: list[int]) {
    try {
        k: int = 0
        while k < n {
            yield k
            k = k + 1
        }
    } finally {
        sink.append(99)
    }
}


class YieldGuard {
    sink: list[int]
    def(s: list[int]) { self.sink = s }
    def __enter__() -> YieldGuard { return self }
    def __exit__() -> None { self.sink.append(7) }
}


def with_around_yield(n: int, sink: list[int]) {
    with YieldGuard(sink) as g {
        k: int = 0
        while k < n {
            yield k
            k = k + 1
        }
    }
}


def inner_gen(n: int) {
    k: int = 0
    while k < n {
        s: str = "i" + str(k)
        yield k
        k = k + 1
    }
}


def outer_gen(n: int) {
    for v in inner_gen(n) {
        t: str = "o" + str(v)
        yield v * 2
    }
}


def heap_yield(n: int) {
    k: int = 0
    while k < n {
        yield "v" + str(k)
        k = k + 1
    }
}


def early_return(n: int) {
    k: int = 0
    while k < n {
        s: str = "e" + str(k)
        if k == 2 { return }
        yield k
        k = k + 1
    }
}


def parking_gen(n: int) {
    k: int = 0
    while k < n {
        sleep_ms(1)
        yield k
        k = k + 1
    }
}


def drain_parking(n: int) -> int {
    t: int = 0
    for v in parking_gen(n) { t = t + v }
    return t
}


def drain_plain(n: int) -> int {
    t: int = 0
    for v in str_across("t", n) { t = t + v }
    return t
}


class GeneratorFrameTests(TestCase) {
    def test_break_releases_str_held_across_yield() {
        i: int = 0
        total: int = 0
        while i < 2000 {
            for v in str_across("p", 50) {
                total = total + v
                if v == 3 { break }
            }
            i = i + 1
        }
        self.assertEqual(total, 12000)
    }

    def test_break_releases_list_held_across_yield() {
        i: int = 0
        total: int = 0
        while i < 2000 {
            for v in list_across(50) {
                total = total + v
                if v == 2 { break }
            }
            i = i + 1
        }
        self.assertEqual(total, 6000)
    }

    def test_break_releases_instance_held_across_yield() {
        i: int = 0
        total: int = 0
        while i < 2000 {
            for v in obj_across(50) {
                total = total + v
                if v == 4 { break }
            }
            i = i + 1
        }
        self.assertEqual(total, 20000)
    }

    def test_body_raise_reaches_consumer_try() {
        i: int = 0
        caught: int = 0
        seen: int = 0
        while i < 2000 {
            try {
                for v in raiser(10, 3) { seen = seen + 1 }
            } except GenErr {
                caught = caught + 1
            }
            i = i + 1
        }
        self.assertEqual(caught, 2000)
        self.assertEqual(seen, 6000)
    }

    def test_try_inside_generator_body_catches_and_yields() {
        out: list[int] = []
        for v in try_around_yield(4) { out.append(v) }
        self.assertEqual(out, [0, -1, 2, 3])
    }

    def test_finally_inside_generator_runs_when_drained() {
        sink: list[int] = []
        total: int = 0
        for v in finally_around_yield(3, sink) { total = total + v }
        self.assertEqual(total, 3)
        self.assertEqual(sink, [99])
    }

    def test_with_inside_generator_exits_when_drained() {
        sink: list[int] = []
        total: int = 0
        for v in with_around_yield(3, sink) { total = total + v }
        self.assertEqual(total, 3)
        self.assertEqual(sink, [7])
    }

    def test_nested_generators_drain_and_abandon() {
        full: int = 0
        for v in outer_gen(5) { full = full + v }
        self.assertEqual(full, 20)
        i: int = 0
        part: int = 0
        while i < 2000 {
            for v2 in outer_gen(50) {
                part = part + v2
                if v2 >= 4 { break }
            }
            i = i + 1
        }
        self.assertEqual(part, 12000)
    }

    def test_heap_yield_owned_by_consumer() {
        out: list[str] = []
        for s in heap_yield(4) { out.append(s) }
        self.assertEqual(out, ["v0", "v1", "v2", "v3"])
        i: int = 0
        kept: int = 0
        while i < 2000 {
            seen: list[str] = []
            for s2 in heap_yield(50) {
                seen.append(s2)
                if len(seen) == 3 { break }
            }
            kept = kept + len(seen)
            i = i + 1
        }
        self.assertEqual(kept, 6000)
    }

    def test_early_return_inside_generator() {
        out: list[int] = []
        i: int = 0
        while i < 2000 {
            for v in early_return(10) { out.append(v) }
            i = i + 1
        }
        self.assertEqual(len(out), 4000)
    }

    def test_generator_in_fired_task() {
        i: int = 0
        total: int = 0
        while i < 200 {
            t: Task[int] = fire drain_plain(20)
            total = total + t.join()
            i = i + 1
        }
        self.assertEqual(total, 38000)
    }

    def test_parking_generator_in_fired_task() {
        i: int = 0
        total: int = 0
        while i < 20 {
            t: Task[int] = fire drain_parking(4)
            total = total + t.join()
            i = i + 1
        }
        self.assertEqual(total, 120)
    }

    def test_parking_generator_on_main_thread() {
        self.assertEqual(drain_parking(4), 6)
    }
}


main([MethodKwargsTests(), MethodKwargsEscapeTests(), MethodGeneratorTests(), GeneratorFrameTests(),
      IterProtocolClassTests(), StaticMethodDefaultTests()])

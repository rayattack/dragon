type Boxed = int | float | bool | str | bytes | list[int] | list[float] | list[bool] | list[str] | list[list[int]] | list[Boxed] | dict[str, int] | dict[str, str] | dict[str, Boxed]

from unittest import TestCase, main

const N: int = 3000


def arg_len(s: str) -> int {
    return len(s)
}


def fresh_any(v: str) -> Boxed {
    return v.upper()
}


def fresh_doc(n: int) -> dict[str, Boxed] {
    return {"mrn": "A" + str(n)}
}


class Doc {
    data: dict[str, Boxed]

    def(data: dict[str, Boxed]) {
        self.data = data
    }

    def __getitem__(k: str) -> Boxed {
        return self.data[k]
    }
}


def churn() -> int {
    junk: list[str] = []
    i: int = 0
    while i < 200 {
        junk.append("filler-" + str(i))
        i = i + 1
    }
    return len(junk)
}


class TestAnyArgNarrow(TestCase) {
    """An `Boxed` handed straight to a typed slot must narrow under a tag check.

    Pre-fix, `out.append(doc["action"])` reached a consumer that never unboxed and
    died in the LLVM verifier, while a user call unboxed with no tag check and
    segfaulted on an int. Binding to a name first already worked."""

    def test_append_borrowed_box() {
        i: int = 0
        while i < 300 {
            d: dict[str, Boxed] = {"mrn": "A" + str(i)}
            out: list[str] = []
            const mrn: str = d["mrn"]        # checked downcast to the declared arm
            out.append(mrn)
            self.assertEqual(out[0], "A" + str(i))
            self.assertEqual(arg_len(mrn), len("A" + str(i)))
            i = i + 1
        }
        self.assertEqual(churn(), 200)
    }

    def test_append_owned_box() {
        i: int = 0
        while i < 300 {
            out: list[str] = []
            const v: str = fresh_any("mrn" + str(i))        # checked downcast
            out.append(v)
            self.assertEqual(out[0], ("mrn" + str(i)).upper())
            i = i + 1
        }
        self.assertEqual(churn(), 200)
    }

    def test_append_int_and_float_tiers() {
        d: dict[str, Boxed] = {"n": 7, "f": 1.5}
        nums: list[int] = []
        reals: list[float] = []
        i: int = 0
        while i < 200 {
            const n: int = d["n"]            # checked downcast
            const f: float = d["f"]          # checked downcast
            nums.append(n)
            reals.append(f)
            i = i + 1
        }
        self.assertEqual(nums[0], 7)
        self.assertEqual(len(nums), 200)
        self.assertAlmostEqual(reals[0], 1.5)
    }

    def test_set_add_and_list_insert() {
        i: int = 0
        while i < 300 {
            d: dict[str, Boxed] = {"mrn": "A" + str(i)}
            seen: set[str] = set()
            const mv1: str = d["mrn"]        # checked downcast to the declared arm
            seen.add(mv1)
            self.assertEqual(len(seen), 1)
            out: list[str] = ["z"]
            const mv2: str = d["mrn"]        # checked downcast to the declared arm
            out.insert(0, mv2)
            self.assertEqual(out[0], "A" + str(i))
            self.assertEqual(out[1], "z")
            i = i + 1
        }
        self.assertEqual(churn(), 200)
    }

    def test_str_method_argument() {
        i: int = 0
        while i < 300 {
            d: dict[str, Boxed] = {"pre": "AB"}
            const pre: str = d["pre"]        # checked downcast to the declared arm
            self.assertTrue("ABC".startswith(pre))
            self.assertFalse("XBC".startswith(pre))
            i = i + 1
        }
        self.assertEqual(churn(), 200)
    }

    def test_literal_element_and_join() {
        i: int = 0
        while i < 300 {
            d: dict[str, Boxed] = {"mrn": "A" + str(i)}
            const pm: str = d["mrn"]         # checked downcast
            parts: list[str] = ["id", pm]
            self.assertEqual(parts[1], "A" + str(i))
            self.assertEqual(", ".join(parts), "id, A" + str(i))
            i = i + 1
        }
        self.assertEqual(churn(), 200)
    }

    def test_any_field_and_nested_dict_source() {
        i: int = 0
        while i < 300 {
            outer: dict[str, Boxed] = {"mrn": "A" + str(i)}
            a: Boxed = outer["mrn"]
            const av: str = a                # checked downcast
            out: list[str] = []
            out.append(av)
            self.assertEqual(out[0], "A" + str(i))
            i = i + 1
        }
        self.assertEqual(churn(), 200)
    }

    def test_dict_literal_value() {
        i: int = 0
        while i < 300 {
            d: dict[str, Boxed] = {"mrn": "A" + str(i)}
            const mrn: str = d["mrn"]        # checked downcast to the declared arm
            byname: dict[str, str] = {"id": mrn}
            self.assertEqual(byname["id"], "A" + str(i))
            i = i + 1
        }
        self.assertEqual(churn(), 200)
    }

    def test_tuple_literal_element() {
        i: int = 0
        while i < 300 {
            d: dict[str, Boxed] = {"mrn": "A" + str(i)}
            const mrn: str = d["mrn"]        # checked downcast to the declared arm
            row: tuple[str, int] = (mrn, i)
            self.assertEqual(row[0], "A" + str(i))
            self.assertEqual(row[1], i)
            i = i + 1
        }
        self.assertEqual(churn(), 200)
    }

    def test_owned_receiver_subscript() {
        out: list[str] = []
        i: int = 0
        while i < 300 {
            const m: str = fresh_doc(i)["mrn"]   # checked downcast
            out.append(m)
            i = i + 1
        }
        self.assertEqual(len(out), 300)
        self.assertEqual(out[299], "A299")
        self.assertEqual(churn(), 200)
    }

    def test_user_getitem_returning_any() {
        r: Doc = Doc({"mrn": "A1"})
        out: list[str] = []
        const rm: str = r["mrn"]        # checked downcast to the declared arm
        out.append(rm)
        self.assertEqual(out[0], "A1")
        const m: str = r["mrn"]
        self.assertEqual(m, "A1")
    }

    def test_wrong_runtime_type_raises_not_segv() {
        d: dict[str, Boxed] = {"mrn": 7}
        raised: bool = False
        try {
            const mv3: str = d["mrn"]        # checked downcast to the declared arm
            print(arg_len(mv3))
        } except TypeError {
            raised = True
        }
        self.assertTrue(raised)
    }

    def test_wrong_runtime_type_on_append_raises() {
        d: dict[str, Boxed] = {"mrn": 7}
        out: list[str] = []
        raised: bool = False
        try {
            const mv4: str = d["mrn"]        # checked downcast to the declared arm
            out.append(mv4)
        } except TypeError {
            raised = True
        }
        self.assertTrue(raised)
        self.assertEqual(len(out), 0)
    }

    def test_source_dict_survives_every_narrowing() {
        d: dict[str, Boxed] = {"mrn": "A1"}
        out: list[str] = []
        i: int = 0
        while i < 300 {
            const mv5: str = d["mrn"]        # checked downcast to the declared arm
            out.append(mv5)
            i = i + 1
        }
        self.assertEqual(len(out), 300)
        self.assertEqual(out[299], "A1")
        const still: str = d["mrn"]
        self.assertEqual(still, "A1")
        self.assertEqual(churn(), 200)
    }
}


class Keeper {
    v: Boxed
    def(v: Boxed) {
        self.v = v
    }
    def replace(nv: Boxed) {
        self.v = nv
    }
}


class DoubleKeeper {
    a: Boxed
    b: Boxed
    def(v: Boxed) {
        self.a = v
        self.b = v
    }
}


def sink(x: Boxed) -> int {
    return 1
}


def echo(x: Boxed) -> Boxed {
    return x
}


class ABase {
    def m(v: Boxed) -> int {
        return 1
    }
}


class AStore(ABase) {
    kept: Boxed
    def() {
        self.kept = 0
    }
    def m(v: Boxed) -> int {
        self.kept = v
        return 2
    }
}


def call_m(a: ABase, v: Boxed) -> int {
    return a.m(v)
}



def replace_union_param(p: Boxed) -> str {
    p = "replaced-one"
    const out: str = p
    return out
}


def replace_union_param_when(p: Boxed, flag: bool) -> str {
    if flag {
        p = "replaced-two"
    }
    const out: str = p
    return out
}


def replace_union_local(seed: str) -> str {
    v: Boxed = seed
    v = "local-" + str(3)
    const out: str = v
    return out
}



def str_param_maybe_replaced(v: str, flag: bool) -> int {
    if flag {
        v = "rep-" + str(1)
    }
    return len(v)
}


def str_param_both_branches(v: str, flag: bool) -> int {
    if flag {
        v = "yes-" + str(1)
    } else {
        v = "no-" + str(22)
    }
    return len(v)
}


def str_param_replaced_in_loop(v: str, rounds: int) -> int {
    i: int = 0
    while i < rounds {
        v = "iter-" + str(i)
        i = i + 1
    }
    return len(v)
}


def str_param_appended(v: str, flag: bool) -> int {
    if flag {
        v += "-tail"
    }
    return len(v)
}


def str_param_raises_before_store(v: str, boom: bool) -> int {
    if boom {
        raise ValueError("before")
    }
    v = "rep-" + str(1)
    return len(v)
}


def str_param_raises_after_store(v: str, boom: bool) -> int {
    v = "rep-" + str(2)
    if boom {
        raise ValueError("after")
    }
    return len(v)
}


def str_param_raises_in_loop(v: str, boom: bool) -> int {
    i: int = 0
    while i < 4 {
        v = "iter-" + str(i)
        if boom {
            if i == 2 {
                raise ValueError("loop")
            }
        }
        i = i + 1
    }
    return len(v)
}


def union_param_raises_before_store(p: Boxed, boom: bool) -> int {
    if boom {
        raise ValueError("before")
    }
    p = "rep-" + str(3)
    const out: str = p
    return len(out)
}


def union_param_raises_after_store(p: Boxed, boom: bool) -> int {
    p = "rep-" + str(4)
    if boom {
        raise ValueError("after")
    }
    const out: str = p
    return len(out)
}


def str_param_never_replaced(v: str) -> int {
    return len(v)
}


def union_param_owned_temp(p: Boxed) -> int {
    p = "temp-" + str(1)
    const out: str = p
    return len(out)
}



def temp_dict_elem(n: int) -> int {
    const m: str = fresh_doc(n)["mrn"]
    return len(m)
}


def fresh_nested(n: int) -> dict[str, Boxed] {
    const inner: dict[str, Boxed] = {"mrn": "N" + str(n)}
    return {"row": inner}
}


def temp_nested_elem(n: int) -> int {
    const row: dict[str, Boxed] = fresh_nested(n)["row"]
    const m: str = row["mrn"]
    return len(m)
}


def plain_dict_elem(n: int) -> int {
    const d: dict[str, str] = {"mrn": "A" + str(n)}
    const m: str = d["mrn"]
    return len(m)
}


def rendered_temp_elem(n: int) -> int {
    return len(str(fresh_doc(n)["mrn"]))
}


def rendered_get_hit(d: dict[str, Boxed]) -> int {
    return len(str(d.get("mrn", "fallback")))
}


def rendered_get_miss(d: dict[str, Boxed]) -> int {
    return len(str(d.get("zz", "fallback")))
}


def rendered_plain_elem(d: dict[str, Boxed]) -> int {
    return len(str(d["mrn"]))
}


def rendered_fstring_temp(n: int) -> int {
    return len(f"{fresh_doc(n)['mrn']}")
}


def rendered_owned_tuple(n: int) -> int {
    return len(str(tuple([n, n + 1])))
}


def rendered_owned_list(n: int) -> int {
    return len(str(sorted([n + 1, n])))
}


class AnyOwnershipTests(TestCase) {
    def test_borrowed_alias_survives_instance_death() {
        p: Boxed = "alias " + str(1)
        k: Keeper = Keeper(p)
        k = Keeper(0)
        narrowed: int = 0
        if isinstance(p, str) {
            const s: str = p
            self.assertEqual(s, "alias 1")
            narrowed = 1
        }
        self.assertEqual(narrowed, 1)
    }

    def test_double_adopt_two_fields() {
        p: Boxed = "dbl " + str(2)
        d: DoubleKeeper = DoubleKeeper(p)
        d = DoubleKeeper(0)
        narrowed: int = 0
        if isinstance(p, str) {
            const s: str = p
            self.assertEqual(s, "dbl 2")
            narrowed = 1
        }
        self.assertEqual(narrowed, 1)
    }

    def test_owned_temp_to_borrow_any_param_churn() {
        total: int = 0
        i: int = 0
        while i < 1000 {
            total = total + sink("t" + str(i))
            i = i + 1
        }
        self.assertEqual(total, 1000)
    }

    def test_owned_temp_via_method_store_churn() {
        k: Keeper = Keeper(0)
        i: int = 0
        while i < 1000 {
            k.replace("v" + str(i))
            i = i + 1
        }
        const back: Boxed = k.v
        narrowed: int = 0
        if isinstance(back, str) {
            const s: str = back
            self.assertEqual(s, "v999")
            narrowed = 1
        }
        self.assertEqual(narrowed, 1)
    }

    def test_direct_field_assign_owned_temp_churn() {
        k: Keeper = Keeper(0)
        i: int = 0
        while i < 1000 {
            k.v = "d" + str(i)
            i = i + 1
        }
        const back: Boxed = k.v
        narrowed: int = 0
        if isinstance(back, str) {
            const s: str = back
            self.assertEqual(s, "d999")
            narrowed = 1
        }
        self.assertEqual(narrowed, 1)
    }

    def test_ctor_owned_temp_churn() {
        i: int = 0
        while i < 1000 {
            k: Keeper = Keeper("c" + str(i))
            i = i + 1
        }
    }

    def test_borrowed_native_str_into_field() {
        s: str = "keep " + str(6)
        k: Keeper = Keeper(0)
        k.v = s
        k = Keeper(0)
        self.assertEqual(s, "keep 6")
    }

    def test_echo_roundtrip() {
        p: Boxed = echo("e" + str(3))
        narrowed: int = 0
        if isinstance(p, str) {
            const s: str = p
            self.assertEqual(s, "e3")
            narrowed = 1
        }
        self.assertEqual(narrowed, 1)
    }


    def test_union_param_assign_keeps_caller_value() {
        i: int = 0
        while i < 1000 {
            held: Boxed = "held-" + str(i)
            self.assertEqual(replace_union_param(held), "replaced-one")
            const still: str = held
            self.assertEqual(still, "held-" + str(i))
            i = i + 1
        }
    }

    def test_union_param_conditional_assign_not_taken() {
        i: int = 0
        while i < 1000 {
            held: Boxed = "kept-" + str(i)
            self.assertEqual(replace_union_param_when(held, False),
                             "kept-" + str(i))
            const still: str = held
            self.assertEqual(still, "kept-" + str(i))
            i = i + 1
        }
    }

    def test_union_param_conditional_assign_taken() {
        i: int = 0
        while i < 1000 {
            held: Boxed = "swap-" + str(i)
            self.assertEqual(replace_union_param_when(held, True), "replaced-two")
            const still: str = held
            self.assertEqual(still, "swap-" + str(i))
            i = i + 1
        }
    }

    def test_union_local_assign_releases_old() {
        i: int = 0
        while i < 1000 {
            self.assertEqual(replace_union_local("seed-" + str(i)), "local-3")
            i = i + 1
        }
    }


    def test_str_param_conditional_replace_not_taken() {
        i: int = 0
        while i < 1000 {
            held: str = "keep-" + str(i)
            self.assertEqual(str_param_maybe_replaced(held, False), len(held))
            self.assertEqual(held, "keep-" + str(i))
            i = i + 1
        }
    }

    def test_str_param_conditional_replace_taken() {
        i: int = 0
        while i < 1000 {
            held: str = "keep-" + str(i)
            self.assertEqual(str_param_maybe_replaced(held, True), 5)
            self.assertEqual(held, "keep-" + str(i))
            i = i + 1
        }
    }

    def test_str_param_replaced_on_both_branches() {
        i: int = 0
        while i < 1000 {
            held: str = "keep-" + str(i)
            self.assertEqual(str_param_both_branches(held, True), 5)
            self.assertEqual(str_param_both_branches(held, False), 5)
            self.assertEqual(held, "keep-" + str(i))
            i = i + 1
        }
    }

    def test_str_param_replaced_in_loop() {
        i: int = 0
        while i < 1000 {
            held: str = "keep-" + str(i)
            self.assertEqual(str_param_replaced_in_loop(held, 4), 6)
            self.assertEqual(held, "keep-" + str(i))
            i = i + 1
        }
    }


    def test_str_param_augmented_append() {
        i: int = 0
        while i < 1000 {
            held: str = "keep-" + str(i)
            self.assertEqual(str_param_appended(held, False), len(held))
            self.assertEqual(str_param_appended(held, True), len(held) + 5)
            self.assertEqual(held, "keep-" + str(i))
            i = i + 1
        }
    }


    def test_str_param_unwind_before_store() {
        i: int = 0
        while i < 2000 {
            held: str = "keep-" + str(i)
            n: int = 0
            try {
                n = str_param_raises_before_store(held, i % 2 == 0)
            } except ValueError {
                n = -1
            }
            self.assertEqual(held, "keep-" + str(i))
            i = i + 1
        }
    }

    def test_str_param_unwind_after_store() {
        i: int = 0
        while i < 2000 {
            held: str = "keep-" + str(i)
            n: int = 0
            try {
                n = str_param_raises_after_store(held, i % 2 == 0)
            } except ValueError {
                n = -1
            }
            self.assertEqual(held, "keep-" + str(i))
            i = i + 1
        }
    }

    def test_str_param_unwind_in_loop() {
        i: int = 0
        while i < 2000 {
            held: str = "keep-" + str(i)
            n: int = 0
            try {
                n = str_param_raises_in_loop(held, i % 2 == 0)
            } except ValueError {
                n = -1
            }
            self.assertEqual(held, "keep-" + str(i))
            i = i + 1
        }
    }

    def test_union_param_unwind_before_store() {
        i: int = 0
        while i < 2000 {
            held: Boxed = "held-" + str(i)
            n: int = 0
            try {
                n = union_param_raises_before_store(held, i % 2 == 0)
            } except ValueError {
                n = -1
            }
            const still: str = held
            self.assertEqual(still, "held-" + str(i))
            i = i + 1
        }
    }

    def test_union_param_unwind_after_store() {
        i: int = 0
        while i < 2000 {
            held: Boxed = "held-" + str(i)
            n: int = 0
            try {
                n = union_param_raises_after_store(held, i % 2 == 0)
            } except ValueError {
                n = -1
            }
            const still: str = held
            self.assertEqual(still, "held-" + str(i))
            i = i + 1
        }
    }

    def test_str_param_never_replaced() {
        i: int = 0
        while i < 1000 {
            held: str = "keep-" + str(i)
            self.assertEqual(str_param_never_replaced(held), len(held))
            self.assertEqual(held, "keep-" + str(i))
            i = i + 1
        }
    }

    def test_union_param_owned_temp_assign() {
        i: int = 0
        while i < 1000 {
            held: Boxed = "held-" + str(i)
            self.assertEqual(union_param_owned_temp(held), 6)
            const still: str = held
            self.assertEqual(still, "held-" + str(i))
            i = i + 1
        }
    }


    def test_temp_boxed_dict_elem_read() {
        i: int = 0
        while i < 300 {
            self.assertEqual(temp_dict_elem(i), len("A" + str(i)))
            i = i + 1
        }
    }

    def test_temp_boxed_dict_nested_elem_read() {
        i: int = 0
        while i < 300 {
            self.assertEqual(temp_nested_elem(i), len("N" + str(i)))
            i = i + 1
        }
    }

    def test_temp_plain_dict_elem_read() {
        i: int = 0
        while i < 300 {
            self.assertEqual(plain_dict_elem(i), len("A" + str(i)))
            i = i + 1
        }
    }

    def test_virtual_override_stores_param() {
        b: AStore = AStore()
        n: int = call_m(b, "vs " + str(4))
        self.assertEqual(n, 2)
        const back: Boxed = b.kept
        narrowed: int = 0
        if isinstance(back, str) {
            const s: str = back
            self.assertEqual(s, "vs 4")
            narrowed = 1
        }
        self.assertEqual(narrowed, 1)
    }

    def test_str_of_an_owned_box_releases_it() {
        total: int = 0
        i: int = 0
        while i < 300 {
            total = total + rendered_temp_elem(i)
            i = i + 1
        }
        self.assertEqual(total, 1090)
    }

    def test_str_of_a_get_hit_releases_the_retained_box() {
        d: dict[str, Boxed] = {"mrn": "A1"}
        total: int = 0
        i: int = 0
        while i < 300 {
            total = total + rendered_get_hit(d)
            i = i + 1
        }
        self.assertEqual(total, 600)
        self.assertEqual(len(d), 1)
    }

    def test_str_of_a_get_miss_releases_the_default() {
        d: dict[str, Boxed] = {"mrn": "A1"}
        total: int = 0
        i: int = 0
        while i < 300 {
            total = total + rendered_get_miss(d)
            i = i + 1
        }
        self.assertEqual(total, 2400)
    }

    def test_str_of_a_borrowed_box_keeps_it_alive() {
        d: dict[str, Boxed] = {"mrn": "A1"}
        total: int = 0
        i: int = 0
        while i < 300 {
            total = total + rendered_plain_elem(d)
            i = i + 1
        }
        self.assertEqual(total, 600)
        const back: str = d["mrn"]
        self.assertEqual(back, "A1")
    }

    def test_fstring_of_an_owned_box_releases_it() {
        total: int = 0
        i: int = 0
        while i < 300 {
            total = total + rendered_fstring_temp(i)
            i = i + 1
        }
        self.assertEqual(total, 1090)
    }

    def test_str_of_an_owned_container_is_released_once() {
        total: int = 0
        i: int = 0
        while i < 300 {
            total = total + rendered_owned_tuple(i) + rendered_owned_list(i)
            i = i + 1
        }
        self.assertTrue(total > 0)
    }

}


class Sink {
    def take[T](x: T) -> int {
        return 1
    }
}

class GenericMethodArgRc(TestCase) {
    def test_owned_str_result_arg() {
        s: Sink = Sink()
        i: int = 0
        while i < N {
            const r: int = s.take(("ab" + "cd").upper())
            self.assertEqual(r, 1)
            i = i + 1
        }
    }

    def test_owned_box_result_arg() {
        s: Sink = Sink()
        i: int = 0
        while i < N {
            const m: Boxed = {"k": "value"}
            const r: int = s.take(m["k"])
            self.assertEqual(r, 1)
            i = i + 1
        }
    }

    def test_assertequal_owned_hex() {
        i: int = 0
        while i < N {
            const b: bytes = "hello".encode()
            self.assertEqual(b.hex(), "68656c6c6f")
            i = i + 1
        }
    }
}


main([TestAnyArgNarrow(), AnyOwnershipTests(), GenericMethodArgRc()])

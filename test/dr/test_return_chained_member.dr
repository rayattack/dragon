from unittest import TestCase, main


class Field {
    name: str
    tag: int

    def(name: str, tag: int) {
        self.name = name
        self.tag = tag
    }
}


class Nest {
    one: Field

    def(f: Field) {
        self.one = f
    }
}


class SoleOwner {
    own one: Field
    by_id: dict[int, Field]

    def(nm: str) {
        self.one = Field(nm, 0)
        self.by_id = {}
        self.by_id[0] = Field(nm, 0)
    }
}


class Holder {
    by_id: dict[int, Field]
    by_name: dict[str, Field]
    by_ix: list[Field]

    def(items: list[Field], by_id: dict[int, Field], by_name: dict[str, Field]) {
        self.by_ix = items
        self.by_id = by_id
        self.by_name = by_name
    }
}


def _build() -> Holder {
    items: list[Field] = []
    ids: dict[int, Field] = {}
    names: dict[str, Field] = {}
    i: int = 0
    while i < 16 {
        const nm: str = "field_" + str(i)
        const f: Field = Field(nm, i)
        items.append(f)
        ids[i] = f
        names[nm] = f
        i = i + 1
    }
    return Holder(items, ids, names)
}


def via_int_dict(b: Holder, fid: int) -> str {
    return b.by_id[fid].name
}


def via_str_dict(b: Holder, key: str) -> str {
    return b.by_name[key].name
}


def via_list(b: Holder, ix: int) -> str {
    return b.by_ix[ix].name
}


def via_nested_member(n: Nest) -> str {
    return n.one.name
}


def via_int_member(b: Holder, fid: int) -> int {
    return b.by_id[fid].tag
}


def via_bound_local(b: Holder, fid: int) -> str {
    const f: Field = b.by_id[fid]
    const nm: str = f.name
    return nm
}


def from_own_param_member(own s: SoleOwner) -> str {
    return s.one.name
}


def from_own_param_dict(own s: SoleOwner) -> str {
    return s.by_id[0].name
}


def after_del_of_receiver(tag: int) -> str {
    h: SoleOwner = SoleOwner("deleted_" + str(tag))
    const nm: str = h.one.name
    del h
    return nm
}


class ChainedIntDictReturnTest(TestCase) {
    def test_int_keyed_dict_chain_survives_repeated_returns() -> None {
        const b: Holder = _build()
        r: int = 0
        while r < 4 {
            i: int = 0
            while i < 16 {
                const got: str = via_int_dict(b, i)
                self.assertEqual(got, "field_" + str(i))
                i = i + 1
            }
            r = r + 1
        }

        seen: dict[str, int] = {}
        j: int = 0
        while j < 16 {
            const key: str = via_int_dict(b, j)
            seen[key] = j
            j = j + 1
        }
        self.assertEqual(len(seen), 16)

        m: int = 0
        while m < 16 {
            const want: str = "field_" + str(m)
            self.assertTrue(want in seen)
            m = m + 1
        }
    }
}


class ChainedStrDictReturnTest(TestCase) {
    def test_str_keyed_dict_chain_survives_repeated_returns() -> None {
        const b: Holder = _build()
        seen: dict[str, int] = {}
        r: int = 0
        while r < 4 {
            i: int = 0
            while i < 16 {
                const want: str = "field_" + str(i)
                const got: str = via_str_dict(b, want)
                self.assertEqual(got, want)
                seen[got] = i
                i = i + 1
            }
            r = r + 1
        }
        self.assertEqual(len(seen), 16)
    }
}


class ChainedListReturnTest(TestCase) {
    def test_list_chain_survives_repeated_returns() -> None {
        const b: Holder = _build()
        seen: dict[str, int] = {}
        r: int = 0
        while r < 4 {
            i: int = 0
            while i < 16 {
                const got: str = via_list(b, i)
                self.assertEqual(got, "field_" + str(i))
                seen[got] = i
                i = i + 1
            }
            r = r + 1
        }
        self.assertEqual(len(seen), 16)
    }
}


class NestedMemberReturnTest(TestCase) {
    def test_nested_member_chain_survives_repeated_returns() -> None {
        const n: Nest = Nest(Field("only_" + str(1), 1))
        seen: dict[str, int] = {}
        i: int = 0
        while i < 32 {
            const got: str = via_nested_member(n)
            self.assertEqual(got, "only_1")
            seen[got] = i
            i = i + 1
        }
        self.assertEqual(len(seen), 1)
        self.assertTrue("only_1" in seen)
    }
}


class ChainedControlsTest(TestCase) {
    def test_int_chain_and_bound_local_stay_correct() -> None {
        const b: Holder = _build()
        i: int = 0
        while i < 16 {
            self.assertEqual(via_int_member(b, i), i)
            i = i + 1
        }

        seen: dict[str, int] = {}
        r: int = 0
        while r < 4 {
            j: int = 0
            while j < 16 {
                const got: str = via_bound_local(b, j)
                self.assertEqual(got, "field_" + str(j))
                seen[got] = j
                j = j + 1
            }
            r = r + 1
        }
        self.assertEqual(len(seen), 16)
    }
}


class OwnedReceiverReturnTest(TestCase) {
    def test_own_param_member_chain_outlives_the_destroyed_receiver() -> None {
        seen: dict[str, int] = {}
        i: int = 0
        while i < 8 {
            a: SoleOwner = SoleOwner("owned_" + str(i))
            const got: str = from_own_param_member(own a)
            self.assertEqual(got, "owned_" + str(i))
            seen[got] = i
            i = i + 1
        }
        self.assertEqual(len(seen), 8)
        self.assertTrue("owned_3" in seen)
    }

    def test_own_param_dict_chain_outlives_the_destroyed_receiver() -> None {
        seen: dict[str, int] = {}
        i: int = 0
        while i < 8 {
            b: SoleOwner = SoleOwner("downed_" + str(i))
            const got: str = from_own_param_dict(own b)
            self.assertEqual(got, "downed_" + str(i))
            seen[got] = i
            i = i + 1
        }
        self.assertEqual(len(seen), 8)
        self.assertTrue("downed_5" in seen)
    }

    def test_a_deleted_receiver_leaves_the_returned_name_intact() -> None {
        seen: dict[str, int] = {}
        i: int = 0
        while i < 8 {
            const got: str = after_del_of_receiver(i)
            self.assertEqual(got, "deleted_" + str(i))
            seen[got] = i
            i = i + 1
        }
        self.assertEqual(len(seen), 8)
    }
}


main([ChainedIntDictReturnTest(), ChainedStrDictReturnTest(),
      ChainedListReturnTest(), NestedMemberReturnTest(),
      ChainedControlsTest(), OwnedReceiverReturnTest()])

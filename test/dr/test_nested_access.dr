type Boxed = int | float | bool | str | bytes | none | list[int] | list[str] | list[Boxed] | dict[str, int] | dict[str, str] | dict[str, Boxed]

from unittest import TestCase, main
from json import dumps


class IterInner {
    ds: dict[str, int]
    di: dict[int, str]
    title: str
    xs: list[int]

    def() {
        self.ds = {}
        self.ds["x"] = 1
        self.ds["y"] = 2
        self.di = {}
        self.di[10] = "a"
        self.di[20] = "b"
        self.title = "abc"
        self.xs = [7, 8, 9]
    }
}

class IterOuter {
    inner: IterInner

    def(inner: IterInner) {
        self.inner = inner
    }

    def str_keys() -> str {
        parts: list[str] = []
        for k in self.inner.ds {
            parts.append(k)
        }
        return ",".join(parts)
    }

    def int_keys() -> int {
        total: int = 0
        for k in self.inner.di {
            total = total + k
        }
        return total
    }

    def items_sum() -> int {
        total: int = 0
        for k, v in self.inner.ds.items() {
            total = total + v
        }
        return total
    }

    def keys_join() -> str {
        parts: list[str] = []
        for k in self.inner.ds.keys() {
            parts.append(k)
        }
        return ",".join(parts)
    }

    def chars() -> int {
        n: int = 0
        for c in self.inner.title {
            n = n + 1
        }
        return n
    }

    def list_sum() -> int {
        total: int = 0
        for x in self.inner.xs {
            total = total + x
        }
        return total
    }
}


class StoreInner {
    a: int
    b: int
    tags: dict[int, bytes]
    names: list[str]

    def() {
        self.a = 1
        self.b = 2
        self.tags = {}
        self.names = ["x"]
    }
}

class StoreMiddle {
    inner: StoreInner

    def(x: StoreInner) {
        self.inner = x
    }
}

class StoreOuter {
    mid: StoreMiddle

    def(m: StoreMiddle) {
        self.mid = m
    }

    def poke_two_level(v: int) -> None {
        self.mid.inner.a = v
    }
}


class Point {
    x: int

    def (x: int) {
        self.x = x
    }
}


def _dumps_cyclic_dict() {
    d: dict[str, Boxed] = {}
    d["self"] = d
    dumps(d)
}


def _dumps_cyclic_list() {
    l: list[Boxed] = []
    l.append(l)
    dumps(l)
}


def _getattr_missing() {
    p: Point = Point(1)
    name: str = "no" + "pe"
    getattr(p, name)
}


class NestedAttrIterationTests(TestCase) {
    """Iterating a container reached through a NESTED attribute chain.

    You did nothing wrong: ordinary code like

        class Db { schemas: dict[str, int] }
        class Shell {
            db: Db
            def names() -> None {
                for k in self.db.schemas { ... }
            }
        }

    crashed, while the same loop over a local copy (`d: dict[str, int] =
    self.db.schemas` then `for k in d`) worked. The for-loop codegen resolved the
    owning class only for single-level `self.field` / `obj.field` iterables; a
    nested base (`self.db.schemas`) resolved to no class, fell through to the
    LIST default, and the loop read the dict's heap pages as list slots: a
    heap-buffer-overflow that ASan flags immediately and that segfaults in a
    plain build the moment the fake slot is dereferenced. It bites whenever a
    class holds another class that holds a dict - a wrapper over a database, a
    config inside an app object - and the wrapper iterates it directly.

    The fix resolves the owner class of a nested base with the same resolution
    the dict key-kind lookup already used (resolveExprClassName), and when the
    field kind still is not tracked, falls back to the iterable's stamped static
    type instead of assuming list. Before: `for k in self.db.schemas` crashed.
    After: the identical line iterates the dict's keys, str- and int-keyed alike
    """

    def test_str_keyed_dict_keys() {
        o: IterOuter = IterOuter(IterInner())
        self.assertEqual(o.str_keys(), "x,y")
    }

    def test_int_keyed_dict_keys() {
        o: IterOuter = IterOuter(IterInner())
        self.assertEqual(o.int_keys(), 30)
    }

    def test_items_unpack_on_nested_chain() {
        o: IterOuter = IterOuter(IterInner())
        self.assertEqual(o.items_sum(), 3)
    }

    def test_keys_call_on_nested_chain() {
        o: IterOuter = IterOuter(IterInner())
        self.assertEqual(o.keys_join(), "x,y")
    }

    def test_str_field_iterates_chars() {
        o: IterOuter = IterOuter(IterInner())
        self.assertEqual(o.chars(), 3)
    }

    def test_list_field_still_list() {
        o: IterOuter = IterOuter(IterInner())
        self.assertEqual(o.list_sum(), 24)
    }
}


class NestedAttrStoreTest(TestCase) {
    def test_two_level_store_outside() -> None {
        x: StoreInner = StoreInner()
        m: StoreMiddle = StoreMiddle(x)
        m.inner.a = 123
        self.assertEqual(m.inner.a, 123)
        self.assertEqual(x.a, 123)
    }

    def test_two_level_store_in_method() -> None {
        x: StoreInner = StoreInner()
        m: StoreMiddle = StoreMiddle(x)
        vals: list[int] = [99]
        m.inner.b = vals[0]
        self.assertEqual(x.b, 99)
    }

    def test_three_level_store() -> None {
        x: StoreInner = StoreInner()
        o: StoreOuter = StoreOuter(StoreMiddle(x))
        o.poke_two_level(55)
        self.assertEqual(x.a, 55)
        o.mid.inner.b = 66
        self.assertEqual(x.b, 66)
    }

    def test_compound_assign() -> None {
        x: StoreInner = StoreInner()
        m: StoreMiddle = StoreMiddle(x)
        m.inner.a = m.inner.a + 10
        self.assertEqual(x.a, 11)
    }

    def test_container_store_through_chain() -> None {
        x: StoreInner = StoreInner()
        m: StoreMiddle = StoreMiddle(x)
        m.inner.tags[7] = bytes([1, 2, 3])
        self.assertEqual(len(x.tags), 1)
        got: bytes = x.tags[7]
        self.assertEqual(got[2], 3)
        m.inner.names[0] = "changed"
        self.assertEqual(x.names[0], "changed")
    }

    def test_aug_assign() -> None {
        x: StoreInner = StoreInner()
        m: StoreMiddle = StoreMiddle(x)
        m.inner.a += 5
        self.assertEqual(x.a, 6)
        m.inner.a -= 2
        self.assertEqual(x.a, 4)
        o: StoreOuter = StoreOuter(m)
        o.mid.inner.b *= 10
        self.assertEqual(x.b, 20)
    }
}


class NestedSubscriptStore(TestCase) {
    """Chained subscript stores must mutate the inner container (J7).

    Regression for the silent-no-op family: `outer[0][1] = x`, `d["a"][0] = x`,
    `m[0]["k"] = x` and their augmented twins compiled to nothing because the
    assign path only recognized bare-name and field receivers, never a subscript
    receiver typed by the checker. Aliasing through a local always worked, which
    is exactly what made the bug invisible.
    """

    def test_list_in_list_store() {
        outer: list[list[int]] = [[1, 2], [3, 4]]
        outer[0][1] = 9
        self.assertEqual(outer[0][1], 9)
        outer[1][0] = -5
        self.assertEqual(outer[1][0], -5)
    }

    def test_list_in_dict_store() {
        d: dict[str, list[int]] = {"a": [1, 2]}
        d["a"][0] = 7
        self.assertEqual(d["a"][0], 7)
    }

    def test_dict_in_list_store() {
        m: list[dict[str, int]] = [{"k": 1}]
        m[0]["k"] = 5
        self.assertEqual(m[0]["k"], 5)
    }

    def test_three_level_store() {
        deep: list[list[list[int]]] = [[[1]]]
        deep[0][0][0] = 42
        self.assertEqual(deep[0][0][0], 42)
    }

    def test_heap_elem_store() {
        names: list[list[str]] = [["a", "b"]]
        names[0][1] = "z"
        self.assertEqual(names[0][1], "z")
    }

    def test_aug_assign_list_in_list() {
        outer: list[list[int]] = [[1, 2], [3, 4]]
        outer[0][1] += 10
        self.assertEqual(outer[0][1], 12)
        outer[1][1] -= 4
        self.assertEqual(outer[1][1], 0)
    }

    def test_aug_assign_list_in_dict() {
        d: dict[str, list[int]] = {"a": [1, 2]}
        d["a"][0] += 6
        self.assertEqual(d["a"][0], 7)
    }

    def test_aug_assign_dict_in_list() {
        m: list[dict[str, int]] = [{"k": 1}]
        m[0]["k"] += 4
        self.assertEqual(m[0]["k"], 5)
    }
}


class CycleTests(TestCase) {
    def test_str_cyclic_list() {
        l: list[Boxed] = []
        l.append(l)
        self.assertEqual(str(l), "[[...]]")
    }

    def test_str_cyclic_dict() {
        d: dict[str, Boxed] = {}
        d["self"] = d
        self.assertEqual(str(d), "{'self': {...}}")
    }

    def test_print_cyclic_no_crash() {
        l: list[Boxed] = []
        l.append(l)
        print(l)
        self.assertTrue(true)
    }

    def test_dumps_cyclic_raises() {
        self.assertRaises(ValueError, _dumps_cyclic_dict)
        self.assertRaises(ValueError, _dumps_cyclic_list)
    }

    def test_acyclic_shared_subtree_still_renders() {
        inner: list[int] = [1, 2]
        outer: list[Boxed] = []
        outer.append(inner)
        outer.append(inner)
        self.assertEqual(str(outer), "[[1, 2], [1, 2]]")
    }
}


class NonAsciiContainerTests(TestCase) {
    def test_dict_str_nonascii() {
        d: dict[str, str] = {"é": "ü€"}
        self.assertEqual(str(d), "{'é': 'ü€'}")
    }

    def test_nested_list_nonascii() {
        xs: list[str] = ["Āb", "€"]
        self.assertEqual(str(xs), "['Āb', '€']")
    }
}


class GetattrTests(TestCase) {
    def test_missing_raises() {
        self.assertRaises(AttributeError, _getattr_missing)
    }

    def test_default_still_works() {
        p: Point = Point(7)
        missing: int = getattr(p, "nope", 42)
        present: int = getattr(p, "x", 0)
        self.assertEqual(missing, 42)
        self.assertEqual(present, 7)
    }
}


def count_tags(text: str) -> int {
    def is_tag(c: str, open_mark: str = "<") -> bool {
        return c == open_mark
    }
    n: int = 0
    for c in text {
        if is_tag(c) {
            n = n + 1
        }
        if is_tag(c, ">") {
            n = n + 1
        }
    }
    return n
}


def greet_all(names: list[str]) -> list[str] {
    suffix: str = "!"
    def greet(name: str, opener: str = "hi ", closer: str = suffix) -> str {
        return opener + name + closer
    }
    out: list[str] = []
    for name in names {
        out.append(greet(name))
    }
    suffix = "?"
    out.append(greet("late"))
    out.append(greet("all", "yo "))
    return out
}


def sum_with_fresh_default(n: int) -> int {
    def total(xs: list[int] = [1, 2, 3]) -> int {
        acc: int = 0
        for x in xs {
            acc = acc + x
        }
        return acc
    }
    result: int = 0
    i: int = 0
    while i < n {
        result = result + total()
        i = i + 1
    }
    return result + total([10])
}


def captured_with_default(base: int) -> int {
    def scaled(k: int = 2) -> int {
        return base * k
    }
    return scaled() + scaled(3)
}


def label_with_keywords(n: int) -> str {
    def h(a: int, b: str = "b", c: str = "c") -> str {
        return str(a) + b + c
    }
    return h(n, b="z") + "|" + h(n, c="z") + "|" + h(n, c="y", b="x") + "|" + h(n)
}


def capturing_keyword_default(base: int) -> int {
    def scaled(k: int = 2, extra: int = 0) -> int {
        return base * k + extra
    }
    return scaled(extra=1) + scaled(k=3) + scaled(3, extra=base)
}


class NestedDefaultArgTests(TestCase) {
    def test_keyword_arguments_fill_around_defaults() {
        self.assertEqual(label_with_keywords(1), "1zc|1bz|1xy|1bc")
    }

    def test_keyword_arguments_on_a_capturing_nested_def() {
        self.assertEqual(capturing_keyword_default(5), 11 + 15 + 20)
    }

    def test_nested_def_called_without_its_default() {
        self.assertEqual(count_tags("".join(["a<b>", "<c"])), 3)
    }

    def test_defaults_read_the_enclosing_scope_at_call_time() {
        self.assertEqual(greet_all(["x", "y"]), ["hi x!", "hi y!", "hi late?", "yo all?"])
    }

    def test_a_fresh_default_is_released_every_call() {
        self.assertEqual(sum_with_fresh_default(3000), 3000 * 6 + 10)
    }

    def test_a_capturing_nested_def_keeps_its_default() {
        self.assertEqual(captured_with_default(5), 25)
    }
}


main([NestedAttrIterationTests(), NestedAttrStoreTest(), NestedSubscriptStore(),
      CycleTests(), NonAsciiContainerTests(), GetattrTests(), NestedDefaultArgTests()])

from unittest import TestCase, main


def add3(a: int, b: int, c: int) -> int {
    return a + b + c
}

def describe(n: int, label: str) -> str {
    return label + "=" + str(n)
}

def addf(x: float, y: float) -> float {
    return x + y
}

def cat2(x: str, y: str) -> str {
    return x + y
}

def greet(name: str, greeting: str) -> str {
    return greeting + ", " + name
}

def show_any(a: Any, b: Any) -> str {
    return str(a) + "/" + str(b)
}

def with_default(a: int, b: int, c: int = 100) -> int {
    return a + b + c
}


class Point {
    x: int
    y: int
    def(x: int, y: int) {
        self.x = x
        self.y = y
    }
    def manhattan() -> int { return self.x + self.y }
}


class Calc {
    base: int
    def(base: int) { self.base = base }
    def add3(a: int, b: int, c: int) -> int { return self.base + a + b + c }
    def tag(n: int, label: str) -> str { return label + ":" + str(n + self.base) }
}


class Wrap {
    c: Calc
    def(c: Calc) { self.c = c }
    def run(t: tuple[int, int, int]) -> int { return self.c.add3(*t) }
}


class Animal {
    def combine(a: int, b: int) -> str { return "animal:" + str(a + b) }
}

class Dog(Animal) {
    def combine(a: int, b: int) -> str { return "dog:" + str(a * b) }
}


class TupleSpreadDirectTests(TestCase) {
    """C9-B - general call-site spread (`*tuple` / `*list` / `**dict`), decisions/047.

    Covers spread into free functions, class constructors, and instance/static
    methods (incl. virtual dispatch), plus vararg-param forwarding:
      - `*tuple` static spread: homogeneous, heterogeneous, leading-positional,
        float (native f64), boxed `Any` params, heap (str) elements, + named kwarg.
      - `*list[T]` dynamic spread: typed loads + runtime length-mismatch raise.
      - `**dict` spread: bind-by-name, optional-defaulted, missing-required raise,
        unexpected-key raise.
      - mixed `f(*t, **d)`; `*args`-as-`list` forwarding into a fixed-arity callee.

    Cost model: `*tuple` is compile-time/free (per-element typed loads, static
    arity, no runtime check); `*list` adds a runtime length check; `**dict` does
    one hash lookup per parameter. Writing `*`/`**` is the explicit opt-in.
    """

    def test_homogeneous_int() {
        coords: tuple[int, int, int] = (10, 20, 30)
        self.assertEqual(add3(*coords), 60)
    }

    def test_heterogeneous() {
        pair: tuple[int, str] = (7, "seven")
        self.assertEqual(describe(*pair), "seven=7")
    }

    def test_leading_positional_then_spread() {
        rest: tuple[int, int] = (5, 6)
        self.assertEqual(add3(1, *rest), 12)
    }

    def test_float_tuple_native_f64() {
        fs: tuple[float, float] = (1.5, 2.25)
        self.assertEqual(addf(*fs), 3.75)
    }

    def test_str_heap_elements() {
        ss: tuple[str, str] = ("foo", "bar")
        self.assertEqual(cat2(*ss), "foobar")
    }

    def test_into_any_box_params() {
        mixed: tuple[int, str] = (42, "hello")
        self.assertEqual(show_any(*mixed), "42/hello")
    }

    def test_spread_with_named_kwarg() {
        who: tuple[str] = ("Ada",)
        self.assertEqual(greet(*who, greeting="Hi"), "Hi, Ada")
    }

    def test_spread_fills_before_default() {
        ab: tuple[int, int] = (1, 2)
        self.assertEqual(with_default(*ab), 103)
    }

    def test_spread_overrides_default_via_full_tuple() {
        abc: tuple[int, int, int] = (1, 2, 3)
        self.assertEqual(with_default(*abc), 6)
    }
}


class TupleSpreadCtorTests(TestCase) {
    def test_single_ctor() {
        coords: tuple[int, int] = (3, 4)
        p: Point = Point(*coords)
        self.assertEqual(p.manhattan(), 7)
    }

    def test_ctor_leading_positional_then_spread() {
        coords: tuple[int] = (9,)
        p: Point = Point(1, *coords)
        self.assertEqual(p.manhattan(), 10)
    }
}


class TupleSpreadMethodTests(TestCase) {
    def test_instance_method() {
        c: Calc = Calc(100)
        xs: tuple[int, int, int] = (1, 2, 3)
        self.assertEqual(c.add3(*xs), 106)
    }

    def test_instance_method_heterogeneous() {
        c: Calc = Calc(100)
        het: tuple[int, str] = (5, "hp")
        self.assertEqual(c.tag(*het), "hp:105")
    }

    def test_attribute_chain_receiver() {
        w: Wrap = Wrap(Calc(10))
        yy: tuple[int, int, int] = (7, 8, 9)
        self.assertEqual(w.run(yy), 34)
    }

    def test_virtual_dispatch_with_spread() {
        pets: list[Animal] = [Animal(), Dog()]
        t: tuple[int, int] = (3, 4)
        out: list[str] = []
        for p in pets {
            out.append(p.combine(*t))
        }
        self.assertEqual(out, ["animal:7", "dog:12"])
    }
}


def _add3_too_few() -> None {
    xs: list[int] = [1, 2]
    r: int = add3(*xs)
}

def _add3_too_many() -> None {
    xs: list[int] = [1, 2, 3, 4]
    r: int = add3(*xs)
}


def cfg(host: str, port: int, debug: bool = False) -> str {
    return host + ":" + str(port) + "/" + str(debug)
}

def two_ints(a: int, b: int) -> int { return a + b }

def four_ints(a: int, b: int, c: int, d: int) -> int {
    return a * 1000 + b * 100 + c * 10 + d
}

def forward_sum(*args: int) -> int {
    return add3(*args)
}

def count_args(*args: int) -> int {
    return len(args)
}


def _cfg_missing_required() -> None {
    d: dict[str, Any] = {"host": "h"}
    s: str = cfg(**d)
}

def _cfg_unexpected_key() -> None {
    d: dict[str, Any] = {"host": "h", "port": 80, "extra": 9}
    s: str = cfg(**d)
}


class ListSpreadTests(TestCase) {
    def test_homogeneous_int() {
        xs: list[int] = [10, 20, 30]
        self.assertEqual(add3(*xs), 60)
    }

    def test_leading_positional_then_list() {
        ys: list[int] = [5, 6]
        self.assertEqual(add3(1, *ys), 12)
    }

    def test_float_list() {
        fs: list[float] = [1.5, 2.25]
        self.assertEqual(addf(*fs), 3.75)
    }

    def test_str_list_heap() {
        ss: list[str] = ["foo", "bar"]
        self.assertEqual(cat2(*ss), "foobar")
    }

    def test_list_into_ctor() {
        pc: list[int] = [3, 4]
        p: Point = Point(*pc)
        self.assertEqual(p.manhattan(), 7)
    }

    def test_list_into_method() {
        c: Calc = Calc(100)
        ml: list[int] = [1, 2, 3]
        self.assertEqual(c.add3(*ml), 106)
    }

    def test_wrong_length_too_few_raises() {
        self.assertRaises(TypeError, _add3_too_few)
    }

    def test_wrong_length_too_many_raises() {
        self.assertRaises(TypeError, _add3_too_many)
    }
}


class DictSpreadTests(TestCase) {
    def test_all_keys_present() {
        d: dict[str, Any] = {"host": "localhost", "port": 8080, "debug": True}
        self.assertEqual(cfg(**d), "localhost:8080/True")
    }

    def test_optional_defaulted() {
        d: dict[str, Any] = {"host": "h", "port": 99}
        self.assertEqual(cfg(**d), "h:99/False")
    }

    def test_concrete_int_dict() {
        d: dict[str, int] = {"a": 3, "b": 4}
        self.assertEqual(two_ints(**d), 7)
    }

    def test_dict_into_ctor() {
        d: dict[str, int] = {"x": 10, "y": 20}
        p: Point = Point(**d)
        self.assertEqual(p.manhattan(), 30)
    }

    def test_dict_into_method() {
        c: Calc = Calc(100)
        d: dict[str, int] = {"a": 1, "b": 2, "c": 3}
        self.assertEqual(c.add3(**d), 106)
    }

    def test_missing_required_raises() {
        self.assertRaises(TypeError, _cfg_missing_required)
    }

    def test_unexpected_key_raises() {
        self.assertRaises(TypeError, _cfg_unexpected_key)
    }
}


class MixedSpreadTests(TestCase) {
    def test_tuple_then_dict() {
        t: tuple[int, int] = (1, 2)
        d: dict[str, int] = {"c": 3, "d": 4}
        self.assertEqual(four_ints(*t, **d), 1234)
    }
}


class ForwardingTests(TestCase) {
    def test_vararg_list_forward() {
        self.assertEqual(forward_sum(1, 2, 3), 6)
    }

    def test_vararg_len() {
        self.assertEqual(count_args(10, 20, 30, 40), 4)
    }
}


def kw_total(**kw: int) -> int {
    t: int = 0
    for k in kw {
        t = t + kw[k]
    }
    return t
}

def greet_opts(name: str, **opts: str) -> str {
    out: str = name
    for k in opts {
        out = out + "," + opts[k]
    }
    return out
}

def head_count(a: int, *xs: int) -> int {
    return a * 100 + len(xs)
}

def keep(**kw: int) -> dict[str, int] {
    return kw
}


class KwargsSpreadTests(TestCase) {
    """`**dict` spread into variadic callees (the D047 deferral).

    `f(**d)` into a callee declaring `**kwargs` used to error "call-site spread
    into this callable is not supported" (only fixed-arity targets accepted a
    `**dict`). The variadic call path now: binds regular params by NAME from the
    spread source (required/default machinery shared with the fixed-arity path),
    raises TypeError for a spread key naming an already-filled slot or duplicating
    an explicit keyword, flows the remaining entries into the callee's kwargs dict
    via one excluding copy (dragon_dict_copy_excluding), and rejects stray keys at
    runtime for a *args-only callee.

    The same pass fixed a pre-existing per-call leak: the packed *args list and
    **kwargs dict are call-site-owned temporaries and are now released after the
    call (callees borrow their params; return/store paths take their own refs).
    """

    def test_pure_spread() {
        d: dict[str, int] = {"a": 1, "b": 2, "c": 3}
        self.assertEqual(kw_total(**d), 6)
    }

    def test_explicit_plus_spread() {
        d: dict[str, int] = {"a": 1, "b": 2}
        self.assertEqual(kw_total(x=10, **d), 13)
    }

    def test_spread_binds_regular_param() {
        self.assertEqual(greet_opts(**{"name": "scale", "extra": "x"}), "scale,x")
    }

    def test_positional_plus_spread_to_kwargs() {
        o: dict[str, str] = {"tone": "warm"}
        self.assertEqual(greet_opts("dragon", **o), "dragon,warm")
    }

    def test_duplicate_regular_param_raises() {
        caught: bool = false
        try {
            s: str = greet_opts("dup", **{"name": "x"})
        } except TypeError {
            caught = true
        }
        self.assertTrue(caught)
    }

    def test_missing_required_raises() {
        caught: bool = false
        try {
            s: str = greet_opts(**{"opt": "x"})
        } except TypeError {
            caught = true
        }
        self.assertTrue(caught)
    }

    def test_spread_into_args_only_callee() {
        self.assertEqual(head_count(**{"a": 7}), 700)
    }

    def test_stray_key_into_args_only_raises() {
        caught: bool = false
        try {
            n: int = head_count(**{"a": 1, "stray": 2})
        } except TypeError {
            caught = true
        }
        self.assertTrue(caught)
    }

    def test_returned_kwargs_survive_callsite_release() {
        r: dict[str, int] = keep(a=1, b=2)
        self.assertEqual(len(r), 2)
        self.assertEqual(r["b"], 2)
    }
}


def va_total(*args: int) -> int {
    s: int = 0
    for x in args { s = s + x }
    return s
}

def favg(*xs: float) -> float {
    s: float = 0.0
    for x in xs { s = s + x }
    return s
}

def joiner(*parts: str) -> str {
    out: str = ""
    for p in parts { out = out + p }
    return out
}


class VarargsSpreadTests(TestCase) {
    """call-site spread into *args - forwarding a *list into a variadic parameter.

    Fixed-arity spread (add(*xs)) and *args packing (total(1, 2, 3)) already worked;
    this covers the remaining case from the gap audit: spreading an existing list
    into a `*args: T` parameter. The list is bulk-extended into the pack via
    dragon_list_extend (one tag-reconciling C loop), not per-element IR appends.
    Covers int, float, str, and the mixed loose-args-still-work form.
    """

    def test_int_spread() {
        ys: list[int] = [1, 2, 3]
        self.assertEqual(va_total(*ys), 6)
    }

    def test_float_spread() {
        fs: list[float] = [1.5, 2.5, 4.0]
        self.assertEqual(favg(*fs), 8.0)
    }

    def test_str_spread() {
        ws: list[str] = ["a", "b", "c"]
        self.assertEqual(joiner(*ws), "abc")
    }

    def test_packing_still_works() {
        self.assertEqual(va_total(1, 2, 3), 6)
        self.assertEqual(joiner("X", "Y"), "XY")
    }
}


def f(a: int, b: int = 10, *xs: int) -> int {
    s: int = a + b
    for x in xs {
        s = s + x
    }
    return s
}

def two_defaults(a: int, b: int = 10, c: int = 20, *xs: int) -> int {
    s: int = a + b + c
    for x in xs {
        s = s + x
    }
    return s
}

def with_kwargs(a: int, b: int = 2, **kw: int) -> int {
    return a + b + len(kw)
}


class DefaultBeforeVarargsTests(TestCase) {
    """A default parameter BEFORE `*args`, plus keyword binding to a variadic
    callee's regular params.

    `def f(a: int, b: int = 10, *xs: int)` called as `f(1)` produced an LLVM
    "Operand is null" verify crash: the call-site marshaller pushed the *args list
    into b's slot and left the real *args slot null. The fix pads the omitted
    regular-param slots with nullptr so the *args list lands in its own slot and
    fillDefaultArgs fills the gaps.

    The same variadic call path now also binds keyword arguments that name a
    regular parameter (`f(a=1)` / `f(1, b=5)`) - mirroring the non-variadic D040
    binding - and splits the rest into **kwargs. A missing required param before
    *args, or an unexpected keyword to a *args-only callee, is now a clean
    compile-time error instead of a codegen crash.
    """

    def test_positional_default_used() {
        self.assertEqual(f(1), 11)
    }

    def test_positional_default_overridden() {
        self.assertEqual(f(1, 2), 3)
    }

    def test_positional_with_varargs() {
        self.assertEqual(f(1, 2, 3, 4), 10)
    }

    def test_two_defaults() {
        self.assertEqual(two_defaults(1), 31)
        self.assertEqual(two_defaults(1, 2), 23)
        self.assertEqual(two_defaults(1, 2, 3), 6)
        self.assertEqual(two_defaults(1, 2, 3, 4, 5), 15)
    }

    def test_keyword_fills_required() {
        self.assertEqual(f(a=5), 15)
    }

    def test_keyword_overrides_default() {
        self.assertEqual(f(a=5, b=1), 6)
        self.assertEqual(f(1, b=5), 6)
    }

    def test_kwargs_split_from_regular_params() {
        self.assertEqual(with_kwargs(a=1), 3)
        self.assertEqual(with_kwargs(1, b=5, x=9, y=8), 8)
    }
}


main([TupleSpreadDirectTests(), TupleSpreadCtorTests(),
      TupleSpreadMethodTests(), ListSpreadTests(),
      DictSpreadTests(), MixedSpreadTests(), ForwardingTests(),
      KwargsSpreadTests(), VarargsSpreadTests(), DefaultBeforeVarargsTests()])

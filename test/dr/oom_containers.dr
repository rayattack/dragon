from unittest import TestCase, main

class ContainerOomTests(TestCase) {
    def test_tuple_from_list_oom_is_catchable() {
        xs: list[int] = [0] * 20000000
        caught: bool = False
        try {
            t: tuple = tuple(xs)
            print(len(t))
        } except MemoryError {
            caught = True
        }
        self.assertTrue(caught)
    }
    def test_recovery_after_container_oom() {
        xs: list[int] = [0] * 20000000
        caught: bool = False
        try {
            t: tuple = tuple(xs)
            print(len(t))
        } except MemoryError {
            caught = True
        }
        self.assertTrue(caught)

        small: set[int] = set()
        small.add(1)
        small.add(2)
        self.assertEqual(len(small), 2)

        d: dict[str, int] = {}
        d["a"] = 1
        self.assertEqual(d["a"], 1)

        ys: list[int] = [1, 2, 3]
        ys.append(4)
        self.assertEqual(len(ys), 4)
    }
}

main([ContainerOomTests()])

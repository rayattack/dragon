from unittest import TestCase, main
from threading import Barrier, Semaphore, RWLock, Thread, Lock
import time

const N: int = 4

barrier: Barrier = Barrier(N)
counter_lock: Lock = Lock()
serial_count: int = 0
arrivals: int = 0

def barrier_worker() -> None {
    global serial_count
    global arrivals
    const rc: int = barrier.wait()
    with counter_lock {
        if rc == 1 {
            serial_count = serial_count + 1
        }
        arrivals = arrivals + 1
    }
}

class BarrierTests(TestCase) {
    def test_rendezvous_elects_one_serial_thread() {
        global serial_count
        t1: Thread = Thread(target=barrier_worker)
        t2: Thread = Thread(target=barrier_worker)
        t3: Thread = Thread(target=barrier_worker)
        t1.start()
        t2.start()
        t3.start()
        const rc: int = barrier.wait()
        t1.join()
        t2.join()
        t3.join()
        if rc == 1 {
            serial_count = serial_count + 1
        }
        self.assertEqual(arrivals, N - 1)
        self.assertEqual(serial_count, 1)
    }

    def test_construct_and_destroy() {
        b: Barrier = Barrier(1)
        self.assertEqual(b.wait(), 1)
        self.assertEqual(b.wait(), 1)
        self.assertEqual(b.destroy(), 0)
    }
}

class SemaphoreTests(TestCase) {
    def test_permits_are_counted() {
        s: Semaphore = Semaphore(2)
        self.assertTrue(s.acquire(blocking=False))
        self.assertTrue(s.acquire(blocking=False))
        self.assertFalse(s.acquire(blocking=False))
        s.release()
        self.assertTrue(s.acquire(blocking=False))
        s.release()
        s.release()
        self.assertEqual(s.destroy(), 0)
    }

    def test_available_permit_is_taken_immediately() {
        s: Semaphore = Semaphore(1)
        self.assertTrue(s.acquire(blocking=True, timeout=1.0))
        s.release()
        s.destroy()
    }

    def test_timeout_waits_then_fails() {
        s: Semaphore = Semaphore(1)
        s.acquire()
        const t0: float = time.monotonic()
        const got: bool = s.acquire(blocking=True, timeout=0.1)
        const dt: float = time.monotonic() - t0
        s.release()
        s.destroy()
        self.assertFalse(got)
        self.assertGreaterEqual(dt, 0.05)
    }
}

class RWLockTests(TestCase) {
    def test_construct_read_release_destroy() {
        rw: RWLock = RWLock()
        self.assertTrue(rw.acquire())
        self.assertEqual(rw.release(), 0)
        self.assertTrue(rw.acquire(write=True))
        self.assertEqual(rw.release(), 0)
        self.assertEqual(rw.destroy(), 0)
    }
}

class ClockTests(TestCase) {
    def test_monotonic_is_not_stuck_at_zero() {
        const a: float = time.monotonic()
        self.assertTrue(a > 0.0)
    }

    def test_monotonic_advances() {
        const a: float = time.monotonic()
        time.sleep_ms(20)
        const b: float = time.monotonic()
        self.assertTrue(b > a)
    }

    def test_perf_counter_is_live() {
        const a: float = time.perf_counter()
        self.assertTrue(a > 0.0)
    }

    def test_realtime_still_works() {
        self.assertTrue(time.now_float() > 1000000000.0)
    }
}

main([BarrierTests(), SemaphoreTests(), RWLockTests(), ClockTests()])

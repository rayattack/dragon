O5fub72fkq0h2g7zlLodPdJsGKWWJt+4Vg==
-----END EC PRIVATE KEY-----
"""


const ca_file: str = _materialize(CA_PEM, ".crt")
const star_com_cert: str = _materialize(STAR_COM_CERT, ".crt")
const star_com_key: str = _materialize(STAR_COM_KEY, ".key")
const star_ex_cert: str = _materialize(STAR_EXAMPLE_CERT, ".crt")
const star_ex_key: str = _materialize(STAR_EXAMPLE_KEY, ".key")

const PORT: int = 19643
const g_listener: TcpListener = TcpListener("127.0.0.1", PORT)


def _serve_once(certfile: str, keyfile: str) -> None {
    try {
        const conn: TcpStream = g_listener.accept()
        const sctx: SSLContext = SSLContext(PROTOCOL_TLS_SERVER)
        sctx.load_cert_chain(certfile, keyfile)
        const tls: SSLSocket = sctx.wrap_socket(conn, True, "")
        tls.send("ok")
        tls.close()
    } except Exception {
    }
}


def server_star_com() -> int {
    _serve_once(star_com_cert, star_com_key)
    return 0
}


def server_star_example() -> int {
    _serve_once(star_ex_cert, star_ex_key)
    return 0
}


g_listener.bind()
g_listener.listen(16)


class WildcardTests(TestCase) {
    def test_star_com_rejected_for_second_level_host() {
        const th: Thread = Thread(server_star_com)
        th.start()
        self.assertRaises(SSLCertVerificationError, lambda () -> None {
            const ctx: SSLContext = SSLContext(PROTOCOL_TLS_CLIENT)
            ctx.load_verify_locations(ca_file, "")
            const raw: TcpStream = TcpStream.open("127.0.0.1", PORT)
            ctx.wrap_socket(raw, False, "evil.com")
        })
        th.join()
    }

    def test_legitimate_wildcard_still_verifies() {
        const th: Thread = Thread(server_star_example)
        th.start()
        const ctx: SSLContext = SSLContext(PROTOCOL_TLS_CLIENT)
        ctx.load_verify_locations(ca_file, "")
        const raw: TcpStream = TcpStream.open("127.0.0.1", PORT)
        const s: SSLSocket = ctx.wrap_socket(raw, False, "host.example.com")
        self.assertTrue(s.getpeer_verified())
        s.close()
        th.join()
    }

    def test_wildcard_does_not_span_multiple_labels() {
        const th: Thread = Thread(server_star_example)
        th.start()
        self.assertRaises(SSLCertVerificationError, lambda () -> None {
            const ctx: SSLContext = SSLContext(PROTOCOL_TLS_CLIENT)
            ctx.load_verify_locations(ca_file, "")
            const raw: TcpStream = TcpStream.open("127.0.0.1", PORT)
            ctx.wrap_socket(raw, False, "a.b.example.com")
        })
        th.join()
    }
}


main([WildcardTests()])

type Boxed = int | float | bool | str | bytes | list[Boxed] | dict[str, Boxed]
type LooseBytes = int | bytes

from unittest import TestCase, main
from threading import Thread


def _ord_two_chars() {
    ord("ab")
}


def _ord_empty() {
    ord("")
}


class Dog {
    name: str
    def(name: str) {
        self.name = name
    }
}


class StringEmptyOperandTests(TestCase) {
    """Regression test for empty / NULL string-operand handling in the runtime.

    dragon_str_concat / _append_inplace / _replace_n used to substitute "" for a NULL
    operand BEFORE probing dragon_is_heap_string, so the probe read the header of a
    header-less rodata literal out of bounds (and append_inplace's fallback decref'd
    that "" the same way). The probe is now routed through the single NULL-guarded
    dragon_str_is_heap and runs on the ORIGINAL pointer, with "" materialized only
    afterward for the byte-copy paths (where the matching length is already 0).

    These assertions pin the observable behavior of the empty-operand paths so the
    reordering can't silently regress. Run under the ASan build to confirm the OOB
    read is gone.
    """

    def test_concat_empty_ascii() {
        const e: str = ""
        self.assertEqual(e + "x", "x")
        self.assertEqual("x" + e, "x")
        self.assertEqual(e + e, "")
        self.assertEqual(len(e + e), 0)
        self.assertEqual("a" + e + "b", "ab")
    }

    def test_concat_empty_with_kind4_operand() {
        const u: str = "aλb"
        const e: str = ""
        self.assertEqual(e + u, "aλb")
        self.assertEqual(u + e, "aλb")
        self.assertEqual(len(u + e), 3)
        self.assertEqual(len(e + u), 3)
    }

    def test_append_inplace_empty() {
        s: str = "ab"
        s += ""
        self.assertEqual(s, "ab")
        t: str = ""
        t += "xy"
        self.assertEqual(t, "xy")
        t += ""
        self.assertEqual(t, "xy")
    }

    def test_append_inplace_accumulate_from_empty() {
        acc: str = ""
        i: int = 0
        while i < 5 {
            acc += "ab"
            i = i + 1
        }
        self.assertEqual(acc, "ababababab")
        self.assertEqual(len(acc), 10)
    }

    def test_replace_empty_args() {
        const s: str = "hello"
        self.assertEqual(s.replace("", "-"), "hello")
        self.assertEqual(s.replace("l", ""), "heo")
        const e: str = ""
        self.assertEqual(e.replace("a", "b"), "")
        self.assertEqual(e.replace("", "b"), "")
    }

    def test_replace_kind4_empty_new() {
        const s: str = "aλbλc"
        self.assertEqual(s.replace("λ", ""), "abc")
        self.assertEqual(len(s.replace("λ", "")), 3)
    }
}


class StringLiteralHeaderTests(TestCase) {
    """Regression test for the string-literal DragonObjectHeader fix.

    ASCII string literals are emitted as immortal DragonString constants with a real
    header, so dragon_is_heap_string / _eq / _len / _concat / decref read in-bounds
    data (no OOB read off a bare C global) and incref/decref no-op on the immortal
    sentinel. Previously a literal compared/decref'd against a heap string could
    layout-dependently misbehave or corrupt the heap.
    """

    def test_eq_is_commutative_literal_vs_heap() {
        const parts: list[str] = "a$b$c".split("$")
        self.assertTrue(parts[1] == "b")
        self.assertTrue("b" == parts[1])
        self.assertFalse(parts[1] == "x")
        self.assertFalse("x" == parts[1])
        self.assertEqual(parts[0], "a")
        self.assertEqual(parts[2], "c")
    }

    def test_literal_through_dict_decref() {
        # A literal stored as a dict value, read back, then both the local and
        # the dict are decref'd at scope exit - must not double-free / fault.
        d: dict[str, str] = {}
        d["k"] = "value-literal"
        const v: str = d["k"]
        self.assertEqual(v, "value-literal")
        self.assertEqual(d.get("k", "missing"), "value-literal")
        self.assertEqual(d.get("absent", "fallback-literal"), "fallback-literal")
    }

    def test_len_and_concat() {
        const s: str = "hello"
        self.assertEqual(len(s), 5)
        self.assertEqual(s + " world", "hello world")
        self.assertEqual(len(""), 0)
        self.assertTrue("" == "")
    }

    def test_literal_list_roundtrip() {
        xs: list[str] = ["one", "two", "three"]
        self.assertEqual(len(xs), 3)
        self.assertEqual(xs[1], "two")
        self.assertTrue("two" == xs[1])
    }
}


class StrSubstringInTests(TestCase) {
    def test_substring_present_and_absent() {
        s: str = "Hello, World"
        self.assertTrue("Hello" in s)
        self.assertTrue("o, W" in s)
        self.assertTrue("World" in s)
        self.assertFalse("xyz" in s)
    }

    def test_is_case_sensitive() {
        s: str = "Hello"
        self.assertTrue("Hello" in s)
        self.assertFalse("hello" in s)
        self.assertFalse("HELLO" in s)
    }

    def test_whole_string_and_overlong_needle() {
        s: str = "hello world"
        self.assertTrue("hello world" in s)
        self.assertFalse("hello world!" in s)
    }

    def test_empty_needle_is_always_present() {
        self.assertTrue("" in "anything")
        empty: str = ""
        self.assertTrue("" in empty)
        self.assertFalse("a" in empty)
    }

    def test_matches_whole_code_points_not_bytes() {
        u: str = "café über"
        self.assertTrue("é" in u)
        self.assertTrue("über" in u)
        self.assertTrue("café" in u)
        self.assertFalse("cafe" in u)
        self.assertFalse("CAFÉ" in u)
    }

    def test_agrees_with_find() {
        s: str = "Dragon Lang"
        self.assertEqual("rag" in s, s.find("rag") >= 0)
        self.assertEqual("zzz" in s, s.find("zzz") >= 0)
        u: str = "café über"
        self.assertEqual("é" in u, u.find("é") >= 0)
        self.assertEqual("cafe" in u, u.find("cafe") >= 0)
    }

    def test_not_in_negates() {
        s: str = "Dragon Lang"
        self.assertTrue("zzz" not in s)
        self.assertFalse("rag" not in s)
    }

    def test_owned_temporary_operand() {
        raw: str = "  Dragon Lang  "
        self.assertTrue("lang" in raw.strip().lower())
        self.assertFalse("Lang" in raw.strip().lower())
    }

    def test_heap_built_operands() {
        i: int = 7
        built: str = "key-" + str(i)
        needle: str = "y-" + str(i)
        self.assertTrue(needle in built)
        self.assertFalse("y-8" in built)
    }

    def test_loop_stress_keeps_operand_intact() {
        base: str = "abcdefghij"
        hits: int = 0
        i: int = 0
        while i < 2000 {
            probe: str = "de" + ""
            if probe in base {
                hits = hits + 1
            }
            i = i + 1
        }
        self.assertEqual(hits, 2000)
        self.assertEqual(len(base), 10)
    }
}


class IntToStrTests(TestCase) {
    """str(int) - hand-rolled itoa fast path (replaced snprintf).

    Guards the edge cases of the manual decimal conversion: zero, single digit,
    negatives, the sign boundary, and INT64_MIN (whose magnitude has no positive
    counterpart - handled by negating in unsigned). INT64_MIN can't be written as a
    literal (the lexer parses the positive magnitude first, which overflows), so it
    is built at runtime.
    """

    def test_small_and_zero() {
        self.assertEqual(str(0), "0")
        self.assertEqual(str(7), "7")
        self.assertEqual(str(10), "10")
        self.assertEqual(str(100), "100")
    }

    def test_negatives() {
        self.assertEqual(str(-1), "-1")
        self.assertEqual(str(-7), "-7")
        self.assertEqual(str(-42), "-42")
        self.assertEqual(str(-123456789), "-123456789")
    }

    def test_int64_bounds() {
        self.assertEqual(str(9223372036854775807), "9223372036854775807")
        mn: int = -9223372036854775807
        mn = mn - 1
        self.assertEqual(str(mn), "-9223372036854775808")
    }

    def test_in_fstring_and_concat() {
        x: int = -305
        self.assertEqual(f"val={x}", "val=-305")
        self.assertEqual("n=" + str(2000000000), "n=2000000000")
    }

    def test_len_of_conversion() {
        self.assertEqual(len(str(0)), 1)
        self.assertEqual(len(str(-1)), 2)
        self.assertEqual(len(str(12345)), 5)
        self.assertEqual(len(str(-12345)), 6)
    }
}


class OrdTests(TestCase) {
    def test_ascii() {
        self.assertEqual(ord("A"), 65)
        self.assertEqual(ord("\x7F"), 127)
    }

    def test_latin1() {
        self.assertEqual(ord("é"), 233)
        self.assertEqual(ord("ÿ"), 255)
    }

    def test_bmp() {
        self.assertEqual(ord("Ā"), 256)
        self.assertEqual(ord("€"), 8364)
        self.assertEqual(ord("中"), 20013)
    }

    def test_astral() {
        self.assertEqual(ord("😀"), 128512)
    }

    def test_chr_ord_roundtrip() {
        codes: list[int] = [0, 65, 127, 128, 233, 256, 8364, 20013, 65535, 65536, 128512, 1114111]
        for c in codes {
            self.assertEqual(ord(chr(c)), c)
        }
    }

    def test_wrong_length_raises() {
        self.assertRaises(TypeError, _ord_two_chars)
        self.assertRaises(TypeError, _ord_empty)
    }
}


class PredicateTests(TestCase) {
    def test_isalpha_nonascii() {
        self.assertTrue("éabc".isalpha())
        self.assertTrue("Ā".isalpha())
        self.assertTrue("αβγ".isalpha())
        self.assertTrue("привет".isalpha())
        self.assertFalse("€".isalpha())
        self.assertFalse("éa1".isalpha())
        self.assertFalse("".isalpha())
    }

    def test_isalnum_nonascii() {
        self.assertTrue("é1".isalnum())
        self.assertFalse("é ".isalnum())
    }

    def test_isdigit_nonascii() {
        self.assertFalse("€2".isdigit())
        self.assertFalse("Ā".isdigit())
        self.assertTrue("123".isdigit())
    }

    def test_isspace_nonascii() {
        self.assertTrue(chr(160).isspace())
        self.assertTrue(chr(8232).isspace())
        self.assertTrue((" " + chr(160)).isspace())
        self.assertFalse(("x" + chr(160)).isspace())
        self.assertFalse("€".isspace())
    }

    def test_isupper_islower_nonascii() {
        self.assertTrue("ÉÀ".isupper())
        self.assertFalse("Éà".isupper())
        self.assertTrue("éà".islower())
        self.assertFalse("éÀ".islower())
        self.assertTrue("ΣΔ".isupper())
        self.assertTrue("σδ".islower())
        self.assertTrue("ЖУК".isupper())
        self.assertTrue("жук".islower())
        self.assertTrue("É€".isupper())
        self.assertTrue("é€".islower())
        self.assertFalse("€".isupper())
        self.assertFalse("€".islower())
    }

    def test_istitle_nonascii() {
        self.assertTrue("Über".istitle())
        self.assertTrue("Éa Ба".istitle())
        self.assertFalse("ÜBer".istitle())
        self.assertFalse("über".istitle())
    }

    def test_isidentifier_nonascii() {
        self.assertFalse("€x".isidentifier())
        self.assertFalse("aé".isidentifier())
        self.assertTrue("a_1".isidentifier())
        self.assertFalse("1a".isidentifier())
    }
}


class ReprTests(TestCase) {
    def test_repr_ascii() {
        self.assertEqual(repr("hello"), "'hello'")
    }

    def test_repr_nonascii_roundtrips() {
        self.assertEqual(repr("héllo"), "'héllo'")
        self.assertEqual(repr("€uro"), "'€uro'")
        self.assertEqual(repr("中文"), "'中文'")
        self.assertEqual(repr("😀"), "'😀'")
        self.assertEqual(len(repr("Āb")), 4)
    }
}


class HashPoint {
    x: int
    y: int

    def(x: int, y: int) {
        self.x = x
        self.y = y
    }

    def __hash__() -> int {
        return self.x * 31 + self.y
    }
}


class HashTests(TestCase) {
    def test_equal_content_equal_hash() {
        self.assertEqual(hash("é€"), hash("é" + "€"))
        self.assertEqual(hash("Āabc"), hash("Ā" + "abc"))
    }

    def test_distinct_nonascii_strings_differ() {
        self.assertNotEqual(hash("Ā"), hash("Ă"))
        self.assertNotEqual(hash("Āx"), hash("Āy"))
        self.assertNotEqual(hash("Ā"), hash(""))
        self.assertNotEqual(hash("€1"), hash("€2"))
    }

    def test_prefix_differs() {
        self.assertNotEqual(hash("é"), hash("éé"))
    }

    def test_optional_str_hashes_its_content() {
        s: str | None = "abc"
        t: str = "abc"
        self.assertEqual(hash(s), hash(t))
        self.assertNotEqual(hash(s), hash(none))
    }

    def test_optional_str_holding_none_hashes_as_none() {
        s: str | None = none
        self.assertEqual(hash(s), hash(none))
    }

    def test_optional_bytes_hashes_its_content() {
        b: bytes | None = b"xy"
        c: bytes = b"xy"
        self.assertEqual(hash(b), hash(c))
        self.assertNotEqual(hash(b), hash(none))
    }

    def test_optional_bytes_holding_none_hashes_as_none() {
        b: bytes | None = none
        self.assertEqual(hash(b), hash(none))
    }

    def test_optional_tuple_hashes_its_content() {
        t: tuple[int, int] | None = (1, 2)
        u: tuple[int, int] = (1, 2)
        self.assertEqual(hash(t), hash(u))
        self.assertNotEqual(hash(t), hash(none))
    }

    def test_optional_tuple_holding_none_hashes_as_none() {
        t: tuple[int, int] | None = none
        self.assertEqual(hash(t), hash(none))
    }

    def test_optional_instance_uses_dunder_hash() {
        p: HashPoint = HashPoint(3, 4)
        o: HashPoint | None = p
        self.assertEqual(hash(o), hash(p))
        self.assertEqual(hash(o), 97)
    }

    def test_optional_instance_holding_none_hashes_as_none() {
        o: HashPoint | None = none
        self.assertEqual(hash(o), hash(none))
    }

    def test_optional_plain_instance_keeps_identity() {
        d: Dog = Dog("rex")
        o: Dog | None = d
        self.assertEqual(hash(o), hash(d))
    }

    def test_optional_plain_instance_holding_none_hashes_as_none() {
        o: Dog | None = none
        self.assertEqual(hash(o), hash(none))
    }
}


class ConversionTests(TestCase) {
    """float(str) parsing + None/float boxing in Boxed.

    Regressions: (1) float("3.5") used to reinterpret the str pointer as an f64 bit
    pattern (garbage) instead of parsing; (2) a None value boxed into dict[str, Boxed]
    read back as int 0 instead of None (missing TAG_NONE case). Both are exactly the
    shapes the database drivers hit on float / NULL columns.
    """

    def test_float_from_string() {
        x: float = float("3.5")
        y: float = float("-2.25")
        self.assertAlmostEqual(x, 3.5)
        self.assertAlmostEqual(x + y, 1.25)
    }

    def test_float_str_into_dict_any() {
        d: dict[str, Boxed] = {}
        d["f"] = float("3.5")
        got: float = d["f"]
        self.assertAlmostEqual(got, 3.5)
    }

    def test_none_in_dict_any_roundtrip() {
        d: dict[str, Boxed] = {}
        d["n"] = none
        self.assertIsNone(d["n"])
    }

    def test_none_str_overwrite_cleanup() {
        d: dict[str, Boxed] = {}
        d["k"] = none
        d["k"] = "s"
        d["k"] = none
        self.assertIsNone(d["k"])
    }
}


class TypeBuiltinTests(TestCase) {
    """type(x) returns the type's NAME as a str (e.g. "int", "Dog"). Two root-cause
    regressions are pinned here:

      1. Boxing a type(x) result into Boxed carried TAG_INT (so `print(any)` showed a
         raw pointer): `type`'s declared return type was Boxed, not str, so the box
         tag fell back to int. Fixed by declaring type() -> str.
      2. type() on a literal returned "object": the name was derived only from the
         argument's VarKind, which a literal (no NameExpr) doesn't have. Fixed by
         deriving the name from the argument's static type first.

    assertEqual boxes each argument into Boxed, so every case below also exercises
    the Boxed-boxing path that regression #1 broke.
    """

    def test_literals() {
        self.assertEqual(type(5), "int")
        self.assertEqual(type("hi"), "str")
        self.assertEqual(type(3.5), "float")
        self.assertEqual(type(True), "bool")
    }

    def test_variables() {
        n: int = 7
        s: str = "z"
        xs: list[int] = [1, 2]
        self.assertEqual(type(n), "int")
        self.assertEqual(type(s), "str")
        self.assertEqual(type(xs), "list")
    }

    def test_instance() {
        d: Dog = Dog("rex")
        self.assertEqual(type(d), "Dog")
    }

    def test_boxed_into_any() {
        a: Boxed = type(Dog("rex"))
        self.assertEqual(a, "Dog")
        b: Boxed = type(42)
        self.assertEqual(b, "int")
    }
}


class ByteHolder {
    data: bytes

    def(data: bytes) {
        self.data = data
    }
}


class ByteWindow {
    data: bytes
    depth: int

    def(data: bytes) {
        self.data = data
        self.depth = 0
    }

    def __enter__() -> ByteWindow {
        self.depth = self.depth + 1
        return self
    }

    def __exit__() -> int {
        self.depth = self.depth - 1
        return 0
    }

    def first() -> int {
        return self.data[0]
    }
}


def _first_high_byte(buf: bytes) -> int {
    for b in buf {
        if b > 127 {
            return b
        }
    }
    return -1
}


class BytesIterationTests(TestCase) {
    """A for loop over bytes yields each byte as an int (DRG-84).
    Pre-fix: a bytes iterable took the list lane, so dragon_list_len walked a
    DragonBytes as a DragonList and the compiled program segfaulted."""

    def test_for_over_encoded_temp() {
        total: int = 0
        for b in "abc".encode("utf-8") {
            total = total + b
        }
        self.assertEqual(total, ord("a") + ord("b") + ord("c"))
    }

    def test_for_over_bytes_local() {
        data: bytes = "é".encode("utf-8")
        out: list[int] = []
        for b in data {
            out.append(b)
        }
        self.assertEqual(out, [data[0], data[1]])
    }

    def test_for_over_bytes_literal() {
        count: int = 0
        for b in b"xyz" {
            count = count + 1
        }
        self.assertEqual(count, 3)
    }

    def test_loop_var_is_an_int() {
        shifted: list[int] = []
        for b in b"AB" {
            shifted.append(b + 1)
        }
        self.assertEqual(shifted, [ord("B"), ord("C")])
    }

    def test_empty_bytes_skips_the_body() {
        ran: bool = False
        for b in "".encode("utf-8") {
            ran = True
        }
        self.assertFalse(ran)
    }

    def test_bytes_field_iterates() {
        h: ByteHolder = ByteHolder(b"hi")
        seen: list[int] = []
        for b in h.data {
            seen.append(b)
        }
        self.assertEqual(seen, [ord("h"), ord("i")])
    }

    def test_encoded_temp_iterated_repeatedly() {
        grand: int = 0
        for i in range(2000) {
            for b in "leak probe".encode("utf-8") {
                grand = grand + b
            }
        }
        per_pass: int = ord("l") + ord("e") + ord("a") + ord("k") + ord(" ") + ord("p") + ord("r") + ord("o") + ord("b") + ord("e")
        self.assertEqual(grand, 2000 * per_pass)
    }

    def test_break_leaves_the_loop_at_the_right_byte() {
        seen: list[int] = []
        for b in b"abcd" {
            if b == ord("c") {
                break
            }
            seen.append(b)
        }
        self.assertEqual(seen, [ord("a"), ord("b")])
    }

    def test_early_return_out_of_a_bytes_loop() {
        self.assertEqual(_first_high_byte(b"\x01\x02\xfe\x03"), 254)
        self.assertEqual(_first_high_byte(b"\x01\x02"), -1)
        self.assertEqual(_first_high_byte("".encode("utf-8")), -1)
    }

    def test_for_over_a_full_page() {
        page: bytes = ("abcd" * 1023).encode("utf-8")
        total: int = 0
        for b in page {
            total = total + b
        }
        self.assertEqual(total, 1023 * (ord("a") + ord("b") + ord("c") + ord("d")))
    }
}


class BytesElementAccessTests(TestCase) {
    """b[i] and len(b) read the DragonBytes header and buffer inline (DRG-187).
    The bounds check, the negative-index adjust, the IndexError and the empty
    and NULL cases must land exactly where the runtime call put them."""

    def test_positive_indices_at_both_ends() {
        buf: bytes = b"abcd"
        self.assertEqual(buf[0], ord("a"))
        self.assertEqual(buf[3], ord("d"))
        self.assertEqual(buf[len(buf) - 1], ord("d"))
    }

    def test_negative_indices_at_both_ends() {
        buf: bytes = b"abcd"
        self.assertEqual(buf[-1], ord("d"))
        self.assertEqual(buf[-4], ord("a"))
        self.assertEqual(buf[-len(buf)], ord("a"))
    }

    def test_bytes_are_unsigned() {
        buf: bytes = b"\x00\x7f\x80\xff"
        self.assertEqual(buf[0], 0)
        self.assertEqual(buf[1], 127)
        self.assertEqual(buf[2], 128)
        self.assertEqual(buf[3], 255)
    }

    def test_index_at_len_raises() {
        buf: bytes = b"abcd"
        caught: str = ""
        try {
            const x: int = buf[len(buf)]
        } except IndexError {
            caught = "index"
        }
        self.assertEqual(caught, "index")
    }

    def test_index_below_negative_len_raises() {
        buf: bytes = b"abcd"
        caught: str = ""
        try {
            const x: int = buf[-len(buf) - 1]
        } except IndexError {
            caught = "index"
        }
        self.assertEqual(caught, "index")
    }

    def test_index_into_empty_bytes_raises() {
        buf: bytes = "".encode("utf-8")
        self.assertEqual(len(buf), 0)
        caught: str = ""
        try {
            const x: int = buf[0]
        } except IndexError {
            caught = "index"
        }
        self.assertEqual(caught, "index")
    }

    def test_len_of_empty_and_of_a_full_page() {
        page: bytes = ("abcd" * 1023).encode("utf-8")
        self.assertEqual(len(page), 4092)
        self.assertEqual(len("".encode("utf-8")), 0)
        self.assertEqual(len(b"abcd"), 4)
    }

    def test_indexed_sum_over_a_full_page() {
        page: bytes = ("abcd" * 1023).encode("utf-8")
        total: int = 0
        i: int = 0
        while i < len(page) {
            total = total + page[i]
            i = i + 1
        }
        self.assertEqual(total, 1023 * (ord("a") + ord("b") + ord("c") + ord("d")))
        self.assertEqual(page[4091], ord("d"))
        self.assertEqual(page[-4092], ord("a"))
    }

    def test_field_bytes_index_and_len() {
        h: ByteHolder = ByteHolder(b"hi")
        self.assertEqual(h.data[0], ord("h"))
        self.assertEqual(h.data[-1], ord("i"))
        self.assertEqual(len(h.data), 2)
    }

    def test_read_inside_with_and_try() {
        w: ByteWindow = ByteWindow(b"page")
        first: int = 0
        last: int = 0
        with w {
            first = w.first()
            try {
                last = w.data[-1]
                const oob: int = w.data[99]
            } except IndexError {
                last = last + 1000
            }
        }
        self.assertEqual(first, ord("p"))
        self.assertEqual(last, ord("e") + 1000)
        self.assertEqual(w.depth, 0)
    }

    def test_owned_temp_indexed_repeatedly() {
        grand: int = 0
        for i in range(2000) {
            grand = grand + "leak probe".encode("utf-8")[0]
        }
        self.assertEqual(grand, 2000 * ord("l"))
    }

    def test_four_reads_of_one_value_decode_every_byte() {
        buf: bytes = b"\x01\x02\x03\x04"
        packed: int = buf[0] | (buf[1] << 8) | (buf[2] << 16) | (buf[3] << 24)
        self.assertEqual(packed, 67305985)
    }

    def test_a_later_read_of_a_shared_value_still_raises() {
        buf: bytes = b"abc"
        caught: int = 0
        for i in range(2000) {
            try {
                const x: int = buf[0] | (buf[1] << 8) | (buf[2] << 16) | (buf[3] << 24)
            } except IndexError {
                caught = caught + 1
            }
        }
        self.assertEqual(caught, 2000)
    }

    def test_a_first_read_of_a_shared_value_still_raises() {
        buf: bytes = b"abcd"
        caught: int = 0
        for i in range(2000) {
            try {
                const x: int = buf[9] | (buf[1] << 8) | (buf[2] << 16)
            } except IndexError {
                caught = caught + 1
            }
        }
        self.assertEqual(caught, 2000)
    }

    def test_negative_indices_mix_with_a_shared_length() {
        buf: bytes = b"abcd"
        mixed: int = buf[0] + buf[-1] + buf[1] + buf[-2]
        self.assertEqual(mixed, ord("a") + ord("d") + ord("b") + ord("c"))
    }

    def test_a_reassigned_value_is_checked_against_its_own_length() {
        buf: bytes = b"abcd"
        first: int = buf[3]
        buf = b"xy"
        caught: str = ""
        try {
            const x: int = buf[3]
        } except IndexError {
            caught = "index"
        }
        self.assertEqual(first, ord("d"))
        self.assertEqual(caught, "index")
    }

    def test_owned_temp_out_of_range_releases_the_temp() {
        caught: int = 0
        for i in range(2000) {
            try {
                const x: int = "leak probe".encode("utf-8")[99]
            } except IndexError {
                caught = caught + 1
            }
        }
        self.assertEqual(caught, 2000)
    }
}


def _len_of(buf: bytes) -> int {
    return len(buf)
}


def _sum_of(buf: bytes) -> int {
    total: int = 0
    for b in buf {
        total = total + b
    }
    return total
}


class BytesEmptyAndSliceTests(TestCase) {
    """Every zero-length bytes is one immortal singleton, and a step-1 slice is a
    single memcpy out of one allocation (DRG-198). The singleton is handed to
    containers, tasks, boxes and concat, so it has to survive release, shared
    marking and collection without ever being freed."""

    def test_every_producer_of_zero_bytes_agrees() {
        made: bytes = bytes()
        from_list: bytes = bytes([])
        literal: bytes = b""
        encoded: bytes = "".encode("utf-8")
        sliced: bytes = b"abcd"[2:2]
        joined: bytes = b"" + b""
        self.assertEqual(len(made), 0)
        self.assertEqual(len(from_list), 0)
        self.assertEqual(len(literal), 0)
        self.assertEqual(len(encoded), 0)
        self.assertEqual(len(sliced), 0)
        self.assertEqual(len(joined), 0)
        self.assertEqual(made == from_list, True)
        self.assertEqual(literal == encoded, True)
        self.assertEqual(sliced == joined, True)
    }

    def test_reassigning_an_empty_thousands_of_times_releases_it_each_turn() {
        held: bytes = b""
        i: int = 0
        while i < 2000 {
            held = bytes()
            held = bytes([])
            held = b"abcd"[1:1]
            i = i + 1
        }
        self.assertEqual(len(held), 0)
    }

    def test_empty_crosses_a_task_boundary() {
        i: int = 0
        total: int = 0
        while i < 2000 {
            blank: bytes = bytes([])
            const t: Task[int] = fire _len_of(blank)
            total = total + await t
            total = total + len(blank)
            i = i + 1
        }
        self.assertEqual(total, 0)
    }

    def test_empty_lives_and_dies_inside_containers() {
        i: int = 0
        while i < 2000 {
            bag: dict[str, bytes] = {}
            bag["blank"] = bytes()
            bag["also"] = b""
            row: list[bytes] = [bytes([]), b"", b"ab"[0:0]]
            self.assertEqual(len(bag["blank"]) + len(row[2]), 0)
            i = i + 1
        }
    }

    def test_concat_with_an_empty_on_either_side_keeps_the_payload() {
        payload: bytes = b"abcd"
        i: int = 0
        while i < 2000 {
            const left: bytes = b"" + payload
            const right: bytes = payload + bytes()
            self.assertEqual(len(left), 4)
            self.assertEqual(len(right), 4)
            self.assertEqual(left == payload, True)
            self.assertEqual(right == payload, True)
            i = i + 1
        }
        self.assertEqual(payload[0], ord("a"))
        self.assertEqual(payload[3], ord("d"))
        self.assertEqual(len(payload), 4)
    }

    def test_the_empty_can_be_sliced_iterated_and_decoded() {
        blank: bytes = bytes()
        i: int = 0
        while i < 2000 {
            self.assertEqual(len(blank[0:0]), 0)
            self.assertEqual(len(blank[0:5]), 0)
            self.assertEqual(len(blank[-3:]), 0)
            self.assertEqual(len(blank[::-1]), 0)
            self.assertEqual(_sum_of(blank), 0)
            self.assertEqual(len(blank.decode("utf-8")), 0)
            i = i + 1
        }
        self.assertEqual(len(blank), 0)
    }

    def test_the_empty_hashes_reprs_and_compares_like_a_value() {
        blank: bytes = bytes()
        other: bytes = bytes([])
        self.assertEqual(hash(blank), hash(other))
        self.assertEqual(repr(blank), "b\'\'")
        self.assertEqual(blank == other, True)
        self.assertEqual(blank == b"a", False)
        self.assertEqual(blank < b"a", True)
    }

    def test_the_empty_round_trips_through_a_union() {
        i: int = 0
        while i < 2000 {
            boxed: Boxed = bytes([])
            const back: bytes = boxed
            self.assertEqual(len(back), 0)
            i = i + 1
        }
    }

    def test_step_one_slices_read_the_whole_window() {
        buf: bytes = b"abcdefgh"
        self.assertEqual(buf[0:8] == buf, True)
        self.assertEqual(buf[2:6] == b"cdef", True)
        self.assertEqual(buf[-3:] == b"fgh", True)
        self.assertEqual(buf[:3] == b"abc", True)
        self.assertEqual(len(buf[6:2]), 0)
        self.assertEqual(len(buf[100:200]), 0)
        self.assertEqual(len(buf[-100:-50]), 0)
    }

    def test_stepped_and_reversed_slices_are_unchanged() {
        buf: bytes = b"abcdefgh"
        self.assertEqual(buf[::2] == b"aceg", True)
        self.assertEqual(buf[1::2] == b"bdfh", True)
        self.assertEqual(buf[::-1] == b"hgfedcba", True)
        self.assertEqual(buf[::-2] == b"hfdb", True)
        self.assertEqual(buf[6:1:-2] == b"gec", True)
        self.assertEqual(len(buf[2:2:3]), 0)
    }

    def test_slices_across_a_page_larger_than_four_kilobytes() {
        page: bytes = ("abcd" * 1200).encode("utf-8")
        self.assertEqual(len(page), 4800)
        head: bytes = page[0:4096]
        tail: bytes = page[4096:]
        self.assertEqual(len(head), 4096)
        self.assertEqual(len(tail), 704)
        self.assertEqual(head[0], ord("a"))
        self.assertEqual(head[4095], ord("d"))
        self.assertEqual(tail[0], ord("a"))
        self.assertEqual(tail[703], ord("d"))
        self.assertEqual(len(page[1:4799]), 4798)
        self.assertEqual(len(page[::2]), 2400)
        self.assertEqual(page[::2][0], ord("a"))
        self.assertEqual(page[::2][1], ord("c"))
    }

    def test_bytes_from_a_list_masks_every_element_to_one_byte() {
        wide: bytes = bytes([0, 65, 255, 256, 257, 511, -1, -256, 1000000])
        self.assertEqual(len(wide), 9)
        self.assertEqual(wide[0], 0)
        self.assertEqual(wide[1], 65)
        self.assertEqual(wide[2], 255)
        self.assertEqual(wide[3], 0)
        self.assertEqual(wide[4], 1)
        self.assertEqual(wide[5], 255)
        self.assertEqual(wide[6], 255)
        self.assertEqual(wide[7], 0)
        self.assertEqual(wide[8], 64)
    }

    def test_bytes_from_a_bool_list_reads_one_byte_per_flag() {
        flags: bytes = bytes([True, False, True, True])
        self.assertEqual(len(flags), 4)
        self.assertEqual(flags[0], 1)
        self.assertEqual(flags[1], 0)
        self.assertEqual(flags[3], 1)
    }

    def test_bytes_from_a_blank_page_list() {
        blank: bytes = bytes([0] * 4080)
        self.assertEqual(len(blank), 4080)
        self.assertEqual(blank[0], 0)
        self.assertEqual(blank[4079], 0)
        filled: list[int] = [0] * 4080
        filled[5] = 7
        filled[4079] = 200
        page: bytes = bytes(filled)
        self.assertEqual(page[5], 7)
        self.assertEqual(page[4], 0)
        self.assertEqual(page[4079], 200)
    }

    def test_bytes_from_an_empty_list_is_the_shared_empty() {
        i: int = 0
        while i < 2000 {
            const blank: bytes = bytes([])
            const also: bytes = bytes([0] * 0)
            self.assertEqual(len(blank) + len(also), 0)
            self.assertEqual(blank == also, True)
            i = i + 1
        }
    }

    def test_bytes_from_a_union_list_of_ints_reads_the_payloads() {
        wrapped: list[Boxed] = [65, 66, 300]
        made: bytes = bytes(wrapped)
        self.assertEqual(len(made), 3)
        self.assertEqual(made[0], 65)
        self.assertEqual(made[1], 66)
        self.assertEqual(made[2], 44)
    }

    def test_bytes_from_a_union_list_holding_a_string_raises() {
        wrapped: list[Boxed] = [65, "no"]
        caught: str = ""
        try {
            const made: bytes = bytes(wrapped)
        } except TypeError {
            caught = "type"
        }
        self.assertEqual(caught, "type")
    }

    def test_owned_temp_slices_in_a_loop_stay_balanced() {
        page: bytes = ("abcd" * 1023).encode("utf-8")
        total: int = 0
        i: int = 0
        while i < 2000 {
            const piece: bytes = page[8:16]
            total = total + piece[0] + len(piece)
            total = total + len(page[0:0])
            i = i + 1
        }
        self.assertEqual(total, 2000 * (ord("a") + 8))
    }
}


class BytesDecodeTests(TestCase) {
    """`b.decode()` scans for high bytes eight at a time and copies an all-ASCII
    payload in one memcpy (DRG-200). Before, it called the UTF-8 decoder once per
    byte to count code points and then copied the ASCII output a byte at a time.
    Strict and replace behaviour, both encodings and every length class have to
    come out identical."""

    def test_ascii_at_each_length_class() {
        self.assertEqual(bytes().decode("utf-8"), "")
        self.assertEqual(b"a".decode("utf-8"), "a")
        self.assertEqual(b"abcdefg".decode("utf-8"), "abcdefg")
        self.assertEqual(b"abcdefgh".decode("utf-8"), "abcdefgh")
        self.assertEqual(b"abcdefghi".decode("utf-8"), "abcdefghi")
        self.assertEqual(len(b"abcdefg".decode("utf-8")), 7)
        self.assertEqual(len(b"abcdefgh".decode("utf-8")), 8)
        self.assertEqual(len(b"abcdefghi".decode("utf-8")), 9)
    }

    def test_a_four_kilobyte_ascii_payload() {
        page: bytes = ("abcd" * 1024).encode("utf-8")
        self.assertEqual(len(page), 4096)
        text: str = page.decode("utf-8")
        self.assertEqual(len(text), 4096)
        self.assertEqual(text[0], "a")
        self.assertEqual(text[4095], "d")
        self.assertEqual(text == "abcd" * 1024, True)
    }

    def test_a_high_byte_at_every_position_of_a_word() {
        i: int = 0
        while i < 8 {
            vals: list[int] = [65] * 9
            vals[i] = 0xC3
            vals[i + 1] = 0xA9
            const decoded: str = bytes(vals).decode("utf-8")
            self.assertEqual(len(decoded), 8)
            self.assertEqual(ord(decoded[i]), 233)
            i = i + 1
        }
    }

    def test_multibyte_lengths_count_code_points() {
        two: bytes = "é".encode("utf-8")
        three: bytes = "€".encode("utf-8")
        four: bytes = "𝄞".encode("utf-8")
        self.assertEqual(len(two), 2)
        self.assertEqual(len(three), 3)
        self.assertEqual(len(four), 4)
        self.assertEqual(len(two.decode("utf-8")), 1)
        self.assertEqual(len(three.decode("utf-8")), 1)
        self.assertEqual(len(four.decode("utf-8")), 1)
        self.assertEqual(two.decode("utf-8"), "é")
        self.assertEqual(three.decode("utf-8"), "€")
        self.assertEqual(four.decode("utf-8"), "𝄞")
        mixed: bytes = "aé€b".encode("utf-8")
        self.assertEqual(len(mixed), 7)
        self.assertEqual(len(mixed.decode("utf-8")), 4)
        self.assertEqual(mixed.decode("utf-8"), "aé€b")
    }

    def test_invalid_utf8_raises_under_strict() {
        bad: bytes = bytes([0xFF, 0x41])
        caught: str = ""
        try {
            const text: str = bad.decode("utf-8")
        } except UnicodeDecodeError {
            caught = "decode"
        }
        self.assertEqual(caught, "decode")
    }

    def test_invalid_utf8_substitutes_under_replace() {
        bad: bytes = bytes([0xFF, 0x41])
        text: str = bad.decode("utf-8", "replace")
        self.assertEqual(len(text), 2)
        self.assertEqual(text[1], "A")
        self.assertEqual(ord(text[0]), 65533)
        truncated: bytes = bytes([0xE2, 0x82])
        self.assertEqual(len(truncated.decode("utf-8", "replace")), 2)
    }

    def test_ascii_encoding_rejects_high_bytes() {
        high: bytes = bytes([0x41, 0x80])
        caught: str = ""
        try {
            const text: str = high.decode("ascii")
        } except UnicodeDecodeError {
            caught = "decode"
        }
        self.assertEqual(caught, "decode")
        replaced: str = high.decode("ascii", "replace")
        self.assertEqual(len(replaced), 2)
        self.assertEqual(replaced[0], "A")
        self.assertEqual(b"plain".decode("ascii"), "plain")
    }

    def test_encoding_names_are_case_insensitive_with_aliases() {
        payload: bytes = b"abc"
        self.assertEqual(payload.decode("UTF-8"), "abc")
        self.assertEqual(payload.decode("utf8"), "abc")
        self.assertEqual(payload.decode("u8"), "abc")
        self.assertEqual(payload.decode("ascii"), "abc")
        self.assertEqual(payload.decode("US-ASCII"), "abc")
        self.assertEqual(payload.decode("Ascii"), "abc")
    }

    def test_unknown_encoding_and_handler_are_rejected() {
        payload: bytes = b"abc"
        caught: str = ""
        try {
            const text: str = payload.decode("latin-1")
        } except LookupError {
            caught = "encoding"
        }
        self.assertEqual(caught, "encoding")
        caught = ""
        try {
            const text2: str = payload.decode("utf-8", "ignore")
        } except LookupError {
            caught = "handler"
        }
        self.assertEqual(caught, "handler")
    }

    def test_decoding_in_a_loop_stays_balanced() {
        page: bytes = ("abcd" * 1023).encode("utf-8")
        total: int = 0
        i: int = 0
        while i < 2000 {
            total = total + len(page[8:16].decode("utf-8"))
            total = total + len(bytes().decode("utf-8"))
            total = total + len("é".encode("utf-8").decode("utf-8"))
            i = i + 1
        }
        self.assertEqual(total, 2000 * 9)
    }
}


shared_literal: bytes = b"crossing"
thread_total: int = 0


class LiteralDefaults {
    raw: bytes = b""
    tag: bytes = b"probe"

    def touch() -> int {
        return len(self.raw) + len(self.tag)
    }
}


def _fold_bytes(buf: bytes) -> int {
    total: int = 0
    for b in buf {
        total = total + b
    }
    return total
}


def _here_literal() -> bytes {
    return b"shared literal"
}


def _there_literal() -> bytes {
    return b"shared literal"
}


def _fold_list(items: list[bytes]) -> int {
    total: int = 0
    for it in items {
        total = total + len(it)
    }
    return total
}


shared_box: list[bytes] = [b"abc", b"defg"]


def _thread_body() -> None {
    global thread_total
    thread_total = _fold_bytes(shared_literal) + _fold_list(shared_box)
}


class BytesLiteralImmortalTests(TestCase) {
    def test_a_literal_reassigned_in_a_loop() {
        buf: bytes = b""
        total: int = 0
        for i in range(5000) {
            buf = b"abcd"
            total = total + len(buf)
            buf = b""
        }
        self.assertEqual(total, 20000)
        self.assertEqual(len(buf), 0)
    }

    def test_a_literal_outlives_the_container_it_was_put_in() {
        for i in range(5000) {
            box: list[bytes] = [b"abc", b"", b"abc"]
            self.assertEqual(len(box[0]), 3)
            self.assertEqual(len(box[1]), 0)
            table: dict[bytes, int] = {}
            table[b"key"] = 1
            table[b"other"] = 2
            self.assertEqual(table[b"key"], 1)
            self.assertEqual(len(table), 2)
        }
        self.assertEqual(len(b"abc"), 3)
    }

    def test_concatenating_a_literal_with_the_empty_literal() {
        for i in range(5000) {
            left: bytes = b"abc" + b""
            right: bytes = b"" + b"abc"
            self.assertEqual(left, b"abc")
            self.assertEqual(right, b"abc")
            self.assertEqual(left, right)
        }
        self.assertEqual(b"abc" + b"", b"abc")
    }

    def test_a_literal_handed_to_a_fire() {
        for i in range(2000) {
            t: Task[int] = fire _fold_bytes(b"abcd")
            self.assertEqual(t.join(), 394)
        }
    }

    def test_a_literal_read_from_an_os_thread() {
        th: Thread = Thread(target=_thread_body)
        th.start()
        th.join()
        self.assertEqual(thread_total, _fold_bytes(b"crossing") + 7)
        self.assertEqual(len(shared_literal), 8)
        self.assertEqual(_fold_list(shared_box), 7)
    }

    def test_a_literal_inside_a_container_handed_to_a_fire() {
        for i in range(2000) {
            box: list[bytes] = [b"abc", b"defg"]
            t: Task[int] = fire _fold_list(box)
            self.assertEqual(t.join(), 7)
        }
    }

    def test_a_literal_boxed_and_unboxed() {
        for i in range(5000) {
            v: LooseBytes = b"payload"
            self.assertTrue(isinstance(v, bytes))
            if isinstance(v, bytes) {
                self.assertEqual(len(v), 7)
                self.assertEqual(v, b"payload")
            }
        }
    }

    def test_a_literal_field_default_built_many_times() {
        total: int = 0
        for i in range(5000) {
            holder: LiteralDefaults = LiteralDefaults()
            total = total + holder.touch()
        }
        self.assertEqual(total, 25000)
    }

    def test_slicing_and_iterating_a_literal() {
        for i in range(5000) {
            self.assertEqual(len(b"abcd"[1:3]), 2)
            self.assertEqual(b"abcd"[1:3], b"bc")
            self.assertEqual(len(b""[0:5]), 0)
            self.assertEqual(_fold_bytes(b"abcd"), 394)
        }
        self.assertEqual(b"abcd"[::-1], b"dcba")
    }

    def test_len_hash_and_decode_of_a_literal() {
        for i in range(2000) {
            self.assertEqual(len(b"abc"), 3)
            self.assertEqual(hash(b"abc"), hash(b"ab" + b"c"))
            self.assertEqual(b"abc".decode("utf-8"), "abc")
            self.assertEqual(b"".decode("utf-8"), "")
        }
    }

    def test_the_same_literal_in_two_functions_compares_equal() {
        for i in range(2000) {
            self.assertEqual(_here_literal(), _there_literal())
            self.assertEqual(len(_here_literal()), 14)
        }
    }

    def test_deleting_a_name_bound_to_a_literal() {
        for i in range(2000) {
            buf: bytes = b"deleteme"
            self.assertEqual(len(buf), 8)
            del buf
        }
        self.assertEqual(len(b"deleteme"), 8)
    }

    def test_literals_with_embedded_nul_and_high_bytes() {
        for i in range(2000) {
            const nulled: bytes = b"a\x00b"
            const high: bytes = b"\x80\xff\x00\x7f"
            self.assertEqual(len(nulled), 3)
            self.assertEqual(len(high), 4)
            self.assertEqual(nulled[1], 0)
            self.assertEqual(high[0], 128)
            self.assertEqual(high[1], 255)
            self.assertEqual(_fold_bytes(nulled), ord("a") + ord("b"))
            self.assertEqual(nulled, b"a\x00b")
            self.assertNotEqual(nulled, b"ab")
        }
    }

    def test_returning_a_literal_from_a_function() {
        total: int = 0
        for i in range(5000) {
            total = total + len(_here_literal())
        }
        self.assertEqual(total, 70000)
    }
}


main([StringEmptyOperandTests(), StringLiteralHeaderTests(), StrSubstringInTests(),
      IntToStrTests(), OrdTests(), PredicateTests(), ReprTests(), HashTests(),
      ConversionTests(), TypeBuiltinTests(), BytesIterationTests(),
      BytesElementAccessTests(), BytesEmptyAndSliceTests(), BytesDecodeTests(),
      BytesLiteralImmortalTests()])

from unittest import TestCase, main
from odb import ODB, Documents, Document
from odb.vfs import SimVFS
from odb.pager import create, Pager
from odb.errors import SchemaError, IntegrityError


def _plain(ty: str) -> dict[str, Any] {
    p: dict[str, Any] = {}
    p["type"] = ty
    return p
}

def _array_of(ty: str) -> dict[str, Any] {
    item: dict[str, Any] = {}
    item["type"] = ty
    p: dict[str, Any] = {}
    p["type"] = "array"
    p["items"] = item
    return p
}

def _fresh() -> ODB {
    v: SimVFS = SimVFS()
    p: Pager = create(v, 4096)
    return ODB(v, p)
}

def _teams(db: ODB) -> Documents {
    props: dict[str, Any] = {}
    props["id"] = _plain("integer")
    props["name"] = _plain("string")
    s: dict[str, Any] = {}
    s["type"] = "object"
    s["properties"] = props
    req: list[Any] = ["id", "name"]
    s["required"] = req
    meta: dict[str, Any] = {}
    pk: list[Any] = ["id"]
    meta["primary"] = pk
    return db.schema("teams", s).meta(meta)
}

def _people(db: ODB, on_delete: str) -> Documents {
    props: dict[str, Any] = {}
    props["id"] = _plain("integer")
    props["team_ids"] = _array_of("integer")
    s: dict[str, Any] = {}
    s["type"] = "object"
    s["properties"] = props
    req: list[Any] = ["id", "team_ids"]
    s["required"] = req

    refspec: dict[str, Any] = {}
    refspec["to"] = "teams.id"
    refspec["on_delete"] = on_delete
    refs: dict[str, Any] = {}
    refs["team_ids"] = refspec
    meta: dict[str, Any] = {}
    pk: list[Any] = ["id"]
    meta["primary"] = pk
    meta["refs"] = refs
    return db.schema("people", s).meta(meta)
}

def _save_team(teams: Documents, tid: int, nm: str) -> None {
    t: dict[str, Any] = {}
    t["id"] = tid
    t["name"] = nm
    teams.save(t)
}

def _save_person(people: Documents, pid: int, ids: list[Any]) -> None {
    p: dict[str, Any] = {}
    p["id"] = pid
    p["team_ids"] = ids
    people.save(p)
}

def _team_ids(people: Documents, pid: int) -> list[int] {
    const d: Document = people.read(id=pid)
    const raw: list[Any] = d["team_ids"]
    out: list[int] = []
    for e in raw {
        const i: int = e
        out.append(i)
    }
    return out
}


class DetachTest(TestCase) {
    def test_detach_removes_only_the_matching_element() -> None {
        db: ODB = _fresh()
        teams: Documents = _teams(db)
        people: Documents = _people(db, "detach")
        _save_team(teams, 10, "core")
        _save_team(teams, 20, "infra")
        _save_team(teams, 30, "web")
        three: list[Any] = [10, 20, 30]
        one: list[Any] = [20]
        other: list[Any] = [10, 30]
        _save_person(people, 1, three)
        _save_person(people, 2, one)
        _save_person(people, 3, other)

        const target: Document = teams.read(id=20)
        target.wipe()

        const p1: list[int] = _team_ids(people, 1)
        self.assertEqual(len(p1), 2)
        self.assertEqual(p1[0], 10)
        self.assertEqual(p1[1], 30)

        const p2: list[int] = _team_ids(people, 2)
        self.assertEqual(len(p2), 0)

        const p3: list[int] = _team_ids(people, 3)
        self.assertEqual(len(p3), 2)
    }

    def test_detach_keeps_every_referring_document() -> None {
        db: ODB = _fresh()
        teams: Documents = _teams(db)
        people: Documents = _people(db, "detach")
        _save_team(teams, 10, "core")
        only: list[Any] = [10]
        _save_person(people, 1, only)

        const target: Document = teams.read(id=10)
        target.wipe()
        self.assertEqual(people.count(), 1)
    }

    def test_detach_requires_an_array_field() -> None {
        db: ODB = _fresh()
        _teams(db)
        props: dict[str, Any] = {}
        props["id"] = _plain("integer")
        props["team_id"] = _plain("integer")
        s: dict[str, Any] = {}
        s["type"] = "object"
        s["properties"] = props
        req: list[Any] = ["id", "team_id"]
        s["required"] = req
        refspec: dict[str, Any] = {}
        refspec["to"] = "teams.id"
        refspec["on_delete"] = "detach"
        refs: dict[str, Any] = {}
        refs["team_id"] = refspec
        meta: dict[str, Any] = {}
        pk: list[Any] = ["id"]
        meta["primary"] = pk
        meta["refs"] = refs

        raised: bool = False
        try {
            db.schema("people", s).meta(meta)
        } except SchemaError {
            raised = True
        }
        self.assertTrue(raised)
    }

    def test_a_missing_target_is_still_rejected() -> None {
        db: ODB = _fresh()
        _teams(db)
        people: Documents = _people(db, "detach")
        ghost: list[Any] = [99]
        raised: bool = False
        try {
            _save_person(people, 1, ghost)
        } except IntegrityError {
            raised = True
        }
        self.assertTrue(raised)
    }
}


class MultikeyIndexTest(TestCase) {
    def test_every_element_is_indexed() -> None {
        db: ODB = _fresh()
        props: dict[str, Any] = {}
        props["id"] = _plain("integer")
        props["tags"] = _array_of("string")
        s: dict[str, Any] = {}
        s["type"] = "object"
        s["properties"] = props
        req: list[Any] = ["id", "tags"]
        s["required"] = req
        meta: dict[str, Any] = {}
        pk: list[Any] = ["id"]
        idx: list[Any] = ["tags"]
        meta["primary"] = pk
        meta["index"] = idx
        coll: Documents = db.schema("t", s).meta(meta)

        a: list[Any] = ["red", "green", "blue"]
        p: dict[str, Any] = {}
        p["id"] = 1
        p["tags"] = a
        coll.save(p)

        b: list[Any] = ["green"]
        q: dict[str, Any] = {}
        q["id"] = 2
        q["tags"] = b
        coll.save(q)

        self.assertEqual(coll.count(), 2)
        const back: Document = coll.read(id=1)
        const got: list[Any] = back["tags"]
        self.assertEqual(len(got), 3)
    }

    def test_duplicate_elements_do_not_break_a_unique_index() -> None {
        db: ODB = _fresh()
        props: dict[str, Any] = {}
        props["id"] = _plain("integer")
        props["tags"] = _array_of("string")
        s: dict[str, Any] = {}
        s["type"] = "object"
        s["properties"] = props
        req: list[Any] = ["id", "tags"]
        s["required"] = req
        meta: dict[str, Any] = {}
        pk: list[Any] = ["id"]
        idx: list[Any] = ["tags"]
        meta["primary"] = pk
        meta["index"] = idx
        coll: Documents = db.schema("t", s).meta(meta)

        dupes: list[Any] = ["x", "x", "y"]
        p: dict[str, Any] = {}
        p["id"] = 1
        p["tags"] = dupes
        coll.save(p)
        self.assertEqual(coll.count(), 1)
        const back: Document = coll.read(id=1)
        const got: list[Any] = back["tags"]
        self.assertEqual(len(got), 3)
    }

    def test_an_empty_array_indexes_nothing_and_still_stores() -> None {
        db: ODB = _fresh()
        props: dict[str, Any] = {}
        props["id"] = _plain("integer")
        props["tags"] = _array_of("string")
        s: dict[str, Any] = {}
        s["type"] = "object"
        s["properties"] = props
        req: list[Any] = ["id", "tags"]
        s["required"] = req
        meta: dict[str, Any] = {}
        pk: list[Any] = ["id"]
        idx: list[Any] = ["tags"]
        meta["primary"] = pk
        meta["index"] = idx
        coll: Documents = db.schema("t", s).meta(meta)

        none_yet: list[Any] = []
        p: dict[str, Any] = {}
        p["id"] = 1
        p["tags"] = none_yet
        coll.save(p)
        self.assertEqual(coll.count(), 1)
        const back: Document = coll.read(id=1)
        const got: list[Any] = back["tags"]
        self.assertEqual(len(got), 0)
    }

    def test_editing_an_array_updates_every_index_entry() -> None {
        db: ODB = _fresh()
        teams: Documents = _teams(db)
        people: Documents = _people(db, "detach")
        _save_team(teams, 10, "core")
        _save_team(teams, 20, "infra")
        start: list[Any] = [10, 20]
        _save_person(people, 1, start)

        const d: Document = people.read(id=1)
        shrunk: list[Any] = [10]
        patch: dict[str, Any] = {}
        patch["team_ids"] = shrunk
        d.edit(patch)

        const t20: Document = teams.read(id=20)
        t20.wipe()

        const after: list[int] = _team_ids(people, 1)
        self.assertEqual(len(after), 1)
        self.assertEqual(after[0], 10)
    }
}


main([DetachTest(), MultikeyIndexTest()])

from unittest import TestCase, main
import ctorovl_mod


class Local {
    v: int = 0

    def(a: int) {
        self.v = a
    }

    def(a: int, b: int, c: int = 100) {
        self.v = a + b + c
    }
}


class CtorOverloadDispatchTests(TestCase) {
    """Constructor overloads dispatch by positional argument count, with a
    trailing default widening an overload's accepted count downward. A count
    matching no overload is a type-check error (pinned in TypeCheckerTest and
    by ctor_arity_guard.dr for the cross-module path); these pin that every
    legal count reaches the right constructor with defaults filled, in the
    same module and through a module-qualified name."""

    def test_exact_arity_dispatch() {
        self.assertEqual(Local(7).v, 7)
        self.assertEqual(Local(1, 2, 3).v, 6)
    }

    def test_default_fill_dispatches_to_wider_overload() {
        self.assertEqual(Local(1, 2).v, 103)
    }

    def test_module_qualified_exact_arity() {
        self.assertEqual(ctorovl_mod.Pair(9).v, 9)
        self.assertEqual(ctorovl_mod.Pair(1, 2, 3).v, 6)
    }

    def test_module_qualified_default_fill() {
        self.assertEqual(ctorovl_mod.Pair(5, 6).v, 111)
    }

    def test_dispatch_loop_no_leak() {
        i: int = 0
        while i < 5000 {
            const p: ctorovl_mod.Pair = ctorovl_mod.Pair(i, 1)
            self.assertEqual(p.v, i + 101)
            i = i + 1
        }
    }
}


main([CtorOverloadDispatchTests()])

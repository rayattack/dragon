from database.base import Value
from unittest import TestCase, main
import database
from database import SQL, ConnectionError, TxError
from sqlite import Database, Cursor
from tempfile import mkdtemp

class Customer(TypedDict) {
    id: int
    name: str
}

class DatabaseTests(TestCase) {
    """D032 database stdlib (SQLite backend) end-to-end.

    Exercises the Phase 1 surface via the real driver: template[SQL] parameter
    binding, native-typed dict[str, Value] rows, the Customer(**row) typed-conversion
    gate, and the structural injection-safety guarantee (a payload reaches a bound
    param, never the SQL text - the table survives).
    """

    def test_query_params_and_types() {
        db: database.Connection = database.open("sqlite::memory:")
        db.raw("create table t(id integer primary key, name text, score real)")
        nm: str = "dragon"
        sc: float = 9.5
        db.run(template[SQL] { insert into t(name, score) values(!{nm}, !{sc}) })
        rows: list[dict[str, Value]] = db.all(template[SQL] { select id, name, score from t })
        self.assertEqual(len(rows), 1)
        r: dict[str, Value] = rows[0]
        self.assertEqual(r["id"], 1)
        self.assertEqual(r["name"], "dragon")
        got: float = r["score"]
        self.assertAlmostEqual(got, 9.5)
        db.close()
    }

    def test_injection_safe() {
        db: database.Connection = database.open("sqlite::memory:")
        db.raw("create table t(id integer primary key, name text)")
        evil: str = "'; DROP TABLE t; --"
        db.run(template[SQL] { insert into t(name) values(!{evil}) })
        cnt: int = db.val(template[SQL] { select count(*) from t })
        self.assertEqual(cnt, 1)
        row: dict[str, Value] = db.one(template[SQL] { select name from t })
        self.assertEqual(row["name"], "'; DROP TABLE t; --")
        db.close()
    }

    def test_typed_row_conversion() {
        db: database.Connection = database.open("sqlite::memory:")
        db.raw("create table c(id integer primary key, name text)")
        a: str = "Ada"
        db.run(template[SQL] { insert into c(name) values(!{a}) })
        customers: list[Customer] = db.all[Customer](template[SQL] { select id, name from c })
        self.assertEqual(len(customers), 1)
        self.assertEqual(customers[0].id, 1)
        self.assertEqual(customers[0].name, "Ada")
        only: Customer = db.one(template[SQL] { select id, name from c where id = 1 })
        self.assertEqual(only.name, "Ada")
        db.close()
    }

    def test_transaction() {
        db: database.Connection = database.open("sqlite::memory:")
        db.raw("create table tx(id integer primary key, n int)")
        with db.transaction() as t {
            t.run(template[SQL] { insert into tx(n) values(1) })
            t.run(template[SQL] { insert into tx(n) values(2) })
            t.commit()
        }
        self.assertEqual(db.val[int](template[SQL] { select count(*) from tx }), 2)
        try {
            with db.transaction() as t2 {
                t2.run(template[SQL] { insert into tx(n) values(3) })
                raise ValueError("boom")
            }
        } except ValueError {
            pass
        }
        self.assertEqual(db.val[int](template[SQL] { select count(*) from tx }), 2)
        ins: database.Results = db.run(template[SQL] { insert into tx(n) values(9) })
        self.assertEqual(ins.ran, 1)
        self.assertTrue(ins.xid > 0)
        self.assertEqual(db.val[int](template[SQL] { select count(*) from tx }), 3)
        db.close()
    }

    def test_tx_handle_commit_persists() {
        db: database.Connection = database.open("sqlite::memory:")
        db.raw("create table h(id integer primary key, v text)")
        with db.transaction() as t {
            t.run(template[SQL] { insert into h(id, v) values(!{1}, !{"kept"}) })
            t.commit()
        }
        self.assertEqual(db.val[int](template[SQL] { select count(*) from h }), 1)
        db.run(template[SQL] { insert into h(id, v) values(!{2}, !{"after"}) })
        self.assertEqual(db.val[int](template[SQL] { select count(*) from h }), 2)
        db.close()
    }

    def test_tx_without_commit_rolls_back() {
        db: database.Connection = database.open("sqlite::memory:")
        db.raw("create table h(id integer primary key, v text)")
        with db.transaction() as t {
            t.run(template[SQL] { insert into h(id, v) values(!{1}, !{"dropped"}) })
        }
        self.assertEqual(db.val[int](template[SQL] { select count(*) from h }), 0)
        db.close()
    }

    def test_connection_commit_settles_the_block() {
        db: database.Connection = database.open("sqlite::memory:")
        db.raw("create table h(id integer primary key, v text)")
        with db.transaction() {
            db.run(template[SQL] { insert into h(id, v) values(!{2}, !{"batch"}) })
            db.commit()
        }
        self.assertEqual(db.val[int](template[SQL] { select count(*) from h }), 1)
        db.run(template[SQL] { insert into h(id, v) values(!{3}, !{"after"}) })
        self.assertEqual(db.val[int](template[SQL] { select count(*) from h }), 2)
        db.close()
    }

    def test_connection_rollback_settles_the_block() {
        db: database.Connection = database.open("sqlite::memory:")
        db.raw("create table h(id integer primary key, v text)")
        with db.transaction() {
            db.run(template[SQL] { insert into h(id, v) values(!{2}, !{"batch"}) })
            db.rollback()
        }
        self.assertEqual(db.val[int](template[SQL] { select count(*) from h }), 0)
        db.run(template[SQL] { insert into h(id, v) values(!{3}, !{"after"}) })
        self.assertEqual(db.val[int](template[SQL] { select count(*) from h }), 1)
        db.close()
    }

    def test_tx_exception_rolls_back_and_propagates() {
        db: database.Connection = database.open("sqlite::memory:")
        db.raw("create table h(id integer primary key, v text)")
        seen: bool = false
        try {
            with db.transaction() as t {
                t.run(template[SQL] { insert into h(id, v) values(!{1}, !{"lost"}) })
                raise ValueError("boom")
            }
        } except ValueError {
            seen = true
        }
        self.assertTrue(seen)
        self.assertEqual(db.val[int](template[SQL] { select count(*) from h }), 0)
        db.close()
    }

    def test_nested_transaction_raises_tx_error() {
        db: database.Connection = database.open("sqlite::memory:")
        db.raw("create table h(id integer primary key, v text)")
        refused: bool = false
        with db.transaction() as outer {
            outer.run(template[SQL] { insert into h(id, v) values(!{1}, !{"outer"}) })
            try {
                with db.transaction() as inner {
                    inner.run(template[SQL] { insert into h(id, v) values(!{2}, !{"inner"}) })
                }
            } except TxError {
                refused = true
            }
            outer.commit()
        }
        self.assertTrue(refused)
        self.assertEqual(db.val[int](template[SQL] { select count(*) from h }), 1)
        db.run(template[SQL] { insert into h(id, v) values(!{3}, !{"after"}) })
        self.assertEqual(db.val[int](template[SQL] { select count(*) from h }), 2)
        db.close()
    }

    def test_with_block() {
        with database.open("sqlite::memory:") as db {
            db.raw("create table w(id integer primary key, name text)")
            nm: str = "Ada"
            db.run(template[SQL] { insert into w(name) values(!{nm}) })
            self.assertEqual(db.val[int](template[SQL] { select count(*) from w }), 1)
            people: list[Customer] = db.all[Customer](template[SQL] { select id, name from w })
            self.assertEqual(len(people), 1)
            self.assertEqual(people[0].name, "Ada")
        }
    }

    def test_pool() {
        pool: database.Pool = database.Pool("sqlite::memory:", 2)
        c1: database.Connection = pool.acquire()
        self.assertEqual(c1.val[int](template[SQL] { select 1 as n }), 1)
        pool.release(c1)
        c2: database.Connection = pool.acquire()
        self.assertEqual(c2.val[int](template[SQL] { select 2 as n }), 2)
        pool.release(c2)
        pool.close()
    }
}

const BODY: str = "arrow → here, § then … and ô"


class TestSqliteUnicode(TestCase) {
    def test_bind_text_roundtrip() {
        const dir: str = mkdtemp("dr-sqlite-uni-", "")
        with Database(dir + "/u.db") as db {
            db.execute("CREATE TABLE t (id INTEGER PRIMARY KEY, body TEXT)")
            cur: Cursor = db.prepare("INSERT INTO t (body) VALUES (?)")
            cur.bind_text(1, BODY)
            self.assertEqual(cur.step(), 101)
            cur.finalize()

            rd: Cursor = db.prepare("SELECT body, length(body) FROM t WHERE id = 1")
            self.assertEqual(rd.step(), 100)
            self.assertEqual(rd.column_text(0), BODY)
            self.assertEqual(rd.column_int(1), len(BODY))
            rd.finalize()
        }
    }

    def test_sql_text_with_nonascii_literal() {
        const dir: str = mkdtemp("dr-sqlite-lit-", "")
        with Database(dir + "/l.db") as db {
            db.execute("CREATE TABLE t (id INTEGER PRIMARY KEY, body TEXT)")
            self.assertEqual(db.execute("INSERT INTO t (body) VALUES ('drakon → literal')"), 0)
            rd: Cursor = db.prepare("SELECT body FROM t WHERE body = 'drakon → literal'")
            self.assertEqual(rd.step(), 100)
            self.assertEqual(rd.column_text(0), "drakon → literal")
            rd.finalize()
        }
    }

    def test_bound_buffer_survives_until_step() {
        const dir: str = mkdtemp("dr-sqlite-pin-", "")
        with Database(dir + "/p.db") as db {
            db.execute("CREATE TABLE t (id INTEGER PRIMARY KEY, a TEXT, b TEXT)")
            cur: Cursor = db.prepare("INSERT INTO t (a, b) VALUES (?, ?)")
            _bind_pair(cur)
            self.assertEqual(cur.step(), 101)
            cur.finalize()
            rd: Cursor = db.prepare("SELECT a, b FROM t WHERE id = 1")
            self.assertEqual(rd.step(), 100)
            self.assertEqual(rd.column_text(0), "left →")
            self.assertEqual(rd.column_text(1), "right §")
            rd.finalize()
        }
    }

    def test_ascii_unchanged() {
        const dir: str = mkdtemp("dr-sqlite-ascii-", "")
        with Database(dir + "/a.db") as db {
            db.execute("CREATE TABLE t (id INTEGER PRIMARY KEY, body TEXT)")
            cur: Cursor = db.prepare("INSERT INTO t (body) VALUES (?)")
            cur.bind_text(1, "plain ascii")
            self.assertEqual(cur.step(), 101)
            cur.finalize()
            rd: Cursor = db.prepare("SELECT body FROM t")
            self.assertEqual(rd.step(), 100)
            self.assertEqual(rd.column_text(0), "plain ascii")
            rd.finalize()
        }
    }
}


def _bind_pair(cur: Cursor) -> None {
    a: str = "left →"
    b: str = "right §"
    cur.bind_text(1, a)
    cur.bind_text(2, b)
}


const MYSQL_DSN: str = "mysql://root:eldorad0@127.0.0.1:3306/"


class MySqlTests(TestCase) {
    """D032 MySQL backend end-to-end, against a live server.

    Exercises the real wire-protocol driver: `database.open("mysql://...")` with
    the connection handshake (caching_sha2_password fast path + the
    mysql_native_password auth switch), binary-protocol prepared statements
    (COM_STMT_PREPARE/EXECUTE) with template[SQL] param binding, binary result-row
    decode (FLOAT/DOUBLE via struct), and the shared base-class surface
    (one / scalar) dispatching to MySqlConnection.

    Self-gating: if no MySQL is reachable / auth fails, the body raises
    ConnectionError before any assertion runs, which is caught and reported as a
    skip. AssertionError is not a ConnectionError, so a genuine wrong-answer still
    propagates. All writes go to a TEMPORARY table that vanishes on disconnect.
    """

    def test_mysql_live() {
        try {
            db: database.Connection = database.open(MYSQL_DSN)
            db.raw("create database if not exists dragontest")
            db.raw("use dragontest")
            db.raw("create temporary table dr_my_test(id int auto_increment primary key, name varchar(64), score double, flag tinyint)")

            nm: str = "'; drop table dr_my_test; --"
            sc: float = 9.5
            fl: int = 1
            res: database.Results = db.run(template[SQL] {
                insert into dr_my_test(name, score, flag) values(!{nm}, !{sc}, !{fl})
            })
            self.assertEqual(res.ran, 1)
            self.assertEqual(res.xid, 1)

            minscore: float = 5.0
            rows: list[dict[str, Value]] = db.all(template[SQL] {
                select id, name, score, flag from dr_my_test where score > !{minscore}
            })
            self.assertEqual(len(rows), 1)
            r: dict[str, Value] = rows[0]
            self.assertEqual(r["id"], 1)
            self.assertEqual(r["name"], "'; drop table dr_my_test; --")
            got: float = r["score"]
            self.assertAlmostEqual(got, 9.5)
            self.assertEqual(r["flag"], 1)

            cnt: int = db.val(template[SQL] { select count(*) as n from dr_my_test })
            self.assertEqual(cnt, 1)
            one: dict[str, Value] = db.one(template[SQL] { select name from dr_my_test })
            self.assertEqual(one["name"], "'; drop table dr_my_test; --")
            db.close()
        } except ConnectionError {
            print("skip: mysql not reachable at", MYSQL_DSN)
        }
    }
}


const PG_DSN: str = "postgres://stationbot:eldorad0@127.0.0.1:5432/stationbase"


class PostgresTests(TestCase) {
    """D032 Postgres backend end-to-end, against a live server.

    Exercises the real wire-protocol driver: `database.open("postgres://...")`
    SCRAM-SHA-256 auth, the extended query protocol with template[SQL] parameter
    binding (TEXT format), oid->dragon type mapping into dict[str, Value] rows, and
    the shared base-class surface (one / scalar) dispatching to PgConnection.

    Self-gating: if no Postgres is reachable at the test DSN the whole body raises
    ConnectionError before any assertion runs, which is caught and reported as a
    skip - so the test is a no-op off the dev box. AssertionError is NOT a
    ConnectionError, so a genuine wrong-answer failure still propagates.

    The dev test DB is postgres://stationbot:eldorad0@127.0.0.1:5432/stationbase
    (PG 16, scram-sha-256). All writes go to a session TEMP table that vanishes on
    disconnect, so the run leaves no trace.
    """

    def test_postgres_live() {
        try {
            db: database.Connection = database.open(PG_DSN)

            a: int = 42
            b: str = "O'Brien"
            c: float = 2.5
            flag: bool = True
            rows: list[dict[str, Value]] = db.all(template[SQL] {
                select !{a}::int as a, !{b}::text as b, !{c}::float8 as c, !{flag}::bool as d
            })
            self.assertEqual(len(rows), 1)
            r: dict[str, Value] = rows[0]
            self.assertEqual(r["a"], 42)
            self.assertEqual(r["b"], "O'Brien")
            got: float = r["c"]
            self.assertAlmostEqual(got, 2.5)
            self.assertEqual(r["d"], True)

            nrow: dict[str, Value] = db.one(template[SQL] { select null::int as n })
            self.assertEqual(nrow["n"], none)

            db.raw("create temp table dr_pg_test(id serial primary key, name text)")
            evil: str = "'; drop table dr_pg_test; --"
            res: database.Results = db.run(template[SQL] {
                insert into dr_pg_test(name) values(!{evil})
            })
            self.assertEqual(res.ran, 1)

            cnt: int = db.val(template[SQL] { select count(*) as n from dr_pg_test })
            self.assertEqual(cnt, 1)
            stored: dict[str, Value] = db.one(template[SQL] { select name from dr_pg_test })
            self.assertEqual(stored["name"], "'; drop table dr_pg_test; --")

            db.raw("drop table dr_pg_test")
            db.close()
        } except ConnectionError {
            print("skip: postgres not reachable at", PG_DSN)
        }
    }

    def test_tls_and_pool() {
        try {
            pool: database.Pool = database.Pool(PG_DSN + "?sslmode=require", 4)
            c1: database.Connection = pool.acquire()
            self.assertEqual(c1.val[int](template[SQL] { select !{7}::int as n }), 7)
            pool.release(c1)
            c2: database.Connection = pool.acquire()
            self.assertEqual(c2.val[int](template[SQL] { select !{8}::int as n }), 8)
            pool.release(c2)
            pool.close()
        } except ConnectionError {
            print("skip: postgres not reachable at", PG_DSN)
        }
    }
}


main([DatabaseTests(), TestSqliteUnicode(), MySqlTests(), PostgresTests()])

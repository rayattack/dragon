from unittest import TestCase, main
from odb import connect, ODB, Documents, Document
from odb.vfs import SimVFS
from odb.pager import create, Pager
from odb.errors import PrepareError


def _db() -> ODB {
    v: SimVFS = SimVFS()
    p: Pager = create(v, 4096)
    db: ODB = ODB(v, p)
    ntype: list[Any] = ["string", "null"]
    nprop: dict[str, Any] = {}
    nprop["type"] = ntype
    props: dict[str, Any] = {}
    idp: dict[str, Any] = {}
    idp["type"] = "integer"
    props["id"] = idp
    props["note"] = nprop
    tagp: dict[str, Any] = {}
    tagp["type"] = "array"
    props["tags"] = tagp
    s: dict[str, Any] = {}
    s["type"] = "object"
    s["properties"] = props
    req: list[Any] = ["id"]
    s["required"] = req
    meta: dict[str, Any] = {}
    pk: list[Any] = ["id"]
    meta["primary"] = pk

    coll: Documents = db.schema("t", s).meta(meta)
    tags: list[Any] = ["x", "y"]
    stored_null: dict[str, Any] = {}
    stored_null["id"] = 1
    stored_null["note"] = None
    stored_null["tags"] = tags
    coll.save(stored_null)
    has_value: dict[str, Any] = {}
    has_value["id"] = 2
    has_value["note"] = "hi"
    coll.save(has_value)
    absent: dict[str, Any] = {}
    absent["id"] = 3
    coll.save(absent)
    return db
}

def _ids(db: ODB, q: str) -> list[int] {
    out: list[int] = []
    for r in db.find(q) {
        const i: int = r["id"]
        out.append(i)
    }
    out.sort()
    return out
}


class NullComparisonTest(TestCase) {
    def test_equals_null_matches_stored_null_only() -> None {
        db: ODB = _db()
        const got: list[int] = _ids(db, "t ? note == null { id }")
        self.assertEqual(len(got), 1)
        self.assertEqual(got[0], 1)
    }

    def test_not_equals_null_excludes_stored_null() -> None {
        db: ODB = _db()
        const got: list[int] = _ids(db, "t ? note != null { id }")
        self.assertEqual(len(got), 2)
        self.assertEqual(got[0], 2)
        self.assertEqual(got[1], 3)
    }

    def test_a_stored_null_does_not_break_an_ordinary_filter() -> None {
        db: ODB = _db()
        const got: list[int] = _ids(db, "t ? note == \"hi\" { id }")
        self.assertEqual(len(got), 1)
        self.assertEqual(got[0], 2)
    }

    def test_ordering_comparisons_against_null_are_false() -> None {
        db: ODB = _db()
        const got: list[int] = _ids(db, "t ? note > null { id }")
        self.assertEqual(len(got), 0)
    }
}


class UndefinedDesugarTest(TestCase) {
    def test_equals_undefined_matches_absence_only() -> None {
        db: ODB = _db()
        const got: list[int] = _ids(db, "t ? note == undefined { id }")
        self.assertEqual(len(got), 1)
        self.assertEqual(got[0], 3)
    }

    def test_not_equals_undefined_matches_every_present_field() -> None {
        db: ODB = _db()
        const got: list[int] = _ids(db, "t ? note != undefined { id }")
        self.assertEqual(len(got), 2)
        self.assertEqual(got[0], 1)
        self.assertEqual(got[1], 2)
    }

    def test_desugar_matches_the_intrinsics_exactly() -> None {
        db: ODB = _db()
        self.assertEqual(_ids(db, "t ? note == undefined { id }"),
                         _ids(db, "t ? missing!(note) { id }"))
        self.assertEqual(_ids(db, "t ? note != undefined { id }"),
                         _ids(db, "t ? exists!(note) { id }"))
    }

    def test_undefined_is_rejected_outside_a_field_comparison() -> None {
        db: ODB = _db()
        raised: bool = False
        try {
            db.find("t ? undefined { id }")
        } except PrepareError {
            raised = True
        }
        self.assertTrue(raised)
    }

    def test_undefined_is_rejected_with_ordering_operators() -> None {
        db: ODB = _db()
        raised: bool = False
        try {
            db.find("t ? note < undefined { id }")
        } except PrepareError {
            raised = True
        }
        self.assertTrue(raised)
    }

    def test_null_against_null_is_rejected() -> None {
        db: ODB = _db()
        raised: bool = False
        try {
            db.find("t ? null == null { id }")
        } except PrepareError {
            raised = True
        }
        self.assertTrue(raised)
    }
}


class CoalesceTest(TestCase) {
    def test_coalesce_covers_both_null_and_absence() -> None {
        db: ODB = _db()
        const got: list[int] = _ids(db, "t ? (note ?? \"none\") == \"none\" { id }")
        self.assertEqual(len(got), 2)
        self.assertEqual(got[0], 1)
        self.assertEqual(got[1], 3)
    }
}


class ProjectionTest(TestCase) {
    def test_null_is_projected_as_a_present_key() -> None {
        db: ODB = _db()
        const rows: list[Document] = db.find("t ? id == 1 { note }")
        self.assertEqual(len(rows), 1)
        const r: Document = rows[0]
        self.assertTrue("note" in r.data)
        self.assertTrue(r.data["note"] is None)
    }

    def test_absent_is_projected_as_no_key() -> None {
        db: ODB = _db()
        const rows: list[Document] = db.find("t ? id == 3 { note }")
        self.assertEqual(len(rows), 1)
        const r: Document = rows[0]
        self.assertFalse("note" in r.data)
    }

    def test_an_array_field_projects_as_a_list() -> None {
        db: ODB = _db()
        const rows: list[Document] = db.find("t ? id == 1 { tags }")
        self.assertEqual(len(rows), 1)
        const r: Document = rows[0]
        const tags: list[Any] = r.data["tags"]
        self.assertEqual(len(tags), 2)
        const t0: str = tags[0]
        self.assertEqual(t0, "x")
    }
}


main([NullComparisonTest(), UndefinedDesugarTest(), CoalesceTest(), ProjectionTest()])

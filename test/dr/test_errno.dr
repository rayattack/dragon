from unittest import TestCase, main
import errno

class ErrnoTests(TestCase) {
    def test_known_codes() {
        self.assertEqual(errno.ENOENT, 2)
        self.assertEqual(errno.errorcode(errno.ENOENT), "ENOENT")
        self.assertEqual(errno.errorcode(1), "EPERM")
    }

    def test_unknown_code_returns_empty() {
        self.assertEqual(errno.errorcode(99999), "")
    }

    def test_cache_is_built_once_and_reused() {
        const first: int = len(errno.errorcode_dict())
        self.assertTrue(first > 0)
        self.assertEqual(len(errno.errorcode_dict()), first)
        self.assertEqual(errno.errorcode(2), "ENOENT")
    }

    def test_dict_and_function_agree() {
        const d: dict[int, str] = errno.errorcode_dict()
        self.assertEqual(d[2], errno.errorcode(2))
        self.assertEqual(d[1], errno.errorcode(1))
    }
}

main([ErrnoTests()])

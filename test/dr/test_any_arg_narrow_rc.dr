"""An `Any` handed straight to a typed slot must narrow under a tag check.

Pre-fix, `out.append(doc["action"])` reached a consumer that never unboxed and
died in the LLVM verifier, while a user call unboxed with no tag check and
segfaulted on an int. Binding to a name first already worked."""

from unittest import TestCase, main


def arg_len(s: str) -> int {
    return len(s)
}


def fresh_any(v: str) -> Any {
    return v.upper()
}


def fresh_doc(n: int) -> dict[str, Any] {
    return {"mrn": "A" + str(n)}
}


class Doc {
    data: dict[str, Any]

    def(data: dict[str, Any]) {
        self.data = data
    }

    def __getitem__(k: str) -> Any {
        return self.data[k]
    }
}


def churn() -> int {
    junk: list[str] = []
    i: int = 0
    while i < 200 {
        junk.append("filler-" + str(i))
        i = i + 1
    }
    return len(junk)
}


class TestAnyArgNarrow(TestCase) {
    def test_append_borrowed_box() {
        i: int = 0
        while i < 300 {
            d: dict[str, Any] = {"mrn": "A" + str(i)}
            out: list[str] = []
            out.append(d["mrn"])
            self.assertEqual(out[0], "A" + str(i))
            self.assertEqual(arg_len(d["mrn"]), len("A" + str(i)))
            i = i + 1
        }
        self.assertEqual(churn(), 200)
    }

    def test_append_owned_box() {
        i: int = 0
        while i < 300 {
            out: list[str] = []
            out.append(fresh_any("mrn" + str(i)))
            self.assertEqual(out[0], ("mrn" + str(i)).upper())
            i = i + 1
        }
        self.assertEqual(churn(), 200)
    }

    def test_append_int_and_float_tiers() {
        d: dict[str, Any] = {"n": 7, "f": 1.5}
        nums: list[int] = []
        reals: list[float] = []
        i: int = 0
        while i < 200 {
            nums.append(d["n"])
            reals.append(d["f"])
            i = i + 1
        }
        self.assertEqual(nums[0], 7)
        self.assertEqual(len(nums), 200)
        self.assertAlmostEqual(reals[0], 1.5)
    }

    def test_set_add_and_list_insert() {
        i: int = 0
        while i < 300 {
            d: dict[str, Any] = {"mrn": "A" + str(i)}
            seen: set[str] = set()
            seen.add(d["mrn"])
            self.assertEqual(len(seen), 1)
            out: list[str] = ["z"]
            out.insert(0, d["mrn"])
            self.assertEqual(out[0], "A" + str(i))
            self.assertEqual(out[1], "z")
            i = i + 1
        }
        self.assertEqual(churn(), 200)
    }

    def test_str_method_argument() {
        i: int = 0
        while i < 300 {
            d: dict[str, Any] = {"pre": "AB"}
            self.assertTrue("ABC".startswith(d["pre"]))
            self.assertFalse("XBC".startswith(d["pre"]))
            i = i + 1
        }
        self.assertEqual(churn(), 200)
    }

    def test_literal_element_and_join() {
        i: int = 0
        while i < 300 {
            d: dict[str, Any] = {"mrn": "A" + str(i)}
            parts: list[str] = ["id", d["mrn"]]
            self.assertEqual(parts[1], "A" + str(i))
            self.assertEqual(", ".join(parts), "id, A" + str(i))
            i = i + 1
        }
        self.assertEqual(churn(), 200)
    }

    def test_any_field_and_nested_dict_source() {
        i: int = 0
        while i < 300 {
            outer: dict[str, Any] = {"mrn": "A" + str(i)}
            a: Any = outer["mrn"]
            out: list[str] = []
            out.append(a)
            self.assertEqual(out[0], "A" + str(i))
            i = i + 1
        }
        self.assertEqual(churn(), 200)
    }

    def test_dict_literal_value() {
        i: int = 0
        while i < 300 {
            d: dict[str, Any] = {"mrn": "A" + str(i)}
            byname: dict[str, str] = {"id": d["mrn"]}
            self.assertEqual(byname["id"], "A" + str(i))
            i = i + 1
        }
        self.assertEqual(churn(), 200)
    }

    def test_tuple_literal_element() {
        i: int = 0
        while i < 300 {
            d: dict[str, Any] = {"mrn": "A" + str(i)}
            row: tuple[str, int] = (d["mrn"], i)
            self.assertEqual(row[0], "A" + str(i))
            self.assertEqual(row[1], i)
            i = i + 1
        }
        self.assertEqual(churn(), 200)
    }

    def test_owned_receiver_subscript() {
        out: list[str] = []
        i: int = 0
        while i < 300 {
            out.append(fresh_doc(i)["mrn"])
            i = i + 1
        }
        self.assertEqual(len(out), 300)
        self.assertEqual(out[299], "A299")
        self.assertEqual(churn(), 200)
    }

    def test_user_getitem_returning_any() {
        r: Doc = Doc({"mrn": "A1"})
        out: list[str] = []
        out.append(r["mrn"])
        self.assertEqual(out[0], "A1")
        const m: str = r["mrn"]
        self.assertEqual(m, "A1")
    }

    def test_wrong_runtime_type_raises_not_segv() {
        d: dict[str, Any] = {"mrn": 7}
        raised: bool = False
        try {
            print(arg_len(d["mrn"]))
        } except TypeError {
            raised = True
        }
        self.assertTrue(raised)
    }

    def test_wrong_runtime_type_on_append_raises() {
        d: dict[str, Any] = {"mrn": 7}
        out: list[str] = []
        raised: bool = False
        try {
            out.append(d["mrn"])
        } except TypeError {
            raised = True
        }
        self.assertTrue(raised)
        self.assertEqual(len(out), 0)
    }

    def test_source_dict_survives_every_narrowing() {
        d: dict[str, Any] = {"mrn": "A1"}
        out: list[str] = []
        i: int = 0
        while i < 300 {
            out.append(d["mrn"])
            i = i + 1
        }
        self.assertEqual(len(out), 300)
        self.assertEqual(out[299], "A1")
        const still: str = d["mrn"]
        self.assertEqual(still, "A1")
        self.assertEqual(churn(), 200)
    }
}


main([TestAnyArgNarrow()])

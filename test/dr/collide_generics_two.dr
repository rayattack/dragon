"""The other Box[T] and pick[T]: same template names, different bodies."""


class Box[T] {
    def(v: T) {
        self.v = v
        self.stamp: int = 99
    }

    def get() -> T {
        return self.v
    }

    def stamped() -> int {
        return self.stamp
    }
}


def two_box_int() -> int {
    b: Box[int] = Box[int](5)
    return b.get() + b.stamped()
}


def pick[T](xs: list[T]) -> T {
    return xs[len(xs) - 1]
}


def two_pick_int() -> int {
    return pick([11, 22, 33])
}

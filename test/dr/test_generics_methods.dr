from unittest import TestCase, main

class Animal {
    name: str
    def(name: str) {
        self.name = name
    }
    def speak() -> str {
        return self.name + " makes a sound"
    }
}

class Dog(Animal) {
    def(name: str) {
        self.name = name
    }
    def speak() -> str {
        return self.name + " says woof"
    }
}

class Vec {
    x: int
    def(x: int) {
        self.x = x
    }
    def __add__(other: Vec) -> Vec {
        return Vec(self.x + other.x)
    }
    def val() -> int {
        return self.x
    }
}

def describe[T: Animal](x: T) -> str {
    return x.name + ": " + x.speak()
}

class Shelter[T: Animal] {
    occupant: T
    def(occupant: T) {
        self.occupant = occupant
    }
    def announce() -> str {
        return self.occupant.speak()
    }
}

class Registry {
    def loudest[T: Animal](a: T) -> str {
        return a.speak()
    }
}

def sum_pair[T: Vec](a: T, b: T) -> T {
    return a + b
}

class Customer {
    id: int
    name: str
    def(id: int, name: str) {
        self.id = id
        self.name = name
    }
}

class Repo {
    def cast[T](x: T) -> T {
        return x
    }
    def wrap[T](x: T) -> list[T] {
        ys: list[T] = []
        ys.append(x)
        return ys
    }
    def make[T](n: int) -> list[T] {
        out: list[T] = []
        i: int = 0
        while i < n {
            out.append(T(i, "row"))
            i = i + 1
        }
        return out
    }
    def cast_via_self[T](x: T) -> T {
        return self.cast[T](x)
    }
    def second[K, V](k: K, v: V) -> V {
        return v
    }
    def fetch[T](rows: list[dict[str, Any]]) -> list[T] {
        return [T(**r) for r in rows]
    }
    def gather[T](xs: list[int]) -> list[T] {
        return [T(x, "g") for x in xs]
    }
}

class Base {
    def echo[T](x: T) -> T {
        return x
    }
}

class Derived(Base) {
    tag: int
    def(t: int) {
        self.tag = t
    }
}

class OtherRepo {
    def cast[T](x: T) -> T {
        return x
    }
}


class SubRepo(Repo) {
    def tag() -> str {
        return "sub"
    }
}


class Store {
    def(seed: int) {
        self._seed = seed
    }

    def grab[T]() -> list[T] {
        out: list[T] = []
        out.append(T(self._seed))
        return out
    }

    def pair[T](extra: T) -> list[T] {
        out: list[T] = []
        out.append(T(self._seed))
        out.append(extra)
        return out
    }

    def plain() -> int {
        return self._seed
    }
}

store: Store = Store(7)

class BoundedGenericsTests(TestCase) {
    """Bounded type parameters (`T: Bound`).

    A bounded `T: B` lifts the unbounded-`T` restriction inside the generic body:
    members, methods, and operators that the bound `B` provides may be used on a
    `T`-typed value (type-checked against `B`, dispatched to the concrete argument
    after monomorphization). Each instantiation requires the concrete type argument
    to be `B` or a subclass - enforced at the instantiation site, so a violating
    argument is a clean compile error, never a miscompile (the negative cases live
    in TypeCheckerTest.Bounded* as must-not-compile checks).

    Covered here (behavioral / value assertions): method + attribute access on a
    bounded free-function `T`; subclass dispatch (the concrete arg's override runs,
    not the bound's); inferred type args; a bounded generic CLASS; a bounded generic
    METHOD declaring its own `T`; and operator (dunder) dispatch through a bounded T.
    """

    def test_method_and_attr_on_bound() {
        a: Animal = Animal("Critter")
        self.assertEqual(describe[Animal](a), "Critter: Critter makes a sound")
    }

    def test_subclass_arg_dispatches_override() {
        d: Dog = Dog("Rex")
        self.assertEqual(describe[Dog](d), "Rex: Rex says woof")
    }

    def test_inferred_type_arg() {
        d: Dog = Dog("Fido")
        self.assertEqual(describe(d), "Fido: Fido says woof")
    }

    def test_bounded_generic_class() {
        s: Shelter[Dog] = Shelter[Dog](Dog("Bingo"))
        self.assertEqual(s.announce(), "Bingo says woof")
    }

    def test_bounded_generic_method() {
        r: Registry = Registry()
        self.assertEqual(r.loudest[Dog](Dog("Spot")), "Spot says woof")
    }

    def test_operator_dunder_on_bound() {
        v: Vec = sum_pair[Vec](Vec(2), Vec(40))
        self.assertEqual(v.val(), 42)
    }
}

class GenericsMethodTests(TestCase) {
    """Decision 044+ - generic METHODS (a method declaring its OWN type parameter).

    `def m[T](...)` on a class is monomorphized exactly like a generic free function:
    each concrete use site (`recv.m[int](...)` explicit, or `recv.m(x)` inferred)
    stamps a specialization into the owning class body, reached through ordinary
    method dispatch (so D026 vtable/MRO and inheritance keep working). This is the
    language feature underpinning the D049 `db.all[T]` / `db.one[T]` fetch surface.

    Covered: identity + `list[T]` return shapes; explicit and inferred type args;
    constructing `T(...)` inside the body; a generic method inherited from a base and
    called on a subclass (MRO walk); a method calling a sibling generic method via
    `self`; and multi-parameter `[K, V]` methods.
    """

    def test_cast_explicit() {
        r: Repo = Repo()
        self.assertEqual(r.cast[int](7), 7)
    }

    def test_cast_inferred() {
        r: Repo = Repo()
        self.assertEqual(r.cast("hi"), "hi")
    }

    def test_wrap_explicit_int() {
        r: Repo = Repo()
        xs: list[int] = r.wrap[int](3)
        self.assertEqual(len(xs), 1)
        self.assertEqual(xs[0], 3)
    }

    def test_wrap_inferred_str() {
        r: Repo = Repo()
        ss: list[str] = r.wrap("z")
        self.assertEqual(ss[0], "z")
    }

    def test_make_constructs_T() {
        r: Repo = Repo()
        custs: list[Customer] = r.make[Customer](3)
        self.assertEqual(len(custs), 3)
        self.assertEqual(custs[0].name, "row")
        self.assertEqual(custs[2].id, 2)
    }

    def test_self_call() {
        r: Repo = Repo()
        self.assertEqual(r.cast_via_self[int](99), 99)
    }

    def test_multi_param_explicit() {
        r: Repo = Repo()
        self.assertEqual(r.second[str, int]("k", 5), 5)
    }

    def test_multi_param_inferred() {
        r: Repo = Repo()
        self.assertEqual(r.second("a", 9), 9)
    }

    def test_inherited_generic_method_int() {
        d: Derived = Derived(5)
        self.assertEqual(d.echo[int](42), 42)
    }

    def test_inherited_generic_method_inferred() {
        d: Derived = Derived(5)
        self.assertEqual(d.echo("hello"), "hello")
    }

    def test_comprehension_spread_materialization() {
        r: Repo = Repo()
        rows: list[dict[str, Any]] = [{"id": 1, "name": "alice"}, {"id": 2, "name": "bob"}]
        custs: list[Customer] = r.fetch[Customer](rows)
        self.assertEqual(len(custs), 2)
        self.assertEqual(custs[0].id, 1)
        self.assertEqual(custs[0].name, "alice")
        self.assertEqual(custs[1].name, "bob")
    }

    def test_comprehension_positional_construction() {
        r: Repo = Repo()
        cs: list[Customer] = r.gather[Customer]([5, 6, 7])
        self.assertEqual(len(cs), 3)
        self.assertEqual(cs[2].id, 7)
        self.assertEqual(cs[0].name, "g")
    }

    def test_bracketless_infers_T_from_annotation() {
        r: Repo = Repo()
        cs: list[Customer] = r.gather([8, 9])
        self.assertEqual(len(cs), 2)
        self.assertEqual(cs[1].id, 9)
    }

    def test_bracketless_scalar_infers_from_annotation() {
        r: Repo = Repo()
        x: int = r.cast(5)
        self.assertEqual(x, 5)
    }
}

class GenericMethodReassignTests(TestCase) {
    """Generic-method call as a bare reassignment RHS.

    Given the code:

        const a: int = db.val[int]("SELECT 1")   # compiles
        x = db.val[int]("SELECT 2")              # ERROR: type 'Connection' has
                                                 #        no attribute 'val[int]'

    The declaration form worked; the plain reassignment of an existing variable
    failed on the SAME call. Checking `recv.method[T](args)` stamps a concrete
    specialization and retargets the call node to its stamped name
    (`val[int]`). A declaration infers its RHS once, but a bare reassignment
    infers the RHS AGAIN to validate it against the slot's declared type - and
    the second look saw the already-retargeted node, fell through to ordinary
    attribute dispatch, and reported the stamped name as a missing attribute.

    WHEN: any reassignment (or re-checked pass) whose RHS calls a generic
    method - the db.val[T]/one[T]/all[T] fetch surface being the everyday case.

    WHY: IT appears the revisit guard recognised retargeted FREE functions but not
    retargeted METHODS e.g. (an AttributeExpr attribute containing '[').

    BEFORE: `x = r.cast[int](42)` was a compile error. AFTER: it compiles and
    returns the right value; declaration behavior unchanged.

    One line: a stamped generic-method call now survives being type-checked
    twice.
    """

    def test_explicit_stamp_on_reassignment() {
        const r: Repo = Repo()
        x: int = 0
        x = r.cast[int](42)
        self.assertEqual(x, 42)
        s: str = ""
        s = r.cast[str]("hi")
        self.assertEqual(s, "hi")
    }

    def test_inferred_stamp_on_reassignment() {
        const r: Repo = Repo()
        x: int = 0
        x = r.cast(7)
        self.assertEqual(x, 7)
    }

    def test_reassignment_in_loop_revisits() {
        const r: Repo = Repo()
        acc: int = 0
        i: int = 0
        while i < 5 {
            acc = acc + r.cast[int](i)
            i = i + 1
        }
        self.assertEqual(acc, 10)
    }

    def test_inherited_generic_method_reassignment() {
        const s: SubRepo = SubRepo()
        x: int = 0
        x = s.cast[int](9)
        self.assertEqual(x, 9)
        self.assertEqual(s.tag(), "sub")
    }

    def test_same_named_stamps_do_not_collide() {
        const a: Repo = Repo()
        const b: OtherRepo = OtherRepo()
        x: int = 0
        x = a.cast[int](1)
        y: int = 0
        y = b.cast[int](2)
        self.assertEqual(x, 1)
        self.assertEqual(y, 2)
    }

    def test_declaration_form_still_works() {
        const r: Repo = Repo()
        const a: int = r.cast[int](41)
        self.assertEqual(a, 41)
    }
}

class LambdaBodyTypeTests(TestCase) {

    def test_explicit_generic_method_in_lambda() {
        f: Callable[[], int] = lambda () -> int {
            rows: list[int] = store.grab[int]()
            return rows[0] if len(rows) == 1 else -1
        }
        self.assertEqual(f(), 7)
    }

    def test_bare_inference_generic_method_in_lambda() {
        g: Callable[[], int] = lambda () -> int {
            rows: list[int] = store.grab()
            return rows[0] if len(rows) == 1 else -1
        }
        self.assertEqual(g(), 7)
    }

    def test_generic_method_with_args_in_lambda() {
        h: Callable[[int], int] = lambda (extra: int) -> int {
            rows: list[int] = store.pair[int](extra)
            return rows[0] + rows[1] if len(rows) == 2 else -1
        }
        self.assertEqual(h(35), 42)
    }

    def test_non_generic_method_in_lambda_still_works() {
        p: Callable[[], int] = lambda () -> int {
            return store.plain()
        }
        self.assertEqual(p(), 7)
    }

    def test_loop_statements_in_lambda_body() {
        q: Callable[[list[int]], int] = lambda (xs: list[int]) -> int {
            total: int = 0
            for x in xs {
                total = total + x
            }
            return total
        }
        rows: list[int] = store.pair[int](35)
        self.assertEqual(q(rows), 42)
    }
}


main([BoundedGenericsTests(), GenericsMethodTests(), GenericMethodReassignTests(), LambdaBodyTypeTests()])

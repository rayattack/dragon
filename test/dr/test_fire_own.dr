from unittest import TestCase, main
from socket import SocketHandle
from time import sleep_ms

extern "C" def socket(domain: intc, type: intc, protocol: intc) -> intc
extern "C" def bind(fd: intc, addr: ptr, addrlen: intc) -> intc
extern "C" def listen(fd: intc, backlog: intc) -> intc
extern "C" def dragon_setsockopt_reuse(fd: int)
extern "C" def dragon_nb_accept(server_fd: int, addr: ptr, addrlen: ptr) -> int
extern "C" def dragon_nb_connect(fd: int, addr: ptr, addrlen: int) -> int
extern "C" def dragon_nb_send(fd: int, buf: str, length: int) -> int
extern "C" def dragon_nb_recv_str(fd: int, max_len: int) -> str
extern "C" def dragon_sockaddr_in_new(port: intc, addr: str) -> ptr
extern "C" def dragon_sockaddr_in_size() -> intc
extern "C" def free(p: ptr)

class OwnStream {
    own _s: SocketHandle
    def(own s: SocketHandle) { self._s = s }
    def send(d: str) -> int { return dragon_nb_send(self._s.fd(), d, len(d)) }
    def recv(n: int) -> str { return dragon_nb_recv_str(self._s.fd(), n) }
    def close() -> None { self._s.close() }
}

class OwnListener {
    own _s: SocketHandle
    def(own s: SocketHandle) { self._s = s }
    def acc() -> int { return dragon_nb_accept(self._s.fd(), none, none) }
    def close() -> None { self._s.close() }
}

class PlainListener {
    _s: SocketHandle
    def(s: SocketHandle) { self._s = s }
    def acc() -> int { return dragon_nb_accept(self._s.fd(), none, none) }
    def close() -> None { self._s.close() }
}

class OwnBox {
    own _v: SocketHandle
    _n: int
    def(own v: SocketHandle, n: int) { self._v = v; self._n = n }
    def n() -> int { return self._n }
}

def _listen_on(port: int) -> int {
    lfd: int = socket(2, 1, 0)
    dragon_setsockopt_reuse(lfd)
    a: ptr = dragon_sockaddr_in_new(port, "127.0.0.1")
    brc: int = bind(lfd, a, dragon_sockaddr_in_size())
    free(a)
    if brc != 0 {
        return -1
    }
    listen(lfd, 8)
    return lfd
}

def _echo_own(ls: OwnListener) -> None {
    cfd: int = ls.acc()
    conn: OwnStream = OwnStream(SocketHandle.adopt_raw(cfd))
    msg: str = conn.recv(1024)
    conn.send("echo:" + msg)
    conn.close()
}

def _echo_plain(ls: PlainListener) -> None {
    cfd: int = ls.acc()
    conn: OwnStream = OwnStream(SocketHandle.adopt_raw(cfd))
    msg: str = conn.recv(1024)
    conn.send("echo:" + msg)
    conn.close()
}

def _timer_worker(b: OwnBox) -> int {
    sleep_ms(10)
    return b.n() * 2
}

# Forward-referenced ctor with an own param: the construction site lowered before the ctor's
# ownership descriptor registered, so the adopted +1 was also caller-drained (UAF, hang on a garbage fd).

class Strm {
    own _s: SocketHandle
    def(own s: SocketHandle) { self._s = s }
    def send(d: str) -> int { return dragon_nb_send(self._s.fd(), d, len(d)) }
    def recv(n: int) -> str { return dragon_nb_recv_str(self._s.fd(), n) }
    def close() -> None { self._s.close() }
}

class Lstn {
    own _s: SocketHandle
    host: str
    port: int
    def(host: str, port: int) {
        const sfd: int = socket(2, 1, 0)
        self._s = SocketHandle.adopt_raw(sfd)
        self.host = host
        self.port = port
        dragon_setsockopt_reuse(self._s.fd())
    }
    def bind() -> int {
        const a: ptr = dragon_sockaddr_in_new(self.port, self.host)
        const rc: int = bind(self._s.fd(), a, dragon_sockaddr_in_size())
        free(a)
        return rc
    }
    def listen(n: int) -> int { return listen(self._s.fd(), n) }
    def accept() -> Strm {
        return Strm(SocketHandle.adopt_raw(dragon_nb_accept(self._s.fd(), none, none)))
    }
    def close() -> None { self._s.close() }
}

def _echo(ls: Lstn) -> None {
    conn: Strm = ls.accept()
    conn.send("echo:" + conn.recv(1024))
    conn.close()
}

class LstnF {
    own _s: SocketHandle
    host: str
    port: int
    def(host: str, port: int) {
        const sfd: int = socket(2, 1, 0)
        self._s = SocketHandle.adopt_raw(sfd)
        self.host = host
        self.port = port
        dragon_setsockopt_reuse(self._s.fd())
    }
    def bind() -> int {
        const a: ptr = dragon_sockaddr_in_new(self.port, self.host)
        const rc: int = bind(self._s.fd(), a, dragon_sockaddr_in_size())
        free(a)
        return rc
    }
    def listen(n: int) -> int { return listen(self._s.fd(), n) }
    def accept() -> StrmF {
        return StrmF(SocketHandle.adopt_raw(dragon_nb_accept(self._s.fd(), none, none)))
    }
    def close() -> None { self._s.close() }
}

class StrmF {
    own _s: SocketHandle
    def(own s: SocketHandle) { self._s = s }
    def send(d: str) -> int { return dragon_nb_send(self._s.fd(), d, len(d)) }
    def recv(n: int) -> str { return dragon_nb_recv_str(self._s.fd(), n) }
    def close() -> None { self._s.close() }
}

def _echo_fwd(ls: LstnF) -> None {
    conn: StrmF = ls.accept()
    conn.send("echo:" + conn.recv(1024))
    conn.close()
}

class KwHolder {
    own _s: SocketHandle
    def(own s: SocketHandle) { self._s = s }
    def fd() -> int { return self._s.fd() }
    def close() -> None { self._s.close() }
}

class FireOwnIoTests(TestCase) {
    def test_own_field_fire_fd_echo() {
        lfd: int = _listen_on(54491)
        self.assertNotEqual(lfd, -1, "bind failed: port 54491 busy")
        if lfd == -1 { return }
        ls: OwnListener = OwnListener(SocketHandle.adopt_raw(lfd))
        t: Task[None] = fire _echo_own(ls)

        cfd: int = socket(2, 1, 0)
        a: ptr = dragon_sockaddr_in_new(54491, "127.0.0.1")
        dragon_nb_connect(cfd, a, dragon_sockaddr_in_size())
        free(a)
        c: OwnStream = OwnStream(SocketHandle.adopt_raw(cfd))
        c.send("ping")
        reply: str = c.recv(1024)
        await t
        c.close()
        ls.close()
        self.assertEqual(reply, "echo:ping")
    }

    def test_plain_field_fire_fd_echo() {
        lfd: int = _listen_on(54492)
        self.assertNotEqual(lfd, -1, "bind failed: port 54492 busy")
        if lfd == -1 { return }
        ls: PlainListener = PlainListener(SocketHandle.adopt_raw(lfd))
        t: Task[None] = fire _echo_plain(ls)

        cfd: int = socket(2, 1, 0)
        a: ptr = dragon_sockaddr_in_new(54492, "127.0.0.1")
        dragon_nb_connect(cfd, a, dragon_sockaddr_in_size())
        free(a)
        c: OwnStream = OwnStream(SocketHandle.adopt_raw(cfd))
        c.send("ping")
        reply: str = c.recv(1024)
        await t
        c.close()
        ls.close()
        self.assertEqual(reply, "echo:ping")
    }

    def test_own_field_fire_timer() {
        b: OwnBox = OwnBox(SocketHandle.adopt_raw(-1), 21)
        t: Task[int] = fire _timer_worker(b)
        sleep_ms(5)
        got: int = await t
        self.assertEqual(got, 42)
    }
}

class FireOwnFwdRefTests(TestCase) {
    def test_backward_ref_construction_fires_ok() {
        ls: Lstn = Lstn("127.0.0.1", 55851)
        brc: int = ls.bind()
        self.assertEqual(brc, 0, "bind failed: port 55851 busy")
        if brc != 0 { return }
        ls.listen(8)
        t: Task[None] = fire _echo(ls)

        cfd: int = socket(2, 1, 0)
        a: ptr = dragon_sockaddr_in_new(55851, "127.0.0.1")
        dragon_nb_connect(cfd, a, dragon_sockaddr_in_size())
        free(a)
        c: Strm = Strm(SocketHandle.adopt_raw(cfd))
        c.send("ping")
        reply: str = c.recv(1024)
        await t
        c.close()
        ls.close()
        self.assertEqual(reply, "echo:ping")
    }

    def test_forward_ref_construction_fires_ok() {
        ls: LstnF = LstnF("127.0.0.1", 55852)
        brc: int = ls.bind()
        self.assertEqual(brc, 0, "bind failed: port 55852 busy")
        if brc != 0 { return }
        ls.listen(8)
        t: Task[None] = fire _echo_fwd(ls)

        cfd: int = socket(2, 1, 0)
        a: ptr = dragon_sockaddr_in_new(55852, "127.0.0.1")
        dragon_nb_connect(cfd, a, dragon_sockaddr_in_size())
        free(a)
        c: StrmF = StrmF(SocketHandle.adopt_raw(cfd))
        c.send("ping")
        reply: str = c.recv(1024)
        await t
        c.close()
        ls.close()
        self.assertEqual(reply, "echo:ping")
    }

    def test_own_ctor_param_bound_by_keyword() {
        sfd: int = socket(2, 1, 0)
        h: KwHolder = KwHolder(s=SocketHandle.adopt_raw(sfd))
        self.assertEqual(h.fd(), sfd)
        h.close()
    }
}

def _apply_bool(f: Callable[[], bool]) -> bool {
    return f()
}


def _apply_int(f: Callable[[], int]) -> int {
    return f()
}


class FireLambdaArgRC(TestCase) {
    def test_fired_lambda_capturing_a_string_is_released() {
        needle: str = "".join(["<"])
        hits: int = 0
        i: int = 0
        while i < 3000 {
            t: Task[bool] = fire _apply_bool(lambda () -> bool { return needle == "<" })
            if await t {
                hits = hits + 1
            }
            i = i + 1
        }
        self.assertEqual(hits, 3000)
    }

    def test_fired_lambda_capturing_a_list_is_released() {
        total: int = 0
        i: int = 0
        while i < 3000 {
            xs: list[int] = [i, i + 1]
            t: Task[int] = fire _apply_int(lambda () -> int { return xs[0] + xs[1] })
            total = total + await t
            i = i + 1
        }
        self.assertEqual(total, 3000 * 3000)
    }
}


main([FireOwnIoTests(), FireOwnFwdRefTests(), FireLambdaArgRC()])

from unittest import TestCase, main
from textwrap import TextWrapper, wrap, fill, shorten, dedent, indent
from shlex import split, quote, join
from string import capwords, center, ljust, rjust, zfill, repeat
from difflib import ratio, get_close_matches
from fnmatch import fnmatch, fnmatchcase, filter_names, translate
import quopri
from html import escape, unescape
from re import compile, sub, findall, error, Pattern
import re


def _wrap_width_zero() -> None {
    wrap("hello world", 0)
}

def _wrap_width_negative() -> None {
    wrap("hello world", -3)
}

def _shorten_placeholder_too_wide() -> None {
    shorten("hello world", 4)
}

def _shorten_fits_but_placeholder_too_wide() -> None {
    shorten("hi", 3)
}


class WrapWidthTests(TestCase) {
    def test_zero_width_raises() {
        self.assertRaises(ValueError, _wrap_width_zero)
    }

    def test_negative_width_raises() {
        self.assertRaises(ValueError, _wrap_width_negative)
    }

    def test_narrow_width_with_wider_indent_terminates() {
        const tw: TextWrapper = TextWrapper(2, "", "  ")
        self.assertEqual(tw.wrap("abcdef"), ["ab", "  c", "  d", "  e", "  f"])
    }

    def test_long_word_breaks() {
        self.assertEqual(wrap("abcdefghij", 3), ["abc", "def", "ghi", "j"])
    }

    def test_basic_wrap() {
        self.assertEqual(wrap("the quick brown fox jumps", 10),
                         ["the quick", "brown fox", "jumps"])
    }

    def test_fill() {
        self.assertEqual(fill("a b c", 3), "a b\nc")
    }
}


class ShortenTests(TestCase) {
    def test_placeholder_too_wide_raises() {
        self.assertRaises(ValueError, _shorten_placeholder_too_wide)
    }

    def test_placeholder_check_precedes_fit() {
        self.assertRaises(ValueError, _shorten_fits_but_placeholder_too_wide)
    }

    def test_shorten_fits() {
        self.assertEqual(shorten("hello world", 15), "hello world")
    }

    def test_shorten_truncates_at_word_boundary() {
        self.assertEqual(shorten("The quick brown fox", 10), "The [...]")
    }

    def test_shorten_nothing_fits() {
        self.assertEqual(shorten("hello world", 5), "[...]")
    }
}


class SpanRewriteTests(TestCase) {
    def test_dedent() {
        self.assertEqual(dedent("    a\n    b\n"), "a\nb\n")
        self.assertEqual(dedent("  a\n    b"), "a\n  b")
        self.assertEqual(dedent("a\n  b"), "a\n  b")
    }

    def test_dedent_blank_lines_kept() {
        self.assertEqual(dedent("  a\n\n  b"), "a\n\nb")
    }

    def test_indent() {
        self.assertEqual(indent("a\nb\n", "  "), "  a\n  b\n")
        self.assertEqual(indent("a\n\nb", "> "), "> a\n\n> b")
    }
}


class SplitTests(TestCase) {
    """shlex - POSIX split / quote / join round-trips against CPython behaviour."""

    def test_split_basic() {
        parts: list[str] = split("ls -la /tmp")
        self.assertEqual(len(parts), 3)
        self.assertEqual(parts[0], "ls")
        self.assertEqual(parts[2], "/tmp")
    }

    def test_split_quotes() {
        self.assertEqual(split("echo 'hello world' foo"),
                         ["echo", "hello world", "foo"])
        self.assertEqual(split("a \"b c\" d"), ["a", "b c", "d"])
    }

    def test_split_empty() {
        self.assertEqual(len(split("")), 0)
        self.assertEqual(len(split("   ")), 0)
    }

    def test_backslash_escape() {
        self.assertEqual(split("a\\ b"), ["a b"])
        self.assertEqual(split("a\\"), ["a"])
    }

    def test_adjacent_quotes_merge() {
        self.assertEqual(split("ab'cd'ef"), ["abcdef"])
        self.assertEqual(split("a'b c'\"d e\"f"), ["ab cd ef"])
    }

    def test_double_quote_escapes() {
        self.assertEqual(split("\"a\\\"b\""), ["a\"b"])
        self.assertEqual(split("\"a\\\\b\""), ["a\\b"])
        self.assertEqual(split("\"a\\nb\""), ["a\\nb"])
    }

    def test_empty_quoted_token() {
        self.assertEqual(split("''"), [""])
        self.assertEqual(split("a '' b"), ["a", "", "b"])
    }

    def test_unterminated_quote_takes_rest() {
        self.assertEqual(split("a 'bc def"), ["a", "bc def"])
    }

    def test_larger_input() {
        words: list[str] = []
        i: int = 0
        while i < 300 {
            words.append(f"word{i}")
            i = i + 1
        }
        const line: str = " ".join(words)
        self.assertEqual(split(line), words)
    }
}


class QuoteJoinTests(TestCase) {
    def test_quote() {
        self.assertEqual(quote("plain"), "plain")
        self.assertEqual(quote(""), "''")
        self.assertEqual(quote("it's"), "'it'\"'\"'s'")
        self.assertEqual(quote("a'b'c"), "'a'\"'\"'b'\"'\"'c'")
    }

    def test_quote_basic() {
        self.assertEqual(quote("plain"), "plain")
        self.assertEqual(quote(""), "''")
        self.assertEqual(quote("has space"), "'has space'")
        self.assertEqual(quote("it's"), "'it'\"'\"'s'")
    }

    def test_join_roundtrip() {
        const args: list[str] = ["a b", "it's", "plain", "x\"y"]
        self.assertEqual(split(join(args)), args)
    }
}


class PaddingTests(TestCase) {
    """string module utilities: padding, repetition, capwords.

    The padding helpers used to build fill one character per concat (quadratic on
    pad width); they now use built-in string repetition. These assertions pin the
    exact output shapes so the rewrite cannot drift.
    """

    def test_center() {
        self.assertEqual(center("ab", 6, "-"), "--ab--")
        self.assertEqual(center("ab", 5, "-"), "-ab--")
        self.assertEqual(center("abc", 3, "-"), "abc")
        self.assertEqual(center("abc", 2, "-"), "abc")
        self.assertEqual(center("", 3, "*"), "***")
    }

    def test_ljust_rjust() {
        self.assertEqual(ljust("ab", 5, "."), "ab...")
        self.assertEqual(rjust("ab", 5, "."), "...ab")
        self.assertEqual(ljust("abcdef", 3, "."), "abcdef")
        self.assertEqual(rjust("abcdef", 3, "."), "abcdef")
    }

    def test_zfill() {
        self.assertEqual(zfill("42", 5), "00042")
        self.assertEqual(zfill("42", 2), "42")
        self.assertEqual(zfill("", 3), "000")
    }

    def test_repeat() {
        self.assertEqual(repeat("ab", 3), "ababab")
        self.assertEqual(repeat("x", 0), "")
        self.assertEqual(repeat("x", -2), "")
        self.assertEqual(repeat("", 5), "")
    }

    def test_capwords() {
        self.assertEqual(capwords("hello world"), "Hello World")
        self.assertEqual(capwords("one"), "One")
        self.assertEqual(capwords(""), "")
        self.assertEqual(capwords("a  b"), "A B")
    }
}


class DifflibTests(TestCase) {
    """difflib - Ratcliff-Obershelp ratio + get_close_matches vs CPython values."""

    def test_ratio_exact_and_empty() {
        self.assertAlmostEqual(ratio("abcd", "abcd"), 1.0)
        self.assertAlmostEqual(ratio("", ""), 1.0)
        self.assertAlmostEqual(ratio("abc", ""), 0.0)
    }

    def test_ratio_known_values() {
        self.assertAlmostEqual(ratio("abcd", "abce"), 0.75)
        self.assertAlmostEqual(ratio("kitten", "sitting"), 0.6153846, 6)
    }

    def test_get_close_matches() {
        got: list[str] = get_close_matches("appel", ["ape", "apple", "peach", "puppy"])
        self.assertEqual(got[0], "apple")
        self.assertEqual(len(got), 2)
    }

    def test_get_close_matches_cutoff_n() {
        got: list[str] = get_close_matches("wrd", ["word", "words", "ward", "xyz"], 2, 0.5)
        self.assertEqual(len(got), 2)
        self.assertEqual(got[0], "word")
    }
}


class TranslateTests(TestCase) {
    def test_star_and_escape() {
        self.assertEqual(translate("*.py"), "(?s:.*\\.py)\\Z")
    }

    def test_question_mark() {
        self.assertEqual(translate("a?c"), "(?s:a.c)\\Z")
    }

    def test_char_class() {
        self.assertEqual(translate("[abc]"), "(?s:[abc])\\Z")
        self.assertEqual(translate("[!x]"), "(?s:[^x])\\Z")
        self.assertEqual(translate("[a-z]"), "(?s:[a-z])\\Z")
    }

    def test_unterminated_bracket_escaped() {
        self.assertEqual(translate("a["), "(?s:a\\[)\\Z")
    }

    def test_consecutive_stars_collapse() {
        self.assertEqual(translate("a**b"), "(?s:a.*b)\\Z")
    }

    def test_metachars_escaped() {
        self.assertEqual(translate("a+b"), "(?s:a\\+b)\\Z")
        self.assertEqual(translate("a-b"), "(?s:a\\-b)\\Z")
        self.assertEqual(translate("a b"), "(?s:a\\ b)\\Z")
        self.assertEqual(translate("(x)"), "(?s:\\(x\\))\\Z")
    }
}


class MatchTests(TestCase) {
    def test_basic() {
        self.assertTrue(fnmatch("foo.py", "*.py"))
        self.assertFalse(fnmatch("foo.pyc", "*.py"))
        self.assertTrue(fnmatch("abc", "a?c"))
        self.assertTrue(fnmatch("abc", "*"))
        self.assertTrue(fnmatch("", "*"))
        self.assertTrue(fnmatch("", ""))
        self.assertFalse(fnmatch("a", ""))
    }

    def test_char_classes() {
        self.assertTrue(fnmatch("abc", "[ab]bc"))
        self.assertTrue(fnmatch("dbc", "[!ab]bc"))
        self.assertFalse(fnmatch("abc", "[!ab]bc"))
        self.assertTrue(fnmatch("m.txt", "[a-z].txt"))
        self.assertFalse(fnmatch("M.txt", "[a-z].txt"))
    }

    def test_multi_star_backtracking() {
        self.assertTrue(fnmatch("axbyc", "a*b*c"))
        self.assertTrue(fnmatch("aXXbYYcZZc", "a*b*c"))
        self.assertFalse(fnmatch("axbyd", "a*b*c"))
    }

    def test_unterminated_bracket_is_literal() {
        self.assertTrue(fnmatch("ab[", "ab["))
        self.assertFalse(fnmatch("abx", "ab["))
    }

    def test_pathological_pattern_fast() {
        const name: str = "a" * 60
        self.assertFalse(fnmatch(name, "a*a*a*a*a*a*a*a*a*a*b"))
        self.assertTrue(fnmatch(name, "a*a*a*a*a*a*a*a*a*a*"))
    }

    def test_filter_names() {
        self.assertEqual(filter_names(["a.py", "b.txt", "c.py"], "*.py"), ["a.py", "c.py"])
        self.assertTrue(fnmatchcase("foo.PY", "*.PY"))
    }
}


class QuopriTests(TestCase) {
    """quopri - round-trip + CPython KAT vectors."""

    def test_ascii_passthrough() {
        self.assertEqual(quopri.encodestring("hello"), "hello")
        self.assertEqual(quopri.decodestring("hello"), "hello")
    }

    def test_equals_is_escaped() {
        self.assertEqual(quopri.encodestring("a=b"), "a=3Db")
        self.assertEqual(quopri.decodestring("a=3Db"), "a=b")
    }

    def test_non_printable_escaped() {
        self.assertEqual(quopri.encodestring(chr(1)), "=01")
        self.assertEqual(quopri.decodestring("=01"), chr(1))
    }

    def test_quotetabs_default() {
        self.assertEqual(quopri.encodestring("a b\tc"), "a b\tc")
    }

    def test_quotetabs_true() {
        self.assertEqual(quopri.encodestring("a b\tc", true), "a=20b=09c")
        self.assertEqual(quopri.decodestring("a=20b=09c"), "a b\tc")
    }

    def test_round_trip_extended_ascii() {
        original: str = ""
        for i in range(128, 145) {
            original = original + chr(i)
        }
        encoded: str = quopri.encodestring(original)
        decoded: str = quopri.decodestring(encoded)
        self.assertEqual(decoded, original)
    }

    def test_soft_line_break_decoded() {
        self.assertEqual(quopri.decodestring("foo=\nbar"), "foobar")
    }

    def test_lowercase_hex_decoded() {
        self.assertEqual(quopri.decodestring("=3d"), "=")
    }
}


class UnescapeRangeTests(TestCase) {
    def test_decimal_beyond_ascii() {
        self.assertEqual(unescape("&#233;"), chr(233))
        self.assertEqual(unescape("caf&#233;"), "caf" + chr(233))
        self.assertEqual(unescape("&#0000065;"), "A")
    }

    def test_hex_beyond_ascii() {
        self.assertEqual(unescape("&#xE9;"), chr(233))
        self.assertEqual(unescape("&#xe9;"), chr(233))
    }

    def test_astral_code_points() {
        self.assertEqual(unescape("&#128512;"), chr(128512))
        self.assertEqual(unescape("&#x1F600;"), chr(128512))
    }

    def test_low_controls_decode() {
        self.assertEqual(unescape("&#10;"), "\n")
        self.assertEqual(unescape("&#9;"), "\t")
    }

    def test_invalid_hex_left_verbatim() {
        self.assertEqual(unescape("&#xZZ;"), "&#xZZ;")
        self.assertEqual(unescape("&#x;"), "&#x;")
        self.assertEqual(unescape("&#x1G;"), "&#x1G;")
    }

    def test_out_of_range_left_verbatim() {
        self.assertEqual(unescape("&#1114112;"), "&#1114112;")
        self.assertEqual(unescape("&#x110000;"), "&#x110000;")
        self.assertEqual(unescape("&#99999999999999999999;"), "&#99999999999999999999;")
        self.assertEqual(unescape("&#xFFFFFFFFFFFFFFFFFF;"), "&#xFFFFFFFFFFFFFFFFFF;")
    }

    def test_max_code_point() {
        self.assertEqual(unescape("&#1114111;"), chr(1114111))
        self.assertEqual(unescape("&#x10FFFF;"), chr(1114111))
    }

    def test_named_still_work() {
        self.assertEqual(unescape("&amp;&lt;&gt;"), "&<>")
    }
}


class EscapeSpanTests(TestCase) {
    def test_all_specials() {
        self.assertEqual(escape("<a href=\"x\">&'</a>"),
                         "&lt;a href=&quot;x&quot;&gt;&amp;&#x27;&lt;/a&gt;")
    }

    def test_no_specials_identity() {
        self.assertEqual(escape("plain text 123"), "plain text 123")
        self.assertEqual(escape(""), "")
    }

    def test_no_double_escape_ordering() {
        self.assertEqual(escape("&amp;"), "&amp;amp;")
        self.assertEqual(escape("a&b<c"), "a&amp;b&lt;c")
    }

    def test_roundtrip() {
        const raw: str = "Tom & 'Jerry' <b>\"hi\"</b>"
        self.assertEqual(unescape(escape(raw)), raw)
    }
}


class ReCompileErrorTests(TestCase) {
    def test_unbalanced_paren_raises() {
        def bad() {
            const p: Pattern = compile("(")
        }
        self.assertRaises(error, bad)
    }

    def test_bad_quantifier_raises() {
        def bad() {
            const p: Pattern = compile("*a")
        }
        self.assertRaises(error, bad)
    }

    def test_error_message_has_position() {
        msg: str = ""
        try {
            const p: Pattern = compile("(")
        } except error as e {
            msg = str(e)
        }
        self.assertIn("position", msg)
    }

    def test_valid_pattern_still_compiles() {
        const p: Pattern = compile("[a-z]+")
        self.assertEqual(p.find("123abc456"), "abc")
        p.destroy()
    }
}


class ReSubTests(TestCase) {
    def test_sub_multiple_matches() {
        self.assertEqual(sub("[0-9]+", "N", "a1b22c333"), "aNbNcN")
    }

    def test_sub_no_match_returns_subject() {
        self.assertEqual(sub("z+", "N", "abc"), "abc")
    }

    def test_sub_backreference() {
        self.assertEqual(sub("([a-z])([0-9])", "\\2\\1", "a1 b2"), "1a 2b")
    }

    def test_sub_many_matches() {
        parts: list[str] = []
        i: int = 0
        while i < 2000 {
            parts.append("a1")
            i = i + 1
        }
        const subject: str = "".join(parts)
        const result: str = sub("[0-9]", "N", subject)
        self.assertEqual(len(result), 4000)
        self.assertTrue(result.startswith("aNaN"))
        self.assertTrue(result.endswith("aNaN"))
    }
}


class ReScanTests(TestCase) {
    def test_findall() {
        const xs: list[str] = findall("[0-9]+", "a1b22c333")
        self.assertEqual(len(xs), 3)
        self.assertEqual(xs[0], "1")
        self.assertEqual(xs[2], "333")
    }

    def test_split() {
        const ps: list[str] = re.split(",", "a,b,c")
        self.assertEqual(len(ps), 3)
        self.assertEqual(ps[1], "b")
    }
}


class ReMatchBoolTests(TestCase) {
    def test_match_returns_bool() {
        self.assertTrue(re.match("h.llo", "hello world"))
        self.assertFalse(re.match("zzz", "abc"))
    }

    def test_no_match_is_falsy_in_if() {
        accepted: bool = false
        if re.match("^[0-9]+$", "not-a-number") {
            accepted = true
        }
        self.assertFalse(accepted)
    }

    def test_pattern_match_returns_bool() {
        const p: Pattern = compile("^ab")
        self.assertTrue(p.match("abc"))
        self.assertFalse(p.match("xabc"))
        p.destroy()
    }

    def test_match_limit_exhaustion_raises() {
        def explode() {
            re.match("(a|a)+$", ("a" * 40) + "b")
        }
        self.assertRaises(error, explode)
    }

    def test_find_reports_match_errors() {
        def explode() {
            const p: Pattern = compile("(a|a)+$")
            defer p.destroy()
            p.find(("a" * 40) + "b")
        }
        self.assertRaises(error, explode)
    }
}


main([WrapWidthTests(), ShortenTests(), SpanRewriteTests(),
      SplitTests(), QuoteJoinTests(), PaddingTests(), DifflibTests(),
      TranslateTests(), MatchTests(), QuopriTests(),
      UnescapeRangeTests(), EscapeSpanTests(),
      ReCompileErrorTests(), ReSubTests(), ReScanTests(), ReMatchBoolTests()])

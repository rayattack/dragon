from unittest import TestCase, main

class TruthinessContextTests(TestCase) {
    def test_assert_accepts_truthy_non_bool() {
        xs: list[int] = [1]
        assert xs
        assert "text"
        assert 1.5
        d: dict[str, int] = {"a": 1}
        assert d
        self.assertTrue(True)
    }

    def test_assert_rejects_empty_container() {
        raised: bool = False
        try {
            empty: list[int] = []
            assert empty
        } except AssertionError {
            raised = True
        }
        self.assertTrue(raised)
    }

    def test_assert_rejects_empty_str() {
        raised: bool = False
        try {
            blank: str = ""
            assert blank
        } except AssertionError {
            raised = True
        }
        self.assertTrue(raised)
    }

    def test_union_truthiness_follows_payload() {
        v: int | str = 42
        self.assertTrue(bool(v))
        w: int | str = 0
        self.assertFalse(bool(w))
        s: int | str = "x"
        self.assertTrue(bool(s))
        e: int | str = ""
        self.assertFalse(bool(e))
    }

    def test_union_as_condition() {
        v: int | str = "text"
        hit: int = 0
        if v {
            hit = 1
        }
        self.assertEqual(hit, 1)
        e: int | str = ""
        if e {
            hit = 2
        }
        self.assertEqual(hit, 1)
    }

    def test_union_as_while_condition() {
        v: int | str = 3
        n: int = 0
        while v {
            n = n + 1
            if n > 2 {
                v = 0
            }
        }
        self.assertEqual(n, 3)
    }
}

main([TruthinessContextTests()])

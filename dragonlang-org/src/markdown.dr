from highlight import highlight


def _html_escape(s: str) -> str {
    out: str = ""
    i: int = 0
    while i < len(s) {
        const c: str = s[i]
        if c == "&" {
            out = out + "&amp;"
        } elif c == "<" {
            out = out + "&lt;"
        } elif c == ">" {
            out = out + "&gt;"
        } elif c == "\"" {
            out = out + "&quot;"
        } else {
            out = out + c
        }
        i = i + 1
    }
    return out
}


def slug(text: str) -> str {
    parts: list[str] = []
    prev_dash: bool = True
    i: int = 0
    while i < len(text) {
        const c: int = ord(text[i])
        if (c >= 97 and c <= 122) or (c >= 48 and c <= 57) {
            parts.append(text[i])
            prev_dash = False
        } elif c >= 65 and c <= 90 {
            parts.append(chr(c + 32))
            prev_dash = False
        } else {
            if not prev_dash {
                parts.append("-")
                prev_dash = True
            }
        }
        i = i + 1
    }
    out: str = "".join(parts)
    while len(out) > 0 and out.endswith("-") {
        out = out[:len(out) - 1]
    }
    return out
}


def _starts_with(s: str, prefix: str) -> bool {
    if len(prefix) > len(s) {
        return false
    }
    i: int = 0
    while i < len(prefix) {
        if s[i] != prefix[i] {
            return false
        }
        i = i + 1
    }
    return true
}


def _strip(s: str) -> str {
    n: int = len(s)
    if n == 0 {
        return s
    }
    lo: int = 0
    while lo < n {
        const c: str = s[lo]
        if c == " " or c == "\t" or c == "\r" or c == "\n" {
            lo = lo + 1
        } else {
            break
        }
    }
    hi: int = n
    while hi > lo {
        const c: str = s[hi - 1]
        if c == " " or c == "\t" or c == "\r" or c == "\n" {
            hi = hi - 1
        } else {
            break
        }
    }
    return s[lo:hi]
}


def _rstrip(s: str) -> str {
    n: int = len(s)
    hi: int = n
    while hi > 0 {
        const c: str = s[hi - 1]
        if c == " " or c == "\t" or c == "\r" or c == "\n" {
            hi = hi - 1
        } else {
            break
        }
    }
    return s[0:hi]
}


def _render_inline(line: str) -> str {
    out: str = ""
    i: int = 0
    n: int = len(line)
    while i < n {
        const c: str = line[i]

        if c == "`" {
            const close: int = line.find("`", i + 1)
            if close > i {
                const code: str = line[i + 1:close]
                out = out + "<code>" + _html_escape(code) + "</code>"
                i = close + 1
                continue
            }
            out = out + "&#96;"
            i = i + 1
            continue
        }

        if c == "*" and i + 1 < n and line[i + 1] == "*" {
            const close: int = line.find("**", i + 2)
            if close > i {
                const inner: str = line[i + 2:close]
                out = out + "<strong>" + _render_inline(inner) + "</strong>"
                i = close + 2
                continue
            }
        }

        if c == "*" {
            const close: int = line.find("*", i + 1)
            if close > i and (close + 1 >= n or line[close + 1] != "*") {
                const inner: str = line[i + 1:close]
                out = out + "<em>" + _render_inline(inner) + "</em>"
                i = close + 1
                continue
            }
        }

        if c == "[" {
            const closeB: int = line.find("]", i + 1)
            if closeB > i and closeB + 1 < n and line[closeB + 1] == "(" {
                const closeP: int = line.find(")", closeB + 2)
                if closeP > closeB {
                    const text: str = line[i + 1:closeB]
                    const url: str = line[closeB + 2:closeP]
                    out = out + "<a href=\"" + _html_escape(url) + "\">"
                    out = out + _render_inline(text) + "</a>"
                    i = closeP + 1
                    continue
                }
            }
        }

        if c == "&" {
            out = out + "&amp;"
        } elif c == "<" {
            out = out + "&lt;"
        } elif c == ">" {
            out = out + "&gt;"
        } else {
            out = out + c
        }
        i = i + 1
    }
    return out
}


def _is_table_row(line: str) -> bool {
    const s: str = _strip(line)
    if len(s) < 2 {
        return false
    }
    if s[0] != "|" {
        return false
    }
    return s.find("|", 1) >= 0
}

def _split_table_row(line: str) -> list[str] {
    const s: str = _strip(line)
    const raw: list[str] = s.split("|")
    const out: list[str] = []
    i: int = 0
    while i < len(raw) {
        const cell: str = _strip(raw[i])
        if i == 0 and len(cell) == 0 {
            i = i + 1
            continue
        }
        if i == len(raw) - 1 and len(cell) == 0 {
            i = i + 1
            continue
        }
        out.append(cell)
        i = i + 1
    }
    return out
}

def _is_table_separator(line: str) -> bool {
    if not _is_table_row(line) {
        return false
    }
    const cells: list[str] = _split_table_row(line)
    if len(cells) == 0 {
        return false
    }
    i: int = 0
    while i < len(cells) {
        const c: str = _strip(cells[i])
        if len(c) == 0 {
            return false
        }
        lo: int = 0
        hi: int = len(c)
        if c[0] == ":" {
            lo = 1
        }
        if hi > lo and c[hi - 1] == ":" {
            hi = hi - 1
        }
        if hi - lo < 1 {
            return false
        }
        j: int = lo
        while j < hi {
            if c[j] != "-" {
                return false
            }
            j = j + 1
        }
        i = i + 1
    }
    return true
}


def _is_digits(s: str) -> bool {
    if len(s) == 0 {
        return false
    }
    i: int = 0
    while i < len(s) {
        const c: str = s[i]
        if c < "0" or c > "9" {
            return false
        }
        i = i + 1
    }
    return true
}


def _first_word(s: str) -> str {
    i: int = 0
    const n: int = len(s)
    while i < n and (s[i] == " " or s[i] == "\t") {
        i = i + 1
    }
    j: int = i
    while j < n and s[j] != " " and s[j] != "\t" {
        j = j + 1
    }
    return s[i:j].lower()
}


def _render_code_block(lang: str, lines: list[str]) -> str {
    body: str = ""
    i: int = 0
    while i < len(lines) {
        if i > 0 {
            body = body + "\n"
        }
        body = body + lines[i]
        i = i + 1
    }
    open_tag: str = "<pre><code>"
    if len(lang) > 0 {
        open_tag = "<pre><code class=\"language-" + _html_escape(lang) + "\">"
    }
    return open_tag + highlight(lang, body) + "</code></pre>\n"
}


def render(md: str) -> str {
    const lines: list[str] = md.split("\n")
    out: str = ""
    in_ul: bool = false
    in_ol: bool = false
    in_quote: bool = false
    in_code: bool = false
    code_lang: str = ""
    code_lines: list[str] = []
    para: list[str] = []

    def close_para() -> None {
        nonlocal out, para
        if len(para) > 0 {
            joined: str = ""
            j: int = 0
            while j < len(para) {
                if j > 0 {
                    joined = joined + " "
                }
                joined = joined + _render_inline(para[j])
                j = j + 1
            }
            out = out + "<p>" + joined + "</p>\n"
            para = []
        }
    }

    def close_lists() -> None {
        nonlocal out, in_ul, in_ol, in_quote
        if in_ul {
            out = out + "</ul>\n"
            in_ul = false
        }
        if in_ol {
            out = out + "</ol>\n"
            in_ol = false
        }
        if in_quote {
            out = out + "</blockquote>\n"
            in_quote = false
        }
    }

    i: int = 0
    while i < len(lines) {
        const raw: str = _rstrip(lines[i])

        if in_code {
            if _starts_with(_strip(raw), "```") {
                out = out + _render_code_block(code_lang, code_lines)
                in_code = false
                code_lines = []
                code_lang = ""
            } else {
                code_lines.append(raw)
            }
            i = i + 1
            continue
        }

        if _starts_with(_strip(raw), "```") {
            close_para()
            close_lists()
            const fence: str = _strip(raw)
            code_lang = _first_word(fence[3:]) if len(fence) > 3 else ""
            code_lines = []
            in_code = true
            i = i + 1
            continue
        }

        const stripped: str = _strip(raw)

        if len(stripped) == 0 {
            close_para()
            close_lists()
            i = i + 1
            continue
        }

        const is_table_start: bool = _is_table_row(raw) and i + 1 < len(lines) and _is_table_separator(lines[i + 1])
        if is_table_start {
            close_para()
            close_lists()
            const headers: list[str] = _split_table_row(raw)
            out = out + "<table>\n<thead><tr>"
            h: int = 0
            while h < len(headers) {
                out = out + "<th>" + _render_inline(headers[h]) + "</th>"
                h = h + 1
            }
            out = out + "</tr></thead>\n<tbody>\n"
            i = i + 2
            while i < len(lines) and _is_table_row(_rstrip(lines[i])) {
                const cells: list[str] = _split_table_row(_rstrip(lines[i]))
                out = out + "<tr>"
                c: int = 0
                while c < len(cells) {
                    out = out + "<td>" + _render_inline(cells[c]) + "</td>"
                    c = c + 1
                }
                out = out + "</tr>\n"
                i = i + 1
            }
            out = out + "</tbody>\n</table>\n"
            continue
        }

        if _starts_with(stripped, "# ") {
            close_para(); close_lists()
            const t: str = stripped[2:]
            out = out + "<h1 id=\"" + slug(t) + "\">" + _render_inline(t) + "</h1>\n"
            i = i + 1
            continue
        }
        if _starts_with(stripped, "## ") {
            close_para(); close_lists()
            const t: str = stripped[3:]
            out = out + "<h2 id=\"" + slug(t) + "\">" + _render_inline(t) + "</h2>\n"
            i = i + 1
            continue
        }
        if _starts_with(stripped, "### ") {
            close_para(); close_lists()
            const t: str = stripped[4:]
            out = out + "<h3 id=\"" + slug(t) + "\">" + _render_inline(t) + "</h3>\n"
            i = i + 1
            continue
        }
        if _starts_with(stripped, "#### ") {
            close_para(); close_lists()
            const t: str = stripped[5:]
            out = out + "<h4 id=\"" + slug(t) + "\">" + _render_inline(t) + "</h4>\n"
            i = i + 1
            continue
        }

        if stripped == "---" or stripped == "***" or stripped == "___" {
            close_para(); close_lists()
            out = out + "<hr>\n"
            i = i + 1
            continue
        }

        if _starts_with(stripped, "> ") {
            close_para()
            if in_ul { out = out + "</ul>\n"; in_ul = false }
            if in_ol { out = out + "</ol>\n"; in_ol = false }
            if not in_quote {
                out = out + "<blockquote>\n"
                in_quote = true
            }
            out = out + "<p>" + _render_inline(stripped[2:]) + "</p>\n"
            i = i + 1
            continue
        }

        if _starts_with(stripped, "- ") or _starts_with(stripped, "* ") {
            close_para()
            if in_ol { out = out + "</ol>\n"; in_ol = false }
            if in_quote { out = out + "</blockquote>\n"; in_quote = false }
            if not in_ul {
                out = out + "<ul>\n"
                in_ul = true
            }
            item: str = stripped[2:]
            i = i + 1
            while i < len(lines) {
                const next_raw: str = _rstrip(lines[i])
                const next_strip: str = _strip(next_raw)
                if len(next_strip) == 0 { break }
                if _starts_with(next_strip, "- ") { break }
                if _starts_with(next_strip, "* ") { break }
                if _starts_with(next_strip, "# ") { break }
                if _starts_with(next_strip, "## ") { break }
                if _starts_with(next_strip, "### ") { break }
                if _starts_with(next_strip, "#### ") { break }
                if _starts_with(next_strip, "```") { break }
                if _starts_with(next_strip, "> ") { break }
                if next_strip == "---" or next_strip == "***" or next_strip == "___" { break }
                const ndot: int = next_strip.find(". ")
                if ndot > 0 and ndot < 4 {
                    const nprefix: str = next_strip[0:ndot]
                    if _is_digits(nprefix) { break }
                }
                const tbl_close: bool = _is_table_row(next_strip) and i + 1 < len(lines) and _is_table_separator(lines[i + 1])
                if tbl_close { break }
                item = item + " " + next_strip
                i = i + 1
            }
            out = out + "<li>" + _render_inline(item) + "</li>\n"
            continue
        }

        const dot: int = stripped.find(". ")
        if dot > 0 and dot < 4 {
            const prefix: str = stripped[0:dot]
            if _is_digits(prefix) {
                close_para()
                if in_ul { out = out + "</ul>\n"; in_ul = false }
                if in_quote { out = out + "</blockquote>\n"; in_quote = false }
                if not in_ol {
                    out = out + "<ol>\n"
                    in_ol = true
                }
                item: str = stripped[dot + 2:]
                i = i + 1
                while i < len(lines) {
                    const next_raw: str = _rstrip(lines[i])
                    const next_strip: str = _strip(next_raw)
                    if len(next_strip) == 0 { break }
                    if _starts_with(next_strip, "- ") { break }
                    if _starts_with(next_strip, "* ") { break }
                    if _starts_with(next_strip, "# ") { break }
                    if _starts_with(next_strip, "## ") { break }
                    if _starts_with(next_strip, "### ") { break }
                    if _starts_with(next_strip, "#### ") { break }
                    if _starts_with(next_strip, "```") { break }
                    if _starts_with(next_strip, "> ") { break }
                    if next_strip == "---" or next_strip == "***" or next_strip == "___" { break }
                    const ndot: int = next_strip.find(". ")
                    if ndot > 0 and ndot < 4 {
                        const nprefix: str = next_strip[0:ndot]
                        if _is_digits(nprefix) { break }
                    }
                    const tbl_close: bool = _is_table_row(next_strip) and i + 1 < len(lines) and _is_table_separator(lines[i + 1])
                    if tbl_close { break }
                    item = item + " " + next_strip
                    i = i + 1
                }
                out = out + "<li>" + _render_inline(item) + "</li>\n"
                continue
            }
        }

        close_lists()
        para.append(stripped)
        i = i + 1
    }

    close_para()
    close_lists()
    if in_code {
        out = out + _render_code_block(code_lang, code_lines)
    }
    return out
}

